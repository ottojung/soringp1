+#!/bin/sh
+# Preserve a departing appointment's exact status and worktree evidence.
+set -eu
+[ "$#" -eq 3 ] || { echo 'Usage: terminal-appointment-evidence.sh KEY ID CWD' >&2; exit 2; }
+key=$1 id=$2 cwd=$3
+case "$key:$id" in *[!a-zA-Z0-9_:-]*|'') exit 2;; esac
+root=${VICHE_STATE_ROOT:-/var/lib/lubko/wd/viche-state}/appointments
+umask 077
+mkdir -p "$root/terminal-evidence/$id"
+incoming=$(mktemp "$root/.terminal-status-XXXXXXXX") || exit 1
+tmp=
+trap 'rm -f "$incoming"; if [ -n "${tmp:-}" ]; then rm -rf "$tmp"; fi' 0 HUP INT TERM
+cat > "$incoming"
+jq -e 'type=="object" and (.state | type=="string")' "$incoming" >/dev/null ||
+  { echo 'Malformed terminal appointment evidence' >&2; exit 1; }
+invocation=$(jq -r '.invocation_id // .run_id // .finished_at // "unreadable"' "$incoming")
+case "$invocation" in *[!a-zA-Z0-9_.:+-]*) echo 'Unsafe invocation identity in terminal status' >&2; exit 1;; esac
+dest=$root/terminal-evidence/$id/$invocation
+if [ ! -d "$dest" ]; then
+  tmp=$(mktemp -d "$root/.terminal-XXXXXXXX") || exit 1
+  cp "$incoming" "$tmp/status.json"
+  state=$(jq -r '.state' "$tmp/status.json")
+  antonina agent log --id "$id" --lines 80 > "$tmp/log-tail.txt" 2>&1 || :
+  git -C "$cwd" rev-parse HEAD > "$tmp/worktree-head.txt" 2>/dev/null || printf 'unavailable\n' > "$tmp/worktree-head.txt"
+  git -C "$cwd" status --short > "$tmp/worktree-status.txt" 2>/dev/null || :
+  jq -cn --arg key "$key" --arg id "$id" --arg cwd "$cwd" \
+    --arg at "$(date -u +%FT%TZ)" --slurpfile m "$tmp/status.json" \
+    '{at:$at, office:$key, agent_id:$id, cwd:$cwd, state:$m[0].state,
+      finished_at:($m[0].finished_at//null), prompts:($m[0].prompts//null),
+      failure_class:($m[0].backend_error.classification//null),
+      transient:$m[0].backend_error.transient,
+      automatic_retry_safe:$m[0].backend_error.automatic_retry_safe,
+      invocation_identity:($m[0].invocation_id//$m[0].run_id//$m[0].finished_at//"unreadable"|tostring),
+      evidence:("terminal-evidence/" + $id + "/" + (($m[0].invocation_id//$m[0].run_id//$m[0].finished_at//"unreadable")|tostring))}' > "$tmp/event.json"
+  mv "$tmp" "$dest"
+  tmp=
+fi
+# Repair the convenience index after a crash between snapshot publication and
+# indexing. The appointment lock serializes callers; checking by agent ID also
+# makes a crash after append but before return idempotent.
+index=$root/terminal-events.jsonl
+if [ -s "$index" ]; then
+  found=$(jq -s --arg id "$id" --arg inv "$invocation" \
+    'any(.[]; .agent_id==$id and (.invocation_identity|tostring)==$inv)' "$index") || exit 1
+else
+  found=false
+fi
+if [ "$found" != true ]; then
+  cat "$dest/event.json" >> "$index"
+fi
+rm -f "$incoming"
+trap - 0 HUP INT TERM
