+    n=$((n+1)); printf '%s\n' "$n" > "$MOCK_ROOT/next"
+    id="id-$n"
+    printf '{"state":"idle","model":null,"variant":null}\n' > "$MOCK_ROOT/$id.json"
+    printf '%s\n' "$id" ;;
+  'agent log')
