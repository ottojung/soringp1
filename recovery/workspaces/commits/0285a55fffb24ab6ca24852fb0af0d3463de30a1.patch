+# A successor failure that predates its claimed verification invalidates the
+# continuity receipt. Re-signalling must reopen the original object in place.
+mkdir -p "$d/state/appointments/terminal-evidence/new-agent"
+printf '{"state":"failed","finished_at":1400}\n' > "$d/state/appointments/terminal-evidence/new-agent/status.json"
+original_id=$(jq -r '.id' "$d/state/institutional-cases/continuity_unverified_innovation-centre.json")
+original_first_seen=$(jq -r '.first_seen' "$d/state/institutional-cases/continuity_unverified_innovation-centre.json")
+original_verified_at=$(jq -r '.verified_at' "$d/state/institutional-cases/continuity_unverified_innovation-centre.json")
+original_observations=$(jq -r '.observations' "$d/state/institutional-cases/continuity_unverified_innovation-centre.json")
