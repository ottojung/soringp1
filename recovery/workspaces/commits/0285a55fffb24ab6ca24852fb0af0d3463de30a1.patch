+jq '.state="verified_closed" | .first_seen=900 | .verified_at=950 | .observations=7 | .id="innovation_stale:900"' \
+  "$d/state/institutional-cases/innovation_stale.json" > "$d/state/institutional-cases/innovation_stale.json.tmp"
+mv "$d/state/institutional-cases/innovation_stale.json.tmp" "$d/state/institutional-cases/innovation_stale.json"
+printf '{"signals":["innovation_stale"],"observed_at":1600}\n' > "$d/state/branches/incident.json"
+VICHE_CASE_NOW=1600 python3 "$repo/government/institutional-cases.py" reconcile >/dev/null
+jq -e '.state=="open" and .id=="innovation_stale:900" and .first_seen==900 and .verified_at==950 and .closure_history[0].verified_at==950 and .observations==8 and .reopened_at==1600 and .reopen_count==1' \
+  "$d/state/institutional-cases/innovation_stale.json" >/dev/null
