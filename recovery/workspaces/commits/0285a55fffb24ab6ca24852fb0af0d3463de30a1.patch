diff --git a/government/institutional-cases.py b/government/institutional-cases.py
index 77951743..a133649b 100644
--- a/government/institutional-cases.py
+++ b/government/institutional-cases.py
@@ -6,6 +6,7 @@ to enact law. Observation and routing remain deterministic even if every model
 is down. Existing independent Judiciary/Parliament/Executive powers remain.
 """
 import argparse
+import datetime
 import hashlib
 import json
 import os
@@ -58,6 +59,29 @@ def continuity_receipt(office):
         return None
     if verified.get("verification_scope") != "external_effect_reconciled":
         return None
+    # A receipt that says the successor was running cannot be accepted if its
+    # durable terminal record says it had already failed by verification time.
+    # This is a contradiction check, not proof that free-form evidence text is
+    # truthful or that every external effect was reconciled.
+    successor = receipt.get("successor_agent")
+    verified_at = verified.get("verified_at")
+    if (not isinstance(successor, str)
+            or not successor
+            or any(c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_" for c in successor)
+            or not isinstance(verified_at, str)):
+        return None
+    try:
+        verified_time = datetime.datetime.fromisoformat(verified_at.replace("Z", "+00:00"))
+        if verified_time.tzinfo is None:
+            return None
+        verified_epoch = verified_time.timestamp()
+    except (ValueError, OverflowError):
+        return None
+    terminal = read(ROOT / "appointments/terminal-evidence" / successor / "status.json")
+    if terminal.get("state") == "failed":
+        finished_at = terminal.get("finished_at")
+        if isinstance(finished_at, (int, float)) and finished_at <= verified_epoch:
+            return None
     ref = verified.get("evidence_ref")
     if not isinstance(ref, str) or not ref.strip():
         return None
@@ -246,7 +270,7 @@ def reconcile():
         path = STORE / (signal + ".json")
         case = read(path)
         if signal in signals:
-            if not case or case.get("state") == "verified_closed":
+            if not case:
                 case = {
                     "id": f"{signal}:{now}", "signal": signal,
                     "first_seen": now, "state": "open",
@@ -258,6 +282,23 @@ def reconcile():
                     "closure_rule": "independent verification artifact bound to this case; "
                                     "healthy probes are only a precondition",
                 }
+            elif case.get("state") == "verified_closed":
+                # Re-signal an existing historical case in place. Never replace
+                # its identity, first_seen, verification time, or observation
+                # history with a synthetic new case.
+                closure = {
+                    key: case[key] for key in ("verified_at", "verification", "closure_evidence")
+                    if key in case
+                }
+                if closure:
+                    case.setdefault("closure_history", []).append(closure)
+                case["state"] = "open"
+                case["reopened_at"] = now
+                case["reopen_reason"] = "monitored signal reappeared after recorded closure"
+                case["reopen_count"] = case.get("reopen_count", 0) + 1
+                case["clear_observations"] = 0
+                case.pop("last_clear_observation", None)
+                case.pop("awaiting_independent_verification", None)
             case["last_seen"] = now
             case["observations"] = case.get("observations", 0) + 1
             case["clear_observations"] = 0
