+  '.state=="open" and .id==$id and .first_seen==$first and .verified_at==$verified and .closure_history[0].verified_at==$verified and .observations==($observations+1) and .reopened_at==1520 and .reopen_count==1' \
+  "$d/state/institutional-cases/continuity_unverified_innovation-centre.json" >/dev/null
+# A closed non-continuity case must likewise retain its old identity/history
