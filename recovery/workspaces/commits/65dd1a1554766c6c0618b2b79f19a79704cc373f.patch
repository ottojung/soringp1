diff --git a/government/obligation-expiry.py b/government/obligation-expiry.py
new file mode 100644
index 00000000..f74e363e
--- /dev/null
+++ b/government/obligation-expiry.py
@@ -0,0 +1,343 @@
+#!/usr/bin/env python3
+"""Obligation expiry (Founder directive 2026-11-16, "Act 30" in LAWS.md).
+
+Every obligation that the town's scripts inject into an office's prompt now has
+an owner who can close it alone and an expiry time. When the time passes and
+nobody has renewed it with a reason, the obligation is ARCHIVED, never deleted:
+the original evidence is kept, the state becomes ``expired`` and the injection
+stops. An expired obligation is explicitly *unverified*; expiry is not proof
+that the underlying problem is fixed (Constitution VI: no misrepresenting
+progress), it only stops the obligation from taxing every future pass.
+
+Kinds handled
+  receipt  state/continuity/reconciliation-OFFICE.json  (state awaiting_reconciliation)
+           owner: the office named in the receipt
+  handoff  records/handoffs/H-*.txt                      (status open)
+           owner: the office that holds the handoff (see its ``assigned-by``)
+  mailbox  state/oversight/judiciary-mailbox/inbox/*     (unreviewed reports)
+           owner: the Judiciary
+
+Commands
+  sweep [--now EPOCH]                 expire everything past its time (default)
+  report                              JSON summary of live and expired obligations
+  renew receipt OFFICE --reason TEXT  restart the clock for one receipt
+  renew handoff ID --reason TEXT      restart the clock for one handoff
+  close receipt OFFICE --evidence TXT owner closes its own receipt, no verifier needed
+
+Environment
+  VICHE_OBLIGATION_TTL_HOURS   default 72 (0 disables expiry)
+  VICHE_TOWN_ROOT / VICHE_STATE_ROOT
+"""
+import argparse
+import datetime
+import json
+import os
+import pathlib
+import re
+import shutil
+import sys
+import tempfile
+import time
+
+TOWN = pathlib.Path(os.environ.get("VICHE_TOWN_ROOT", "/var/lib/lubko/wd/viche"))
+STATE = pathlib.Path(os.environ.get("VICHE_STATE_ROOT", "/var/lib/lubko/wd/viche-state"))
+LEDGER_DIR = STATE / "obligations"
+CONTINUITY = STATE / "continuity"
+HANDOFFS = TOWN / "records" / "handoffs"
+MAILBOX = STATE / "oversight" / "judiciary-mailbox"
+
+
+def ttl_seconds():
+    raw = os.environ.get("VICHE_OBLIGATION_TTL_HOURS", "72")
+    try:
+        hours = float(raw)
+    except ValueError:
+        hours = 72.0
+    return int(hours * 3600) if hours > 0 else 0
+
+
+def iso_to_epoch(text):
+    if not isinstance(text, str) or not text:
+        return None
+    try:
+        return datetime.datetime.strptime(text.strip(), "%Y-%m-%dT%H:%M:%SZ").replace(
+            tzinfo=datetime.timezone.utc).timestamp()
+    except ValueError:
+        return None
+
+
+def epoch_to_iso(epoch):
+    return datetime.datetime.fromtimestamp(int(epoch), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def atomic_write(path, text, mode=None):
+    path = pathlib.Path(path)
+    fd, name = tempfile.mkstemp(prefix=".tmp.", dir=str(path.parent))
+    try:
+        with os.fdopen(fd, "w") as handle:
+            handle.write(text)
+        if mode is not None:
+            os.chmod(name, mode)
+        os.replace(name, path)
+    finally:
+        if os.path.exists(name):
+            os.unlink(name)
+
+
+def ledger(entry):
+    LEDGER_DIR.mkdir(parents=True, exist_ok=True)
+    with open(LEDGER_DIR / "ledger.jsonl", "a") as handle:
+        handle.write(json.dumps(entry, sort_keys=True) + "\n")
+
+
+# --- receipts ---------------------------------------------------------------
+
+def receipt_clock(receipt):
+    """Epoch from which the receipt's time-to-live is counted."""
+    start = iso_to_epoch(receipt.get("at"))
+    renewed = iso_to_epoch(receipt.get("renewed_at"))
+    candidates = [value for value in (start, renewed) if value is not None]
+    return max(candidates) if candidates else None
+
+
+def receipts():
+    for path in sorted(CONTINUITY.glob("reconciliation-*.json")):
+        try:
+            data = json.loads(path.read_text())
+        except (OSError, ValueError):
+            continue
+        if isinstance(data, dict):
+            yield path, data
+
+
+def expire_receipts(now, ttl):
+    expired = []
+    for path, data in receipts():
+        if data.get("state") != "awaiting_reconciliation":
+            continue
+        clock = receipt_clock(data)
+        if clock is None or ttl <= 0 or now - clock < ttl:
+            continue
+        archive = CONTINUITY / "archive"
+        archive.mkdir(parents=True, exist_ok=True)
+        stamp = re.sub(r"[^0-9A-Za-z]", "", str(data.get("at", "unknown")))
+        copy = archive / (path.stem + "-" + stamp + ".original.json")
+        if not copy.exists():
+            shutil.copy2(path, copy)
+        updated = dict(data)
+        updated.update({
+            "state": "expired",
+            "expired_at": epoch_to_iso(now),
+            "expired_unverified": True,
+            "expiry_reason": "ttl_elapsed_without_renewal",
+            "expiry_ttl_hours": ttl / 3600,
+            "original_preserved": str(copy.relative_to(STATE)),
+        })
+        atomic_write(path, json.dumps(updated, separators=(",", ":")) + "\n", 0o600)
+        age = (now - clock) / 3600
+        ledger({"at": epoch_to_iso(now), "kind": "receipt", "id": data.get("office", path.stem),
+                "age_hours": round(age, 1), "action": "expired"})
+        expired.append(data.get("office", path.stem))
+    return expired
+
+
+# --- handoffs ---------------------------------------------------------------
+
+def handoff_fields(path):
+    fields = {}
+    try:
+        for line in path.read_text().splitlines():
+            match = re.match(r"^([a-z-]+):\s*(.*)$", line)
+            if match:
+                fields[match.group(1)] = match.group(2)
+    except OSError:
+        pass
+    return fields
+
+
+def expire_handoffs(now, ttl):
+    expired = []
+    if not HANDOFFS.is_dir():
+        return expired
+    for path in sorted(HANDOFFS.glob("H-*.txt")):
+        fields = handoff_fields(path)
+        if fields.get("status") != "open":
+            continue
+        created = iso_to_epoch(fields.get("created"))
+        renewed = iso_to_epoch(fields.get("renewed"))
+        clock = max([v for v in (created, renewed) if v is not None], default=None)
+        if clock is None or ttl <= 0 or now - clock < ttl:
+            continue
+        text = path.read_text()
+        text = re.sub(r"(?m)^status: open$", "status: expired", text, count=1)
+        if not text.endswith("\n"):
+            text += "\n"
+        text += "closed: %s\nnote: expired unverified after %dh without renewal (Act 30); evidence preserved\n" % (
+            epoch_to_iso(now), ttl // 3600)
+        atomic_write(path, text)
+        ledger({"at": epoch_to_iso(now), "kind": "handoff", "id": fields.get("id", path.stem),
+                "age_hours": round((now - clock) / 3600, 1), "action": "expired"})
+        expired.append(fields.get("id", path.stem))
+    return expired
+
+
+# --- Judiciary mailbox -------------------------------------------------------
+
+def mailbox_item_epoch(path):
+    match = re.match(r"^(\d{8})T(\d{4})(\d{2})?Z", path.name)
+    if match:
+        date, hhmm, ss = match.group(1), match.group(2), match.group(3) or "00"
+        try:
+            return datetime.datetime.strptime(date + hhmm + ss, "%Y%m%d%H%M%S").replace(
+                tzinfo=datetime.timezone.utc).timestamp()
+        except ValueError:
+            pass
+    try:
+        return path.stat().st_mtime
+    except OSError:
+        return None
+
+
+def expire_mailbox(now, ttl):
+    expired = []
+    inbox = MAILBOX / "inbox"
+    if not inbox.is_dir() or ttl <= 0:
+        return expired
+    target = MAILBOX / "expired"
+    for path in sorted(inbox.iterdir()):
+        if not path.is_file() or path.name.startswith("."):
+            continue
+        stamp = mailbox_item_epoch(path)
+        if stamp is None or now - stamp < ttl:
+            continue
+        target.mkdir(parents=True, exist_ok=True)
+        destination = target / path.name
+        if destination.exists():
+            destination = target / (path.name + "." + str(int(now)))
+        os.replace(path, destination)
+        ledger({"at": epoch_to_iso(now), "kind": "mailbox", "id": path.name,
+                "age_hours": round((now - stamp) / 3600, 1), "action": "expired"})
+        expired.append(path.name)
+    return expired
+
+
+# --- commands ---------------------------------------------------------------
+
+def sweep(now):
+    ttl = ttl_seconds()
+    result = {"at": epoch_to_iso(now), "ttl_hours": ttl / 3600,
+              "receipts": expire_receipts(now, ttl),
+              "handoffs": expire_handoffs(now, ttl),
+              "mailbox": expire_mailbox(now, ttl)}
+    LEDGER_DIR.mkdir(parents=True, exist_ok=True)
+    atomic_write(LEDGER_DIR / "latest.json", json.dumps(result, sort_keys=True) + "\n")
+    return result
+
+
+def report(now):
+    ttl = ttl_seconds()
+    live = {"receipts": [], "handoffs": [], "mailbox": 0}
+    for _, data in receipts():
+        if data.get("state") == "awaiting_reconciliation":
+            clock = receipt_clock(data)
+            live["receipts"].append({
+                "office": data.get("office"),
+                "expires_at": epoch_to_iso(clock + ttl) if clock and ttl else None})
+    if HANDOFFS.is_dir():
+        for path in sorted(HANDOFFS.glob("H-*.txt")):
+            fields = handoff_fields(path)
+            if fields.get("status") == "open":
+                created = iso_to_epoch(fields.get("created"))
+                renewed = iso_to_epoch(fields.get("renewed"))
+                clock = max([v for v in (created, renewed) if v is not None], default=None)
+                live["handoffs"].append({
+                    "id": fields.get("id"),
+                    "expires_at": epoch_to_iso(clock + ttl) if clock and ttl else None})
+    inbox = MAILBOX / "inbox"
+    if inbox.is_dir():
+        live["mailbox"] = sum(1 for p in inbox.iterdir() if p.is_file() and not p.name.startswith("."))
+    totals = {"receipt": 0, "handoff": 0, "mailbox": 0}
+    ledger_path = LEDGER_DIR / "ledger.jsonl"
+    if ledger_path.is_file():
+        for line in ledger_path.read_text().splitlines():
+            try:
+                entry = json.loads(line)
+            except ValueError:
+                continue
+            if entry.get("action") == "expired" and entry.get("kind") in totals:
+                totals[entry["kind"]] += 1
+    return {"at": epoch_to_iso(now), "ttl_hours": ttl / 3600, "live": live, "expired_total": totals}
+
+
+def renew(kind, ident, reason, now):
+    if not reason or not reason.strip():
+        raise SystemExit("renewal requires a reason")
+    if kind == "receipt":
+        path = CONTINUITY / ("reconciliation-" + ident + ".json")
+        data = json.loads(path.read_text())
+        if data.get("state") != "awaiting_reconciliation":
+            raise SystemExit("receipt %s is %s, not awaiting_reconciliation" % (ident, data.get("state")))
+        data["renewed_at"] = epoch_to_iso(now)
+        data["renewals"] = int(data.get("renewals", 0)) + 1
+        data["renewal_reason"] = reason.strip()
+        atomic_write(path, json.dumps(data, separators=(",", ":")) + "\n", 0o600)
+    elif kind == "handoff":
+        path = HANDOFFS / (ident + ".txt")
+        fields = handoff_fields(path)
+        if fields.get("status") != "open":
+            raise SystemExit("handoff %s is %s, not open" % (ident, fields.get("status")))
+        text = path.read_text()
+        if not text.endswith("\n"):
+            text += "\n"
+        text += "renewed: %s\nrenewal-reason: %s\n" % (epoch_to_iso(now), " ".join(reason.split()))
+        atomic_write(path, text)
+    else:
+        raise SystemExit("unknown kind " + kind)
+    ledger({"at": epoch_to_iso(now), "kind": kind, "id": ident, "action": "renewed", "reason": reason.strip()})
+
+
+def close_receipt(office, evidence, now):
+    if not evidence or not evidence.strip():
+        raise SystemExit("closing a receipt requires evidence text")
+    path = CONTINUITY / ("reconciliation-" + office + ".json")
+    data = json.loads(path.read_text())
+    if data.get("state") != "awaiting_reconciliation":
+        raise SystemExit("receipt %s is %s" % (office, data.get("state")))
+    data.update({"state": "closed_by_owner", "closed_at": epoch_to_iso(now),
+                 "closed_by": office, "closure_evidence": evidence.strip(),
+                 "independently_verified": False})
+    atomic_write(path, json.dumps(data, separators=(",", ":")) + "\n", 0o600)
+    ledger({"at": epoch_to_iso(now), "kind": "receipt", "id": office, "action": "closed_by_owner",
+            "evidence": evidence.strip()})
+
+
+def main(argv):
+    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    parser.add_argument("--now", type=int, default=None)
+    sub = parser.add_subparsers(dest="command")
+    sub.add_parser("sweep")
+    sub.add_parser("report")
+    renew_p = sub.add_parser("renew")
+    renew_p.add_argument("kind", choices=["receipt", "handoff"])
+    renew_p.add_argument("ident")
+    renew_p.add_argument("--reason", required=True)
+    close_p = sub.add_parser("close")
+    close_p.add_argument("kind", choices=["receipt"])
+    close_p.add_argument("ident")
+    close_p.add_argument("--evidence", required=True)
+    args = parser.parse_args(argv)
+    now = args.now if args.now is not None else int(os.environ.get("VICHE_OBLIGATION_NOW", time.time()))
+    command = args.command or "sweep"
+    if command == "sweep":
+        print(json.dumps(sweep(now), sort_keys=True))
+    elif command == "report":
+        print(json.dumps(report(now), sort_keys=True, indent=2))
+    elif command == "renew":
+        renew(args.kind, args.ident, args.reason, now)
+    elif command == "close":
+        close_receipt(args.ident, args.evidence, now)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/government/proceed-by-default.sh b/government/proceed-by-default.sh
new file mode 100644
index 00000000..0d42481d
--- /dev/null
+++ b/government/proceed-by-default.sh
@@ -0,0 +1,184 @@
+#!/bin/sh
+# Proceed-by-default ledger (Founder directive 2026-11-16, "Act 30").
+#
+# The rule: an office that needs something from another office files a
+# REQUEST with a deadline (default 24h, never more than 72h). If the
+# addressee has not answered by then, the requester may go ahead; the
+# addressee (or the Judiciary) audits afterwards. Waiting is no longer the
+# default. Irreversible acts are the exception: they never proceed by
+# default, and `proceed` refuses them.
+#
+#   proceed-by-default.sh request TOWN REQUESTER ADDRESSEE HOURS CLASS ACTION...
+#       CLASS is reversible|irreversible. Prints the request id.
+#   proceed-by-default.sh answer  TOWN ID approved|declined NOTE...
+#       Addressee answers before the deadline. `declined` ends the request.
+#   proceed-by-default.sh proceed TOWN ID NOTE...
+#       Requester records that it went ahead after the deadline passed.
+#   proceed-by-default.sh audit   TOWN ID upheld|reversed|concern NOTE...
+#       Addressee or Judiciary reviews an action taken by default.
+#   proceed-by-default.sh sweep   TOWN
+#       Mark pending requests whose deadline passed as `due`.
+#   proceed-by-default.sh list    TOWN [pending|due|proceeded|all]
+#   proceed-by-default.sh brief   TOWN OFFICE
+#       Prompt block for OFFICE: requests it may proceed on, requests waiting
+#       on it (with deadlines), and actions it must audit. Empty if none.
+#
+# One file per request at TOWN/records/proceed/P-<epoch>-<hex>.txt, written
+# atomically; Git records keep the history (Act 5).
+set -eu
+cmd=${1:-}
+[ -n "$cmd" ] || { echo 'usage: proceed-by-default.sh request|answer|proceed|audit|sweep|list|brief TOWN ...' >&2; exit 2; }
+shift
+[ "$#" -ge 1 ] || { echo 'TOWN required' >&2; exit 2; }
+town=$1
+shift
+dir=$town/records/proceed
+now=$(date +%s)
+iso() { date -u -d "@$1" +%FT%TZ; }
+field() { sed -n "s/^$2:[[:space:]]*//p" "$1" | head -n 1; }
+epoch_of() {
+  [ -n "$1" ] || { echo 0; return; }
+  date -u -d "$1" +%s 2>/dev/null || echo 0
+}
+one_line() { printf '%s' "$*" | tr '\n\t' '  '; }
+write_atomic() { # file <- stdin
+  tmp=$(mktemp "$dir/.tmp.XXXXXX") || exit 1
+  cat > "$tmp"
+  mv -f "$tmp" "$1"
+}
+need_file() {
+  file=$dir/$1.txt
+  [ -f "$file" ] || { echo "no such request: $1" >&2; exit 1; }
+  printf '%s\n' "$file"
+}
+set_status() { # file new_status note_key note
+  tmp=$(mktemp "$dir/.tmp.XXXXXX") || exit 1
+  sed "s/^status: .*\$/status: $2/" "$1" > "$tmp"
+  printf '%s: %s\n%s-at: %s\n' "$3" "$(one_line "$4")" "$3" "$(iso "$now")" >> "$tmp"
+  mv -f "$tmp" "$1"
+}
+
+case "$cmd" in
+  request)
+    [ "$#" -ge 5 ] || { echo 'usage: request TOWN REQUESTER ADDRESSEE HOURS CLASS ACTION...' >&2; exit 2; }
+    requester=$1 addressee=$2 hours=$3 class=$4
+    shift 4
+    action=$(one_line "$*")
+    case "$requester$addressee" in *[!a-zA-Z0-9_-]*|'') echo 'office names are [a-zA-Z0-9_-]+' >&2; exit 2 ;; esac
+    case "$hours" in ''|*[!0-9]*|0) echo 'HOURS must be a positive integer' >&2; exit 2 ;; esac
+    [ "$hours" -le 72 ] || { echo 'deadline may not exceed 72 hours' >&2; exit 2; }
+    case "$class" in reversible|irreversible) : ;; *) echo 'CLASS must be reversible or irreversible' >&2; exit 2 ;; esac
+    [ -n "$action" ] || { echo 'action text required' >&2; exit 2; }
+    mkdir -p "$dir"
+    id=P-$now-$(head -c 2 /dev/urandom | od -An -tx1 | tr -d ' \n')
+    deadline=$((now + hours * 3600))
+    {
+      printf 'id: %s\nstatus: pending\nrequester: %s\naddressee: %s\nclass: %s\n' "$id" "$requester" "$addressee" "$class"
+      printf 'created: %s\ndeadline: %s\naction: %s\n' "$(iso "$now")" "$(iso "$deadline")" "$action"
+    } | write_atomic "$dir/$id.txt"
+    printf '%s\n' "$id"
+    ;;
+  answer)
+    [ "$#" -ge 3 ] || { echo 'usage: answer TOWN ID approved|declined NOTE...' >&2; exit 2; }
+    id=$1 verdict=$2
+    shift 2
+    case "$verdict" in approved|declined) : ;; *) echo 'verdict must be approved or declined' >&2; exit 2 ;; esac
+    file=$(need_file "$id")
+    case "$(field "$file" status)" in pending|due) : ;; *) echo "request $id is $(field "$file" status)" >&2; exit 1 ;; esac
+    set_status "$file" "$verdict" answer "$*"
+    ;;
+  proceed)
+    [ "$#" -ge 2 ] || { echo 'usage: proceed TOWN ID NOTE...' >&2; exit 2; }
+    id=$1
+    shift
+    file=$(need_file "$id")
+    [ "$(field "$file" class)" = reversible ] ||
+      { echo "request $id is irreversible; it never proceeds by default" >&2; exit 3; }
+    case "$(field "$file" status)" in
+      pending|due) : ;;
+      approved) echo "request $id was approved; proceeding is covered by the approval" >&2; exit 0 ;;
+      *) echo "request $id is $(field "$file" status), cannot proceed" >&2; exit 1 ;;
+    esac
+    [ "$now" -ge "$(epoch_of "$(field "$file" deadline)")" ] ||
+      { echo "request $id deadline $(field "$file" deadline) has not passed" >&2; exit 1; }
+    set_status "$file" proceeded proceed-note "$*"
+    ;;
+  audit)
+    [ "$#" -ge 3 ] || { echo 'usage: audit TOWN ID upheld|reversed|concern NOTE...' >&2; exit 2; }
+    id=$1 verdict=$2
+    shift 2
+    case "$verdict" in upheld|reversed|concern) : ;; *) echo 'verdict must be upheld, reversed or concern' >&2; exit 2 ;; esac
+    file=$(need_file "$id")
+    [ "$(field "$file" status)" = proceeded ] || { echo "request $id did not proceed by default" >&2; exit 1; }
+    set_status "$file" "audited-$verdict" audit-note "$*"
+    ;;
+  sweep)
+    [ -d "$dir" ] || exit 0
+    for file in "$dir"/P-*.txt; do
+      [ -f "$file" ] || continue
+      [ "$(field "$file" status)" = pending ] || continue
+      [ "$now" -ge "$(epoch_of "$(field "$file" deadline)")" ] || continue
+      set_status "$file" due due-note 'deadline passed without an answer'
+    done
+    ;;
+  list)
+    which=${1:-all}
+    [ -d "$dir" ] || exit 0
+    for file in "$dir"/P-*.txt; do
+      [ -f "$file" ] || continue
+      st=$(field "$file" status)
+      [ "$which" = all ] || [ "$which" = "$st" ] || continue
+      printf '%s\t%s\t%s>%s\t%s\t%s\t%s\n' "$(field "$file" id)" "$st" "$(field "$file" requester)" \
+        "$(field "$file" addressee)" "$(field "$file" class)" "$(field "$file" deadline)" "$(field "$file" action)"
+    done
+    ;;
+  brief)
+    [ "$#" -ge 1 ] || { echo 'usage: brief TOWN OFFICE' >&2; exit 2; }
+    office=$1
+    [ -d "$dir" ] || exit 0
+    may= waiting= audit=
+    for file in "$dir"/P-*.txt; do
+      [ -f "$file" ] || continue
+      st=$(field "$file" status)
+      line="$(field "$file" id) | $(field "$file" requester) -> $(field "$file" addressee) | deadline $(field "$file" deadline) | $(field "$file" action)"
+      case "$st" in
+        pending|due)
