+         [ "$(jq -r --argjson now "$now" '((.skips_since_dispatch // 0) > 0) and (($now - (.last_skip_at // 0)) < 900)' "$gate_file" 2>/dev/null)" = true ]; then
+        readiness=ready
+      fi
+    else
+      readiness=pending
+    fi
   fi
 fi
