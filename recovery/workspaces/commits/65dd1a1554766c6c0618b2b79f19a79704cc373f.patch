diff --git a/government/daily-sitting.py b/government/daily-sitting.py
new file mode 100644
index 00000000..b848869c
--- /dev/null
+++ b/government/daily-sitting.py
@@ -0,0 +1,216 @@
+#!/usr/bin/env python3
+"""Fixed daily plenary sitting (Founder directive 2026-11-16, item 5).
+
+Measured problem: 8 of 10 parliamentary seats had not run since Nov 8, because
+a seat only sits when the Clerk summons it and the Clerk summons nobody when no
+new business arrives. A quorum (six seats) could therefore never form.
+
+Once per UTC day, at or after VICHE_PARLIAMENT_HOUR (default 17), every
+non-Clerk seat is added to records/SUMMONED.txt with a generated summons that
+points at a short agenda. The constitutional boot dispatches each seat once;
+this script then removes the seats it added so they are not re-run every
+sitting interval. No model call is made here.
+
+  daily-sitting.py run               called from government/boot.sh each cycle
+  daily-sitting.py dispatched SEAT   called by sitting.sh when SEAT is dispatched
+  daily-sitting.py status            print today's record
+
+Environment
+  VICHE_DAILY_SITTING=off     disable
+  VICHE_PARLIAMENT_HOUR       UTC hour, default 17
+  VICHE_PARLIAMENT_SEATS      all (default) or N: summon only the first N
+                              non-Clerk seats (N=5 gives a six-seat quorum
+                              with the Clerk)
+  VICHE_DAILY_NOW             epoch override for tests
+"""
+import datetime
+import json
+import os
+import pathlib
+import sys
+import tempfile
+import time
+
+TOWN = pathlib.Path(os.environ.get("VICHE_TOWN_ROOT", "/var/lib/lubko/wd/viche"))
+STATE = pathlib.Path(os.environ.get("VICHE_STATE_ROOT", "/var/lib/lubko/wd/viche-state"))
+ROOT = STATE / "parliament" / "daily"
+SUMMONED = TOWN / "records" / "SUMMONED.txt"
+MARKER = "<!-- daily-plenary -->"
+WINDOW_SECONDS = 6 * 3600
+
+
+def now():
+    return int(os.environ.get("VICHE_DAILY_NOW", time.time()))
+
+
+def atomic_write(path, text):
+    path = pathlib.Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, name = tempfile.mkstemp(prefix=".tmp.", dir=str(path.parent))
+    try:
+        with os.fdopen(fd, "w") as handle:
+            handle.write(text)
+        os.replace(name, path)
+    finally:
+        if os.path.exists(name):
+            os.unlink(name)
+
+
+def seat_ids():
+    path = TOWN / "government" / "seats.tsv"
+    ids = []
+    if path.is_file():
+        for line in path.read_text().splitlines():
+            if line.strip():
+                ids.append(line.split("\t")[0])
+    return ids
+
+
+def summoned_ids():
+    if not SUMMONED.is_file():
+        return []
+    return [line.strip() for line in SUMMONED.read_text().splitlines() if line.strip()]
+
+
+def write_summoned(ids):
+    SUMMONED.parent.mkdir(parents=True, exist_ok=True)
+    atomic_write(SUMMONED, "".join(i + "\n" for i in ids))
+
+
+def record_path(day):
+    return ROOT / (day + ".json")
+
+
+def load(path):
+    try:
+        return json.loads(path.read_text())
+    except (OSError, ValueError):
+        return None
+
+
+def release_finished(current):
+    """Remove from SUMMONED.txt the seats this script added and that have sat
+    (or whose six-hour window expired). Seats the Clerk summoned itself are
+    never touched."""
+    if not ROOT.is_dir():
+        return
+    for path in sorted(ROOT.glob("2*.json")):
+        data = load(path)
+        if not isinstance(data, dict):
+            continue
+        added = list(data.get("added", []))
+        dispatched = set(data.get("dispatched", []))
+        convened = int(data.get("convened_at", 0))
+        release = [s for s in added if s in dispatched or current - convened > WINDOW_SECONDS]
+        if not release:
+            continue
+        write_summoned([i for i in summoned_ids() if i not in set(release)])
+        data["added"] = [s for s in added if s not in release]
+        data["released"] = sorted(set(data.get("released", [])) | set(release))
+        atomic_write(path, json.dumps(data, sort_keys=True) + "\n")
+
+
+def bills_without_ballots(current):
+    bills = TOWN / "records" / "bills"
+    ballots = TOWN / "records" / "ballots"
+    found = []
+    if bills.is_dir():
+        for path in sorted(bills.glob("*.md")):
+            try:
+                recent = current - path.stat().st_mtime < 21 * 86400
+            except OSError:
+                continue
+            if recent and not (ballots / (path.stem + ".tsv")).exists():
+                found.append(path.stem)
+    return found
+
+
+def convene(current):
+    day = datetime.datetime.fromtimestamp(current, datetime.timezone.utc)
+    try:
+        hour = int(os.environ.get("VICHE_PARLIAMENT_HOUR", "17"))
+    except ValueError:
+        hour = 17
+    if day.hour < hour:
+        return
+    stamp = day.strftime("%Y-%m-%d")
+    if record_path(stamp).exists():
+        return
+    if not (STATE / "inaugurated").exists():
+        return
+    seats = seat_ids()
+    if not seats:
+        return
+    clerk, others = seats[0], seats[1:]
+    limit = os.environ.get("VICHE_PARLIAMENT_SEATS", "all")
+    if limit.isdigit():
+        others = others[: int(limit)]
+    agenda = ROOT / "plenary-agenda.md"
+    lines = ["# Daily plenary sitting " + stamp, "",
+             "Convened automatically (Founder directive 2026-11-16, Act 30). Quorum is six seats, so every",
+             "summoned seat is needed. Spend this sitting on decisions, not on re-reading history.", "",
+             "## Bills with no recorded ballots (touched in the last 21 days)"]
+    pending = bills_without_ballots(current)
+    lines += ["- %s  (records/bills/%s.md)" % (b, b) for b in pending] or ["- none"]
+    lines += ["", "## Standing items",
+              "- Founder directive Acts 29 and 30 (Ministry of Economy; proceed-by-default and obligation expiry): ratify, amend or reject.",
+              "- Read the Founder daily digest on Town Hall and any open item marked NEEDS-FOUNDER.",
+              "- Requests waiting on you in records/proceed/ (each has a deadline).", "",
+              "## What a seat delivers",
+              "- A recorded ballot on each bill above, or an evidence-based reason to abstain or to amend; or",
+              '- "No business for this seat today" with the one fact that justifies it. Then stop.', ""]
+    atomic_write(agenda, "\n".join(lines))
+    summons_dir = TOWN / "records" / "summons"
+    summons_dir.mkdir(parents=True, exist_ok=True)
+    existing = summoned_ids()
+    added = []
+    for seat in others:
+        file = summons_dir / (seat + ".md")
+        if not file.exists() or file.stat().st_size == 0 or MARKER in file.read_text():
+            atomic_write(file, "%s\n# Daily plenary sitting %s for seat %s\n\nRead %s and deliver what it asks.\n"
+                               "This summons was generated; the Clerk may replace it with a specific assignment.\n"
+                         % (MARKER, stamp, seat, agenda))
+        if seat not in existing:
+            existing.append(seat)
+            added.append(seat)
+    write_summoned(existing)
+    atomic_write(record_path(stamp), json.dumps(
+        {"day": stamp, "clerk": clerk, "convened_at": current, "added": added,
+         "dispatched": [], "bills_listed": pending}, sort_keys=True) + "\n")
+    print("Viche: daily plenary convened for %s with %d seat(s)" % (stamp, len(added)), file=sys.stderr)
+
+
+def dispatched(seat):
+    current = now()
+    stamp = datetime.datetime.fromtimestamp(current, datetime.timezone.utc).strftime("%Y-%m-%d")
+    path = record_path(stamp)
+    data = load(path)
+    if not isinstance(data, dict) or seat not in data.get("added", []):
+        return
+    data["dispatched"] = sorted(set(data.get("dispatched", [])) | {seat})
+    atomic_write(path, json.dumps(data, sort_keys=True) + "\n")
+
+
+def main(argv):
+    command = argv[0] if argv else "run"
+    if command == "run":
+        if os.environ.get("VICHE_DAILY_SITTING", "on") == "off":
+            return 0
+        ROOT.mkdir(parents=True, exist_ok=True)
+        release_finished(now())
+        convene(now())
+    elif command == "dispatched" and len(argv) == 2:
+        dispatched(argv[1])
+    elif command == "status":
+        stamp = datetime.datetime.fromtimestamp(now(), datetime.timezone.utc).strftime("%Y-%m-%d")
+        data = load(record_path(stamp))
+        if data is not None:
+            print(json.dumps(data, sort_keys=True, indent=2))
+    else:
+        print("usage: daily-sitting.py run|dispatched SEAT|status", file=sys.stderr)
+        return 2
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/government/dispatch-gate.sh b/government/dispatch-gate.sh
new file mode 100644
index 00000000..1e1cf990
--- /dev/null
+++ b/government/dispatch-gate.sh
@@ -0,0 +1,118 @@
+#!/bin/sh
+# Skip a model dispatch when nothing the office reads has changed (Founder
+# directive 2026-11-16, item 4). Measured cost of not having this: the
+# Executive ran 222 times in 18 hours at about 105K tokens a pass, and 175 of
+# 223 reports opened with the same recovery note.
+#
+#   dispatch-gate.sh check KEY [MAX_AGE_SECONDS] < normalized-inputs
+#       exit 0   dispatch (stdout says why: first_pass, inputs_changed,
+#                heartbeat or gate_off)
+#       exit 10  skip: inputs are byte-identical to the last dispatched pass
+#                and that pass is younger than MAX_AGE_SECONDS (default 21600)
+#   dispatch-gate.sh commit KEY
+#       record the fingerprint from the last `check` as dispatched. Call it
+#       only after the dispatch was accepted; if it is not called the next
+#       cycle dispatches again, so a failed launch never silences an office.
+#   dispatch-gate.sh board-signature ISSUE...
+#       print "<issue> <updatedAt> <latest-message-id>" per issue; a cheap
+#       stable summary of Founder/agent activity. Exits 1 if any lookup fails
+#       so callers can fail open (a broken probe must never suppress work).
+#   dispatch-gate.sh stats [SINCE_EPOCH]
+#       print "<key> <dispatches> <skips>" counted from the event log.
+#
+# VICHE_DISPATCH_GATE=off disables skipping entirely. A heartbeat guarantees
+# every gated office still runs at least once per MAX_AGE_SECONDS.
+set -eu
+state=${VICHE_STATE_ROOT:-/var/lib/lubko/wd/viche-state}
+dir=$state/dispatch-gate
+cmd=${1:-}
+[ -n "$cmd" ] || { echo 'usage: dispatch-gate.sh check|commit|board-signature|stats ...' >&2; exit 2; }
+shift
+
+case "$cmd" in
+  board-signature)
+    [ "$#" -ge 1 ] || exit 2
+    for issue in "$@"; do
+      case "$issue" in ''|*[!a-zA-Z0-9_-]*) echo "bad issue id $issue" >&2; exit 2 ;; esac
+      line=$(antonina board show --id "$issue" --page 1 --json 2>/dev/null |
+             jq -r --arg n "$issue" '[$n, (.updatedAt // "-"), (.messages[0].id // "-")] | join(" ")') || exit 1
+      [ -n "$line" ] || exit 1
+      printf '%s\n' "$line"
+    done
+    ;;
+  check|commit)
+    [ "$#" -ge 1 ] || exit 2
+    key=$1
+    case "$key" in ''|*[!a-zA-Z0-9_-]*) echo 'invalid gate key' >&2; exit 2 ;; esac
+    umask 077
+    mkdir -p "$dir"
+    now=$(date +%s)
+    json=$dir/$key.json
+    pending=$dir/$key.pending
+    events=$dir/events.tsv
+    if [ "$cmd" = commit ]; then
+      [ -s "$pending" ] || exit 0
+      fp=$(cut -f 1 "$pending")
+      prev_total=0
+      [ ! -s "$json" ] || prev_total=$(jq -r '.total_dispatches // 0' "$json" 2>/dev/null || echo 0)
+      prev_skips=0
+      [ ! -s "$json" ] || prev_skips=$(jq -r '.total_skips // 0' "$json" 2>/dev/null || echo 0)
+      tmp=$(mktemp "$dir/.tmp.XXXXXX")
+      jq -n --arg fp "$fp" --argjson now "$now" --argjson t "$((prev_total+1))" --argjson s "$prev_skips" \
+        '{fingerprint:$fp,last_dispatch_at:$now,skips_since_dispatch:0,total_dispatches:$t,total_skips:$s}' > "$tmp"
+      mv -f "$tmp" "$json"
+      printf '%s\t%s\tdispatch\t%s\n' "$now" "$key" "$(cut -f 2 "$pending")" >> "$events"
+      rm -f "$pending"
+      exit 0
+    fi
+    max_age=${2:-21600}
+    case "$max_age" in ''|*[!0-9]*) max_age=21600 ;; esac
+    fp=$(sha256sum | cut -d ' ' -f 1)
+    reason=
+    if [ "${VICHE_DISPATCH_GATE:-on}" = off ]; then
+      reason=gate_off
+    elif [ ! -s "$json" ]; then
+      reason=first_pass
+    else
+      last_fp=$(jq -r '.fingerprint // ""' "$json" 2>/dev/null || echo '')
+      last_at=$(jq -r '.last_dispatch_at // 0' "$json" 2>/dev/null || echo 0)
+      case "$last_at" in ''|*[!0-9]*) last_at=0 ;; esac
+      if [ "$fp" != "$last_fp" ]; then
+        reason=inputs_changed
+      elif [ $((now-last_at)) -ge "$max_age" ]; then
+        reason=heartbeat
+      fi
+    fi
+    if [ -n "$reason" ]; then
+      printf '%s\t%s\n' "$fp" "$reason" > "$pending"
+      printf '%s\n' "$reason"
+      exit 0
+    fi
+    skips=0
+    total=0
+    last_dispatch=$now
+    if [ -s "$json" ]; then
+      skips=$(jq -r '.skips_since_dispatch // 0' "$json" 2>/dev/null || echo 0)
+      total=$(jq -r '.total_skips // 0' "$json" 2>/dev/null || echo 0)
+      last_dispatch=$(jq -r '.last_dispatch_at // 0' "$json" 2>/dev/null || echo "$now")
+    fi
+    tmp=$(mktemp "$dir/.tmp.XXXXXX")
+    jq --argjson s "$((skips+1))" --argjson t "$((total+1))" --argjson now "$now" \
+       '.skips_since_dispatch=$s | .total_skips=$t | .last_skip_at=$now' "$json" > "$tmp"
+    mv -f "$tmp" "$json"
+    printf '%s\t%s\tskip\tunchanged\n' "$now" "$key" >> "$events"
+    echo "unchanged since $last_dispatch"
+    exit 10
+    ;;
+  stats)
+    since=${1:-0}
+    case "$since" in ''|*[!0-9]*) since=0 ;; esac
+    [ -s "$dir/events.tsv" ] || exit 0
+    awk -F '\t' -v since="$since" '$1 >= since {if ($3=="dispatch") d[$2]++; else if ($3=="skip") s[$2]++; seen[$2]=1}
+      END {for (k in seen) printf "%s\t%d\t%d\n", k, d[k], s[k]}' "$dir/events.tsv" | sort
+    ;;
+  *)
+    echo "unknown command: $cmd" >&2
+    exit 2
+    ;;
+esac
diff --git a/government/economy-models.py b/government/economy-models.py
new file mode 100644
index 00000000..bfcc91cd
--- /dev/null
+++ b/government/economy-models.py
@@ -0,0 +1,367 @@
+#!/usr/bin/env python3
+"""Model funding instrument of the Ministry of Economy (Act 29).
+
+Antonina tries the models in ~/.config/antonina/config.json in order. The Town's
+reliable funding is therefore the ORDER of that list: free models first, so the
+Town keeps running at no cost; paid models last, as a fallback of last resort.
+
+This script is the deterministic half of the Ministry. It discovers what exists
+(`opencode models`), verifies that candidate free models actually answer, and
+rewrites the Antonina list so that the tier order can never be violated, whatever
+the Ministry's agent proposes. The agent supplies judgment (what to exclude, what
+to prefer within a tier, which sources to read) through
+state/economy/model-policy.json; it does not hand-edit the config.
+
+Tiers, best first (a model's tier is decided by this table, not by the agent):
+  0 free         id carries a "-free" component (opencode/beam-free, ...). Only
+                 added to the list after a probe succeeds; probes are free.
+  1 contributor  "-contributor" models of opencode-go: included with the
+                 contributor plan. Never auto-added, only kept.
+  2 paid         every other model. Never auto-added, only kept.
+  3 luna         any "luna" model (openai/gpt-6-luna, ...): paid, and kept at the
+                 very bottom, after every other paid model.
+
+Commands
+  refresh [--probe-limit N] [--no-apply]   catalogue + probes + plan + apply + report
+  plan                                      print the planned order, change nothing
+  check                                     exit 1 if the live config breaks the tier order
+  report                                    print the latest report
+
+Environment
+  VICHE_ANTONINA_CONFIG   config path (default ~/.config/antonina/config.json)
+  VICHE_OPENCODE_MODELS   file with `opencode models` output (tests)
+  VICHE_STATE_ROOT        state root; files live under economy/
+"""
+import argparse
+import datetime
+import json
+import os
+import pathlib
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+STATE = pathlib.Path(os.environ.get("VICHE_STATE_ROOT", "/var/lib/lubko/wd/viche-state"))
+ROOT = STATE / "economy"
+HOME = pathlib.Path(os.environ.get("HOME", "/home/lubko"))
+CONFIG = pathlib.Path(os.environ.get(
+    "VICHE_ANTONINA_CONFIG",
+    str(pathlib.Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "antonina" / "config.json")))
+COOLDOWNS = pathlib.Path(os.environ.get(
+    "VICHE_ANTONINA_COOLDOWNS",
+    str(pathlib.Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state")) / "antonina" / "model-cooldowns")))
+MAX_MODELS = int(os.environ.get("VICHE_ECONOMY_MAX_MODELS", "14"))
+PROBE_FRESH_SECONDS = 14 * 86400
+PROBE_TIMEOUT = int(os.environ.get("VICHE_ECONOMY_PROBE_TIMEOUT", "120"))
+TIER_NAMES = ["free", "contributor", "paid", "luna"]
+
+
+def now():
+    return int(os.environ.get("VICHE_ECONOMY_NOW", time.time()))
+
+
+def tier_of(model):
+    """The tier table. Luna wins over every other rule: it always sorts last."""
+    name = model.lower()
+    if "luna" in name:
+        return 3
+    if re.search(r"(^|[-/])free($|[-/])", name):
+        return 0
+    if "contributor" in name:
+        return 1
+    return 2
+
+
+def atomic_write(path, text):
+    path = pathlib.Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, name = tempfile.mkstemp(prefix=".tmp.", dir=str(path.parent))
+    try:
+        with os.fdopen(fd, "w") as handle:
+            handle.write(text)
+        os.replace(name, path)
+    finally:
+        if os.path.exists(name):
+            os.unlink(name)
+
+
+def load(path, default):
+    try:
+        return json.loads(pathlib.Path(path).read_text())
+    except (OSError, ValueError):
+        return default
+
+
+def read_config():
+    data = load(CONFIG, None)
+    if not isinstance(data, dict) or not isinstance(data.get("models"), list):
+        raise SystemExit("Antonina config unreadable or has no models list: %s" % CONFIG)
+    return data
+
+
+def entry_model(entry):
+    return entry if isinstance(entry, str) else entry.get("model", "")
+
+
+def fetch_catalogue():
+    override = os.environ.get("VICHE_OPENCODE_MODELS")
+    if override:
+        text = pathlib.Path(override).read_text()
+    else:
+        done = subprocess.run(["opencode", "models"], capture_output=True, text=True, timeout=90)
+        if done.returncode != 0:
+            raise RuntimeError("opencode models failed: " + done.stderr.strip()[:200])
+        text = done.stdout
+    ids = [line.strip() for line in text.splitlines() if re.match(r"^[A-Za-z0-9._-]+/[A-Za-z0-9._#:-]+$", line.strip())]
+    if len(ids) < 10:
+        raise RuntimeError("model catalogue implausibly small (%d); refusing to act on it" % len(ids))
+    return sorted(set(ids))
+
+
+def update_catalogue(ids, current):
+    store = load(ROOT / "catalogue.json", {"models": {}})
+    models = store.get("models", {})
+    stamp = datetime.datetime.fromtimestamp(current, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+    new_free = []
+    for model in ids:
+        entry = models.setdefault(model, {"first_seen": stamp})
+        entry["last_seen"] = stamp
+        entry["tier"] = TIER_NAMES[tier_of(model)]
+        if entry["first_seen"] == stamp and store.get("models") and tier_of(model) == 0 and "fetched_at" in store:
+            new_free.append(model)
+    gone = sorted(m for m in models if m not in ids)
+    store = {"fetched_at": stamp, "models": models, "gone": gone}
+    atomic_write(ROOT / "catalogue.json", json.dumps(store, sort_keys=True, indent=1) + "\n")
+    return models, new_free, gone
+
+
+def probe(model):
+    prompt = "Reply with the single word OK and nothing else."
+    try:
+        done = subprocess.run(["opencode", "run", "-m", model, "--format", "json", prompt],
+                              capture_output=True, text=True, timeout=PROBE_TIMEOUT, cwd="/tmp")
+    except subprocess.TimeoutExpired:
+        return False, "timeout after %ds" % PROBE_TIMEOUT
+    out = done.stdout
+    if done.returncode != 0:
+        return False, ("exit %d: %s" % (done.returncode, done.stderr.strip()[:160]))
+    if '"type":"error"' in out:
+        return False, "provider error event"
+    texts = []
+    for line in out.splitlines():
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        part = event.get("part", {})
+        if event.get("type") == "text" and isinstance(part.get("text"), str):
+            texts.append(part["text"])
+    if any("OK" in t.upper() for t in texts):
+        return True, "answered OK"
+    return False, "no usable answer"
+
+
+def run_probes(candidates, limit, current):
+    probes = load(ROOT / "probes.json", {})
+    stale = [m for m in candidates
+             if m not in probes or current - probes[m].get("at", 0) > PROBE_FRESH_SECONDS]
+    stale.sort(key=lambda m: probes.get(m, {}).get("at", 0))
+    ran = []
+    for model in stale[:limit]:
+        ok, detail = probe(model)
+        probes[model] = {"ok": ok, "at": current, "detail": detail}
+        ran.append(model)
+    atomic_write(ROOT / "probes.json", json.dumps(probes, sort_keys=True, indent=1) + "\n")
+    return probes, ran
+
+
+def policy():
+    data = load(ROOT / "model-policy.json", {})
+    exclude = {}
+    for item in data.get("exclude", []):
+        if isinstance(item, dict) and item.get("model"):
+            if int(item.get("until", 0)) > now():
+                exclude[item["model"]] = item
+    return {"exclude": exclude, "prefer": [m for m in data.get("prefer", []) if isinstance(m, str)]}
+
+
+def plan_order(cfg, catalogue_ids, probes, pol, current):
+    configured = [entry_model(e) for e in cfg["models"] if entry_model(e)]
+    in_catalogue = set(catalogue_ids)
+    wanted = {0: [], 1: [], 2: [], 3: []}
+    dropped = []
+    seen = set()
+
+    def consider(model, grandfathered):
+        if model in seen:
+            return
+        seen.add(model)
+        tier = tier_of(model)
+        if model not in in_catalogue:
+            dropped.append((model, "not in catalogue"))
+            return
+        if model in pol["exclude"]:
+            dropped.append((model, "excluded by policy: " + str(pol["exclude"][model].get("reason", ""))))
+            return
+        if tier == 0:
+            result = probes.get(model)
+            if result is not None and not result.get("ok") and current - result.get("at", 0) < PROBE_FRESH_SECONDS:
+                dropped.append((model, "probe failed: " + str(result.get("detail", ""))))
+                return
+            if result is None and not grandfathered:
+                return  # unprobed newcomers wait for their probe
+        elif not grandfathered:
+            return  # contributor/paid/luna models are only ever kept, never auto-added
+        wanted[tier].append(model)
+
+    for model in configured:
+        consider(model, True)
+    for model in catalogue_ids:
+        if tier_of(model) == 0:
+            consider(model, False)
+
+    def rank(model):
+        prefer = pol["prefer"]
+        p = prefer.index(model) if model in prefer else len(prefer)
+        c = configured.index(model) if model in configured else len(configured)
+        return (p, c, model)
+
+    final = []
+    for tier in range(4):
+        final.extend(sorted(wanted[tier], key=rank))
+    final = final[:MAX_MODELS]
+    if not final:
+        raise SystemExit("plan would leave Antonina with no models; refusing")
+    return configured, final, dropped
+
+
+def violations(models):
+    tiers = [tier_of(m) for m in models]
+    return [(models[i], models[i + 1]) for i in range(len(models) - 1) if tiers[i] > tiers[i + 1]]
+
+
+def apply_order(cfg, final, probes, dropped, current):
+    existing = {entry_model(e): e for e in cfg["models"]}
+    stamp = datetime.datetime.fromtimestamp(current, datetime.timezone.utc).strftime("%Y-%m-%d")
+    new_entries = []
+    for model in final:
+        entry = existing.get(model)
+        if entry is None:
+            entry = {"model": model, "comment": "Ministry of Economy %s: free model, probe answered OK." % stamp}
+        elif isinstance(entry, str):
+            entry = {"model": entry}
+        new_entries.append(entry)
+    updated = dict(cfg)
+    updated["models"] = new_entries
+    backup = CONFIG.with_name(CONFIG.name + ".bak-" + str(current))
+    shutil.copy2(CONFIG, backup)
+    atomic_write(CONFIG, json.dumps(updated, indent=2) + "\n")
+    os.chmod(CONFIG, 0o600)
+    try:
+        listed = subprocess.run(["antonina", "agent", "model", "select"], capture_output=True, text=True, timeout=60)
+        ok = listed.returncode == 0 and final[0] in listed.stdout
+    except (OSError, subprocess.TimeoutExpired):
+        ok = os.environ.get("VICHE_ECONOMY_SKIP_VALIDATE") == "1"
+    if not ok and os.environ.get("VICHE_ECONOMY_SKIP_VALIDATE") != "1":
+        shutil.copy2(backup, CONFIG)
+        raise SystemExit("Antonina rejected the new model list; previous config restored from " + str(backup))
+    return str(backup)
+
+
+def cooldown_state(models, current):
+    out = {}
+    if COOLDOWNS.is_dir():
+        for path in COOLDOWNS.glob("*.json"):
+            data = load(path, {})
+            until = data.get("until", 0)
+            if data.get("model") in models and until > current:
+                out[data["model"]] = {"reason": data.get("reason"), "until": int(until)}
+    return out
+
+
+def build_report(final, cfg_before, dropped, new_free, ran, changed, backup, current):
+    cooling = cooldown_state(set(final), current)
+    free = [m for m in final if tier_of(m) == 0]
+    free_available = [m for m in free if m not in cooling]
+    returns = sorted(v["until"] for m, v in cooling.items() if m in free)
+    return {
+        "at": datetime.datetime.fromtimestamp(current, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+        "order": [{"model": m, "tier": TIER_NAMES[tier_of(m)]} for m in final],
+        "free_models": len(free),
+        "free_available_now": len(free_available),
+        "next_free_returns_at": returns[0] if (returns and not free_available) else None,
+        "cooling": cooling,
+        "changed": changed,
+        "previous_order": cfg_before,
+        "dropped": [{"model": m, "why": why} for m, why in dropped],
+        "new_free_models_seen": new_free,
+        "probes_run": ran,
+        "backup": backup,
+        "paid_before_free_violations": [list(v) for v in violations(final)],
+        "funding_risk": "none" if len(free_available) >= 2 else ("high" if not free_available else "elevated"),
+    }
+
+
+def refresh(args):
+    current = now()
+    ROOT.mkdir(parents=True, exist_ok=True)
+    cfg = read_config()
+    try:
+        ids = fetch_catalogue()
+    except (RuntimeError, OSError, subprocess.TimeoutExpired) as error:
+        atomic_write(ROOT / "report.json", json.dumps({"at": current, "error": str(error),
+                     "note": "catalogue unavailable; model list left untouched"}, sort_keys=True) + "\n")
+        print("economy: " + str(error), file=sys.stderr)
+        return 1
+    models, new_free, gone = update_catalogue(ids, current)
+    pol = policy()
+    free_candidates = [m for m in ids if tier_of(m) == 0 and m not in pol["exclude"]]
+    probes, ran = run_probes(free_candidates, args.probe_limit, current)
+    before, final, dropped = plan_order(cfg, ids, probes, pol, current)
+    changed = before != final
+    backup = None
+    if changed and not args.no_apply:
+        backup = apply_order(cfg, final, probes, dropped, current)
+    report = build_report(final, before, dropped, new_free, ran, changed and not args.no_apply, backup, current)
+    atomic_write(ROOT / "report.json", json.dumps(report, sort_keys=True, indent=1) + "\n")
+    print(json.dumps({"changed": report["changed"], "free_available_now": report["free_available_now"],
+                      "funding_risk": report["funding_risk"]}, sort_keys=True))
+    return 0
+
+
+def main(argv):
+    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    sub = parser.add_subparsers(dest="command", required=True)
+    refresh_p = sub.add_parser("refresh")
+    refresh_p.add_argument("--probe-limit", type=int, default=3)
+    refresh_p.add_argument("--no-apply", action="store_true")
+    sub.add_parser("plan")
+    sub.add_parser("check")
+    sub.add_parser("report")
+    args = parser.parse_args(argv)
+    if args.command == "refresh":
+        return refresh(args)
+    if args.command == "check":
+        bad = violations([entry_model(e) for e in read_config()["models"]])
+        for first, second in bad:
+            print("tier violation: %s (%s) is ahead of %s (%s)" % (
+                first, TIER_NAMES[tier_of(first)], second, TIER_NAMES[tier_of(second)]))
+        return 1 if bad else 0
+    if args.command == "plan":
+        cfg = read_config()
+        ids = fetch_catalogue()
+        before, final, dropped = plan_order(cfg, ids, load(ROOT / "probes.json", {}), policy(), now())
+        print(json.dumps({"before": before, "after": final,
+                          "dropped": [{"model": m, "why": w} for m, w in dropped]}, indent=1))
+        return 0
+    if args.command == "report":
+        print(json.dumps(load(ROOT / "report.json", {}), indent=1, sort_keys=True))
+        return 0
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
