diff --git a/records/statistics/evidence/act34-activation-20261124/knowledge-zero-billed.py b/records/statistics/evidence/act34-activation-20261124/knowledge-zero-billed.py
new file mode 100644
index 00000000..ab2e70f9
--- /dev/null
+++ b/records/statistics/evidence/act34-activation-20261124/knowledge-zero-billed.py
@@ -0,0 +1,240 @@
+#!/usr/bin/env python3
+"""Exact-ID zero-billed model policy shared by the Act34 wrapper and gate.
+
+A model name containing ``-free`` is never billing evidence.  This module admits
+only exact provider/model IDs recorded in a reviewed policy whose published
+input, output and cache-read costs are all zero.  The policy expires so a
+limited-time free offer cannot silently outlive its evidence.
+"""
+import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import pathlib
+import re
+import tempfile
+
+SCHEMA = "viche-zero-billed-model-policy-v1"
+MODEL_ID = re.compile(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+")
+REQUIRED_COST = ("input", "output", "cache_read")
+ALLOWED_COST = set(REQUIRED_COST + ("cache_write",))
+
+
+def _zero(value):
+    return (isinstance(value, (int, float)) and not isinstance(value, bool)
+            and value == 0)
+
+
+def _timestamp(value):
+    if not isinstance(value, str):
+        raise ValueError("review_after must be a UTC timestamp")
+    parsed = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
+    if parsed.tzinfo is None:
+        raise ValueError("review_after must include a timezone")
+    return parsed
+
+
+def load_verified(path, now=None, snapshot_path=None):
+    """Load a fresh policy and validate exact IDs against committed provider bytes."""
+    path = Path(path)
+    data = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(data, dict) or data.get("schema") != SCHEMA:
+        raise ValueError("zero-billed policy schema invalid")
+    source = data.get("source")
+    if (not isinstance(source, dict) or source.get("url") != "https://opencode.ai/inference/v1/models"
+            or not isinstance(source.get("sha256"), str)
+            or not re.fullmatch(r"[0-9a-f]{64}", source["sha256"])):
+        raise ValueError("zero-billed provider-cost source invalid")
+    retrieved_at = _timestamp(source.get("retrieved_at"))
+    review_after = _timestamp(data.get("review_after"))
+    now = now or datetime.datetime.now(datetime.timezone.utc)
+    if now.tzinfo is None:
+        now = now.replace(tzinfo=datetime.timezone.utc)
+    if retrieved_at > now or retrieved_at >= review_after:
+        raise ValueError("zero-billed provider-cost timestamps invalid")
+    if now >= review_after:
+        raise ValueError("zero-billed provider-cost evidence expired")
+    snapshot_ref = data.get("snapshot_ref")
+    snapshot_sha = data.get("snapshot_sha256")
+    if (not isinstance(snapshot_ref, str) or not snapshot_ref or
+            pathlib.PurePosixPath(snapshot_ref).is_absolute() or
+            ".." in pathlib.PurePosixPath(snapshot_ref).parts or
+            snapshot_sha != source["sha256"]):
+        raise ValueError("zero-billed provider snapshot binding invalid")
+    if snapshot_path is None:
+        raise ValueError("zero-billed provider snapshot missing")
+    snapshot_bytes = Path(snapshot_path).read_bytes()
+    if hashlib.sha256(snapshot_bytes).hexdigest() != snapshot_sha:
+        raise ValueError("zero-billed provider snapshot digest mismatch")
+    snapshot = json.loads(snapshot_bytes)
+    records = snapshot.get("data") if isinstance(snapshot, dict) else None
+    if not isinstance(records, list):
+        raise ValueError("zero-billed provider snapshot schema invalid")
+    by_id = {"opencode": {row.get("id"): row for row in records if isinstance(row, dict)}}
+    go = data.get("go_source")
+    if go is not None:
+        if (not isinstance(go, dict)
+                or go.get("url") != "https://opencode.ai/inference/go/v1/models"
+                or not isinstance(go.get("sha256"), str)
+                or not re.fullmatch(r"[0-9a-f]{64}", go["sha256"])
+                or not isinstance(go.get("snapshot_ref"), str)
+                or not re.fullmatch(r"records/economy/evidence/[A-Za-z0-9_.-]+[.]json", go["snapshot_ref"])):
+            raise ValueError("zero-billed Go provider-cost source invalid")
+        go_time = _timestamp(go.get("retrieved_at"))
+        if go_time > now or go_time >= review_after:
+            raise ValueError("zero-billed Go provider-cost timestamps invalid")
+        # The two source snapshots share the evidence directory. Do not
+        # accept path traversal or a different provider's endpoint.
+        go_path = Path(snapshot_path).parent / pathlib.PurePosixPath(go["snapshot_ref"]).name
+        go_bytes = go_path.read_bytes()
+        if hashlib.sha256(go_bytes).hexdigest() != go["sha256"]:
+            raise ValueError("zero-billed Go snapshot digest mismatch")
+        go_data = json.loads(go_bytes)
+        if not isinstance(go_data, dict) or not isinstance(go_data.get("data"), list):
+            raise ValueError("zero-billed Go snapshot schema invalid")
+        by_id["opencode-go"] = {row.get("id"): row for row in go_data["data"] if isinstance(row, dict)}
+    models = data.get("models")
+    if not isinstance(models, dict) or not models:
+        raise ValueError("zero-billed exact-ID policy empty")
+    for mid, row in models.items():
+        if not isinstance(mid, str) or not MODEL_ID.fullmatch(mid):
+            raise ValueError("malformed zero-billed model id")
+        provider, provider_model = mid.split("/", 1)
+        if (not isinstance(row, dict) or row.get("provider") != provider
+                or row.get("provider_model") != provider_model):
+            raise ValueError("zero-billed provider/model identity mismatch: " + mid)
+        cost = row.get("cost")
+        if not isinstance(cost, dict) or any(k not in cost for k in REQUIRED_COST):
+            raise ValueError("zero-billed cost dimensions missing: " + mid)
+        if any(k not in ALLOWED_COST for k in cost):
+            raise ValueError("unknown billing dimension: " + mid)
+        if any(not _zero(cost[k]) for k in cost):
+            raise ValueError("nonzero provider cost: " + mid)
+        rec = by_id.get(provider, {}).get(provider_model)
+        # Both first-party endpoints report the model owner as opencode;
+        # the route-specific source above binds which provider can use it.
+        if not isinstance(rec, dict) or rec.get("owned_by") != "opencode":
+            raise ValueError("provider snapshot exact model missing: " + mid)
+        provider_cost = rec.get("cost")
+        if not isinstance(provider_cost, dict) or set(provider_cost) != {"text"}:
+            raise ValueError("unknown provider billing dimension: " + mid)
+        text = provider_cost.get("text", {})
+        inp = text.get("input", {}) if isinstance(text, dict) else {}
+        out = text.get("output", {}) if isinstance(text, dict) else {}
+        cache = inp.get("cache", {}) if isinstance(inp, dict) else {}
+        observed = {"input": inp.get("price") if isinstance(inp, dict) else None,
+                    "output": out.get("price") if isinstance(out, dict) else None,
+                    "cache_read": cache.get("read") if isinstance(cache, dict) else None}
+        if any(not _zero(observed[key]) for key in REQUIRED_COST):
+            raise ValueError("provider snapshot shows nonzero cost: " + mid)
+        if "write" in cache and not _zero(cache.get("write")):
+            raise ValueError("provider snapshot shows nonzero cache-write cost: " + mid)
+        if provider == "opencode-go":
+            # Economy's common four-office scope may include internal
+            # institutional context. Do not admit training, non-ZDR or
+            # region-restricted Go models without a distinct reviewed scope.
+            privacy = rec.get("go")
+            if (not isinstance(privacy, dict)
+                    or privacy.get("training") is not False
+                    or privacy.get("zdr") is not True
+                    or privacy.get("limited_regions") is not False):
+                raise ValueError("Go data-handling scope not approved: " + mid)
+    return data
+
+
+def verified_subset(policy_path, ids, catalogue_models=None, snapshot_path=None):
+    """Return the exact, fresh, zero-cost subset in caller order.
+
+    IDs absent from provider-cost evidence are omitted, not admitted. An empty
+    result fails closed. This lets the general free rotation retain secondary-
+    only offers while the Act34 path uses the primary-confirmed subset.
+    """
+    data = load_verified(policy_path, snapshot_path=snapshot_path)
+    if not isinstance(ids, list):
+        raise ValueError("model allowlist missing")
+    selected = []
+    for mid in ids:
+        if not isinstance(mid, str):
+            raise ValueError("malformed model id")
+        if mid not in data["models"]:
+            continue
+        if catalogue_models is not None:
+            if not isinstance(catalogue_models, dict) or catalogue_models.get(mid, {}).get("tier") != "free":
+                raise ValueError("model not catalogued in Economy rotation: " + mid)
+        selected.append(mid)
+    if not selected:
+        raise ValueError("no primary-confirmed zero-cost model in active policy")
+    return selected
+
+
+def negative_acceptance_digest(paths):
+    """Digest the exact rejected-ID vector and control bytes.
+
+    The vector includes a paid-looking ID that a name-derived catalogue marks
+    free.  Passing the smoke test therefore proves the exact-ID cost policy,
+    not the old suffix/tier inference, made the rejection decision.
+    """
+    names = (
+        "provider/paid-free-trial",
+        "provider/paid-free",
+        "openai/gpt-6-luna",
+        "opencode/hy4-flash-free:nonzero-cost",
+        "opencode/hy4-flash-free:expired-evidence",
+        "opencode/hy4-flash-free:unknown-billing-dimension",
+        "opencode-go/hy4-flash-free:missing-or-wrong-go-source",
+        "opencode-go/iceman-contributor-free:training-enabled",
+        "opencode-go/beam-free:non-zdr-or-region-restricted")
+    payload = {"rejected_ids": names,
+               "controls": {name: hashlib.sha256(Path(path).read_bytes()).hexdigest()
+                            for name, path in sorted(paths.items())}}
+    return hashlib.sha256(json.dumps(payload, sort_keys=True,
+                                     separators=(",", ":")).encode()).hexdigest()
+
+
+def global_config_path(env=None):
+    """Same host/config resolution as Antonina model-config.js."""
+    env = os.environ if env is None else env
+    service = env.get("ANTONINA_OPENCODE_XDG_CONFIG_HOME")
+    host = env.get("ANTONINA_HOST_XDG_CONFIG_HOME")
+    xdg = env.get("XDG_CONFIG_HOME")
+    base = host if service and xdg == service and host else xdg
+    return Path(base or (Path(env.get("HOME", str(Path.home()))) / ".config")) / "antonina/config.json"
+
+
+def authorized_models(path):
+    """Read the durable authorized ladder, with no catalogue dependency."""
+    config = json.loads(Path(path).read_text(encoding="utf-8"))
+    if not isinstance(config, dict) or not isinstance(config.get("models"), list):
+        raise ValueError("authorized Antonina config is malformed")
+    ids = []
+    for entry in config["models"]:
+        if not isinstance(entry, dict) or not isinstance(entry.get("comment"), str):
+            raise ValueError("authorized Antonina model entry is malformed")
+        mid = entry.get("model")
+        if not isinstance(mid, str) or not MODEL_ID.fullmatch(mid) or mid in ids:
+            raise ValueError("authorized Antonina model identity is malformed")
+        ids.append(mid)
+    return ids
+
+
+def build_allowlist(policy_path, global_path, output_path, snapshot_path=None):
+    """Intersect the reviewed exact-ID policy and durable authorization."""
+    ids = verified_subset(policy_path, authorized_models(global_path), snapshot_path=snapshot_path)
+    entries = [{"model": mid, "variant": "low",
+                "comment": "Economy exact-ID zero-cost policy; source-attested provider metadata"}
+               for mid in ids]
+    output = Path(output_path)
+    output.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+    os.chmod(output.parent, 0o700)
+    fd, tmp = tempfile.mkstemp(prefix=".free-allow-", dir=str(output.parent))
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            json.dump({"models": entries}, handle, indent=2)
+            handle.write("\n")
+        os.chmod(tmp, 0o600)
+        os.replace(tmp, output)
+    finally:
+        if os.path.exists(tmp):
+            os.unlink(tmp)
+    return ids
