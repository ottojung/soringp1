    Fix Act 32 reserve arg wiring; regression-test fail-closed guard
    
    The activation caller passes (office, agent id) to 'reserve', but the
    dispatch forwarded only $1, so do_reserve_locked read $2 under set -u
    and aborted on an unbound variable before reaching the intended CPU-meter
    fail-closed guard. Forward both arguments and assert in the smoke test that
    the two-argument path reaches the CPU-meter message (never an unbound abort).
    No activation, spend or policy change: dispatch remains fail-closed.

diff --git a/government/knowledge-budget.sh b/government/knowledge-budget.sh
index 34000b64..393bac20 100644
--- a/government/knowledge-budget.sh
+++ b/government/knowledge-budget.sh
@@ -528,7 +528,7 @@ shift || :
 case "$cmd" in
   config) config_cmd "$@";;
   guard) check_office "${1:-}"; guard "$1";;
-  reserve) check_office "${1:-}"; init; with_lock do_reserve_locked "$1";;
+  reserve) check_office "${1:-}"; init; with_lock do_reserve_locked "$1" "$2";;
   mark-dispatched) init; with_lock mark_dispatched_locked "${1:-}";;
   start) init; with_lock do_start_locked "${1:-}" "${2:-}"; launch_monitor "${1:-}"; printf 'active %s\n' "$1";;
   monitor) init; monitor "${1:-}";;
diff --git a/tests/knowledge-budget-smoke.sh b/tests/knowledge-budget-smoke.sh
index 747abb52..13164c74 100644
--- a/tests/knowledge-budget-smoke.sh
+++ b/tests/knowledge-budget-smoke.sh
@@ -41,6 +41,15 @@ no /bin/sh "$ENGINE" reserve statistics test-agent
 [ "$(find "$d/state/knowledge/budget/reservations" -type f | wc -l)" -eq 0 ] ||
   fail 'reservation was written despite unavailable authoritative CPU meter'
 
+# Regression: the real activation caller passes two arguments (office, agent id).
+# The reserve dispatch must forward both so do_reserve_locked reaches the
+# intended fail-closed CPU-meter guard, not an unset-parameter abort.
+RESERVE_ERR=$(/bin/sh "$ENGINE" reserve statistics test-agent 2>&1 >/dev/null || true)
+printf '%s\n' "$RESERVE_ERR" | grep -q 'authoritative per-session backend CPU meter unavailable' ||
+  fail 'reserve did not reach the fail-closed CPU-meter guard (wrong/missing argument wiring)'
+printf '%s\n' "$RESERVE_ERR" | grep -qi 'unbound variable' &&
+  fail 'reserve aborted on an unset argument instead of the CPU-meter guard'
+
