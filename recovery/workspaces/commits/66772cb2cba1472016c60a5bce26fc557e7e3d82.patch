+        put(town / "government/knowledge-zero-billed-policy.json", policy)
+        git(town, "add", ".")
+        git(town, "commit", "-qm", "Synthetic committed policy change")
+
+    if variant in ("hold-local-missing", "hold-committed-deletion"):
