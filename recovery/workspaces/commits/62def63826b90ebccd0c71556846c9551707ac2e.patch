+++ b/missions/pnp/adapter/adapt.py
@@ -0,0 +1,189 @@
+"""Adapt checked proofs to a target gap while respecting exact lease metadata."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import re
+
+from .. import validate
+from .closure import dependency_closure, parse_source, referenced_names
+
+
+@dataclass
+class AdaptationResult:
+    ok: bool
+    candidate: str | None
+    source_module: str
+    target_module: str
+    strategy: str
+    details: dict
+
+
+def _module_from_path(path: str) -> str:
+    if not path.startswith("lean/") or not path.endswith(".lean"):
+        raise ValueError("gap file must be a lean/PEqualNP/*.lean path")
+    return path.removeprefix("lean/").removesuffix(".lean").replace("/", ".")
+
+
+def controlled_module_rename(text: str, source_module: str, target_module: str) -> str:
+    """Rename only the fully qualified module name as an identifier token.
+
+    This is controlled module renaming, not fragile global namespace substitution.
+    """
+    if source_module == target_module:
+        return text
+    pat = re.compile(r"(?<![A-Za-z0-9_'.])" + re.escape(source_module) + r"(?![A-Za-z0-9_'])")
+    return pat.sub(target_module, text)
+
+
+def _split_imports(source: str) -> tuple[list[str], str]:
+    lines = source.splitlines()
+    i = 0
+    imports = []
+    while i < len(lines):
+        s = lines[i].strip()
+        if s == "" or s.startswith("--") or s.startswith("/-"):
+            if s.startswith("/-"):
+                while i < len(lines) and "-/" not in lines[i]:
+                    i += 1
+            i += 1
+            continue
+        m = re.match(r"^import\s+([A-Za-z0-9_.]+)\s*$", lines[i])
+        if m:
+            imports.append(m.group(1))
+            i += 1
+            continue
+        break
+    rest = "\n".join(lines[i:])
+    return imports, rest
+
+
+def _target_imports(target_gap: dict) -> list[str]:
+    imports = ["Mathlib"]
+    for imp in target_gap.get("imports") or []:
+        if imp != "Mathlib" and imp not in imports:
+            imports.append(imp)
+    return imports
+
+
+def _ensure_imports_allowed(source_imports: list[str], target_gap: dict) -> None:
+    allowed = {"Mathlib"} | set(target_gap.get("imports") or [])
+    for imp in source_imports:
+        if imp not in allowed and not re.fullmatch(r"Mathlib(?:\.[A-Za-z][A-Za-z0-9_]*)+", imp):
+            raise ValueError(f"source import {imp} is not allowed by target gap imports")
+
+
+def _extract_final_theorem(text: str, module: str) -> tuple[str, str, str] | None:
+    pat = re.compile(
+        r"(?<![\w.])theorem\s+" + re.escape(module) + r"\s*:(.*?):=\s*by\b",
+        re.S,
+    )
+    m = pat.search(text)
+    if not m:
+        return None
+    return m.group(0), m.group(1), text[m.end():]
+
+
+def _replace_final_theorem(text: str, target_module: str, target_statement: str, proof_body: str) -> str:
+    pat = re.compile(
+        r"(?<![\w.])theorem\s+" + re.escape(target_module) + r"\s*:.*?:=\s*by\b.*\Z",
+        re.S,
+    )
+    m = pat.search(text)
+    if not m:
+        raise ValueError("target theorem not found after rename")
+    replacement = f"theorem {target_module} : {target_statement} := by{proof_body}"
+    return text[:m.start()] + replacement
+
+
+def emit_standalone(target_gap: dict, body: str, source_imports=None) -> str:
+    imports = list(source_imports) if source_imports else _target_imports(target_gap)
+    header = "\n".join(f"import {imp}" for imp in imports)
+    body = body.strip()
+    return header + "\n\n" + body + "\n"
+
+
+def _demote_helper_theorems(text: str, target_module: str) -> str:
+    """Convert non-final theorem declarations to lemmas.
+
+    The validator requires exactly one theorem, with the exact desk module name.
+    In Lean 4, lemma and theorem are synonymous at the declaration level.
+    """
+    pat = re.compile(r"(?m)^(?P<indent>[ \t]*)(?P<prefix>(?:(?:private|protected|noncomputable|partial|scoped|local|nonrec)\s+)*)theorem\b")
+    matches = list(pat.finditer(text))
+    if not matches:
+        return text
+    target_pat = re.compile(
+        r"(?m)^[ \t]*(?:(?:private|protected|noncomputable|partial|scoped|local|nonrec)\s+)*theorem\s+" + re.escape(target_module) + r"\s*:"
+    )
+    target_matches = list(target_pat.finditer(text))
+    keep = target_matches[-1].start() if target_matches else matches[-1].start()
+    parts = []
+    last = 0
+    for m in matches:
+        if m.start() == keep:
+            continue
+        parts.append(text[last:m.start()])
+        parts.append(m.group("indent") + (m.group("prefix") or "") + "lemma")
+        last = m.end()
+    parts.append(text[last:])
+    return "".join(parts)
+
+
+def _normalize_helper_namespaces(text: str, target_module: str) -> str:
+    """Preserve relative Lean scopes of a renamed checked source.
+
+    Changing a relative nested scope to a fully qualified name changes
+    its actual namespace. The validator checks the outer scope instead.
+    For arbitrary unrelated root namespaces do not guess a rewrite:
+    reject them through validate and let the researcher adapt explicitly.
+    """
+    return text
+
+
+def adapt_exact_module(source: str, target_gap: dict, *, source_module: str | None = None) -> AdaptationResult:
+    """Adapt a checked source by controlled module renaming and exact statement alignment.
+
+    Works when the source proves the same statement or when the target statement is
+    already present in the renamed source; the final theorem must match exactly.
+    """
+    target_module = target_gap["module"]
+    if source_module is None:
+        # infer from theorem in source
+        m = re.search(r"(?m)^theorem\s+(PEqualNP\.[A-Za-z0-9_.]+)\s*:", source)
+        if not m:
+            return AdaptationResult(False, None, "", target_module, "exact_module", {"error": "no theorem found"})
+        source_module = m.group(1)
+
+    renamed = controlled_module_rename(source, source_module, target_module)
+    src_imports, _ = _split_imports(renamed)
+    try:
+        _ensure_imports_allowed(src_imports, target_gap)
+    except ValueError as e:
+        return AdaptationResult(False, None, source_module, target_module, "exact_module", {"error": str(e)})
+
+    # Ensure exact target imports are used.
+    _, body = _split_imports(renamed)
+    body = _demote_helper_theorems(body, target_module)
+    body = _normalize_helper_namespaces(body, target_module)
+    candidate = emit_standalone(target_gap, body, src_imports)
+
+    # If the renamed source's theorem statement differs from target, try replacing
+    # the statement but keeping the proof body only when statements are token-equal.
+    final = _extract_final_theorem(candidate, target_module)
+    if final is None:
+        return AdaptationResult(False, None, source_module, target_module, "exact_module", {"error": "missing final theorem after rename"})
+
+    _, stmt, proof_tail = final
+    target_stmt = target_gap["statement"]
+    if validate.tokens(stmt) != validate.tokens(target_stmt):
+        return AdaptationResult(
+            False, candidate, source_module, target_module, "exact_module",
+            {"error": "final theorem statement differs from target after controlled module rename; refusing to keep mismatched proof body"},
+        )
+
+    try:
+        digest = validate.validate(target_gap, candidate.encode("utf-8"))
+    except validate.InvalidCandidate as e:
+        return AdaptationResult(False, candidate, source_module, target_module, "exact_module", {"error": str(e), "digest": None})
+
+    return AdaptationResult(True, candidate, source_module, target_module, "exact_module", {"sha256": digest})
diff --git a/missions/pnp/adapter/closure.py b/missions/pnp/adapter/closure.py
new file mode 100644
index 00000000..c239c6f9
--- /dev/null
+++ b/missions/pnp/adapter/closure.py
@@ -0,0 +1,220 @@
+"""Lean declaration dependency closure extraction.
+
+This is source-level and heuristic by design: it extracts a conservative
+dependency closure of named declarations from a Lean source file. It does NOT
+perform global namespace substitution; module renaming is a separate, controlled
+operation in adapt.py.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import re
+
+DECL_KEYWORDS = (
+    "theorem", "lemma", "def", "abbrev", "noncomputable def",
+    "instance", "structure", "class", "inductive", "opaque",
+)
+
+# A declaration starts at column 0 or after only whitespace in a namespace/section,
+# but we parse conservatively: lines whose stripped form begins with a decl keyword
+# or attribute+decl keyword.
+DECL_START = re.compile(
+    r"^(?P<indent>[ \t]*)(?P<attrs>(?:@\[.*?\][ \t]*)*)"
+    r"(?P<kw>theorem|lemma|def|abbrev|noncomputable\s+def|instance|structure|class|inductive|opaque)\b"
+    r"(?:[ \t]+(?P<name>[A-Za-z_][A-Za-z0-9_'.]*))?"
+)
+
+NAMESPACE_START = re.compile(r"^(?P<indent>[ \t]*)namespace[ \t]+([A-Za-z_][A-Za-z0-9_'.]*)[ \t]*$")
+NAMESPACE_END = re.compile(r"^(?P<indent>[ \t]*)end[ \t]+([A-Za-z_][A-Za-z0-9_'.]*)[ \t]*$")
+SECTION_START = re.compile(r"^(?P<indent>[ \t]*)section(?:[ \t]+[A-Za-z_][A-Za-z0-9_'.]*)?[ \t]*$")
+SECTION_END = re.compile(r"^(?P<indent>[ \t]*)end(?:[ \t]+[A-Za-z_][A-Za-z0-9_'.]*)?[ \t]*$")
+# Commands that affect scope/context and should be retained when relevant.
+SCOPE_COMMAND = re.compile(
+    r"^(?P<indent>[ \t]*)(?:variable\b|open\b|universe\b|set_option\b|attribute\b|local\b|export\b|omit\b|include\b)"
+)
+
+IDENT = re.compile(r"[A-Za-z_][A-Za-z0-9_'.]*")
+
+
+@dataclass
+class Declaration:
+    name: str
+    start: int  # line index
+    end: int    # exclusive line index
+    kind: str
+    text: str
+    namespace: tuple[str, ...]
+
+
+@dataclass
+class SourceModel:
+    lines: list[str]
+    declarations: list[Declaration]
+    by_name: dict[str, Declaration]
+    preamble_end: int  # line index where first namespace/decl starts after imports
+
+
+def _line_starts_decl(line: str):
+    m = DECL_START.match(line)
+    return m
+
+
+def parse_source(source: str) -> SourceModel:
+    lines = source.splitlines()
+    declarations: list[Declaration] = []
+    ns_stack: list[str] = []
+    section_depth = 0
+
+    # Find preamble end: after imports and blank lines.
+    preamble_end = 0
+    i = 0
+    while i < len(lines):
+        s = lines[i].strip()
+        if s == "" or s.startswith("import ") or s.startswith("--") or s.startswith("/-"):
+            if s.startswith("/-"):
+                # skip block comment
+                while i < len(lines) and "-/" not in lines[i]:
+                    i += 1
+            i += 1
+            continue
+        preamble_end = i
+        break
+    else:
+        preamble_end = len(lines)
+
+    i = 0
+    while i < len(lines):
+        line = lines[i]
+        m_ns = NAMESPACE_START.match(line)
+        if m_ns:
+            ns_stack.append(m_ns.group(2))
+            i += 1
+            continue
+        m_ne = NAMESPACE_END.match(line)
+        if m_ne:
+            name = m_ne.group(2)
+            if ns_stack and ns_stack[-1] == name:
+                ns_stack.pop()
+            elif name in ns_stack:
+                while ns_stack and ns_stack[-1] != name:
+                    ns_stack.pop()
+                if ns_stack:
+                    ns_stack.pop()
+            i += 1
+            continue
+        m_sec = SECTION_START.match(line)
+        if m_sec:
+            section_depth += 1
+            i += 1
+            continue
+        m_se = SECTION_END.match(line)
+        if m_se and section_depth > 0 and not NAMESPACE_END.match(line):
+            # `end` without a namespace name may close section
+            section_depth -= 1
+            i += 1
+            continue
+
+        m_decl = _line_starts_decl(line)
+        if m_decl:
+            name = m_decl.group("name")
+            kind = re.sub(r"\s+", " ", m_decl.group("kw"))
+            start = i
+            # include preceding attributes/doc comments attached to decl
+            j = start - 1
+            while j >= 0:
+                prev = lines[j].strip()
+                if prev.startswith("@[") or prev.startswith("/--") or prev.startswith("/-!") or prev.startswith("--"):
+                    if prev.startswith("/-"):
+                        k = j
+                        while k >= 0 and "/-" not in lines[k]:
+                            k -= 1
+                        j = k - 1
+                        continue
+                    start = j
+                    j -= 1
+                    continue
+                break
+            # find end: next decl start at same or lower structural level, or namespace/section end
+            i += 1
+            while i < len(lines):
+                nxt = lines[i]
+                if NAMESPACE_START.match(nxt) or NAMESPACE_END.match(nxt) or SECTION_START.match(nxt):
+                    # section end is `end` or `end <name>` - ambiguous; treat named end matching ns as boundary
+                    if SECTION_START.match(nxt):
+                        break
+                    if NAMESPACE_START.match(nxt) or NAMESPACE_END.match(nxt):
+                        break
+                if _line_starts_decl(nxt):
+                    break
+                # A bare `end` can close section; be conservative
+                if re.match(r"^[ \t]*end[ \t]*$", nxt) and section_depth > 0:
+                    break
+                i += 1
+            text = "\n".join(lines[start:i])
+            if name:
+                decl = Declaration(name=name, start=start, end=i, kind=kind, text=text, namespace=tuple(ns_stack))
+                declarations.append(decl)
+            continue
+        i += 1
+
+    by_name: dict[str, Declaration] = {}
+    for d in declarations:
+        by_name[d.name] = d
+        qualified = ".".join((*d.namespace, d.name)) if d.namespace else d.name
+        by_name[qualified] = d
+        # also register with full module-like paths seen in text
+        if d.namespace:
+            by_name[".".join(d.namespace) + "." + d.name] = d
+    return SourceModel(lines=lines, declarations=declarations, by_name=by_name, preamble_end=preamble_end)
+
+
+def referenced_names(text: str) -> set[str]:
+    # Remove comments/strings crudely to reduce noise.
+    cleaned = re.sub(r"/-.*?-/", " ", text, flags=re.S)
+    cleaned = re.sub(r"--[^\n]*", " ", cleaned)
+    cleaned = re.sub(r'"[^"\\]*(?:\\.[^"\\]*)*"', " ", cleaned)
+    return set(IDENT.findall(cleaned))
+
+
+def dependency_closure(model: SourceModel, target: str) -> list[Declaration]:
+    """Return declarations in source order forming a conservative transitive closure."""
+    target_decl = model.by_name.get(target)
+    if target_decl is None:
+        # try suffix match
+        for d in model.declarations:
+            qualified = ".".join((*d.namespace, d.name))
+            if qualified == target or d.name == target or qualified.endswith("." + target):
+                target_decl = d
+                break
+    if target_decl is None:
+        raise ValueError(f"target declaration not found: {target}")
+
+    # Build lookup by short name and qualified names.
+    defs: dict[str, Declaration] = {}
+    for d in model.declarations:
+        defs[d.name] = d
+        q = ".".join((*d.namespace, d.name))
+        defs[q] = d
+        # also suffixes for nested namespace refs
+        parts = q.split(".")
+        for k in range(1, len(parts)):
+            defs[".".join(parts[k:])] = d
+
+    wanted: set[int] = set()
+    queue = [target_decl]
+    while queue:
+        d = queue.pop()
+        key = id(d)
+        if key in wanted:
+            continue
+        wanted.add(key)
+        refs = referenced_names(d.text)
+        for ref in refs:
+            dep = defs.get(ref)
+            if dep is None:
+                # try progressively shorter suffixes / longer prefixes are already in defs
+                continue
+            if id(dep) not in wanted:
+                queue.append(dep)
+    # Preserve source order.
+    return [d for d in model.declarations if id(d) in wanted]
diff --git a/missions/pnp/adapter/detect.py b/missions/pnp/adapter/detect.py
new file mode 100644
index 00000000..a96defaa
--- /dev/null
+++ b/missions/pnp/adapter/detect.py
@@ -0,0 +1,155 @@
+"""Detect reusable stronger lemmas in the checked upstream corpus."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import re
+
+from ..proofs import corpus
+from .. import validate
+from .adapt import adapt_exact_module, controlled_module_rename, emit_standalone, _extract_final_theorem, _replace_final_theorem, _split_imports, _ensure_imports_allowed, _demote_helper_theorems, _normalize_helper_namespaces
+
+
+@dataclass
+class Detection:
+    path: str
+    module: str
+    score: float
+    strategy: str
+    ok: bool
+    sha256: str | None
+    error: str | None
+    candidate: str | None
+
+
+def _hypothesis_parts(statement: str) -> tuple[list[str], str]:
+    # Reuse corpus.hypotheses but keep raw text parts.
+    parts, conclusion = corpus.hypotheses(statement)
+    return [p.strip() for p in parts if p.strip()], conclusion.strip()
+
+
+def _is_stronger_or_equal(source_stmt: str, target_stmt: str) -> str | None:
+    """Return a strategy name if source can justify target, else None.
+
+    Strategies:
+    - exact: token-equal statements.
+    - stronger_hypotheses: same conclusion shape, source hypotheses are subset.
+    - weaker_target: target has extra hypotheses; source can be applied after introducing them.
+    """
+    if validate.tokens(source_stmt) == validate.tokens(target_stmt):
+        return "exact"
+    sh, sc = _hypothesis_parts(source_stmt)
+    th, tc = _hypothesis_parts(target_stmt)
+    if validate.tokens(sc) != validate.tokens(tc):
+        # Try structural conclusion shape equality
+        if corpus.shape(sc) != corpus.shape(tc) or not corpus.shape(sc):
+            return None
+    # Source stronger if its hypotheses are a subset of target hypotheses (by normalized token shape).
+    sset = {corpus.shape(h) for h in sh if corpus.shape(h)}
+    tset = {corpus.shape(h) for h in th if corpus.shape(h)}
+    if sset and sset <= tset:
+        return "stronger_hypotheses"
+    if not sset and tset:
+        # Source has no hypotheses, target does - source is stronger.
+        return "stronger_hypotheses"
+    if sset == tset:
+        return "exact_shape"
+    return None
+
+
+def _instantiate_candidate(source: str, source_module: str, target_gap: dict, strategy: str) -> Detection:
+    target_module = target_gap["module"]
+    renamed = controlled_module_rename(source, source_module, target_module)
+    src_imports, _ = _split_imports(renamed)
+    try:
+        _ensure_imports_allowed(src_imports, target_gap)
+    except ValueError as e:
+        return Detection("", source_module, 0.0, strategy, False, None, str(e), None)
+
+    _, body = _split_imports(renamed)
+    body = _demote_helper_theorems(body, target_module)
+    body = _normalize_helper_namespaces(body, target_module)
+    candidate = emit_standalone(target_gap, body, src_imports)
+    final = _extract_final_theorem(candidate, target_module)
+    if final is None:
+        return Detection("", source_module, 0.0, strategy, False, None, "missing final theorem after rename", candidate)
+
+    _, stmt, proof_tail = final
+    target_stmt = target_gap["statement"]
+
+    if validate.tokens(stmt) != validate.tokens(target_stmt):
+        if strategy in ("exact", "exact_shape"):
+            candidate = _replace_final_theorem(candidate, target_module, target_stmt, proof_tail)
+        elif strategy == "stronger_hypotheses":
+            # Source is stronger (fewer/equal hypotheses, same conclusion). Keep the
+            # renamed source theorem as a helper lemma inside a module-derived namespace,
+            # then emit exactly one final theorem matching the target statement.
+            pat = re.compile(
+                r"(?<![\w.])theorem\s+" + re.escape(target_module) + r"\s*:.*?:=\s*by\b.*\Z",
+                re.S,
+            )
+            m = pat.search(candidate)
+            if not m:
+                return Detection("", source_module, 0.0, strategy, False, None, "cannot locate theorem for wrapping", candidate)
+            helper_ns = target_module + "_aux"
+            helper_lemma = f"lemma adapted_stronger :{stmt} := by{proof_tail}"
+            wrapper = (
+                f"namespace {helper_ns}\n"
+                f"{helper_lemma}\n"
+                f"end {helper_ns}\n\n"
+                f"theorem {target_module} : {target_stmt} := by\n"
+                f"  intros\n"
+                f"  first\n"
+                f"  | exact {helper_ns}.adapted_stronger\n"
+                f"  | apply {helper_ns}.adapted_stronger <;> assumption\n"
+                f"  | (have h := {helper_ns}.adapted_stronger; first | exact h | (apply h <;> assumption))\n"
+            )
+            candidate = candidate[:m.start()] + wrapper
+        else:
+            candidate = _replace_final_theorem(candidate, target_module, target_stmt, proof_tail)
+
+    try:
+        digest = validate.validate(target_gap, candidate.encode("utf-8"))
+    except validate.InvalidCandidate as e:
+        return Detection("", source_module, 0.0, strategy, False, None, str(e), candidate)
+    return Detection("", source_module, 0.0, strategy, True, digest, None, candidate)
+
+
+def detect_and_adapt(db, target_gap: dict, *, limit: int = 8, source_text: str | None = None, source_module: str | None = None) -> list[Detection]:
+    target_stmt = target_gap["statement"]
+    target_module = target_gap["module"]
+    results: list[Detection] = []
+
+    if source_text is not None:
+        mod = source_module
+        if mod is None:
+            m = re.search(r"(?m)^theorem\s+(PEqualNP\.[A-Za-z0-9_.]+)\s*:", source_text)
+            mod = m.group(1) if m else target_module
+        strat = "exact" if mod == target_module else "module_rename"
+        r = adapt_exact_module(source_text, target_gap, source_module=mod)
+        results.append(Detection(path="<source>", module=mod, score=1.0, strategy=r.strategy,
+                                 ok=r.ok, sha256=(r.details or {}).get("sha256"), error=(r.details or {}).get("error"), candidate=r.candidate))
+        return results
+
+    matches = corpus.search(db, target_stmt, target_gap.get("imports") or [], limit=limit)
+    for m in matches:
+        src_module = m["module"]
+        src_stmt = m["statement"]
+        strat = _is_stronger_or_equal(src_stmt, target_stmt)
+        if strat is None:
+            # still try module rename adaptation if same conclusion shape
+            hint = m.get("structural_hint") or {}
+            if hint.get("same_conclusion_shape"):
+                strat = "conclusion_shape"
+            else:
+                continue
+        src = db.execute("select source from proof where path=?", (m["path"],)).fetchone()
+        if not src:
+            continue
+        det = _instantiate_candidate(src[0], src_module, target_gap, strat)
+        det.path = m["path"]
+        det.module = src_module
+        det.score = m["score"]
+        det.strategy = strat
+        results.append(det)
+    results.sort(key=lambda d: (not d.ok, -d.score, d.path))
+    return results
