+#!/bin/sh
+# Act 23 §4.1 mapping must exist on current main and must not authorize the
+# deletion of mechanisms required by Acts enacted after Act 23.
+set -eu
+repo=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
+map="$repo/records/agentic-operations-duty-map.md"
+cases="$repo/records/agentic-cutover-open-cases.md"
+for n in 15 17 18 19 21 23; do
+    grep -Fq "Act $n:" "$map"
+done
+grep -Fq 'Acts 25, 27, 30, 31, 32 and 34' "$map"
+grep -Fq 'MUST be retained on current main' "$map"
+grep -Fq 'government/agentic-office.sh' "$map"
+for id in continuity_unverified_c1a00001 continuity_unverified_executive continuity_unverified_judiciary; do
+    grep -Fq "$id" "$cases"
+done
+grep -Fq 'independent verifier' "$cases"
+echo 'Act 23 current-main duty mapping and retained-mechanism register passed'
