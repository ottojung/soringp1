+# Optional second path to a general-purpose recovery agent; never blocks ordinary government.
+if [ "${VICHE_TEST_NO_SYNC:-0}" != 1 ] && [ -n "${VICHE_CONSTITUTION:-}" ] && [ -s "$town/government/recovery-steward-cycle.sh" ]; then /bin/sh "$town/government/recovery-steward-cycle.sh" || echo "Recovery fallback unavailable" >&2; fi
