+#!/bin/sh
+# Isolated adversarial regressions for the DRAFT Held Reservation Resolution
+# Act candidate: knowledge-budget.sh resolve-session. No live agent, provider,
+# credentials or production ledger: antonina is a PATH-first recording stub and
+# every budget/ledger lives in a private temp directory under suite-env scratch.
+# This test does not enact law, deploy code, replay a turn or bind a live agent.
+set -eu
+repo=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
+tool=$repo/government/knowledge-budget-tool.py
+engine=$repo/government/knowledge-budget.sh
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT HUP INT TERM
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+base_state=$VICHE_STATE_ROOT
+town=$tmp/town
+mkdir -p "$town/government" "$tmp/bin"
+cp "$repo/government/knowledge-budget.conf" "$town/government/config.template"
+
+# Exact frozen identifiers from the foresight case evidence. The whole suite
+# exercises the real target shape (native_session_id=null, charge=full cap).
+sid=ses_dee2bc2a9ffevFtsM61Ljl2TvW
+agent=15bm8Esub3exygbtVQDIMX-issues
+sid2=ses_statistics_unrelated
+agent2=statistics-unrelated-agent
+
+# Per-case authoritative meter with the exact session_v2 schema the tool reads.
+mkdb() { # path, tokens
+  python3 - "$1" "$2" "$sid" "$sid2" <<'PY'
+import sqlite3,sys
+path,tokens,s1,s2=sys.argv[1:]
+c=sqlite3.connect(path)
+c.execute('create table session_v2 (id text primary key,tokens_input int,tokens_output int,tokens_reasoning int,tokens_cache_read int,tokens_cache_write int,cost real,time_updated int)')
+for s in (s1,s2):
+    c.execute("insert into session_v2 values (?,?,0,0,0,0,0.0,1795279700000)",(s,int(tokens)))
+c.commit()
+PY
+}
+
+mkdbnull() { # path — meter row with no reported cost
+  python3 - "$1" "$sid" "$sid2" <<'PY'
+import sqlite3,sys
+path,s1,s2=sys.argv[1:]
+c=sqlite3.connect(path)
+c.execute('create table session_v2 (id text primary key,tokens_input int,tokens_output int,tokens_reasoning int,tokens_cache_read int,tokens_cache_write int,cost real,time_updated int)')
+for s in (s1,s2):
+    c.execute("insert into session_v2 values (?,?,0,0,0,0,NULL,1795279700000)",(s,100))
+c.commit()
+PY
+}
+
+mkcfg() { # state_root, db
+  cp "$town/government/config.template" "$town/government/knowledge-budget.conf"
+  python3 - "$town/government/knowledge-budget.conf" "$2" <<'PY'
+import json,sys
+p,db=sys.argv[1:]
+c=json.load(open(p))
+c['metering']['opencode_db']=db
+c['monitor_interval_seconds']=300
+for office in ('foresight','statistics'):
+    c['offices'][office]['caps']={'tokens_total':5000,'cpu_seconds':5000,'wall_seconds':5000}
+    c['offices'][office]['per_run_caps']={'tokens_total':1000,'cpu_seconds':1000,'wall_seconds':1000}
+json.dump(c,open(p,'w'))
+PY
+  mkdir -p "$1/knowledge/budget/reservations"
+}
+
+cat > "$tmp/mkheld.py" <<'PY'
+import json,sys,time
+path,agent,sid=sys.argv[1:4]
+a=json.load(open(path))
+now=int(time.time())
+a.update(state='held',agent_id=agent,native_session_id=None,runner_pid=None,
+         meter=None,usage=None,started_at=None,expires_at=None,
+         charge=dict(a['caps']),held_at=now,
+         held_reason='meter_or_session_binding_unknown_after_launch',
+         history=[{'at':a['created_at'],'event':'reserved','office':a['office']},
+                  {'at':now,'event':'held','reason':'meter_or_session_binding_unknown_after_launch'}])
+json.dump(a,open(path,'w'))
+PY
+
+# The stub is the ONLY antonina any case can see. It never dispatches anything.
+cat > "$tmp/bin/antonina" <<'SH'
+#!/bin/sh
+case "$1 $2" in
+  'agent status')
+    case "${TEST_MODE:-terminal}" in
+      unreadable) exit 9;;
+      malformed) printf 'not-json-at-all\n'; exit 0;;
+      nonterminal) printf '{"id":"%s","state":"running","native_session_id":"%s","runner_pid":123}\n' "$TEST_AGENT" "$TEST_SID";;
+      mismatch) printf '{"id":"%s","state":"killed","native_session_id":"other-session","runner_pid":123}\n' "$TEST_AGENT";;
+      empty_sid) printf '{"id":"%s","state":"killed","native_session_id":"","runner_pid":123}\n' "$TEST_AGENT";;
+      agent_mismatch) printf '{"id":"another-agent","state":"killed","native_session_id":"%s","runner_pid":123}\n' "$TEST_SID";;
+      no_id) printf '{"state":"%s","native_session_id":"%s","runner_pid":123}\n' "${TEST_STATE:-killed}" "$TEST_SID";;
+      *) printf '{"id":"%s","state":"%s","native_session_id":"%s","runner_pid":123}\n' "$TEST_AGENT" "${TEST_STATE:-killed}" "$TEST_SID";;
+    esac
+    ;;
+  'agent kill'|'agent stop')
+    printf '%s\n' "$*" >> "$TEST_AGENT_KILLS"
+    exit 0
+    ;;
+  *) exit 17 ;;
+esac
+SH
+chmod +x "$tmp/bin/antonina"
+export PATH="$tmp/bin:$PATH"
+export TEST_AGENT_KILLS="$tmp/kills.log"; : > "$TEST_AGENT_KILLS"
+export VICHE_TOWN_ROOT="$town" VICHE_BUDGET_TOOL="$tool"
+
+newcase() { # case_dir_suffix, db_suffix
+  s="$base_state/$1"; db="$tmp/$2.db"
+  mkdir -p "$s"
+  mkdb "$db" 100
+  mkcfg "$s" "$db"
+  VICHE_STATE_ROOT="$s"
+  export VICHE_STATE_ROOT TEST_DB="$db" TEST_AGENT="$agent" TEST_SID="$sid"
+  export TEST_MODE=terminal TEST_STATE=killed
+  rid=$(/bin/sh "$engine" reserve foresight "$agent")
+  f="$s/knowledge/budget/reservations/$rid.json"
+  python3 "$tmp/mkheld.py" "$f" "$agent" "$sid"
+}
+
+guard_ok() { # office
+  /bin/sh "$engine" guard "$1" > "$tmp/guard.out" 2>&1 ||
+    fail "guard $1 failed: $(cat "$tmp/guard.out")"
+  grep -q "guard ok: $1" "$tmp/guard.out" || fail "guard $1 did not report ok"
+}
+guard_fails() { # office
+  if /bin/sh "$engine" guard "$1" > "$tmp/guard.out" 2>&1; then
+    fail "guard $1 unexpectedly ok"
+  fi
+}
+
