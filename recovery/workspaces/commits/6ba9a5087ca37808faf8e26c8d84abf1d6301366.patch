    Add inventory, classify, quarantine, and reclaim-quarantined modes to Janitor Office
    
    Implements safe reclamation procedures for #299:
    - inventory: scan the box for large directories (read-only)
    - classify: classify candidates by ownership/liveness (read-only)
    - quarantine: move candidates to quarantine (reversible)
    - reclaim-quarantined: remove past grace period (destructive, gated)
    
    All modes are POSIX /bin/sh compliant and include proper logging.

diff --git a/government/janitor.conf b/government/janitor.conf
index 4b8a9e2f..31c1a9a7 100644
--- a/government/janitor.conf
+++ b/government/janitor.conf
@@ -20,3 +20,10 @@ max_log_bytes=1048576
 # reclaim_enabled gates any future destructive action; there is none in this version.
 safe_reclaim_enabled=1
 reclaim_enabled=0
+
+# Minimum size (KB) for a directory to appear in the box inventory.
+inventory_min_kb=102400
+
+# Quarantine directory and grace period (seconds) before quarantined items are removed.
+quarantine_dir=/var/lib/lubko/wd/viche-state/quarantine
+quarantine_grace_seconds=604800
