+    case "$_qpo_dest" in
+        "$_qpo_root"/*) _qpo_rel=${_qpo_dest#"$_qpo_root"/} ;;
+        *) return 1 ;;
+    esac
+    case "$_qpo_rel" in ''|*/*|.|..) return 1 ;; esac
+    return 0
+}
