@@ -0,0 +1,69 @@
+"""Exact finite witness validation and Lean proof rendering."""
+import re
+
+from .. import validate
+
+GATE = re.compile(r"⟨PEqualNP\.CircuitLowerBounds\.GateOp\.(and|or|not),\s*\[([0-9, ]*)\]⟩")
+EDGE = re.compile(r"\(x (\d+) && x (\d+)\)")
+INPUT = re.compile(r"∀ x : Fin (\d+) → Bool, C\.eval \(List\.ofFn x\) =")
+
+
+def explicit_circuit(meta):
+    """Recognize only explicit circuit equality rows; reject ambiguous shapes."""
+    s = meta["statement"]
+    head = re.match(r"let C : PEqualNP\.CircuitLowerBounds\.Circuit := \(⟨\[(.*?)\],\s*(\d+)⟩ : PEqualNP\.CircuitLowerBounds\.Circuit\);", s, re.S)
+    if not head:
+        return None
+    body = head.group(1)
+    gates = [(m[1], [int(x.strip()) for x in m[2].split(",") if x.strip()])
+             for m in GATE.finditer(body)]
+    if not gates or GATE.sub("", body).replace(",", "").strip():
+        return None
+    m = INPUT.search(s)
+    if not m:
+        return None
+    n, out = int(m[1]), int(head[2])
+    prefix = s[head.end():m.start()].strip()
+    basic = f"C.gates.length = {len(gates)} ∧ C.output = {out} ∧"
+    if not prefix.startswith(basic):
+        return None
+    extra = prefix[len(basic):].strip()
+    gate_shape = ("(∀ p ∈ C.gates.zipIdx, ((p.1.op.eval [] = true ∧ ∀ a b : Bool, "
+                  "p.1.op.eval [a, b] = (a && b)) ∨ (p.1.op.eval [] = false ∧ "
+                  "∀ a b : Bool, p.1.op.eval [a, b] = (a || b))) ∧ "
+                  "p.1.inputs.length = 2 ∧ ∀ i ∈ p.1.inputs, i < " + str(n) + " + p.2) ∧")
+    if extra not in ("", gate_shape):
+        return None
+    if extra and any(op not in ("and", "or") for op, _ in gates):
+        return None
+    if n > 12 or len(gates) > 64 or not 0 <= out < n+len(gates):
+        return None
+    rhs = s[m.end():].strip()
+    # Accept only a disjunction of parenthesized edge conjunctions.
+    if not re.fullmatch(r"[()\s]*" + EDGE.pattern + r"(?:[()\s]*\|\|[()\s]*" + EDGE.pattern + r")*[()\s]*", rhs):
+        return None
+    edges = [(int(a), int(b)) for a,b in EDGE.findall(rhs)]
+    if not edges or any(a >= n or b >= n for a,b in edges):
+        return None
+    if any(len(ins) != (1 if op == "not" else 2) or any(i >= n+j for i in ins)
+           for j,(op,ins) in enumerate(gates)):
+        return None
+    for mask in range(1 << n):
+        wires = [bool(mask & (1 << i)) for i in range(n)]
+        for op, ins in gates:
+            xs = [wires[i] for i in ins]
+            wires.append(all(xs) if op == "and" else any(xs) if op == "or" else not xs[0])
+        expected = any(wires[a] and wires[b] for a,b in edges)
+        if wires[out] != expected:
+            return {"verified": False, "counterexample": mask, "inputs": n}
+    return {"verified": True, "inputs": n, "cases": 1 << n,
+            "gates": len(gates), "output": out, "edges": edges}
+
+
+def render(meta, proof):
+    imports = ["Mathlib"] + [m for m in meta["imports"] if m != "Mathlib"]
+    text = "\n".join("import "+m for m in imports) + "\n\n"
+    text += "set_option maxRecDepth 100000 in\nset_option maxHeartbeats 0 in\n"
+    text += "theorem " + meta["module"] + " : " + meta["statement"] + " := by\n  " + proof + "\n"
+    validate.validate(meta, text.encode())
+    return text
diff --git a/missions/pnp/proofs/corpus.py b/missions/pnp/proofs/corpus.py
new file mode 100644
index 00000000..2b0599cd
--- /dev/null
+++ b/missions/pnp/proofs/corpus.py
@@ -0,0 +1,97 @@
+"""Index checked upstream proof sources, without executing them."""
+import json
+import math
+from pathlib import Path
+import re
+import sqlite3
+import subprocess
+
+from .. import config, gitctl
+
+TOKEN = re.compile(r"[A-Za-z_][A-Za-z_0-9'.]*")
+PROOF = re.compile(r"(?m)^theorem PEqualNP\.Outside\.[A-Za-z0-9_]+\s*:")
+TACTICS = re.compile(r"\b(?:decide|fin_cases|interval_cases|simp|omega|norm_num|ring|aesop|exact|linarith|nlinarith|grind|bv_decide)\b")
+
+
+def terms(s):
+    return {x.lower() for t in TOKEN.findall(s) for x in [t, t.split(".")[-1]]
+            if len(x) > 2 and not x.startswith("L_meta_")}
+
+
+def statement(source):
+    matches = list(PROOF.finditer(source))
+    if not matches:
+        return ""
+    tail = source[matches[-1].end():]
+    return re.split(r":=\s*by\b|:=\s*\n\s*[A-Za-z_]", tail, maxsplit=1)[0].strip()
+
+
+def open_index():
+    path = Path(config.CACHE_DIR, "proof-corpus.sqlite")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    db = sqlite3.connect(path, timeout=15)
+    db.execute("create table if not exists proof(path text primary key, blob text, statement text, source text, tactics text, imports text)")
+    db.execute("create table if not exists metadata(key text primary key, value text)")
+    return db
+
+
+def update(db, mirror=gitctl.MIRROR, revision="refs/remotes/upstream/main"):
+    def git(*args):
+        return subprocess.check_output(["git", "--git-dir=" + mirror, *args], timeout=60)
+    sha = git("rev-parse", revision).decode().strip()
+    old = db.execute("select value from metadata where key='revision'").fetchone()
+    version = db.execute("select value from metadata where key='index_version'").fetchone()
+    if old and old[0] == sha and version == ("2",):
+        return sha
+    rows = {}
+    for line in git("ls-tree", "-r", sha, "lean/PEqualNP/Outside").decode().splitlines():
+        meta, path = line.split("\t", 1)
+        mode, kind, blob = meta.split()
+        if kind == "blob" and mode == "100644" and path.endswith(".lean"):
+            rows[path] = blob
+    known = dict(db.execute("select path,blob from proof")) if version == ("2",) else {}
+    with db:
+        if version != ("2",):
+            db.execute("delete from proof")
+        for path, blob in rows.items():
+            if known.get(path) == blob:
+                continue
+            src = git("cat-file", "blob", blob)
+            db.execute("delete from proof where path=?", (path,))
+            if len(src) > config.MAX_FILE_BYTES:
+                continue
+            text = src.decode("utf-8", "replace")
+            if re.search(r"[\u0400-\u04ff]", text):
+                continue
+            stmt = statement(text)
+            if not stmt:
+                continue
+            imports = re.findall(r"(?m)^import ([A-Za-z0-9_.]+)$", text)
+            db.execute("insert or replace into proof values(?,?,?,?,?,?)",
+                       (path, blob, stmt, text, json.dumps(sorted(set(TACTICS.findall(text)))), json.dumps(imports)))
+        for path in set(known) - set(rows):
+            db.execute("delete from proof where path=?", (path,))
+        db.execute("insert or replace into metadata values('revision',?)", (sha,))
+        db.execute("insert or replace into metadata values('index_version','2')")
+    return sha
+
+
+def search(db, query, allowed=(), limit=8):
+    q = terms(query)
+    rows = list(db.execute("select path,blob,statement,tactics,imports from proof"))
+    doc_terms = [terms(row[2]) for row in rows]
+    freq = {t: sum(t in d for d in doc_terms) for t in q}
+    def score(d):
+        return sum(math.log((len(rows)+1)/(freq[t]+1))+1 for t in q & d) / math.sqrt(max(1,len(d)))
+    found = []
+    for row, d in zip(rows, doc_terms):
+        rank = score(d)
+        if rank <= 0:
+            continue
+        path, blob, stmt, tactics, imports = row
+        module = path.removeprefix("lean/").removesuffix(".lean").replace("/", ".")
+        found.append({"path": path, "blob": blob, "module": module,
+                      "score": round(rank, 4), "statement": stmt,
+                      "tactics": json.loads(tactics), "imports": json.loads(imports),
+                      "direct_import_allowed": module in allowed})
+    return sorted(found, key=lambda r: (-r["score"], r["path"]))[:limit]
diff --git a/missions/pnp/proofs/synthesis.py b/missions/pnp/proofs/synthesis.py
new file mode 100644
index 00000000..10fb7e30
--- /dev/null
+++ b/missions/pnp/proofs/synthesis.py
@@ -0,0 +1,112 @@
+"""Deterministic small graph edge-function circuit synthesis."""
+import itertools
+import re
+
+from .circuit import EDGE
+
+SHAPE = re.compile(
+    r"∃ C : PEqualNP\.CircuitLowerBounds\.Circuit, PEqualNP\.MetaComplexity\.Monotone2 C ∧ C\.size ≤ (\d+) ∧ ∀ x : Fin (\d+) → Bool, C\.eval \(List\.ofFn x\) = \(fun x : Fin \2 → Bool => (.*)\) x", re.S)
+
+
+def parse(statement):
+    m = SHAPE.fullmatch(statement.strip())
+    if not m:
+        return None
+    bound,n,rhs = int(m[1]),int(m[2]),m[3]
+    if not 2 <= n <= 12:
+        return None
+    if not re.fullmatch(r"[()\s]*" + EDGE.pattern + r"(?:[()\s]*\|\|[()\s]*" + EDGE.pattern + r")*[()\s]*", rhs):
+        return None
+    edges = {tuple(sorted((int(a),int(b)))) for a,b in EDGE.findall(rhs)}
+    if not edges or any(a == b or b >= n for a,b in edges):
+        return None
+    return n,bound,edges
+
+
+def synthesize(n, edges):
+    """Cover edges by stars or complete bipartite blocks; share OR subexpressions."""
+    neighbors = {i:{b if a == i else a for a,b in edges if i in (a,b)}
+                 for i in range(n)}
+    blocks = set()
+    for i in range(n):
+        if neighbors[i]:
+            blocks.add(((i,),tuple(sorted(neighbors[i]))))
+    for k in range(2,min(4,n)+1):
+        for left in itertools.combinations(range(n),k):
+            right = set.intersection(*(neighbors[i] for i in left))
+            if right:
+                blocks.add((left,tuple(sorted(right))))
+    blocks = sorted(blocks)
+    best = None
+    for strategy in range(3):
+        gates, memo, remaining, outputs = [], {}, set(edges), []
+        def gate(op,a,b):
+            key = op,*sorted((a,b))
+            if key not in memo:
+                memo[key] = n+len(gates)
+                gates.append(key)
+            return memo[key]
+        def disjoin(xs):
+            xs = list(xs)
+            result = xs[0]
+            for x in xs[1:]:
+                result = gate("or",result,x)
+            return result
+        while remaining:
+            choices = []
+            for a,b in blocks:
+                covered = {tuple(sorted((u,v))) for u in a for v in b} & remaining
+                if not covered:
+                    continue
+                cost = len(a)+len(b)
+                rank = (len(covered)/cost,len(covered)) if strategy == 0 else (
+                    (len(covered),-cost) if strategy == 1 else (len(covered)-cost,-cost))
+                choices.append((rank,a,b,covered))
+            _,a,b,covered = max(choices,key=lambda t:(t[0],t[1],t[2]))
+            outputs.append(gate("and",disjoin(a),disjoin(b)))
+            remaining -= covered
+        output = disjoin(outputs)
+        if best is None or len(gates)<len(best[0]):
+            best = gates,output
+    return best
+
+
+def verify(n,edges,gates,output):
+    for mask in range(1<<n):
+        w = [bool(mask & (1<<i)) for i in range(n)]
+        for op,a,b in gates:
+            if not (0 <= a < len(w) and 0 <= b < len(w)):
+                return False
+            w.append(w[a] and w[b] if op=="and" else w[a] or w[b])
+        if w[output] != any(w[a] and w[b] for a,b in edges):
+            return False
+    return True
+
+
+def candidate(meta):
+    from .. import validate
+    parsed = parse(meta["statement"])
+    if not parsed:
+        return None
+    n,bound,edges = parsed
+    gates,out = synthesize(n,edges)
+    report = {"gates":len(gates),"bound":bound,"cases":1<<n,"candidate":None}
+    if len(gates)>bound or not verify(n,edges,gates,out):
+        return report
+    mod = meta["module"]
+    imports = ["Mathlib"]+[m for m in meta["imports"] if m!="Mathlib"]
+    prefix = "\n".join("import "+m for m in imports)
+    gs = ", ".join("⟨PEqualNP.CircuitLowerBounds.GateOp."+op+", ["+str(a)+", "+str(b)+"]⟩" for op,a,b in gates)
+    text = prefix+"\n\nnamespace "+mod+"\ndef witness : PEqualNP.CircuitLowerBounds.Circuit := ⟨["+gs+"], "+str(out)+"⟩\n"
+    text += "lemma wf : PEqualNP.MetaComplexity.Monotone2 witness := by\n  intro g hg\n  simp only [witness, List.mem_cons, List.not_mem_nil, or_false] at hg\n  rcases hg with "+" | ".join("rfl" for _ in gates)+" <;> simp\n"
+    variables = ["b"+str(i) for i in range(n)]
+    rhs = re.sub(r"\bx (\d+)\b", lambda m: variables[int(m[1])], SHAPE.fullmatch(meta["statement"].strip())[3])
+    text += "set_option maxRecDepth 100000 in\nset_option maxHeartbeats 0 in\n"
+    text += "lemma truth : ∀ "+" ".join(variables)+" : Bool, witness.eval ["+", ".join(variables)+"] = ("+rhs+") := by\n  decide\n"
+    text += "end "+mod+"\n\ntheorem "+mod+" : "+meta["statement"]+" := by\n"
+    text += "  refine ⟨"+mod+".witness, "+mod+".wf, by decide, ?_⟩\n  intro x\n  simp only [List.ofFn_succ, List.ofFn_zero]\n"
+    text += "  exact "+mod+".truth "+" ".join("(x "+str(i)+")" for i in range(n))+"\n"
+    # Never describe the generated candidate as Lean-checked.
+    validate.validate(meta,text.encode())
+    report["candidate"]=text
+    return report
