    Do not count the reviewer's own dispositions as pending mailbox work
    
    Implements the Executive repair specified by the Clerk investigation
    records/investigations/judiciary-mailbox-signal-never-clears-2026-11-08.md.
    branch-health emitted judiciary_mailbox_pending whenever any .md existed in the
    inbox, so reviewer-authored dispositions and addenda kept the signal red
    forever. Count only files that are not dispositions/addenda; preserve every file.
    
    Reconcile now refreshes a case's owner on every cycle, so an existing case
    created under an older routing map surfaces to the current responsible office.
    The non-dict guard is included so a list-shaped evidence record remains
    non-fatal.
    
    Tests: a mailbox with only a disposition emits no signal; an undisposed report
    still does; an existing case's owner updates from legislature to judiciary.

diff --git a/government/branch-health.sh b/government/branch-health.sh
index 4f6b044d..fec8231e 100755
--- a/government/branch-health.sh
+++ b/government/branch-health.sh
@@ -84,10 +84,25 @@ for observation in "outcomes:$state/institutional-outcomes/latest.json" "institu
     signals="${signals}${signals:+,}${evidence_name}_stale"
   fi
 done
-# Unreviewed agent impediments are unresolved adverse evidence.
+# Unreviewed agent impediments are unresolved adverse evidence. A reviewer's
+# own disposition or addendum is an answer, not a pending question, and must
+# not hold the signal red forever. This is a deterministic filename convention
+# because the mailbox has no metadata sidecar; it does not remove or rewrite
+# any preserved report.
 mailbox_dir="$state/oversight/judiciary-mailbox/inbox"
-if [ -d "$mailbox_dir" ] &&
-   [ -n "$(find "$mailbox_dir" -maxdepth 1 -type f -name '*.md' -print -quit 2>/dev/null)" ]; then
+pending_mailbox=no
+if [ -d "$mailbox_dir" ]; then
+  for mailbox_file in "$mailbox_dir"/*.md; do
+    [ -f "$mailbox_file" ] || continue
+    mailbox_name=$(basename "$mailbox_file")
+    case "$mailbox_name" in
+      *disposition*|*addendum*) continue ;;
+    esac
+    pending_mailbox=yes
+    break
+  done
+fi
+if [ "$pending_mailbox" = yes ]; then
   signals="${signals}${signals:+,}judiciary_mailbox_pending"
 fi
 printf '%s\t%s\n' "$now" "${signals:-clear}" >> "$root/observations.tsv"
