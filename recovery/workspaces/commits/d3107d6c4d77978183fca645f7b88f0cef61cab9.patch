diff --git a/government/post_guard.py b/government/post_guard.py
new file mode 100644
index 00000000..34afa572
--- /dev/null
+++ b/government/post_guard.py
@@ -0,0 +1,70 @@
+"""Conservative secret-pattern barrier for PUBLIC Viche Post.
+
+This is defense in depth, NOT confidentiality: all Post messages and the SQLite
+database remain readable by the shared Unix user. Never include a matching
+credential or substring in an error, log, receipt, or incident report.
+"""
+import re
+
+PATTERNS = {
+    "private-key": re.compile(
+        r"-----BEGIN (?:[A-Z0-9 ]* )?PRIVATE KEY-----", re.I),
+    "github-token": re.compile(
+        r"\b(?:github_pat_[A-Za-z0-9_]{40,}|gh[pousr]_[A-Za-z0-9]{30,})\b"),
+    "cloud-key": re.compile(r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b"),
+    "openai-token": re.compile(
+        r"\bsk-(?:proj-|ant-)?[A-Za-z0-9_-]{24,}\b"),
+    "gitlab-token": re.compile(r"\bglpat-[A-Za-z0-9_-]{20,}\b"),
+    "slack-token": re.compile(
+        r"\bxox[baprs]-[A-Za-z0-9-]{20,}\b"),
+    "bearer-token": re.compile(
+        r"\b(?:Authorization\s*:\s*)?Bearer\s+[A-Za-z0-9_+./=-]{24,}\b",
+        re.I),
+    "ssh-key": re.compile(
+        r"\bssh-(?:rsa|ed25519)\s+[A-Za-z0-9+/]{90,}={0,3}\b"),
+}
+ASSIGNMENT = re.compile(
+    r"\b(?:password|api[_-]?key|access[_-]?token|client[_-]?secret|"
+    r"secret[_-]?key|private[_-]?key)\s*[:=]\s*['\"]?"
+    r"(?P<value>[A-Za-z0-9_+./=-]{12,})", re.I)
+PLACEHOLDER = re.compile(
+    r"(?:redacted|placeholder|dummy|example|fake|sample|test|changeme|"
+    r"xxxxxxxx|00000000)", re.I)
+
+
+def detect(value):
+    """Return IDs of likely credential patterns without retaining raw matches."""
+    text = value if isinstance(value, str) else str(value)
+    hits = {name for name, pattern in PATTERNS.items() if pattern.search(text)}
+    for match in ASSIGNMENT.finditer(text):
+        if not PLACEHOLDER.search(match.group("value")):
+            hits.add("credential-assignment")
+    return sorted(hits)
+
+
+def check(*values):
+    patterns = set()
+    for value in values:
+        if value is None:
+            continue
+        if isinstance(value, (list, tuple, set)):
+            patterns.update(check_ids(*value))
+        else:
+            patterns.update(detect(value))
+    if patterns:
+        # Never echo the matched value, even on an exception.
+        raise ValueError("public Post rejected credential-like content; "
+                         "pattern IDs: " + ",".join(sorted(patterns)))
+
+
+def check_ids(*values):
+    """Non-throwing helper for nested source/derivation arrays."""
+    result = set()
+    for value in values:
+        if value is None:
+            continue
+        if isinstance(value, (list, tuple, set)):
+            result.update(check_ids(*value))
+        else:
+            result.update(detect(value))
+    return sorted(result)
diff --git a/government/spying-source-preflight.sh b/government/spying-source-preflight.sh
new file mode 100644
index 00000000..cee3d292
--- /dev/null
+++ b/government/spying-source-preflight.sh
@@ -0,0 +1,49 @@
+#!/bin/sh
+# Act 32 clause 4 / amendment F -- Spying launch preflight (fail closed).
+#
+# Invokes the independent source-allowlist verifier and DENIES (non-zero exit)
+# unless every source in the recorded Spying source-scope bundle validates.
+# This gate never activates an office, publishes a message, contacts a private
+# repository or reads a credential. A missing/malformed/unreadable allowlist,
+# bundle or board API is a DENY, never a pass.
+#
+# Usage: spying-source-preflight.sh [TOWN_ROOT]
+# Optional (all fail closed when absent):
+#   VICHE_SPYING_ALLOWLIST  path to the committed allowlist
+#   VICHE_SPYING_BOARD_JSON offline board snapshot (issue id -> board JSON)
+#   VICHE_SPYING_BUNDLE     path to the source-scope bundle
+#   VICHE_SPYING_NOW        fixed epoch for deterministic/replay runs
+set -eu
+town=${1:-${VICHE_TOWN_ROOT:-/var/lib/lubko/wd/viche}}
+state=${VICHE_STATE_ROOT:-/var/lib/lubko/wd/viche-state}
+module=$town/government/spying_source_allowlist.py
+
+if [ ! -s "$module" ]; then
+  echo 'Spying preflight: allowlist verifier module missing' >&2
+  exit 1
+fi
+
+set --
+[ -z "${VICHE_SPYING_ALLOWLIST:-}" ] || set -- "$@" --allowlist "$VICHE_SPYING_ALLOWLIST"
+[ -z "${VICHE_SPYING_BOARD_JSON:-}" ] || set -- "$@" --board-json "$VICHE_SPYING_BOARD_JSON"
+[ -z "${VICHE_SPYING_BUNDLE:-}" ] || set -- "$@" --bundle "$VICHE_SPYING_BUNDLE"
+[ -z "${VICHE_SPYING_NOW:-}" ] || set -- "$@" --now "$VICHE_SPYING_NOW"
+
+if verdict=$(python3 "$module" preflight --town-root "$town" "$@" 2>&1); then
+  denied=0
+else
+  denied=1
+fi
+
+# Durable, append-only audit of every preflight decision.
+logdir=$state/knowledge/offices/spying
+if mkdir -p "$logdir" 2>/dev/null; then
+  printf '%s\n' "$verdict" >> "$logdir/source-preflight.jsonl" 2>/dev/null || :
+fi
+
+if [ "$denied" -eq 0 ]; then
+  printf '%s\n' "$verdict"
+  exit 0
+fi
+echo "Spying preflight DENIED (source scope unvalidated): $verdict" >&2
+exit 1
