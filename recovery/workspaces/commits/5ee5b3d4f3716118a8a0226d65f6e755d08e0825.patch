index 00000000..9a3f1527
--- /dev/null
+++ b/missions/pnp/staffing/plan.py
@@ -0,0 +1,125 @@
+"""Pure desired-state derivation; no agent or desk mutations."""
+from dataclasses import dataclass
+from pathlib import Path
+import hashlib
+from contextlib import closing
+
+from .. import assignment, config, continuity, focus, staff, state, support
+from . import policy
+
+
+@dataclass(frozen=True)
+class Slot:
+    path: str
+    label: str
+    task: str
+    gap: str = ""
+    attempt: str = ""
+    signature: str = ""
+    base: str = ""
+    priority: int = 0
+
+    @property
+    def key(self):
+        return hashlib.sha256(self.path.encode()).hexdigest()[:32]
+
+
+def bound(rec, label, task, priority, base=""):
+    path = Path(state.gap_dir(rec["gap_id"]), "attempts",
+                assignment.attempt_id(rec["lease"]), "workers", label, "path")
+    return Slot(str(path), label, task, rec["gap_id"], support.attempt(rec),
+                base=base, priority=priority)
+
+
+def current(slot):
+    if not slot.gap:
+        return True
+    rec = state.load(slot.gap)
+    return bool(rec and focus.eligible(rec) and support.attempt(rec) == slot.attempt
+                and staff.current_matches(rec, slot.label == "general"))
+
+
+def desired(p, running, issues=None):
+    issues = [] if issues is None else issues
+    records=[]
+    for gap in state.all_gaps():
+        try:
+            r=state.load(gap)
+            if support.active(r) and not r.get("queued_lease"):
+                records.append(r)
+        except Exception as exc:
+            issues.append(gap+": state "+type(exc).__name__)
+    try:
+        selected=focus.current()
+    except Exception as exc:
+        selected=None
+        issues.append("focus: "+type(exc).__name__)
+    slots = [bound(r, "general", staff.GENERAL_APPROACH, 0) for r in records]
+    if selected and focus.eligible(selected):
+        if focus.correction(selected):
+            slots.append(bound(selected, "correction", "Repair the exact published proof using checker diagnostics.", 1))
+        else:
+            for label, task in continuity.FRONTS:
+                slots.append(bound(selected, label, task, 1))
+            try:
+                from ..research import knowledge, obligations
+                if (Path(config.STATE_ROOT)/"research/knowledge.sqlite").exists():
+                    with closing(knowledge.db()) as c:
+                        nodes = [n for n in obligations.ready(c) if n["status"] == "ready"
+                                 and knowledge.belongs(c, n["id"], selected["gap_id"]+" / ")]
+                    # Keep currently running ready fronts before allocating new ones.
+                    paths = {a.get("cwd") for a in running}
+                    nodes.sort(key=lambda n: (bound(selected,"ob-"+n["id"],"",2).path not in paths,n["id"]))
+                    for n in nodes[:p["focus_obligations"]]:
+                        slots.append(bound(selected, "ob-"+n["id"],
+                            "Solve exact obligation "+n["id"]+
+                            ". Inspect it, submit a proof body, collect the check, and share the result. Preserve exact blockers.", 2,n["base"]))
+            except Exception as exc:
+                issues.append("obligation planning: "+type(exc).__name__)
+        for x in p["extras"]:
+            if x["gap"] == selected["gap_id"] and x["attempt"] == support.attempt(selected):
+                slots.append(bound(selected,x["label"],x["approach"],2))
+    for role in continuity.required_support(records):
+        # Stable evidence signatures, plus bounded periodic refresh. Independent
+        # method/tool fronts continue even without a lease.
+        try:
+            sig = continuity.signature(role,records,selected)
+        except Exception as exc:
+            issues.append(role+": signature "+type(exc).__name__)
+            continue
+        if role in support.FAMILY_ROLES:
+            # No dependency on the old fixed ten-minute cadence.
+            sig = role
+        path = continuity.support_path(role)
+        slots.append(Slot(str(path),role,continuity.SUPPORT[role],signature=sig,priority=3))
+    return slots
+
+
+def obsolete(agent, slots):
+    """Only retire exact bound workspaces, never arbitrary agents by title."""
+    cwd = agent.get("invocation_cwd") or agent.get("cwd")
+    if not cwd:
+        return False
+    path = Path(cwd)
+    binding = assignment.binding(path)
+    if not binding:
+        return False
+    rec = state.load(binding[0])
+    if not rec:
+        return False  # missing/corrupt authority is uncertainty
+    if rec.get("lease") != binding[1]:
+        return True
+    if rec.get("state") in ("RELEASED", "STALE", "ACCEPTED"):
+        return True
+    label = assignment.worker_label(path)
+    selected = focus.current()
+    # Publication/correction transitions are not a license to interrupt a
+    # worker mid-submit. Retire off-focus specialists only in research state.
+    if support.active(rec) and label != "general" and selected:
+        if focus.key(rec) != focus.key(selected):
+            return True
+        # A policy explicitly removes extra positions; existing checked
+        # obligation specialists may finish without preemption.
+        if label and label.startswith("extra-"):
+            return str(path) not in {s.path for s in slots}
+    return False
diff --git a/missions/pnp/staffing/policy.py b/missions/pnp/staffing/policy.py
new file mode 100644
index 00000000..33a68e23
--- /dev/null
+++ b/missions/pnp/staffing/policy.py
@@ -0,0 +1,67 @@
+"""Validated live tuning, without permission to acquire or release leases."""
+import json
+import re
+import fcntl
+from pathlib import Path
+
+from .. import config, state
+
+DEFAULT = {
+    "interval": 5, "parallel": 4, "retry_min": 5, "retry_max": 180,
+    "short_run": 20, "ambiguity_grace": 45, "support_refresh": 600,
+    "focus_obligations": 2, "rotate_after": 3, "alert_after": 120, "paused": False, "extras": [],
+}
+BOUNDS = {
+    "interval": (2, 60), "parallel": (1, 12), "retry_min": (2, 60),
+    "retry_max": (30, 1800), "short_run": (5, 120),
+    "ambiguity_grace": (30, 600), "support_refresh": (120, 3600),
+    "focus_obligations": (0, 12), "rotate_after": (2, 12), "alert_after": (30, 1800),
+}
+
+
+def root():
+    return Path(config.STATE_ROOT, "staffing")
+
+
+def load():
+    path = root() / "policy.json"
+    raw = json.loads(path.read_text()) if path.exists() else {}
+    return validate(raw)
+
+
+def validate(raw):
+    if not isinstance(raw, dict) or set(raw) - set(DEFAULT):
+        raise ValueError("invalid staffing policy keys")
+    p = {**DEFAULT, **raw}
+    for key, (lo, hi) in BOUNDS.items():
+        if type(p[key]) is not int or not lo <= p[key] <= hi:
+            raise ValueError("invalid staffing policy " + key)
+    if p["retry_max"] < p["retry_min"] or type(p["paused"]) is not bool:
+        raise ValueError("invalid retry bounds or pause")
+    if not isinstance(p["extras"], list) or len(p["extras"]) > 24:
+        raise ValueError("invalid extra assignments")
+    seen = set()
+    for x in p["extras"]:
+        if not isinstance(x, dict) or set(x) != {"gap", "attempt", "label", "approach"}:
+            raise ValueError("extra assignment must bind exact attempt")
+        if (not config.GAP_ID_RE.fullmatch(x["gap"])
+                or not re.fullmatch(r"[a-f0-9]{24}-[a-f0-9]{16}", x["attempt"])
+                or not re.fullmatch(r"extra-[A-Za-z0-9_-]{1,40}", x["label"])
+                or not isinstance(x["approach"], str) or not x["approach"].strip()
+                or len(x["approach"]) > 4000):
+            raise ValueError("invalid extra assignment")
+        key = (x["gap"], x["attempt"], x["label"])
+        if key in seen:
+            raise ValueError("duplicate extra assignment")
+        seen.add(key)
+    return p
+
+def change(update):
+    directory=root()
+    directory.mkdir(parents=True,exist_ok=True,mode=0o700)
+    with (directory/"policy.lock").open("a+") as lock:
+        fcntl.flock(lock,fcntl.LOCK_EX)
+        p=load()
+        p=validate(update(p))
+        state.atomic_write(str(directory/"policy.json"),json.dumps(p,indent=2,sort_keys=True)+"\n")
+        return p
diff --git a/missions/pnp/staffing/reconcile.py b/missions/pnp/staffing/reconcile.py
new file mode 100644
index 00000000..f11516df
--- /dev/null
+++ b/missions/pnp/staffing/reconcile.py
@@ -0,0 +1,210 @@
+"""One slot state machine. Persist intent BEFORE any ambiguous side effect."""
+import time
+import subprocess
+import sqlite3
+from .. import gitctl
+from . import backend, plan, store
+
+ERRORS = (OSError, ValueError, TypeError, RuntimeError, subprocess.SubprocessError, gitctl.GitError, sqlite3.Error)
+
+
+def update(row, phase, reason="", **kw):
+    row.update(phase=phase,reason=reason,**kw)
+    return row
+
+
+def save(slot,row,phase,reason="",event=None,**kw):
+    update(row,phase,reason,**kw)
+    if phase in ("running","completed","paused","obsolete"):
+        row["uncovered_since"]=None
+    elif row.get("uncovered_since") is None:
+        row["uncovered_since"]=time.time()
+    store.put(slot.key,row,event)
+    return row
+
+
+def delay(p,n):
+    return min(p["retry_max"],p["retry_min"]*2**min(12,max(0,n-1)))
+
+
+def failure(slot,row,p,now,reason,uncertain=False):
+    n=row.get("failures",0)+1
+    return save(slot,row,"unknown" if uncertain else "retry",reason,"failure",
+                failures=n,next_at=now+delay(p,n))
+
+
+def inspect(slot,row,roster,p,now):
+    # Always consider observed running workers, even when a persisted ID exists.
+    live=[a for a in roster if backend.same(a,slot.path)]
+    if len(live)>1:
+        exact=[backend.status(a["id"]) for a in live]
+        if any(not backend.same(a,slot.path) or
+               not (backend.live(a) or backend.known_terminal(a)) for a in exact):
+            return save(slot,row,"unknown","duplicate identities uncertain")
+        live=[a for a in exact if backend.live(a)]
+        if len(live)>1:
+            keep=min(live,key=lambda a:(a["id"]!=row.get("agent"),
+                                         a.get("started_at") or 0,a["id"]))
+            row=save(slot,row,"unknown","duplicate running identities","duplicate",
+                     agent=keep["id"],duplicates=[a["id"] for a in live if a!=keep])
+            if not p["paused"] and plan.current(slot):
+                for a in live:
+                    if a==keep:
+                        continue
+                    fresh=backend.status(a["id"])
+                    if backend.same(fresh,slot.path) and backend.live(fresh) and plan.current(slot):
+                        backend.stop(fresh["id"])
+            # Confirm retirement on a new observation, never launch here.
+            return row
+    if live:
+        found=backend.status(live[0]["id"])
+        if not backend.same(found,slot.path):
+            return save(slot,row,"unknown","running identity moved")
+        if backend.live(found):
+            changed=row.get("agent")!=found["id"] or row.get("phase")!="running"
+            return save(slot,row,"running","observed live","adopted" if changed else None,
+                        agent=found["id"],started=found.get("started_at",now),
+                        activity=found.get("last_activity_at"),model=found.get("model"),
+                        vacant_since=None,intent=None,next_at=0,duplicates=[],orphan_since=None)
+        # A roster entry may have terminated since enumeration. Preserve its
+        # exact identity for recovery, including an explicitly orphaned runner.
+        if not row.get("agent") or not backend.known_terminal(found):
+            row=save(slot,row,"unknown","reconciling observed identity",agent=found["id"])
+    if not row.get("agent"):
+        return row
+    try:
+        found=backend.status(row["agent"])
+    except backend.MissingAgent:
+        # Explicit authoritative not-found, not a timeout or malformed reply.
+        return save(slot,row,"vacant","agent removed; rediscover workspace","identity_lost",
+                    agent=None,intent=None,next_at=now+p["retry_min"],vacant_since=now)
+    if not backend.same(found,slot.path):
+        return save(slot,row,"unknown","stored agent no longer bound to exact workspace","binding_conflict")
+    if row.get("reason") in ("duplicate running identities","duplicate identities uncertain",
+                             "running identity moved","running observation not confirmed"):
+        row=save(slot,row,"vacant","exact identity reconciled",duplicates=[])
+    if backend.live(found):
+        return save(slot,row,"running","confirmed by exact status",agent=found["id"],
+                    started=found.get("started_at",now),activity=found.get("last_activity_at"),model=found.get("model"),vacant_since=None,intent=None,next_at=0,orphan_since=None)
+    if not backend.known_terminal(found):
+        if found.get("state")=="running" and found.get("alive") is False:
+            since=row.get("orphan_since") or now
+            row=save(slot,row,"unknown","running identity has no live process",orphan_since=since)
+            if not p["paused"] and now-since>=p["ambiguity_grace"] and plan.current(slot):
+                # Ask Antonina to repair its own orphan; never signal a PID.
+                backend.stop(found["id"])
+                row=save(slot,row,"unknown","orphan stop requested","orphan_stop",orphan_since=now)
+            return row
+        return save(slot,row,"unknown","nonterminal or inconsistent backend state")
+    ended=found.get("finished_at") or 0
+    started=found.get("started_at") or 0
+    if row.get("phase")=="running" or ended>row.get("last_finish",0):
+        short=ended-started<p["short_run"] if ended and started else True
+        good=found.get("state")=="clearexit" and not short
+        n=0 if good else row.get("failures",0)+1
+        row=save(slot,row,"vacant","completed" if good else "short or failed invocation",
+                 "finished",last_finish=ended,failures=n,finished_ok=good,
+                 completed_signature=row.get("launched_signature"),vacant_since=now,
+                 intent=None,next_at=now+(p["retry_min"] if good else delay(p,n)))
+        if not good and n>=p["rotate_after"]:
+            # A fresh agent gets the same durable workspace, not a reset
+            # checkout. Do not recycle an exhausted context indefinitely.
+            row=save(slot,row,"vacant","rotate repeatedly short/failed context","rotate",
+                     retired_agent=found["id"],agent=None,created_after=now,
+                     failures=0,next_at=now+p["retry_min"])
+    return row
+
+
+def reconcile(slot,p,roster,history,now=None):
+    now=time.time() if now is None else now
+    row=store.get(slot.key) or {"path":slot.path,"label":slot.label,"gap":slot.gap,
+        "attempt":slot.attempt,"vacant_since":now,"phase":"vacant","failures":0}
+    # A read failure never becomes evidence of absence.
+    try:
+        row=inspect(slot,row,roster,p,now)
+    except ERRORS as exc:
+        return save(slot,row,"unknown","status unavailable: "+type(exc).__name__)
+    if row["phase"]=="running":
+        return row
+    if row["phase"]=="unknown" and row.get("reason") in (
+            "duplicate running identities","stored agent no longer bound to exact workspace",
+            "nonterminal or inconsistent backend state","running observation not confirmed",
+            "duplicate identities uncertain","running identity has no live process","orphan stop requested","running identity moved"):
+        return row
+    if p["paused"]:
+        return save(slot,row,"paused","operator pause")
+    if not plan.current(slot):
+        return save(slot,row,"obsolete","assignment changed")
+    if row.get("next_at",0)>now:
+        return row
+    # A run intent can survive process death, a broken pipe or a timeout.
+    # Exact status above is authoritative; wait before retrying a terminal
+    # status that may predate an in-flight command.
+    intent=row.get("intent")
+    if intent and intent["at"]>now:
+        # Rebase the conservative grace period after a wall-clock rollback.
+        return save(slot,row,"unknown","clock moved backwards; renewing ambiguity grace",
+                    intent={**intent,"at":now},next_at=now+p["ambiguity_grace"])
+    if intent and now-intent["at"]<p["ambiguity_grace"]:
+        return save(slot,row,"unknown","awaiting ambiguous operation reconciliation")
+    if slot.signature and row.get("finished_ok") and row.get("completed_signature")==slot.signature:
+        if now-row.get("last_finish",0)<p["support_refresh"]:
+            return save(slot,row,"completed","current evidence already investigated")
+    try:
+        if not backend.resource_ready():
+            return save(slot,row,"deferred","town resource safety guard",next_at=now+p["retry_min"])
+        if not row.get("agent"):
+            # History must be available and complete before creating a new ID.
+            # Idle orphan creation is harmless; never launch two IDs for a slot.
+            if history is None:
+                return save(slot,row,"unknown","historical roster unavailable")
+            candidates=[a for a in history if backend.same(a,slot.path)]
+            reusable=[]
+            for a in candidates:
+                try:
+                    exact=backend.status(a["id"])
+                except backend.MissingAgent:
+                    continue
+                if not backend.same(exact,slot.path):
+                    return save(slot,row,"unknown","historical identity changed")
+                if backend.live(exact):
+                    return save(slot,row,"running","adopted historical live agent","adopted",
+                                agent=a["id"],intent=None,vacant_since=None,started=exact.get("started_at",now),
+                                activity=exact.get("last_activity_at"),model=exact.get("model"))
+                if not backend.known_terminal(exact):
+                    return save(slot,row,"unknown","historical agent state uncertain")
+                if (exact.get("created_at") or 0)>=row.get("created_after",0):
+                    reusable.append(exact)
+            if reusable:
+                aid=max(reusable,key=lambda a:(a.get("created_at") or 0,a["id"]))["id"]
+                row=save(slot,row,"vacant","adopted exact historical identity","identity",agent=aid,intent=None)
+        backend.prepare(slot)
+        if not plan.current(slot):
+            return save(slot,row,"obsolete","assignment changed during preparation")
+        if not row.get("agent"):
+            row=save(slot,row,"unknown","new identity intent","create_intent",
+                     intent={"op":"new","at":time.time()})
+            aid=backend.new(slot)
+            row=save(slot,row,"vacant","created identity","identity",agent=aid,intent=None)
+        aid=row["agent"]
+        found=backend.status(aid)
+        if not backend.same(found,slot.path):
+            return save(slot,row,"unknown","stored agent no longer bound to exact workspace")
+        if backend.live(found):
+            return save(slot,row,"running","observed before run",agent=aid,intent=None,vacant_since=None)
+        if not backend.known_terminal(found):
+            return save(slot,row,"unknown","nonterminal or inconsistent backend state")
+        if not plan.current(slot):
+            return save(slot,row,"obsolete","assignment changed before run")
+        # A fresh timestamp, not the time the possibly slow preparation began.
+        at=time.time()
+        row=save(slot,row,"unknown","launch intent","run_intent",
+                 intent={"op":"run","at":at},launched_signature=slot.signature,
+                 finished_ok=False,last_finish=max(row.get("last_finish",0),found.get("finished_at") or 0))
+        backend.run(slot,aid)
+        # Ack is not coverage; only a subsequent exact observation is.
+        return save(slot,row,"starting","launch acknowledged","ack",next_at=0)
+    except ERRORS as exc:
+        # No stderr/prompt/credentials in the durable controller journal.
+        return failure(slot,row,p,time.time(),"operation "+type(exc).__name__,
+                       uncertain=bool(row.get("intent")))
diff --git a/missions/pnp/staffing/store.py b/missions/pnp/staffing/store.py
new file mode 100644
index 00000000..149aa1f6
--- /dev/null
+++ b/missions/pnp/staffing/store.py
@@ -0,0 +1,100 @@
+"""Single-controller durable intents, bounded observations and health."""
+import json
+import os
+import sqlite3
+from contextlib import contextmanager
+from pathlib import Path
+import time
+
+from .. import state
+from . import policy
+
+
+def connect():
+    root = policy.root()
+    root.mkdir(parents=True,exist_ok=True,mode=0o700)
+    c = sqlite3.connect(root/"controller.sqlite", timeout=10)
+    c.row_factory = sqlite3.Row
+    c.execute("PRAGMA journal_mode=WAL")
+    c.execute("PRAGMA synchronous=FULL")
+    c.executescript("""
+        CREATE TABLE IF NOT EXISTS slots(key TEXT PRIMARY KEY, data TEXT NOT NULL);
+        CREATE TABLE IF NOT EXISTS events(at REAL, slot TEXT, kind TEXT, detail TEXT);
+        CREATE INDEX IF NOT EXISTS events_at ON events(at);
+        CREATE TABLE IF NOT EXISTS coverage(at REAL PRIMARY KEY, desired INTEGER,
+             running INTEGER, unknown INTEGER, general_desired INTEGER, general_running INTEGER);
+    """)
+    return c
+
+
+@contextmanager
+def db():
+    c = connect()
+    try:
+        with c:
+            yield c
+    finally:
+        c.close()
+
+
+def get(key):
+    with db() as c:
+        r = c.execute("SELECT data FROM slots WHERE key=?",(key,)).fetchone()
+    return json.loads(r[0]) if r else {}
+
+
+def put(key, data, event=None):
+    with db() as c:
+        c.execute("INSERT OR REPLACE INTO slots VALUES(?,?)",(key,json.dumps(data,sort_keys=True)))
+        if event:
+            c.execute("INSERT INTO events VALUES(?,?,?,?)",
+                      (time.time(),key,event,json.dumps({k:data.get(k) for k in
+                        ("agent","phase","reason","failures","next_at")})))
+
+
+def health(data):
+    p = policy.root()/"health.json"
+    state.atomic_write(str(p),json.dumps(data,sort_keys=True,indent=2)+"\n")
+
+
+def read_health():
+    try:
+        x=json.loads((policy.root()/"health.json").read_text())
+        x["age_seconds"]=round(max(0,time.time()-x["at"]),1)
+        x["stale"]=x["age_seconds"]>60
+        if x["stale"]:
+            x["state"]="stale"
+        return x
+    except (OSError,ValueError,KeyError,TypeError):
+        return {"state":"unknown"}
+
+
+def sample(rows, now):
+    general=[r for r in rows if r["label"]=="general"]
+    with db() as c:
+        c.execute("INSERT OR REPLACE INTO coverage VALUES(?,?,?,?,?,?)",
+                  (now,len(rows),sum(r["phase"]=="running" for r in rows),
+                   sum(r["phase"]=="unknown" for r in rows),len(general),
+                   sum(r["phase"]=="running" for r in general)))
+        # Bounded history; slot/intent identity is not discarded.
+        c.execute("DELETE FROM coverage WHERE at<?",(now-7*86400,))
+        c.execute("DELETE FROM events WHERE at<?",(now-30*86400,))
+
+
+def metrics(hours=1):
+    with db() as c:
+        rows=c.execute("SELECT * FROM coverage WHERE at>=? ORDER BY at",(time.time()-hours*3600,)).fetchall()
+        events=dict(c.execute("SELECT kind,count(*) FROM events WHERE at>=? GROUP BY kind",
+                              (time.time()-hours*3600,)).fetchall())
+    # Integrate observed samples; do not fill outages with invented coverage.
+    desired=covered=unknown=unobserved=0.0
+    for a,b in zip(rows,rows[1:]):
+        span=max(0,b["at"]-a["at"])
+        dt=min(60,span)
+        unobserved+=span-dt
+        desired+=dt*a["general_desired"]
+        covered+=dt*a["general_running"]
+        unknown+=dt*a["unknown"]
+    return {"hours":hours,"samples":len(rows),"general_slot_seconds":desired,
+            "general_covered_seconds":covered,"unknown_slot_seconds":unknown,
+            "general_coverage":covered/desired if desired else None,"unobserved_seconds":unobserved,"events":events}
