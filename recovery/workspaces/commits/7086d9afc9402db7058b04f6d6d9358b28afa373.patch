    pnp lbcert: skip desk value/template gaps with no concrete statement
    
    autosolve polled the public desk every 45s and unconditionally read
    g['statement'] for every gap. The desk now publishes 136+ 'kind: value'
    gaps carrying a @@VALUE@@ template with no statement field, so every poll
    died at KeyError 'statement' (200+ consecutive errors since ~10:56Z,
    desk.json/twins.json frozen), disabling lower-bound certificate generation.
    
    Select only entries with a string statement before classification; value
    gaps are not certifiable until the desk resolves them. Verified read-only
    against the live desk: 1972 gaps, 1836 concrete, 136 skipped, 93 lb
    families, 66 twins, clean parse; py_compile OK. No lease or agent action.

diff --git a/missions/pnp/lbcert/autosolve.py b/missions/pnp/lbcert/autosolve.py
index c0ea7d3a..7d85952d 100644
--- a/missions/pnp/lbcert/autosolve.py
+++ b/missions/pnp/lbcert/autosolve.py
@@ -174,16 +174,21 @@ def main():
     while not os.path.exists(os.path.join(WORK, 'STOP')):
         try:
             gaps = json.loads(get(DESK))['gaps']
+            # The desk also publishes unresolved value/template gaps that carry
+            # `template` with @@VALUE@@ holes and no concrete `statement`.
+            # They are not certifiable yet; skip them instead of letting a
+            # KeyError abort the whole poll and disable certificate generation.
+            concrete = [g for g in gaps if isinstance(g.get('statement'), str)]
             pos, twins, desk = {}, {}, {}
             fam = {}
-            for g in gaps:
+            for g in concrete:
                 f = lbparse.family(g['statement'])
                 if f:
                     fam[g['id']] = f
                     desk[g['id']] = g.get('pr_open', 0)
                 if f == 'lb':
                     pos[lbparse.norm(g['statement'])] = g['id']
-            for g in gaps:
+            for g in concrete:
                 m = re.fullmatch(r'¬ ?\((.*)\)', lbparse.norm(g['statement']))
                 if m and m.group(1) in pos:
                     twins[g['id']] = pos[m.group(1)]
