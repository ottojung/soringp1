    Janitor: enable reclaim-quarantined (reclaim_enabled=1) per Act 12.7
    
    Four artifacts passed the Act 12.4 evidence standard and were quarantined
    (verified-safe: 0 unpushed, recoverable). Act 12.7 authorizes the executive to
    set reclaim_enabled=1 for evidence-satisfying actions without further statute.
    Only items already past the quarantine grace window are removed.

diff --git a/government/janitor.conf b/government/janitor.conf
index 31c1a9a7..ecb3a37d 100644
--- a/government/janitor.conf
+++ b/government/janitor.conf
@@ -17,9 +17,14 @@ min_reclaim_age_seconds=86400
 max_log_bytes=1048576
 
 # safe_reclaim_enabled gates the reversible git maintenance and self-temp cleanup.
-# reclaim_enabled gates any future destructive action; there is none in this version.
+# reclaim_enabled gates the destructive reclaim-quarantined step (items past the
+# grace window). Act 12.7: the executive may set this to 1 for evidence-satisfying
+# actions without further statute. Set to 1 on 2026-10-17 by the executive after
+# four artifacts passed the Act 12.4 evidence standard and were quarantined
+# (records/JANITOR-FIRST-RECLAMATION-2026-10-17.md); only items that already
+# passed the quarantine gate are ever removed, and only after quarantine_grace_seconds.
 safe_reclaim_enabled=1
-reclaim_enabled=0
+reclaim_enabled=1
 
 # Minimum size (KB) for a directory to appear in the box inventory.
 inventory_min_kb=102400
