diff --git a/government/suite-env.sh b/government/suite-env.sh
index a646f449..6bd190b1 100755
--- a/government/suite-env.sh
+++ b/government/suite-env.sh
@@ -3,6 +3,8 @@
 # This is an accidental-side-effect barrier, not an OS security sandbox.
 set -eu
 [ "$#" -gt 0 ] || exit 2
+# The tested worktree, not an inherited production root, owns source paths.
+root=$(git rev-parse --show-toplevel) || exit 2
 scratch=$(mktemp -d "${TMPDIR:-/tmp}/viche-test-env.XXXXXXXX")
 trap 'rm -rf "$scratch"' 0
 trap 'exit 130' 1 2 3 15
@@ -18,12 +20,17 @@ XDG_CONFIG_HOME=$scratch/config
 XDG_STATE_HOME=$scratch/state
 XDG_DATA_HOME=$scratch/data
 XDG_CACHE_HOME=$scratch/cache
+VICHE_TOWN_ROOT=$root
 VICHE_STATE_ROOT=$scratch/town-state
 VICHE_SEATS_ROOT=$scratch/seats
 PATH=$scratch/bin:$PATH
 export HOME XDG_CONFIG_HOME XDG_STATE_HOME XDG_DATA_HOME XDG_CACHE_HOME
-export VICHE_STATE_ROOT VICHE_SEATS_ROOT PATH
+export VICHE_TOWN_ROOT VICHE_STATE_ROOT VICHE_SEATS_ROOT PATH
 unset ANTONINA_HOST_XDG_CONFIG_HOME ANTONINA_HOST_XDG_STATE_HOME ANTONINA_HOST_XDG_DATA_HOME
 unset ANTONINA_OPENCODE_XDG_CONFIG_HOME ANTONINA_OPENCODE_XDG_STATE_HOME ANTONINA_OPENCODE_XDG_DATA_HOME
 unset VICHE_ANTONINA_CONFIG VICHE_ANTONINA_COOLDOWNS VICHE_ANTONINA_MODEL_HEALTH VICHE_OPENCODE_MODELS
+unset ANTONINA_OPENCODE_BIN ANTONINA_HOST_XDG_CACHE_HOME ANTONINA_OPENCODE_XDG_CACHE_HOME
+unset VICHE_BUDGET_CONFIG VICHE_BUDGET_DB VICHE_BUDGET_STATE VICHE_BUDGET_TOOL
+unset VICHE_DISPATCH_GATE VICHE_SENTINEL_STATE VICHE_PREDICT_LEDGER
+unset VICHE_SPYING_ALLOWLIST VICHE_SPYING_BOARD_JSON VICHE_SPYING_BUNDLE
 "$@"
