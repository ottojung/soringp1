+fi
+exec "$HOME/.local/bin/node" "$root/relay.mjs" "$@"
diff --git a/missions/relay/pnp-remote-check.py b/missions/relay/pnp-remote-check.py
new file mode 100644
index 00000000..484a56c6
--- /dev/null
+++ b/missions/relay/pnp-remote-check.py
@@ -0,0 +1,143 @@
+#!/usr/bin/env python3
+"""Remote Lean from a bound PnP workspace. Async for expensive iterations."""
+import argparse
+import base64
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+
+ROOT = Path("/var/lib/lubko/wd/viche")
+HOME = Path.home()
+RELAY = str(HOME / ".local/bin/marceline-request")
+
+def load_protocol():
+    sys.path.insert(0, str(ROOT))
+    import missions.pnp
+    # Transitional, independently approved source snapshot, until canonical
+    # remote packer lands. Canonical state/assignment/validator remain in use.
+    if not (ROOT/"missions/pnp/remote/protocol.py").is_file():
+        fallback = HOME/".local/share/viche/relay/pnp-remote-fallback"
+        if (fallback/"remote/protocol.py").is_file():
+            missions.pnp.__path__.append(str(fallback))
+    from missions.pnp.remote import protocol
+    return protocol
+
+def current():
+    from missions.pnp import assignment, focus, state, support
+    cwd = Path.cwd()
+    bound = assignment.binding(cwd)
+    if not bound:
+        raise ValueError("run from a bound research workspace")
+    rec = state.load(bound[0])
+    if not rec or rec["lease"] != bound[1] or not focus.eligible(rec):
+        raise ValueError("obsolete assignment")
+    work = assignment.workspace(cwd)[1].resolve()
+    base = subprocess.check_output(["git", "-C", str(work), "rev-parse", "HEAD"], text=True, timeout=5).strip()
+    toolchain = (work/"lean/lean-toolchain").read_text().strip()
+    return rec, work, base, toolchain, support.attempt(rec)
+
+def availability(base):
+    status = json.loads(subprocess.check_output([RELAY, "status", base], text=True, timeout=15))
+    return status
+
+def scratch(protocol, file, a, binding):
+    rec, work, base, toolchain, attempt = binding
+    source = (Path.cwd()/file).resolve()
+    if not source.is_relative_to(work) or not source.is_file():
+        raise ValueError("file outside bound workspace")
+    with source.open("rb") as f:
+        raw = f.read(512*1024+1)
+    if len(raw)>512*1024:
+        raise ValueError("scratch file exceeds 512 KiB")
+    raw.decode("utf-8")
+    if not protocol.uint(a.wall,1,protocol.MAX_WALL) or not protocol.uint(a.rss_mib,256,protocol.MAX_RSS_MIB):
+        raise ValueError("invalid resource limits")
+    job={"version":1,"mode":"scratch","base":base,"toolchain":toolchain,"attempt":attempt,
+         "wall_seconds":a.wall,"rss_mib":a.rss_mib,"source_sha256":protocol.digest(raw),
+         "source_b64":base64.b64encode(raw).decode("ascii")}
+    job["job"]=protocol.digest(protocol.canonical(job))
+    return job
+
+def record(name):
+    try:
+        from missions.pnp import tools
+        tools.record(name)
+    except (ImportError, AttributeError):
+        # Same bounded evidence format until the independently reviewed tools
+        # inventory lands. No private source or command arguments in telemetry.
+        try:
+            from missions.pnp import assignment, state, support
+            bound=assignment.binding(Path.cwd())
+            if not bound:return
+            rec=state.load(bound[0])
+            if not support.active(rec) or rec["lease"]!=bound[1]:return
+            path=support.directory(rec)/"tool-use"/assignment.worker_label(Path.cwd())/(name+".json")
+            state.atomic_write(str(path),json.dumps({"tool":name,"at":time.time(),"attempt":support.attempt(rec)})+"\n")
+        except Exception:
+            pass
+    except Exception:
+        pass
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("file", type=Path, nargs="?")
+    p.add_argument("--wait", metavar="ID", help="retrieve a submitted Lean check; exit reflects elaboration")
+    p.add_argument("--timeout", type=int, default=1100, help="maximum wait in seconds for --wait")
+    p.add_argument("--availability", action="store_true", help="report current checkout's remote availability and queue")
+    p.add_argument("--scratch", action="store_true", help="check an intermediate Lean file (not a complete proof)")
+    p.add_argument("--async", dest="asynchronous", action="store_true")
+    p.add_argument("--wall", type=int, default=600)
+    p.add_argument("--rss-mib", type=int, default=8192)
+    a = p.parse_args()
+    sys.path.insert(0,str(ROOT))
+    try:
+        if a.wait:
+            proc=subprocess.run([RELAY,"wait",a.wait,str(a.timeout)],stdout=subprocess.PIPE)
+            if proc.returncode:
+                sys.stdout.buffer.write(proc.stdout)
+                return proc.returncode
+            receipt=json.loads(proc.stdout)
+            result=receipt["result"]
+            print(json.dumps(result,ensure_ascii=False))
+            return 0 if result["status"]=="elaborated" and result["exit_code"]==0 else 1
+        binding=current()
+        status=availability(binding[2])
+        if a.availability:
+            print(json.dumps(status))
+            record("remote-availability")
+            return 0 if status.get("base_available") else 1
+        if a.file is None:
+            p.error("FILE required (or --availability / --wait)")
+        if not status.get("base_available"):
+            p.exit(1, "Remote service or exact base unavailable; use local Lean.\n")
+        protocol=load_protocol()
+        if a.scratch:
+            job=scratch(protocol,a.file,a,binding)
+        else:
+            from missions.pnp.remote.__main__ import prepare
+            job=prepare(Path.cwd(),a.file,a.wall,a.rss_mib)
+        if current()[2:] != binding[2:]:
+            raise ValueError("assignment changed during packaging")
+        record("remote-scratch" if a.scratch else "remote-check")
+        with tempfile.TemporaryDirectory(prefix="pnp-remote-job-") as tmp:
+            bundle=Path(tmp)/"job.json"
+            bundle.write_bytes(protocol.canonical(job))
+            bundle.chmod(0o600)
+            if a.asynchronous:
+                return subprocess.call([RELAY,"submit","lean-check",str(bundle)])
+            proc=subprocess.run([RELAY,"lean-check",str(bundle)],stdout=subprocess.PIPE)
+            if proc.returncode:
+                sys.stdout.buffer.write(proc.stdout)
+                return proc.returncode
+            receipt=json.loads(proc.stdout)
+            result=protocol.result(protocol.canonical(receipt["result"]),job)
+            print(json.dumps(receipt,ensure_ascii=False))
+            return 0 if result["status"]=="elaborated" and result["exit_code"]==0 else 1
+    except (ImportError,OSError,ValueError,subprocess.SubprocessError,KeyError) as exc:
+        p.exit(1, f"Remote check unavailable: {type(exc).__name__}: {exc}; use local Lean.\n")
+
+if __name__=="__main__":
+    raise SystemExit(main())
diff --git a/missions/relay/refresh-cache.py b/missions/relay/refresh-cache.py
new file mode 100644
index 00000000..19e4735f
--- /dev/null
+++ b/missions/relay/refresh-cache.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Refresh small exact-base aliases for identical upstream Lean definition trees."""
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+import time
+
+ROOT=Path.home()/".local/share/viche/pnp-remote"
+PATHS=("lean/PEqualNP/Defs","lean/PEqualNP/Defs.lean","lean/lean-toolchain",
+       "lean/lake-manifest.json","lean/lakefile.toml")
+SHA=re.compile(r"[0-9a-f]{40}")
+UPSTREAM="https://github.com/open-goat/pequalnp-proofs.git"
+
+def git(*args):
+    return subprocess.check_output(["git","--git-dir="+str(ROOT/"upstream.git"),*args],
+                                   text=True,timeout=90,stderr=subprocess.DEVNULL).strip()
+
+def atomic(p,value):
+    fd,tmp=tempfile.mkstemp(dir=p.parent)
+    try:
+        with os.fdopen(fd,"w") as f:
+            json.dump(value,f,sort_keys=True)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp,p)
+    finally:
+        if os.path.exists(tmp):os.unlink(tmp)
+
+def fingerprint(rev):
+    value=git("ls-tree",rev,"--",*PATHS)
+    if len(value.splitlines())!=len(PATHS):
+        raise ValueError("incomplete dependency tree")
+    return value
+
+def refresh():
+    directory=ROOT/"manifests"
+    if git("remote","get-url","origin")!=UPSTREAM:
+        raise ValueError("unexpected upstream")
+    git("fetch","--no-tags","origin","+refs/heads/main:refs/heads/main")
+    seeds={}
+    for p in directory.glob("*.provenance.json"):
+        data=json.loads(p.read_text())
+        base=data["base"]
+        if data.get("equivalent_to") or not SHA.fullmatch(base):
+            continue
+        imports=git("grep","-h","^import PEqualNP\\.",base,"--",PATHS[0],PATHS[1])
+        if any(not line.startswith("import PEqualNP.Defs.") for line in imports.splitlines()):
+            continue
+        seeds[fingerprint(base)]=(json.loads((directory/(base+".json")).read_text()),data)
+    if not seeds:raise ValueError("no verified seed caches")
+    recent=git("rev-list","--first-parent","--max-count=160","main").splitlines()
+    count=0
+    for base in recent:
+        m=directory/(base+".json")
+        p=directory/(base+".provenance.json")
+        if m.is_file() and p.is_file():continue
+        seed=seeds.get(fingerprint(base))
+        if seed is None:continue
+        manifest,provenance=seed
+        atomic(p,dict(provenance,base=base,equivalent_to=manifest["base"],dependency_tree=fingerprint(base)))
+        atomic(m,dict(manifest,base=base))
+        count+=1
+    # Keep older aliases for still-running assignments, with a bounded history.
+    aliases=[]
+    for p in directory.glob("*.provenance.json"):
+        data=json.loads(p.read_text())
+        if data.get("equivalent_to") and data["base"] not in recent:
+            aliases.append((p.stat().st_mtime,p,data["base"]))
+    for _,p,base in sorted(aliases,reverse=True)[512:]:
+        (directory/(base+".json")).unlink(missing_ok=True)
+        p.unlink(missing_ok=True)
+    return count
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--loop",action="store_true")
+    args=p.parse_args()
+    while True:
+        try:
+            n=refresh()
+            if n:print("remote cache aliases added:",n,flush=True)
+        except Exception as exc:
+            print("remote cache refresh deferred:",type(exc).__name__,flush=True)
+            if not args.loop:return 1
+        if not args.loop:return 0
+        time.sleep(120)
+
+if __name__=="__main__":
+    raise SystemExit(main())
diff --git a/missions/relay/relay.mjs b/missions/relay/relay.mjs
new file mode 100644
index 00000000..5032ce44
--- /dev/null
+++ b/missions/relay/relay.mjs
@@ -0,0 +1,354 @@
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {spawn} from 'node:child_process';
+import {createCipheriv,createDecipheriv,randomBytes,randomUUID} from 'node:crypto';
+import {setTimeout as sleep} from 'node:timers/promises';
+
+const MAX=4*1024*1024, JOB_MAX=2*1024*1024, TTL=30*60*1000, SKEW=120000, LIMIT=8;
+const MAX_LEAN=2, LEAN_BUDGET=16384;
+const BASE='https://vau.place/_skrynia/store/antonina/';
+const HOME=os.homedir(), HERE=path.dirname(fileURLToPath(import.meta.url));
+const confPath=path.join(HOME,'.config/marceline-relay/config.json');
+const stateRoot=path.join(HOME,'.local/state/marceline-relay');
+const ops=new Set(['ping','lean-check']);
+function config(){
+ const st=fs.lstatSync(confPath);
+ if(!st.isFile()||st.uid!==process.getuid()||(st.mode&0o077))throw Error('private relay config required');
+ const c=JSON.parse(fs.readFileSync(confPath,'utf8'));
+ if(!['key','request','response'].every(k=>/^[0-9a-f]{64}$/.test(c[k]))||c.request===c.response)throw Error('invalid relay config');
+ return c;
+}
+function idok(id){return typeof id==='string'&&/^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/.test(id);}
+function seal(c,box,value){
+ const iv=randomBytes(12),cipher=createCipheriv('aes-256-gcm',Buffer.from(c.key,'hex'),iv);
+ cipher.setAAD(Buffer.from('marceline-relay-v1:'+box+':'+c[box]));
+ const data=Buffer.concat([cipher.update(JSON.stringify(value),'utf8'),cipher.final()]);
+ return JSON.stringify({v:1,iv:iv.toString('base64'),data:data.toString('base64'),tag:cipher.getAuthTag().toString('base64')});
+}
+function open(c,box,raw){
+ try{
+  const e=JSON.parse(raw);
+  if(e.v!==1)throw Error();
+  const iv=Buffer.from(e.iv,'base64'),tag=Buffer.from(e.tag,'base64');
+  if(iv.length!==12||tag.length!==16)throw Error();
+  const d=createDecipheriv('aes-256-gcm',Buffer.from(c.key,'hex'),iv);
+  d.setAAD(Buffer.from('marceline-relay-v1:'+box+':'+c[box]));d.setAuthTag(tag);
+  const v=JSON.parse(Buffer.concat([d.update(Buffer.from(e.data,'base64')),d.final()]));
+  if(v.v!==1||!Array.isArray(v.entries)||v.entries.length>LIMIT)throw Error();
+  const ids=new Set();
+  for(const x of v.entries){
+   if(!x||!idok(x.id)||ids.has(x.id)||!Number.isSafeInteger(x.expires))throw Error();
+   ids.add(x.id);
+   if(box==='request'){
+    if(!ops.has(x.op)||!Number.isSafeInteger(x.created)||x.expires-x.created!==TTL)throw Error();
+    if(x.op==='ping'&&(typeof x.payload!=='string'||Buffer.byteLength(x.payload)>4096))throw Error();
+    if(x.op==='lean-check'&&(!x.payload||typeof x.payload!=='object'||!(/^[0-9a-f]{64}$/.test(x.payload.job))))throw Error();
+   }
+   if(box==='response'&&(!['ack','running','done','error'].includes(x.state)||!Array.isArray(x.events)))throw Error();
+  }
+  return v;
+ }catch{throw Error('relay envelope authentication/schema failed');}
+}
+async function http(c,box,options={}){
+ try{return await fetch(BASE+c[box],{...options,redirect:'error',signal:AbortSignal.timeout(10000)});}
+ catch{throw Error('relay HTTP unavailable');}
+}
+async function get(c,box){
+ const r=await http(c,box,{cache:'no-store'});
+ if(r.status===404){await r.body?.cancel();return {etag:null,value:{v:1,entries:[],heartbeat:null}};}
+ if(r.status!==200||!r.headers.get('etag')){await r.body?.cancel();throw Error('relay read HTTP '+r.status);}
+ const reader=r.body.getReader();let length=0;const chunks=[];
+ for(;;){
+  const {done,value}=await reader.read();if(done)break;length+=value.length;
+  if(length>MAX){await reader.cancel();throw Error('oversized mailbox');}
+  chunks.push(Buffer.from(value));
+ }
+ return {etag:r.headers.get('etag'),value:open(c,box,Buffer.concat(chunks))};
+}
+async function change(c,box,fn){
+ for(let i=0;i<8;i++){
+  const {etag,value}=await get(c,box),next=fn(value);
+  if(!next)return value;
+  const body=seal(c,box,next);if(Buffer.byteLength(body)>MAX)throw Error('mailbox capacity exceeded');
+  const headers={'Content-Type':'application/json',...(etag?{'If-Match':etag}:{'X-Skrynia-Mode':'public-write'})};
+  const r=await http(c,box,{method:etag?'PUT':'POST',headers,body});
+  await r.body?.cancel();
+  if(r.status===(etag?200:201))return next;
+  if(![409,412].includes(r.status))throw Error('relay write HTTP '+r.status);
+  await sleep(50+Math.random()*150);
+ }
+ throw Error('mailbox contention; retry');
+}
+function live(e,now){return Number.isSafeInteger(e.expires)&&e.expires+SKEW>now&&e.expires<=now+TTL+SKEW;}
+function privateDir(root){
+ fs.mkdirSync(root,{recursive:true,mode:0o700});
+ const st=fs.lstatSync(root);
+ if(!st.isDirectory()||st.uid!==process.getuid()||(st.mode&0o077))throw Error('relay state directory must be private');
+ return root;
+}
+function localFile(kind,id){
+ if(!idok(id))throw Error('invalid request ID');
+ return path.join(privateDir(path.join(privateDir(stateRoot),kind)),id+'.json');
+}
+function save(kind,id,value){
+ const dest=localFile(kind,id),tmp=dest+'.'+randomUUID()+'.tmp';
+ try{
+  const fd=fs.openSync(tmp,'wx',0o600);
+  try{fs.writeFileSync(fd,JSON.stringify(value));fs.fsyncSync(fd);}finally{fs.closeSync(fd);}
+  fs.renameSync(tmp,dest);
+  const dir=fs.openSync(path.dirname(dest),'r');try{fs.fsyncSync(dir);}finally{fs.closeSync(dir);}
+ }finally{try{fs.unlinkSync(tmp);}catch(e){if(e.code!=='ENOENT')throw e;}}
+}
+function load(kind,id){
+ try{
+  const p=localFile(kind,id),fd=fs.openSync(p,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW|fs.constants.O_NONBLOCK);
+  try{
+   const st=fs.fstatSync(fd);if(!st.isFile()||st.uid!==process.getuid()||(st.mode&0o077)||st.size>MAX)throw Error('invalid private relay receipt');
+   return JSON.parse(fs.readFileSync(fd,'utf8'));
+  }finally{fs.closeSync(fd);}
+ }catch(e){if(e.code==='ENOENT')return null;throw e;}
+}
+function remove(kind,id){try{fs.unlinkSync(localFile(kind,id));}catch(e){if(e.code!=='ENOENT')throw e;}}
+function pruneLocal(kind,maxAge){
+ const dir=privateDir(path.join(privateDir(stateRoot),kind)),now=Date.now();
+ for(const ent of fs.readdirSync(dir,{withFileTypes:true})){
+  if(!ent.isFile()||!/^[-0-9a-f]{36}\.json$/.test(ent.name))continue;
+  const p=path.join(dir,ent.name);try{if(now-fs.statSync(p).mtimeMs>maxAge)fs.unlinkSync(p);}catch(e){if(e.code!=='ENOENT')throw e;}
+ }
+}
+function makeRequest(op,payload,id=randomUUID(),now=Date.now()){
+ if(!ops.has(op)||!idok(id))throw Error('invalid relay operation or ID');
+ return {id,op,payload,created:now,expires:now+TTL};
+}
+async function enqueue(c,request){
+ if(!live(request,Date.now()))throw Error('request expired');
+ await change(c,'request',v=>{
+  const entries=v.entries.filter(e=>live(e,Date.now()));
+  const old=entries.find(e=>e.id===request.id);
+  if(old){
+   if(JSON.stringify(old)!==JSON.stringify(request))throw Error('request identity conflict');
+   return null;
+  }
+  if(entries.length>=LIMIT)throw Error('relay queue full');
+  return {...v,entries:[...entries,request]};
+ });
+}
+async function cleanup(c,id){
+ await change(c,'request',v=>v.entries.some(e=>e.id===id)?{...v,entries:v.entries.filter(e=>e.id!==id)}:null);
+ remove('requests',id);
+}
+function terminal(e){return e&&['done','error'].includes(e.state);}
+function returnResult(e){
+ console.log(JSON.stringify(e));
+ return e.state==='done'?0:1;
+}
+async function wait(c,id,seconds){
+ if(!idok(id))throw Error('invalid request ID');
+ const cached=load('receipts',id);
+ if(cached){try{await cleanup(c,id);}catch{console.error('cleanup deferred to expiry');}return returnResult(cached);}
+ let last='',lastReport=0,lastBeat=null,lastObserved=null,lastEnqueue=0;
+ const deadline=Date.now()+seconds*1000;
+ while(Date.now()<deadline){
+  if(load('cancelled',id)){try{await cleanup(c,id);}catch{}console.error('request cancelled');return 1;}
+  try{
+   const v=(await get(c,'response')).value,e=v.entries.find(x=>x.id===id);
+   const now=Date.now();
+   if(v.heartbeat!==lastBeat){lastBeat=v.heartbeat;lastObserved=now;}
+   const nextState=e?.state||'waiting_for_ack',changed=nextState!==last;
+   if(changed||now-lastReport>=10000){
+    last=nextState;lastReport=now;
+    console.error(JSON.stringify({id,state:last,heartbeat:v.heartbeat,heartbeat_age_seconds:v.heartbeat?Math.max(0,Math.round((now-v.heartbeat)/1000)):null,
+      heartbeat_observed_seconds:lastObserved===null?null:Math.round((now-lastObserved)/1000),events:changed?e?.events:undefined}));
+   }
+   if(terminal(e)){
+    // Persist before output or cleanup: a restarted client can retrieve the same result.
+    save('receipts',id,e);
+    try{await cleanup(c,id);}catch{console.error('cleanup deferred to expiry');}
+    return returnResult(e);
+   }
+   const request=load('requests',id);
+   if(request&&!e&&!load('cancelled',id)&&now-lastEnqueue>=10000){
+    lastEnqueue=now;
+    await enqueue(c,request);
+    if(load('cancelled',id))await cleanup(c,id);
+   }
+  }catch(e){if(Date.now()-lastReport>=10000){console.error('poll: '+e.message);lastReport=Date.now();}}
+  await sleep(last==='waiting_for_ack'?1000:1500);
+ }
+ console.error('timeout; resume with marceline-request wait '+id);return 2;
+}
+function event(entry,state,message){return {...entry,state,events:[...(entry.events||[]),{at:Date.now(),state,message}].slice(-12)};}
+async function putResponse(c,entry){
+ return change(c,'response',v=>({...v,heartbeat:Date.now(),entries:[...v.entries.filter(e=>e.id!==entry.id),entry]}));
+}
+function leanConfig(){
+ const p=path.join(HOME,'.config/marceline-relay/lean.json');
+ try{
+  const st=fs.lstatSync(p);
+  if(!st.isFile()||st.uid!==process.getuid()||(st.mode&0o077))throw Error('invalid Lean configuration permissions');
+  return p;
+ }catch(e){if(e.code==='ENOENT')return null;throw e;}
+}
+function capabilities(){
+ try{
+  const p=leanConfig();
+  if(!p)return {ping:true,lean_bases:[]};
+  const cfg=JSON.parse(fs.readFileSync(p,'utf8'));
+  const lean_bases=fs.readdirSync(cfg.manifests).filter(x=>/^[0-9a-f]{40}\.json$/.test(x))
+   .filter(x=>{const st=fs.lstatSync(path.join(cfg.manifests,x));return st.isFile()&&st.uid===process.getuid()&&!(st.mode&0o077);})
+   .map(x=>x.slice(0,-5)).filter(base=>{try{const st=fs.lstatSync(path.join(cfg.manifests,base+'.provenance.json'));return st.isFile()&&st.uid===process.getuid()&&!(st.mode&0o077);}catch{return false;}}).sort();
+  return {ping:true,lean_bases,max_parallel_lean:MAX_LEAN};
+ }catch{return {ping:true,lean_bases:[]};}
+}
+function launchLean(req){
+ let configuration;
+ try{configuration=leanConfig();}catch{return {promise:Promise.resolve({error:'invalid Lean operator configuration'}),cancel:()=>{}};}
+ if(!configuration)return {promise:Promise.resolve({error:'remote Lean compiler is not configured'}),cancel:()=>{}};
