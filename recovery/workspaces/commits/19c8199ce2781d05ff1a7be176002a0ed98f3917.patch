@@ -0,0 +1,52 @@
+#!/bin/sh
+set -eu
+root=$(git rev-parse --show-toplevel)
+tmp=${TMPDIR:-/tmp}/viche-evidence-search-$$
+trap 'rm -rf "$tmp"' EXIT HUP INT TERM
+mkdir -p "$tmp/records" "$tmp/government"
+git -C "$tmp" init -q
+git -C "$tmp" config user.name 'Viche test'
+git -C "$tmp" config user.email 'test@example.invalid'
+cat > "$tmp/records/sample.md" <<'EOF'
+Research found a bounded reversible prototype.
+EOF
+cat > "$tmp/government/sample.md" <<'EOF'
+The rule preserves independent review.
+EOF
+git -C "$tmp" add records government
+git -C "$tmp" commit -qm 'test fixture'
+mkdir "$tmp/no-rg-bin"
+ln -s "$(command -v git)" "$tmp/no-rg-bin/git"
+fallback_path=$tmp/no-rg-bin:/usr/bin:/bin
+
+# Exercise the preferred ripgrep route when available.
+if command -v rg >/dev/null 2>&1; then
+    result=$(cd "$tmp" && "$root/government/innovation-evidence-search.sh" 'REVERSIBLE PROTOTYPE')
+    case "$result" in *records/sample.md:1:Research\ found\ a\ bounded\ reversible\ prototype.) ;; *)
+        echo "ripgrep result missing or malformed: $result" >&2; exit 1;;
+    esac
+fi
+
+# Force the Git fallback by hiding the optional rg binary from PATH.
+result=$(cd "$tmp" && PATH=$fallback_path "$root/government/innovation-evidence-search.sh" 'INDEPENDENT REVIEW')
+case "$result" in *government/sample.md:1:The\ rule\ preserves\ independent\ review.) ;; *)
+    echo "git fallback result missing or malformed: $result" >&2; exit 1;;
+esac
+
+if cd "$tmp" && PATH=$fallback_path "$root/government/innovation-evidence-search.sh" 'no matching phrase' >/dev/null 2>&1; then
+    echo 'search unexpectedly succeeded without a match' >&2
+    exit 1
+else
+    status=$?
+    [ "$status" -eq 1 ] || { echo "expected no-match exit 1, got $status" >&2; exit 1; }
+fi
+
+if "$root/government/innovation-evidence-search.sh" >/dev/null 2>&1; then
+    echo 'search unexpectedly accepted an empty query' >&2
+    exit 1
+else
+    status=$?
+    [ "$status" -eq 2 ] || { echo "expected usage exit 2, got $status" >&2; exit 1; }
+fi
+
+echo 'Viche: evidence-search prototype passed (ripgrep when present, Git fallback, no-match and usage behavior)'
