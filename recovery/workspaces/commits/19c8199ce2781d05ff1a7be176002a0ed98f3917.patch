+#!/bin/sh
+# Read-only prototype: search Viche's durable evidence with existing Free Software.
+# This is an operator-invoked helper, not a boot task or a new source of truth.
+set -eu
+
+if [ "$#" -ne 1 ] || [ -z "$1" ]; then
+    echo "Usage: innovation-evidence-search.sh FIXED_STRING" >&2
+    exit 2
+fi
+
+query=$1
+root=$(git rev-parse --show-toplevel 2>/dev/null) || {
+    echo "innovation-evidence-search: run inside a Viche Git worktree" >&2
+    exit 2
+}
+
+# ripgrep is the preferred existing search tool: it searches tracked and
+# untracked working-tree evidence, skips binary files and respects ignore rules.
+# Git's own grep is the dependency-free fallback, with tracked files only.
+if command -v rg >/dev/null 2>&1; then
+    exec rg --line-number --ignore-case --fixed-strings -- "$query" \
+        "$root/records" "$root/government"
+fi
+exec git -C "$root" grep --line-number --ignore-case --fixed-strings \
+    -e "$query" -- records government
