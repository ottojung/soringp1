    Isolate fake native sessions between asynchronous lifecycle test phases

diff --git a/tests/knowledge-host-cpu-lifecycle-smoke.sh b/tests/knowledge-host-cpu-lifecycle-smoke.sh
index c28b636f..fb0334e2 100644
--- a/tests/knowledge-host-cpu-lifecycle-smoke.sh
+++ b/tests/knowledge-host-cpu-lifecycle-smoke.sh
@@ -93,6 +93,8 @@ fi
 # An ordinary production office must not restart until Economy allocates more.
 export VICHE_STATE_ROOT="$tmp/state-second"
 mkdir -p "$VICHE_STATE_ROOT"
+# Each asynchronous monitor inherits only its own fake agent status.
+export TEST_AGENT_STATE="$tmp/agent-second.json"
 # A kill command that exits nonzero or leaves the backend running must
 # NEVER release the cap. Stop verification is independent of kill invocation.
 export TEST_KILL_FAIL=yes
@@ -137,6 +139,8 @@ p=sys.argv[1]; c=json.load(open(p)); c['monitor_interval_seconds']=5; json.dump(
 PY
 export VICHE_STATE_ROOT="$tmp/state-delayed"
 mkdir -p "$VICHE_STATE_ROOT"
+# Each asynchronous monitor inherits only its own fake agent status.
+export TEST_AGENT_STATE="$tmp/agent-delayed.json"
 export TEST_DELAY_CALLS=2
 export TEST_DELAY_COUNT="$tmp/delay-count-delayed"
 : > "$TEST_DELAY_COUNT"
@@ -166,6 +170,8 @@ p=sys.argv[1]; c=json.load(open(p)); c['monitor_interval_seconds']=2; json.dump(
 PY
 export VICHE_STATE_ROOT="$tmp/state-missing"
 mkdir -p "$VICHE_STATE_ROOT"
+# Each asynchronous monitor inherits only its own fake agent status.
+export TEST_AGENT_STATE="$tmp/agent-missing.json"
 export TEST_DELAY_CALLS=999
 export TEST_DELAY_COUNT="$tmp/delay-count-missing"
 : > "$TEST_DELAY_COUNT"
@@ -188,6 +194,8 @@ grep -q 'agent kill' "$TEST_AGENT_KILLS" || {
 unset TEST_DELAY_CALLS
 export VICHE_STATE_ROOT="$tmp/state-unmetered"
 mkdir -p "$VICHE_STATE_ROOT"
+# Each asynchronous monitor inherits only its own fake agent status.
+export TEST_AGENT_STATE="$tmp/agent-unmetered.json"
 printf '{"state":"running","native_session_id":"absent-session"}\n' > "$TEST_AGENT_STATE"
 export TEST_AGENT_KILLS="$tmp/kills-unmetered"
 : > "$TEST_AGENT_KILLS"
