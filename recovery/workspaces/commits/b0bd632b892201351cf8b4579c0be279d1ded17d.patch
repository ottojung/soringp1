 /bin/sh "$d2/town/government/executive-cycle.sh"
 test "$(wc -l < "$OUTPUT")" -eq 3
-if grep -Fq '301' "$PROMPT_FILE"; then echo "generic dispatch superseded the remaining open handoff" >&2; exit 1; fi
