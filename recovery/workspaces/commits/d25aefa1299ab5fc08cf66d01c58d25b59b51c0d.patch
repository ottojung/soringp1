+            for o in context["obligations"]:
+                print(o["id"],"CHECKED" if o.get("verified") else o.get("status","OPEN"),o["statement"][:220].replace("\n"," "))
+        if context.get("knowledge"):
+            print("\nRelevant knowledge:")
