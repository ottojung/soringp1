    Make statistics-trial-design smoke fixture independent of live Act34 activation
    
    Materialize disabled historical Act33 budget and activation rows in the
    hermetic fixture before pinning source hashes, so the DRAFT verifier is
    exercised against inert fixture bytes even when live budget/permits are
    active. Preserve all negative checks; no live permits or activation changed.

diff --git a/tests/statistics-trial-design-smoke.sh b/tests/statistics-trial-design-smoke.sh
index 19f1e8ea..d8da0a41 100644
--- a/tests/statistics-trial-design-smoke.sh
+++ b/tests/statistics-trial-design-smoke.sh
@@ -24,6 +24,16 @@ for i,(key,entry) in enumerate(sorted(d["code_sources"].items())):
         shutil.copy(real,full)
     else:
         open(full,"w").write("fixture code %d\n" % i)
+# Materialize disabled historical Act33-era budget fixture before pinning.
+# The live tree may carry Act34-enabled offices; this smoke exercises the DRAFT
+# trial-design verifier against inert historical bytes only. Negative tests below
+# still flip these fixture flags and must fail closed.
+budget_p=os.path.join(town,"government/knowledge-budget.conf")
+budget=json.load(open(budget_p))
+for row in budget.get("offices",{}).values():
+    if isinstance(row,dict):
+        row["enabled"]=False
+json.dump(budget,open(budget_p,"w"),sort_keys=True,indent=2)
 # Pin the dict to the exact bytes now present in the fixture.
 for entry in d["code_sources"].values():
     p=entry["path"]
@@ -37,6 +47,14 @@ shutil.copytree(os.path.join(repo,"records/knowledge/first-trial-baseline-202611
                 os.path.join(town,"records/knowledge/first-trial-baseline-20261122"))
 shutil.copy(os.path.join(repo,"records/knowledge/activation.json"),
             os.path.join(town,"records/knowledge/activation.json"))
+# Activation fixture: disabled historical Act33 state, independent of live permits.
+act_p=os.path.join(town,"records/knowledge/activation.json")
+act=json.load(open(act_p))
+act.setdefault("offices",{})
+for name in ("statistics","foresight","strategy","spying"):
+    row=act["offices"].setdefault(name,{})
+    row["enabled"]=False
+json.dump(act,open(act_p,"w"),sort_keys=True,indent=2)
 open(os.path.join(town,"government/LAWS.md"),"w").write(
  "## Act 32 — Institutional Knowledge and Communications Act (enacted 2026-11-20)\n"
  "## Act 33 — Prospective Statistics Trial Clarification (enacted 2026-11-22, bill act32-prospective-statistics-trial-amendment)\n"
