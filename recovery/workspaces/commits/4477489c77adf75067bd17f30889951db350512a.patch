+printf '{"generated_by":"government/suite-status.sh","suite":"tests/run-all.sh","result":"green","commit":"%s","tree":"%s","recorded_at":2000,"runs":[{"run":1,"result":"green","exit":0,"output_sha256":"%s"}]}\n' \
