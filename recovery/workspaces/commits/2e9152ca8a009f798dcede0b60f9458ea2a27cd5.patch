 cat > "$town/tests/records-smoke.sh" <<'EOF'
@@ -160,6 +168,21 @@ log=$(jq -r '[.entries[] | select(.branch == "delivery/breaker")] | last | .log'
 grep -q 'records/BREAK with records/ARM' "$log"
