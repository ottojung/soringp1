+p.write_text(s.replace("set -eu\n",'set -eu\n[ "${VICHE_TEST_VERIFY_UNAVAILABLE:-no}" != yes ] || exit 2\n',1))
+PYTEST
 # Suites: red when records/BREAK and records/ARM are both present (green on
