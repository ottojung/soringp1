+
+
+def branch_for(gap_id):
+    """A fresh, deterministic branch name unique to the leased gap."""
+    if not GAP_ID_RE.match(gap_id):
+        raise ValueError("bad gap id")
+    return "pnp/" + gap_id.lower().replace("-", "_")
