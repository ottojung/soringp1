+    "LEASED": {"RESEARCHING", "RELEASED", "STALE", "FAULT"},
+    "RESEARCHING": {"CANDIDATE_READY", "RELEASED", "STALE", "FAULT"},
+    "CANDIDATE_READY": {"LOCAL_CHECKED", "RESEARCHING", "RELEASED",
+                        "STALE", "FAULT"},
+    "LOCAL_CHECKED": {"SIGNED", "RESEARCHING", "RELEASED", "STALE", "FAULT"},
+    "SIGNED": {"PUSHED", "FAULT"},
+    "PUSHED": {"PR_OPEN", "FAULT"},
+    "PR_OPEN": {"ACCEPTED", "REJECTED", "FAULT"},
+    "REJECTED": {"RESEARCHING", "FAULT"},
+    "FAULT": {"RESEARCHING", "RELEASED"},
