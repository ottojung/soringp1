@@ -0,0 +1,117 @@
+"""Nonfatal, idempotent reconciliation after interruption or restart.
+
+Queries remote ground truth (desk, fork, upstream PRs) before retrying.
+Never opens a PR itself and never mistakes a checker verdict for novelty.
+"""
+import re
+import time
+
+from . import config, desk as desk_mod, gitctl, github, state
+
+VERDICT = re.compile(r"\b(ACCEPTED|REJECTED|FAULT)\b")
+
+
+def _heartbeat(gap_id, rec, desk):
+    if not rec.get("lease") or rec["state"] not in (
+            "LEASED", "RESEARCHING", "CANDIDATE_READY", "LOCAL_CHECKED"):
+        return
+    now = time.time()
+    last = rec.get("lease_expires_at") or 0
+    if now < last - config.LEASE_TTL_SECONDS + config.BEAT_INTERVAL_SECONDS:
+        return
+    try:
+        status = desk.beat(rec["lease"])
+    except Exception:
+        return
+    if status == 410:
+        state.transition(gap_id, "STALE", failure_reason="lease returned 410")
+    else:
+        state.update(gap_id, lease_expires_at=now + config.LEASE_TTL_SECONDS)
+
+
+def reconcile_gap(gap_id, desk=None, gh=None, git=None):
+    """Return a short summary; never raise for one bad gap."""
+    desk = desk or desk_mod.Desk()
+    gh = gh or github
+    git = git or gitctl
+    rec = state.load(gap_id)
+    if rec is None:
+        return {"gap": gap_id, "result": "no-state"}
+    if rec["state"] in ("ACCEPTED", "REJECTED", "RELEASED", "STALE"):
+        return {"gap": gap_id, "result": "terminal", "state": rec["state"]}
+
+    _heartbeat(gap_id, rec, desk)
+    rec = state.load(gap_id)
+    if rec["state"] in ("ACCEPTED", "REJECTED", "RELEASED", "STALE"):
+        return {"gap": gap_id, "result": "terminal", "state": rec["state"]}
+
+    branch = rec.get("branch") or config.branch_for(gap_id)
+    remote = git.remote_branch_sha(branch)
+    if remote and rec["state"] == "SIGNED":
+        if remote == rec.get("commit_sha"):
+            state.transition(gap_id, "PUSHED")
+        else:
+            state.transition(gap_id, "FAULT",
+                             failure_reason="remote branch SHA differs")
+    elif not remote and rec["state"] == "PUSHED":
+        # Branch disappeared: do not silently re-push; record for inspection.
+        state.update(gap_id, failure_reason="pushed branch missing at fork")
+
+    number = rec.get("pr_number")
+    if not number:
+        number = gh.pr_exists_for(branch, gap_id)
+    if number:
+        number = int(number)
+        pr = gh.get_pr(number)
+        if rec["state"] in ("PUSHED", "SIGNED", "LOCAL_CHECKED"):
+            state.transition(gap_id, "PR_OPEN", pr_number=number,
+                             pr_url=pr.get("url"),
+                             external_verdict="pending")
+        state.update(gap_id, pr_number=number, pr_url=pr.get("url"))
+        comments = gh.pr_comments(number)
+        verdicts = [(m.get("created_at", ""),
+                     VERDICT.search(m.get("body", "")).group(1))
+                    for m in comments
+                    if VERDICT.search(m.get("body", ""))]
+        if verdicts:
+            verdict = sorted(verdicts)[-1][1]
+            if verdict != "FAULT":
+                state.transition(gap_id, verdict,
+                                 external_verdict=verdict)
+            else:
+                state.update(gap_id, external_verdict="FAULT",
+                             failure_reason="upstream checker FAULT; will recheck")
+    else:
+        # If the desk no longer lists the gap and nothing was submitted, it
+        # is genuinely gone; keep the research record.
+        if rec["state"] == "LEASED" or rec["state"] == "RESEARCHING":
+            try:
+                open_ids = {g.get("id") for g in desk.status().get("gaps", [])
+                            if isinstance(g, dict)}
+            except Exception:
+                open_ids = None
+            if open_ids is not None and gap_id not in open_ids:
+                state.transition(gap_id, "STALE",
+                                 failure_reason="gap no longer posted")
+    rec = state.load(gap_id)
+    state.update(gap_id, last_reconcile=time.strftime("%Y-%m-%dT%H:%M:%SZ",
+                                                      time.gmtime()))
+    return {"gap": gap_id, "result": "ok", "state": rec["state"],
+            "pr": rec.get("pr_number")}
+
+
+def reconcile_all(desk=None, gh=None, git=None):
+    results = []
+    for gap_id in state.all_gaps():
+        try:
+            results.append(reconcile_gap(gap_id, desk=desk, gh=gh, git=git))
+        except Exception as e:                       # nonfatal by construction
+            try:
+                rec = state.load(gap_id)
+                if rec and rec["state"] != "FAULT":
+                    state.transition(gap_id, "FAULT",
+                                     failure_reason="reconcile: %s" % e)
+            except Exception:
+                pass
+            results.append({"gap": gap_id, "result": "error", "detail": str(e)})
+    return results
diff --git a/government/pnp/state.py b/government/pnp/state.py
new file mode 100644
index 00000000..76f32482
--- /dev/null
+++ b/government/pnp/state.py
@@ -0,0 +1,169 @@
+"""Atomic, locked, append-only state for one leased gap at a time.
+
+Every external effect is preceded by a write-ahead intent record; recovery
+queries remote ground truth before retrying anything (see reconcile.py).
+"""
+import contextlib
+import fcntl
+import json
+import os
+import tempfile
+import time
+
+from . import config
+
+EMPTY = {
+    "gap_id": None,
+    "state": "DISCOVERED",
+    "statement": None,
+    "module": None,
+    "path": None,
+    "imports": [],
+    "gap_title": None,
+    "context": None,
+    "dead": None,
+    "lease": None,
+    "lease_obtained_at": None,
+    "lease_expires_at": None,
+    "base_sha": None,
+    "lean_toolchain": config.LEAN_TOOLCHAIN,
+    "researchers": [],
+    "candidate_digest": None,
+    "branch": None,
+    "worktree": None,
+    "commit_sha": None,
+    "pr_number": None,
+    "pr_url": None,
+    "external_verdict": None,
+    "failure_reason": None,
+    "intent": None,
+    "last_reconcile": None,
+    "created_at": None,
+    "updated_at": None,
+}
+
+
+def _now():
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def gap_dir(gap_id):
+    if not config.GAP_ID_RE.match(gap_id):
+        raise ValueError("invalid gap id: %r" % gap_id)
+    return os.path.join(config.GAPS_DIR, gap_id)
+
+
+def state_path(gap_id):
+    return os.path.join(gap_dir(gap_id), "state.json")
+
+
+def events_path(gap_id):
+    return os.path.join(gap_dir(gap_id), "events.jsonl")
+
+
+@contextlib.contextmanager
+def lock(gap_id):
+    d = gap_dir(gap_id)
+    os.makedirs(d, exist_ok=True)
+    fd = os.open(os.path.join(d, ".lock"), os.O_CREAT | os.O_RDWR, 0o600)
+    try:
+        fcntl.flock(fd, fcntl.LOCK_EX)
+        yield
+    finally:
+        fcntl.flock(fd, fcntl.LOCK_UN)
+        os.close(fd)
+
+
+def atomic_write(path, data):
+    d = os.path.dirname(path)
+    os.makedirs(d, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=d)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as f:
+            f.write(data)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp, path)
+    finally:
+        if os.path.exists(tmp):
+            os.unlink(tmp)
+
+
+def load(gap_id):
+    p = state_path(gap_id)
+    if not os.path.exists(p):
+        return None
+    with open(p, encoding="utf-8") as f:
+        return json.load(f)
+
+
+def save(rec):
+    rec["updated_at"] = _now()
+    atomic_write(state_path(rec["gap_id"]),
+                 json.dumps(rec, indent=2, sort_keys=True) + "\n")
+
+
+def event(gap_id, kind, detail=None):
+    rec = {"at": _now(), "kind": kind, "detail": detail or {}}
+    with open(events_path(gap_id), "a", encoding="utf-8") as f:
+        f.write(json.dumps(rec, sort_keys=True) + "\n")
+        f.flush()
+        os.fsync(f.fileno())
+
+
+def create(gap_id, **fields):
+    if load(gap_id) is not None:
+        raise ValueError("gap already exists: " + gap_id)
+    rec = dict(EMPTY)
+    rec.update(fields)
+    rec["gap_id"] = gap_id
+    rec["created_at"] = _now()
+    rec["updated_at"] = rec["created_at"]
+    with lock(gap_id):
+        save(rec)
+        event(gap_id, "created", {"state": rec["state"]})
+    return rec
+
+
+def transition(gap_id, new_state, **fields):
+    with lock(gap_id):
+        rec = load(gap_id)
+        if rec is None:
+            raise KeyError(gap_id)
+        if new_state not in config.ALLOWED.get(rec["state"], set()):
+            raise ValueError("illegal transition %s -> %s" %
+                             (rec["state"], new_state))
+        rec.update(fields)
+        rec["state"] = new_state
+        save(rec)
+        event(gap_id, "state", {"to": new_state, "fields": fields})
+    return rec
+
+
+def update(gap_id, **fields):
+    with lock(gap_id):
+        rec = load(gap_id)
+        if rec is None:
+            raise KeyError(gap_id)
+        rec.update(fields)
+        save(rec)
+        event(gap_id, "update", {"fields": fields})
+    return rec
+
+
+def intent(gap_id, what, payload):
+    """Write-ahead intent before an external effect."""
+    return update(gap_id, intent={"what": what, "at": _now(),
+                                  "payload": payload})
+
+
+def clear_intent(gap_id):
+    return update(gap_id, intent=None)
+
+
+def all_gaps():
+    try:
+        return sorted(d for d in os.listdir(config.GAPS_DIR)
+                      if config.GAP_ID_RE.match(d))
+    except FileNotFoundError:
+        return []
diff --git a/government/pnp/validate.py b/government/pnp/validate.py
new file mode 100644
index 00000000..2a73364c
--- /dev/null
+++ b/government/pnp/validate.py
@@ -0,0 +1,199 @@
+"""Deterministic, offline validation of a candidate Lean file.
+
+A candidate is data, never code: nothing here imports, executes or trusts it.
+Fail closed: any ambiguity is a rejection.
+"""
+import re
+import unicodedata
+
+from . import config
+
+BANNED_DECLARATIONS = (
+    "initialize", "macro", "syntax", "notation", "elab", "native_decide",
+)
+BANNED_AXIOM = re.compile(r"(?<![\w.])axiom\b")
+BANNED_SORRY = re.compile(r"(?<![\w.])sorry\b")
+HASH_COMMAND = re.compile(r"(?m)^\s*#")
+SET_OPTION = re.compile(
+    r"(?m)^\s*set_option\s+([A-Za-z.]+)\s+(\d+)\s+in\s*$")
+ANY_OPTION = re.compile(r"(?<![\w.])set_option\s+([A-Za-z.]+)\b")
+ALLOWED_OPTIONS = {
+    "maxRecDepth", "maxHeartbeats", "synthInstance.maxSize",
+    "synthInstance.maxHeartbeats",
+}
+IMPORT_LINE = re.compile(r"^import\s+([A-Za-z0-9_.]+)\s*$")
+TOKEN = re.compile(r"[A-Za-z0-9_]+|[^\sA-Za-z0-9_]")
+
+
+class InvalidCandidate(Exception):
+    pass
+
+
+def _reject(msg):
+    raise InvalidCandidate(msg)
+
+
+def strip_comments(text):
+    """Remove -- line comments and {-- -} block comments, preserving lines."""
+    out = []
+    i = 0
+    n = len(text)
+    block = False
+    while i < n:
+        if block:
+            if text.startswith("-}", i):
+                block = False
+                i += 2
+                continue
+            out.append("\n" if text[i] == "\n" else " ")
+            i += 1
+            continue
+        if text.startswith("{-", i):
+            block = True
+            i += 2
+            continue
+        if text.startswith("--", i):
+            while i < n and text[i] != "\n":
+                i += 1
+            continue
+        out.append(text[i])
+        i += 1
+    if block:
+        _reject("unterminated block comment")
+    return "".join(out)
+
+
+def comment_text(text):
+    """Collect comment bodies so banned words are rejected there too."""
+    found = []
+    for m in re.finditer(r"--[^\n]*|\{-.*?-\}", text, re.S):
+        found.append(m.group(0))
+    return "\n".join(found)
+
+
+def tokens(text):
+    return TOKEN.findall(unicodedata.normalize("NFKC", text))
+
+
+def validate(gap, candidate_bytes):
+    """Validate byte content against desk metadata.  Return sha256 hex.
+
+    `gap` must contain id, file, module, statement and imports, all obtained
+    independently from the desk/public repository (never from the candidate).
+    """
+    if not isinstance(gap, dict):
+        _reject("gap metadata is not an object")
+    gid = gap.get("id")
+    if not isinstance(gid, str) or not config.GAP_ID_RE.match(gid):
+        _reject("gap id fails the published grammar")
+    path = gap.get("file")
+    if not isinstance(path, str) or not path.startswith("lean/PEqualNP/"):
+        _reject("desk file path is not a PEqualNP Lean file")
+    if not path.endswith(".lean") or not re.match(
+            r"^lean/PEqualNP/[A-Za-z0-9_/]+\.lean$", path):
+        _reject("illegal Lean file path")
+    module = gap.get("module")
+    if not isinstance(module, str) or not re.match(
+            r"^PEqualNP\.[A-Za-z0-9_.]+$", module):
+        _reject("gap module is not a PEqualNP module")
+    statement = gap.get("statement")
+    if not isinstance(statement, str) or not statement.strip():
+        _reject("missing desk statement")
+    imports = gap.get("imports") or []
+    if not isinstance(imports, (list, tuple)):
+        _reject("gap imports is not a list")
+    for imp in imports:
+        if not isinstance(imp, str) or not re.match(
+                r"^(Mathlib|[A-Za-z][A-Za-z0-9_.]*)$", imp):
+            _reject("illegal project import in desk metadata")
+
+    if not isinstance(candidate_bytes, (bytes, bytearray)):
+        _reject("candidate is not raw bytes")
+    if len(candidate_bytes) > config.MAX_FILE_BYTES:
+        _reject("candidate exceeds 512 KiB")
+    try:
+        text = bytes(candidate_bytes).decode("utf-8")
+    except UnicodeDecodeError:
+        _reject("candidate is not UTF-8")
+    if "\x00" in text or '"' in text:
+        _reject("candidate has NUL or double quotes")
+    if not text.strip():
+        _reject("empty candidate")
+
+    code = strip_comments(text)
+    comments = comment_text(text)
+    for word in BANNED_DECLARATIONS + ("sorry", "axiom"):
+        if re.search(r"(?<![\w.])%s\b" % re.escape(word), comments):
+            _reject("banned word %s in comment" % word)
+    if BANNED_SORRY.search(code) or BANNED_SORRY.search(comments):
+        _reject("sorry is forbidden")
+    if BANNED_AXIOM.search(code):
+        _reject("new axiom is forbidden")
+    if "native_decide" in code or HASH_COMMAND.search(code):
+        _reject("command/native_decide is forbidden")
+    for word in BANNED_DECLARATIONS:
+        if re.search(r"(?<![\w.])%s\b" % re.escape(word), code):
+            _reject("forbidden declaration: " + word)
+    for m in ANY_OPTION.finditer(code):
+        if m.group(1) not in ALLOWED_OPTIONS:
+            _reject("unapproved option: " + m.group(1))
+    valid_options = len(ANY_OPTION.findall(code)) == len(SET_OPTION.findall(code))
+    if not valid_options:
+        _reject("set_option must be '<allowed name> <number> in' on its own line")
+    for m in re.finditer(r"@\[([^\]]*)\]", code):
+        attrs = [a.strip() for a in m.group(1).split(",")]
+        for a in attrs:
+            if a not in ("simp", "local simp"):
+                _reject("unapproved attribute: " + a)
+    if re.search(r"(?m)^\s*(attribute|instance)\b", code):
+        _reject("attribute/instance command is forbidden")
+
+    lines = code.splitlines()
+    n = 0
+    while n < len(lines) and not lines[n].strip():
+        n += 1
+    seen_imports = []
+    while n < len(lines):
+        m = IMPORT_LINE.match(lines[n])
+        if not m:
+            break
+        seen_imports.append(m.group(1))
+        n += 1
+    if not seen_imports or seen_imports[0] != "Mathlib":
+        _reject("first import must be Mathlib")
+    allowed_imports = {"Mathlib"} | set(imports)
+    for imp in seen_imports:
+        if imp not in allowed_imports:
+            _reject("unapproved import: " + imp)
+    rest = "\n".join(lines[n:])
+    if re.search(r"(?<![\w.])import\b", rest):
+        _reject("import after the import block")
+    if len(re.findall(r"(?<![\w.])theorem\b", code)) != 1:
+        _reject("exactly one theorem is required")
+
+    pat = re.compile(r"(?<![\w.])theorem\s+" + re.escape(module) +
+                     r"\s*:(.*?):=\s*by\b", re.S)
+    m = pat.search(code)
+    if not m:
+        _reject("theorem with the exact desk module name is missing")
+    if tokens(m.group(1)) != tokens(statement):
+        _reject("theorem statement differs from the posted statement")
+
+    # Helpers must live in a namespace derived from the module; no stray
+    # declarations outside it, and the theorem must be last.
+    namespaces = re.findall(r"(?m)^namespace\s+([A-Za-z0-9_.]+)\s*$", code)
+    for ns in namespaces:
+        if not (ns == module or ns == module + "_aux" or
+                ns.startswith(module + ".")):
+            _reject("helper namespace is not derived from the module")
+    if namespaces:
+        if not re.search(r"(?m)^end\s+" + re.escape(module) +
+                         r"(?:_aux|\.[A-Za-z0-9_.]+)?\s*$", code):
+            _reject("namespace is not closed with its name")
+    tail = code[m.end():]
+    if re.search(r"(?<![\w.])(lemma|theorem|def|abbrev|axiom|namespace)\b",
+                 tail):
+        _reject("the theorem must be the last declaration")
+
+    import hashlib
+    return hashlib.sha256(candidate_bytes).hexdigest()
