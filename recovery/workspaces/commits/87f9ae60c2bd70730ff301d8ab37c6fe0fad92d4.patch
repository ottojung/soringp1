@@ -0,0 +1,34 @@
+{
+  "schema": "act26-prelanding-record/v1",
+  "reviewer": "<seat id, e.g. c1a0000b>",
+  "independence_basis": "<why this reviewer is neither the sponsor nor the Clerk>",
+  "phase": "<phase number and one-line scope>",
+  "bill_id": "<bill or phase identifier, e.g. prelanding-record-ordering-act>",
+  "commit": "<full 40-hex candidate commit>",
+  "tree": "<full 40-hex tree>",
+  "parent": "<full 40-hex parent commit; must equal origin/main at verification>",
+  "main_at_verification": "<full 40-hex origin/main you compared against>",
+  "commands": [
+    {"command": "dash tests/boot-smoke.sh", "exit": 0},
+    {"command": "dash tests/run-all.sh", "exit": 0, "tail": "<last line>"},
+    {"command": "sh tests/records-smoke.sh", "exit": 0}
+  ],
+  "content_assertions": [
+    {
+      "id": "<short-id>",
+      "expected": "<the requirement, quoted from the enacted text or the summons>",
+      "actual": "<what you observed>",
+      "basis": "<the command, file, line or digest that establishes 'actual'>",
+      "result": "pass"
+    }
+  ],
+  "verdict": "pass",
+  "landing_authorisation": "fast_forward_main_to_this_exact_commit_only",
+  "created_at": "<ISO-8601 UTC of writing this record>",
+  "board_pin": {
+    "author": "<reviewer seat id>",
+    "message_id": "<board comment id posted BEFORE the landing>",
+    "server_timestamp": "<board server timestamp of that comment>"
+  },
+  "sha256": "<sha256 of this record file with the sha256 field set to the empty string>"
+}
