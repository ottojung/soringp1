    Require the Clerk as recorder of a case closure artifact
    
    Independent review found the completeness check accepted a self-declared
    artifact whose recorded_by was not clerk, provided its other fields were
    populated. Enforce recorded_by=clerk exactly, in line with the documented
    accountable closure path. Extend the smoke fixture so a Judiciary-attributed
    artifact recorded by the Executive stays unresolved, alongside one with a
    non-Judiciary verifier.

diff --git a/government/institutional-cases.py b/government/institutional-cases.py
index 236813c5..21a6a5db 100644
--- a/government/institutional-cases.py
+++ b/government/institutional-cases.py
@@ -175,10 +175,12 @@ def closure_unsubstantiated(case):
         return True
     if evidence.get("verified_by") != "judiciary":
         return True
+    if evidence.get("recorded_by") != "clerk":
+        return True
     if evidence.get("disposition") not in ("confirmed_resolved", "superseded", "withdrawn"):
         return True
     return not all(nonempty_text(evidence.get(key))
-                   for key in ("verifier", "evidence_ref", "recorded_by"))
+                   for key in ("verifier", "evidence_ref"))
 
 
 def report():
