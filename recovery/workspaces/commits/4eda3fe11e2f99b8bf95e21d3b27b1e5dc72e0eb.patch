diff --git a/government/APPOINTMENT-RECOVERY.md b/government/APPOINTMENT-RECOVERY.md
index 4c2c3140..38307999 100644
--- a/government/APPOINTMENT-RECOVERY.md
+++ b/government/APPOINTMENT-RECOVERY.md
@@ -18,10 +18,15 @@ lock. It captures once per departed agent ID:
   `$VICHE_STATE_ROOT/appointments/terminal-evidence/AGENT_ID/event.json`
   and an append-only `terminal-events.jsonl` convenience index.
 
-Unreachable IDs are explicitly classified as **unreadable**, not counted as
-verified transient failures. Private state is mode 0700/0600. A snapshot
-must be persisted before the registry changes; failures block replacement
-rather than erase evidence.
+If the old agent's status cannot be read, replacement is **refused** rather
+than guessing it has died and creating a second live agent in the same seat.
+Confirmed `failed`, `stopped` and `killed` states permit evidence capture.
+Unavailable log, Git HEAD or worktree-status diagnostics are explicitly
+marked unavailable in the structured event (not silently called successful),
+with ten-second command timeouts and a 128 KiB log excerpt bound. The primary
+per-ID snapshot is authoritative; an interrupted index append is repaired on
+its next idempotent invocation. Private state uses umask 077. A snapshot must
+be persisted before the registry changes; failures block replacement.
 
 **Important limitation:** This safeguard is observational, not an Act 19
 compliance claim. The existing `appointments.sh ensure` still selects a new
diff --git a/government/appointments.sh b/government/appointments.sh
index d4a8e5db..2129ce3e 100644
--- a/government/appointments.sh
+++ b/government/appointments.sh
@@ -44,10 +44,14 @@ fi
 live=false
 if [ -n "$old" ]; then
   case "$old" in *[!a-zA-Z0-9_-]*|'') echo 'invalid stored ID' >&2; exit 1;; esac
-  if meta=$(antonina agent status --id "$old" --json 2>/dev/null); then
-    status=$(printf '%s\n' "$meta" | jq -er '.state') || exit 1
-    case "$status" in running|idle|succeeded) live=true;; failed|stopped|killed) :;; *) echo "unknown status $status" >&2; exit 1;; esac
+  if ! meta=$(antonina agent status --id "$old" --json 2>/dev/null); then
+    # A transient status-query failure is NOT evidence of a dead agent.
+    # Replacing it could create a second live agent on the same worktree.
+    echo "Viche: status of appointed agent $old is unreadable; refuse replacement until a terminal status is proven" >&2
+    exit 1
   fi
+  status=$(printf '%s\n' "$meta" | jq -er '.state') || exit 1
+  case "$status" in running|idle|succeeded) live=true;; failed|stopped|killed) :;; *) echo "unknown status $status" >&2; exit 1;; esac
 fi
 if [ "$action" = resolve ]; then
   [ "$live" = true ] || { echo "no live appointment for $key" >&2; exit 1; }
diff --git a/government/terminal-appointment-evidence.sh b/government/terminal-appointment-evidence.sh
index 3ade22d1..3664f206 100644
--- a/government/terminal-appointment-evidence.sh
+++ b/government/terminal-appointment-evidence.sh
@@ -1,38 +1,75 @@
 #!/bin/sh
-# Preserve terminal appointment evidence BEFORE an Antonina ID is superseded.
-# This is read-only with respect to the old agent and Git worktree; it does NOT
-# claim that replacing an appointee satisfies Act 19's 3-failure reset policy.
+# Durable per-ID terminal evidence before any appointment replacement.
+# Never modify the old agent or worktree. Caller serializes normal mutations.
 set -eu
 [ "$#" -eq 3 ] || { echo 'Usage: terminal-appointment-evidence.sh KEY ID CWD' >&2; exit 2; }
 key=$1 id=$2 cwd=$3
 case "$key:$id" in *[!a-zA-Z0-9_:-]*|'') echo 'Invalid terminal appointment key' >&2; exit 2;; esac
+umask 077
 root=${VICHE_STATE_ROOT:-/var/lib/lubko/wd/viche-state}/appointments
-dest=$root/terminal-evidence/$id
-[ ! -d "$dest" ] || exit 0
 mkdir -p "$root/terminal-evidence"
-umask 077
-tmp=$(mktemp -d "$root/.terminal-XXXXXXXX") || exit 1
-trap 'rm -rf "$tmp"' EXIT HUP INT TERM
-cat > "$tmp/status.json"
-jq -e 'type=="object" and (.state | type=="string")' "$tmp/status.json" >/dev/null ||
-  { echo 'Malformed terminal appointment evidence' >&2; exit 1; }
-state=$(jq -r '.state' "$tmp/status.json")
-case "$state" in
-  failed|killed|stopped|unreadable) : ;;
-  *) echo "Refusing to log nonterminal state: $state" >&2; exit 1 ;;
-esac
-antonina agent log --id "$id" --lines 80 > "$tmp/log-tail.txt" 2>&1 || :
-git -C "$cwd" rev-parse HEAD > "$tmp/worktree-head.txt" 2>/dev/null || printf 'unavailable\n' > "$tmp/worktree-head.txt"
-git -C "$cwd" status --short > "$tmp/worktree-status.txt" 2>/dev/null || :
-jq -cn --arg key "$key" --arg id "$id" --arg cwd "$cwd" \
-  --arg at "$(date -u +%FT%TZ)" --slurpfile m "$tmp/status.json" \
-  '{at:$at, office:$key, agent_id:$id, cwd:$cwd, state:$m[0].state,
-    finished_at:($m[0].finished_at//null), prompts:($m[0].prompts//null),
-    failure_class:($m[0].backend_error.classification//null),
-    transient:($m[0].backend_error.transient),
-    automatic_retry_safe:($m[0].backend_error.automatic_retry_safe),
-    evidence:("terminal-evidence/" + $id)}' > "$tmp/event.json"
-mv "$tmp" "$dest"
-trap - EXIT HUP INT TERM
-cat "$dest/event.json" >> "$root/terminal-events.jsonl"
-echo "Viche: retained terminal appointment $id ($state) before replacement" >&2
+dest=$root/terminal-evidence/$id
+index=$root/terminal-events.jsonl
+
+if [ ! -d "$dest" ]; then
+    tmp=$(mktemp -d "$root/.terminal-XXXXXXXX") || exit 1
+    trap 'rm -rf "$tmp"' EXIT HUP INT TERM
+    cat > "$tmp/status.json"
+    jq -e 'type=="object" and (.state | type=="string")' "$tmp/status.json" >/dev/null ||
+      { echo 'Malformed terminal appointment evidence' >&2; exit 1; }
+    state=$(jq -r '.state' "$tmp/status.json")
+    case "$state" in
+      failed|killed|stopped|unreadable) : ;;
+      *) echo "Refusing to log nonterminal state: $state" >&2; exit 1 ;;
+    esac
+
+    # Diagnostic capture is best-effort, but failure is explicitly recorded.
+    log_ok=false
+    log_truncated=false
+    if timeout 10 antonina agent log --id "$id" --lines 80 > "$tmp/log-tail.txt" 2> "$tmp/log-error.txt"; then
+        log_ok=true
+    fi
+    log_bytes=$(wc -c < "$tmp/log-tail.txt")
+    if [ "$log_bytes" -gt 131072 ]; then
+        head -c 131072 "$tmp/log-tail.txt" > "$tmp/log-limited.txt"
+        mv "$tmp/log-limited.txt" "$tmp/log-tail.txt"
+        log_truncated=true
+    fi
+    head_ok=false
+    if timeout 10 git -C "$cwd" rev-parse HEAD > "$tmp/worktree-head.txt" 2> "$tmp/head-error.txt"; then
+        head_ok=true
+    else
+        printf 'unavailable\n' > "$tmp/worktree-head.txt"
+    fi
+    worktree_ok=false
+    if timeout 10 git -C "$cwd" status --short > "$tmp/worktree-status.txt" 2> "$tmp/worktree-error.txt"; then
+        worktree_ok=true
+    else
+        printf 'UNAVAILABLE: unable to establish worktree status\n' > "$tmp/worktree-status.txt"
+    fi
+
+    jq -cn --arg key "$key" --arg id "$id" --arg cwd "$cwd" \
+      --arg at "$(date -u +%FT%TZ)" --argjson log_ok "$log_ok" \
+      --argjson log_truncated "$log_truncated" --argjson head_ok "$head_ok" \
+      --argjson worktree_ok "$worktree_ok" --slurpfile m "$tmp/status.json" \
+      '{at:$at, office:$key, agent_id:$id, cwd:$cwd, state:$m[0].state,
+        finished_at:($m[0].finished_at//null), prompts:($m[0].prompts//null),
+        failure_class:($m[0].backend_error.classification//null),
+        transient:$m[0].backend_error.transient,
+        automatic_retry_safe:$m[0].backend_error.automatic_retry_safe,
+        log_captured:$log_ok, log_truncated:$log_truncated,
+        worktree_head_captured:$head_ok, worktree_status_captured:$worktree_ok,
+        evidence:("terminal-evidence/" + $id)}' > "$tmp/event.json"
+    mv "$tmp" "$dest"
+    trap - EXIT HUP INT TERM
+fi
+
+# An earlier process may crash after moving the evidence dir but before indexing.
+# The appointment lock serializes these calls; repair the missing index row.
+[ -s "$dest/event.json" ] ||
+  { echo "Incomplete terminal snapshot for $id" >&2; exit 1; }
+if ! { [ -f "$index" ] && grep -Fq "\"agent_id\":\"$id\"" "$index"; }; then
+    cat "$dest/event.json" >> "$index" ||
+      { echo "Could not index terminal evidence for $id" >&2; exit 1; }
+fi
+echo "Viche: retained terminal appointment $id before replacement" >&2
