    Route Act 24 appointment and recovery through the clean office worktree
    
    Independent review of dd25d1f found the clean-worktree change only partial:
    executive-innovation-cycle called branch-bootstrap before creating
    seats/branches/innovation-office; appointments.sh always resolved the stable
    innovation-centre key to the historical legislative worktree; and
    terminal-continuity.sh recorded recovery evidence against that old path. As a
    result the first post-enactment run and any terminal recovery could create the
    agent, capture failure evidence or policy-sync in the preserved historical
    worktree.
    
    Create the office worktree before bootstrap, and redirect the innovation-centre
    key to it (once it exists) in appointments.sh and terminal-continuity.sh.
    branch-bootstrap already redirected; give it the enacted title too.
    
    Extend the institutional smoke to create the office worktree before recovery,
    assert the receipt's worktree_head is the office HEAD (not the historical
    centre HEAD), and exercise the real appointments.sh so the recorded agent-new
    cwd is the office worktree.

diff --git a/government/appointments.sh b/government/appointments.sh
index c6b85f5f..5f702353 100644
--- a/government/appointments.sh
+++ b/government/appointments.sh
@@ -42,6 +42,15 @@ if [ -z "$cwd" ]; then
     *) echo "unknown seat or office $key" >&2; exit 2;;
   esac
   cwd=$seats/branches/$key
+  # Act 24: the stable appointment key remains innovation-centre, but the
+  # active worktree is the clean Executive office once it exists. The
+  # historical legislative worktree is evidence only, never an appointment,
+  # policy-sync or recovery target.
+  if [ "$key" = innovation-centre ] &&
+     { [ -f "$seats/branches/innovation-office/.git" ] ||
+       [ -d "$seats/branches/innovation-office/.git" ]; }; then
+    cwd=$seats/branches/innovation-office
+  fi
 fi
 [ -d "$cwd" ] || { echo "missing worktree $cwd" >&2; exit 1; }
 registry=$root/appointments.tsv
diff --git a/government/branch-bootstrap.sh b/government/branch-bootstrap.sh
index cd224679..2b3c27c0 100755
--- a/government/branch-bootstrap.sh
+++ b/government/branch-bootstrap.sh
@@ -6,7 +6,12 @@ branch=$1
 case "$branch" in
   executive) id=c1e00002; title=Executive ;;
   judiciary) id=c1e00008; title=Judiciary ;;
-  innovation-centre) id=c1e00011; title="Legislative Innovation Centre" ;;
+  innovation-centre)
+    id=c1e00011; title="Legislative Innovation Centre"
+    if grep -Eq '^## Act [0-9]+ — Executive Innovation Office Act \(enacted ' \
+        "${VICHE_TOWN_ROOT:-/var/lib/lubko/wd/viche}/government/LAWS.md" 2>/dev/null; then
+      title="Executive Innovation Office"
+    fi ;;
   *) exit 2 ;;
 esac
 town=${VICHE_TOWN_ROOT:-/var/lib/lubko/wd/viche}
diff --git a/government/executive-innovation-cycle.sh b/government/executive-innovation-cycle.sh
index 08a696a4..6a018b77 100644
--- a/government/executive-innovation-cycle.sh
+++ b/government/executive-innovation-cycle.sh
@@ -13,11 +13,16 @@ root=$state/executive/innovation-office
 # Executive work in its own clean, Git-managed worktree.
 cwd=$seats/branches/innovation-office
 mkdir -p "$root"
-/bin/sh "$town/government/branch-bootstrap.sh" innovation-centre > "$root/bootstrap.log" 2>&1 || exit 1
+# Create the active Executive worktree BEFORE bootstrap. Bootstrap, appointment
+# resolution and terminal recovery all redirect the innovation-centre key to
+# this worktree only once it exists; creating it first prevents the first
+# post-enactment run from recovering or syncing against the historical
+# legislative worktree.
 if [ ! -e "$cwd/.git" ]; then
   [ ! -e "$cwd" ] || { echo "Refusing occupied non-Git Innovation Office workspace" >&2; exit 1; }
   git -C "$town" worktree add --detach "$cwd" HEAD || exit 1
 fi
+/bin/sh "$town/government/branch-bootstrap.sh" innovation-centre > "$root/bootstrap.log" 2>&1 || exit 1
 id=$(/bin/sh "$town/government/appointments.sh" ensure innovation-centre)
 meta=$(antonina agent status --id "$id" --json)
 mode=$(printf '%s\n' "$meta" | jq -r '.state // "unknown"')
diff --git a/government/terminal-continuity.sh b/government/terminal-continuity.sh
index 83b396ea..ce507a03 100644
--- a/government/terminal-continuity.sh
+++ b/government/terminal-continuity.sh
@@ -18,6 +18,13 @@ if [ -r "$town/government/seats.tsv" ] &&
 else
   cwd=$seats/branches/$office
 fi
+# Act 24: continuity for the stable innovation-centre key belongs to the clean
+# Executive office worktree once it exists, not the historical legislative one.
+if [ "$office" = innovation-centre ] &&
+   { [ -f "$seats/branches/innovation-office/.git" ] ||
+     [ -d "$seats/branches/innovation-office/.git" ]; }; then
+  cwd=$seats/branches/innovation-office
+fi
 receipt=$root/reconciliation-$office.json
 
 if [ "$operation" = instruction ]; then
diff --git a/tests/institutional-recovery-smoke.sh b/tests/institutional-recovery-smoke.sh
index 84998b44..c75f6076 100644
--- a/tests/institutional-recovery-smoke.sh
+++ b/tests/institutional-recovery-smoke.sh
@@ -7,6 +7,9 @@ trap 'rm -rf "$d"' EXIT HUP INT TERM
 mkdir -p "$d/bin" "$d/town/government" "$d/seats/branches/innovation-centre" "$d/state/branches" "$d/mock"
 git -C "$d/seats/branches/innovation-centre" init -q
 git -C "$d/seats/branches/innovation-centre" -c user.name=fixture -c user.email=fixture@example.com commit --allow-empty -qm baseline
+mkdir -p "$d/seats/branches/innovation-office"
+git -C "$d/seats/branches/innovation-office" init -q
+git -C "$d/seats/branches/innovation-office" -c user.name=fixture -c user.email=fixture@example.com commit --allow-empty -qm office-baseline
 printf 'old-agent\n' > "$d/mock/registry"
 printf '{"state":"failed","alive":false,"active_runner":false,"native_session_id":"ses_fixture","steers_pending":0,"backend_error":{"transient":true,"automatic_retry_safe":false,"classification":"transient_backend_server_error"}}\n' > "$d/mock/old-agent.json"
 printf '{"state":"idle","alive":false,"active_runner":false}\n' > "$d/mock/new-agent.json"
@@ -25,7 +28,10 @@ MOCK
 cat > "$d/bin/antonina" <<'MOCK'
 #!/bin/sh
 case "$1 $2" in
-  'agent status') cat "$MOCK_ROOT/$4.json" ;;
+  'agent status')
+    if [ "$4" = real-new ]; then printf '{"state":"idle"}\n'
+    else cat "$MOCK_ROOT/$4.json"; fi ;;
+  'agent new') printf '%s\n' "$*" > "$MOCK_ROOT/new-agent-args"; printf 'real-new\n' ;;
   'agent run') printf '%s\n' "$*" >> "$MOCK_ROOT/runs" ;;
   *) exit 6 ;;
 esac
@@ -50,6 +56,12 @@ test ! -e "$MOCK_ROOT/runs"
 test "$(cat "$MOCK_ROOT/registry")" = new-agent
 test "$(wc -l < "$MOCK_ROOT/replacements")" -eq 1
 jq -e '.state=="awaiting_reconciliation" and .previous_agent=="old-agent" and .successor_agent=="new-agent" and .old_session_preserved==true' "$d/state/continuity/reconciliation-innovation-centre.json" >/dev/null
+# Act 24 continuity evidence must point at the clean Executive worktree, not
+# the historical legislative one, while the latter remains intact.
+test "$(jq -r '.worktree_head' "$d/state/continuity/reconciliation-innovation-centre.json")" = \
+  "$(git -C "$d/seats/branches/innovation-office" rev-parse HEAD)"
+test "$(git -C "$d/seats/branches/innovation-centre" rev-parse --verify HEAD)" != \
+  "$(git -C "$d/seats/branches/innovation-office" rev-parse HEAD)"
 /bin/sh "$repo/government/terminal-continuity.sh" recover innovation-centre
 test "$(wc -l < "$MOCK_ROOT/replacements")" -eq 1
 /bin/sh "$repo/government/terminal-continuity.sh" instruction innovation-centre > "$d/reconciliation-prompt"
@@ -106,4 +118,15 @@ test -e "$d/seats/branches/innovation-office/.git"
 # The historical Centre retains its own separate repository and evidence.
 git -C "$d/seats/branches/innovation-centre" rev-parse --verify HEAD >/dev/null
 ! grep -Fq 'permanent LEGISLATIVE' "$MOCK_ROOT/runs"
+# Exercise the real appointment path, not the fixture stub: Act 24's stable
+# key must create the disposable agent in the clean office worktree.
+mkdir -p "$d/real/town/government" "$d/real/seats/branches/innovation-office" "$d/real/state"
+printf 'c1a00001\tClerk\tintake\n' > "$d/real/town/government/seats.tsv"
+printf '## Act 24 — Executive Innovation Office Act (enacted 2026-10-31 by recorded vote)\n' > "$d/real/town/government/LAWS.md"
+git -C "$d/real/seats/branches/innovation-office" init -q
+git -C "$d/real/seats/branches/innovation-office" -c user.name=fixture -c user.email=fixture@example.com commit --allow-empty -qm office
+VICHE_TOWN_ROOT="$d/real/town" VICHE_SEATS_ROOT="$d/real/seats" VICHE_STATE_ROOT="$d/real/state" \
+  PATH="$d/bin:$PATH" /bin/sh "$repo/government/appointments.sh" ensure innovation-centre >/dev/null
+grep -Fq 'innovation-office' "$MOCK_ROOT/new-agent-args"
+! grep -Fq 'innovation-centre' "$MOCK_ROOT/new-agent-args"
 echo 'Institutional continuity + executive innovation gate smoke passed'
