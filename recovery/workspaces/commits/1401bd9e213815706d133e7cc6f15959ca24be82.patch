+def _case_documents():
+    """Return usable case documents, never failing the pass on foreign JSON.
+
+    The store also holds non-case documents (an evidence list, an empty
+    placeholder). Those are skipped. A dict that looks like a case but has no
+    id is malformed: skipping it silently could hide a real obligation, so it
+    is reported on stderr while the pass continues.
+    """
+    cases = []
+    for path in sorted(STORE.glob("*.json")):
+        if path.name == "index.json":
+            continue
+        document = read(path)
+        if not isinstance(document, dict) or not document:
+            continue
+        if document.get("id"):
+            cases.append(document)
+            continue
+        print("institutional-cases: case document without id: {}".format(path.name),
+              file=sys.stderr)
+    return cases
+
+
 def report():
-    cases = [read(p) for p in sorted(STORE.glob("*.json")) if p.name != "index.json"]
-    return [case for case in cases
-            if isinstance(case, dict) and case.get("id") and case.get("state") == "open"]
+    return [case for case in _case_documents() if case.get("state") == "open"]
 
 
