         atomic(path, case)
-    open_cases = [read(p) for p in sorted(STORE.glob("*.json"))]
-    active = [x for x in open_cases if x.get("state") == "open"]
+    records = [x for x in (read(p) for p in sorted(STORE.glob("*.json")))
