    Make free-only dispatch smoke test independent of host config

diff --git a/tests/knowledge-free-dispatch-smoke.sh b/tests/knowledge-free-dispatch-smoke.sh
index a3a57abc..498a6eeb 100755
--- a/tests/knowledge-free-dispatch-smoke.sh
+++ b/tests/knowledge-free-dispatch-smoke.sh
@@ -9,6 +9,14 @@ d=$(mktemp -d)
 trap 'rm -rf "$d"' EXIT HUP INT TERM
 mkdir -p "$d/state/economy" "$d/town/government" "$d/bin"
 cp government/knowledge-practical-bounds.py "$d/town/government/"
+# CI has no actual Antonina global config; create a sentinel and verify that
+# successful and rejected per-invocation dispatches never modify it.
+mkdir -p "$d/global/antonina"
+printf '%s\n' '{"models":[{"model":"global-sentinel"}]}' > "$d/global/antonina/config.json"
+cp "$d/global/antonina/config.json" "$d/global-before.json"
+XDG_CONFIG_HOME="$d/global"
+export XDG_CONFIG_HOME
+
 python3 - "$d/state/economy/model-policy.json" <<'PY'
 import json,sys
 json.dump({"prefer":["opencode/tidepool-alpha-free","opencode-go/hy4-flash-free"],"exclude":[]},open(sys.argv[1],"w"))
@@ -34,7 +42,7 @@ assert all('-free' in e['model'] for e in c['models'])
 PY
 
 # Global ladder is untouched (wrapper works from a temp state root only).
-grep -q 'muse-spark-1.3-contributor' /home/lubko/.config/antonina/config.json ||
+cmp -s "$d/global/antonina/config.json" "$d/global-before.json" ||
   { echo 'FAIL: global config changed' >&2; fail=1; }
 
 # A non-free id in policy prefer is refused (fail closed).
@@ -47,5 +55,7 @@ if CAPTURE="$d/capture2" VICHE_TOWN_ROOT="$d/town" VICHE_STATE_ROOT="$d/state" \
   echo 'FAIL: non-free id admitted' >&2; fail=1
 fi
 
+cmp -s "$d/global/antonina/config.json" "$d/global-before.json" ||
+  { echo 'FAIL: rejected dispatch modified global config' >&2; fail=1; }
 [ "$fail" -eq 0 ] || { echo 'knowledge free dispatch smoke: FAILED' >&2; exit 1; }
 echo 'knowledge free dispatch smoke: OK (XDG pinned, free-only allowlist, global untouched, fail-closed)'
