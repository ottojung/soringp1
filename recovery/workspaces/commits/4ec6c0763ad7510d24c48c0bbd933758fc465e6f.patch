+#!/bin/sh
+# Hermetic tests for Act 27 §3 legacy_no_identity markers and §6(i)-(vii).
+# Synthetic town/state only: no network, no live Viche state.
+set -eu
+repo=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
+scratch=$(mktemp -d)
+trap 'rm -rf "$scratch"' EXIT HUP INT TERM
+mkdir -p "$scratch/bin" "$scratch/state/oversight/random/cases" \
+    "$scratch/state/oversight/random/outcomes" "$scratch/town/records/oversight/corrections"
+printf 'authoritative fixture\n' > "$scratch/charter"
+cat > "$scratch/bin/antonina" <<'MOCK'
+#!/bin/sh
+set -eu
+case "$1 $2" in
+"agent list")
+    printf '{"agents":[],"unreadable":0}\n' ;;
+"agent status")
+    printf '{"state":"idle"}\n' ;;
+*) echo "unexpected mock call: $*" >&2; exit 90 ;;
+esac
+MOCK
+chmod +x "$scratch/bin/antonina"
+PATH=$scratch/bin:$PATH
+VICHE_STATE_ROOT=$scratch/state
+VICHE_TOWN_ROOT=$scratch/town
+VICHE_SEATS_ROOT=$scratch/seats
+VICHE_CONSTITUTION=$scratch/charter
+VICHE_OVERSIGHT_NOW=2000000000
+export PATH VICHE_STATE_ROOT VICHE_TOWN_ROOT VICHE_SEATS_ROOT VICHE_CONSTITUTION VICHE_OVERSIGHT_NOW
+
+CTRL="$repo/government/audit-accountability.py"
+CASE_LEGACY=7750b56b775ed8959a
+CASE_OTHER=edb67f8a646f569b5a
+CASE_NOT_LISTED=222222222222222222
+TOKEN1=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
+TOKEN_MISMATCH=dddddddddddddddddddddddddddddddd
+TRAIL="$scratch/town/records/oversight/corrections/$CASE_LEGACY.jsonl"
+
+git_town() {
+    git -C "$scratch/town" -c user.name=Fixture -c user.email=fixture@example.invalid "$@"
+}
+
+fresh() {
+    rm -rf "$scratch/town" "$scratch/state"
+    mkdir -p "$scratch/state/oversight/random/cases" \
+        "$scratch/state/oversight/random/outcomes" \
+        "$scratch/town/records/oversight/corrections"
+    git -C "$scratch/town" init -q -b main
+    git_town commit --allow-empty -qm 'initial Git state: no correction trails'
+    : > "$scratch/state/oversight/audit-cycle-identities.tsv"
+}
+
+make_case() {
+    printf '{"case_id":"%s","population":"ignored_work","id":"301","at":2000000000}\n' \
+        "$1" > "$scratch/state/oversight/random/cases/$1.json"
+}
+
+base_verdict() {
+    python3 "$CTRL" report --case "$1" --verdict not_assigned \
+        --evidence "original sample $1" >/dev/null
+}
+
+set_token() {
+    printf '%s\n' "$1" > "$scratch/state/oversight/current-audit-cycle"
+    printf '2000000100\t%s\n' "$1" > "$scratch/state/oversight/audit-cycle-identities.tsv"
+}
+
+legacy_trail() {
+    case_id=$1
+    trail="$scratch/town/records/oversight/corrections/$case_id.jsonl"
+    printf '{"at":1792738483,"case_id":"%s","correction":true,"confirmed":false,"verdict":"finding","supersedes":"not_assigned"}\n' \
+        "$case_id" > "$trail"
+    printf '{"at":1792738485,"case_id":"%s","correction":true,"confirmed":true,"verdict":"finding","supersedes":"not_assigned"}\n' \
+        "$case_id" >> "$trail"
+}
+
+commit_town() {
+    git_town add -A
+    git_town commit -qm "$1"
+}
+
+# Build a marker from the trail as it exists. Mode "good" is a complete,
+# independently reviewed marker; "badhash" corrupts one cited hash;
+# "noreview" omits the review record entirely.
+cat > "$scratch/marker.py" <<'PY'
