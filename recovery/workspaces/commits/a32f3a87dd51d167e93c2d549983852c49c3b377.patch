+"""Immutable workspace-to-lease bindings. Researchers never type lease IDs."""
+import hashlib
+import json
+from pathlib import Path
+
+from . import config, state
+
+
+def attempt_id(lease):
+    return hashlib.sha256(lease.encode()).hexdigest()[:24]
+
+
+def workspace(cwd):
+    try:
+        parts = cwd.resolve().relative_to(Path(config.GAPS_DIR).resolve()).parts
+    except ValueError:
+        return None
+    if not parts or not config.GAP_ID_RE.fullmatch(parts[0]):
+        return None
+    root = Path(state.gap_dir(parts[0]))
+    if len(parts) >= 2 and parts[1] == "path":
+        return parts[0], root / "path", root / "research-assignment.json"
+    if len(parts) >= 4 and parts[1] == "attempts" and parts[3] == "path":
+        if len(parts[2]) != 24 or any(c not in "0123456789abcdef" for c in parts[2]):
+            return None
+        parent = root / "attempts" / parts[2]
+        return parts[0], parent / "path", parent / "assignment.json"
+    return None
+
+
+def binding(cwd=None):
+    found = workspace(cwd or Path.cwd())
+    if not found:
+        return None
+    gap, path, marker = found
+    try:
+        obj = json.loads(marker.read_text())
+        if obj.get("gap") != gap or not isinstance(obj.get("lease"), str):
+            return None
+        if marker.name == "assignment.json" and marker.parent.name != attempt_id(obj["lease"]):
+            return None
+        return gap, obj["lease"]
+    except (OSError, ValueError, AttributeError):
+        return None
+
+
+def first_attempt(gap):
+    try:
+        with open(state.events_path(gap), encoding="utf-8") as f:
+            events = [json.loads(line) for line in f]
+        return sum(e.get("kind") == "acquired" for e in events) == 1 and not any(
+            e.get("kind") == "reacquired" for e in events)
+    except (OSError, ValueError, AttributeError):
+        return False
+
+
+def prepare(gap, checkout=True):
+    """Executive calls once per assignment. Never relabel an old checkout."""
+    from . import gitctl
+    if not isinstance(gap, str) or not config.GAP_ID_RE.fullmatch(gap):
+        raise ValueError("invalid gap")
+    with state.lock(gap):
+        rec = state.load(gap)
+        if not rec or rec.get("state") not in ("LEASED", "RESEARCHING") or not rec.get("lease"):
+            raise ValueError("no live research assignment")
+        lease = rec["lease"]
+        root = Path(state.gap_dir(gap))
+        old = root / "path"
+        legacy = root / "research-assignment.json"
+        if old.is_dir() and first_attempt(gap) and not legacy.exists():
+            path, marker = old, legacy
+        elif binding(old) == (gap, lease):
+            path, marker = old, legacy
+        else:
+            parent = root / "attempts" / attempt_id(lease)
+            path, marker = parent / "path", parent / "assignment.json"
+        marker.parent.mkdir(parents=True, exist_ok=True)
+        if marker.exists():
+            if binding(path) != (gap, lease):
+                raise ValueError("workspace binding conflicts; never overwrite")
+        else:
+            state.atomic_write(str(marker), json.dumps({"gap": gap, "lease": lease}) + "\n")
+    if checkout:
+        # Keep network/Git work outside the gap state lock. Do not create a
+        # second worktree if the Executive retries preparation concurrently.
+        import fcntl
+        import os
+        fd = os.open(str(marker) + ".prepare.lock", os.O_CREAT | os.O_RDWR, 0o600)
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            if not (path / ".git").exists():
+                base = gitctl.ensure_mirror()
+                gitctl.run(["git", "--git-dir=" + gitctl.MIRROR, "worktree", "add",
+                            "--detach", str(path), base])
+            gitctl.prepare_build_cache(str(path))
+        except gitctl.GitError as exc:
+            raise ValueError(str(exc)) from exc
+        finally:
+            os.close(fd)
+        latest = state.load(gap)
+        if not latest or latest.get("lease") != lease or latest.get("state") not in ("LEASED", "RESEARCHING"):
+            raise ValueError("assignment ended during checkout preparation")
+    return {"gap": gap, "cwd": str(path), "guard": "python3 /var/lib/lubko/wd/viche/missions/pnp/cli.py guard",
+            "compile": "PYTHONPATH=/var/lib/lubko/wd/viche python3 -m missions.pnp.compile"}
+
+
+def resolve(gap=None, lease=None, cwd=None):
+    """Prefer immutable workspace identity; never adopt a new lease silently."""
+    local = workspace(cwd or Path.cwd())
+    bound = binding(cwd or Path.cwd())
+    if local:
+        if not bound or (gap and gap != bound[0]):
+            raise ValueError("workspace assignment unavailable or wrong gap")
+        # A copied example or the gap itself is not an assignment identifier.
+        if lease and lease not in (gap, bound[0], "LEASE") and lease != bound[1]:
+            raise ValueError("explicit lease conflicts with workspace assignment")
+        return bound
+    if not gap or not config.GAP_ID_RE.fullmatch(gap) or not lease or lease in (gap, "LEASE"):
+        raise ValueError("use the bound research workspace or exact assignment")
+    return gap, lease
diff --git a/missions/pnp/build_control.py b/missions/pnp/build_control.py
new file mode 100644
index 00000000..4e8e17ed
--- /dev/null
+++ b/missions/pnp/build_control.py
@@ -0,0 +1,242 @@
+"""Priority reader/writer queue for PnP Lean builds, not agent sessions."""
+import contextlib
+import fcntl
+import os
+from pathlib import Path
+import time
+
+from . import config, state
+
+GIB = 1024 ** 3
+RESERVE = 2 * GIB
+LIGHT_RSS = 2 * GIB
+HEAVY_MIN = 4 * GIB
+LIGHT_SLOTS = 2
+
+
+class BuildDeferred(Exception):
+    pass
+
+
+class MemoryDeferred(BuildDeferred):
+    def __init__(self, reason, required):
+        super().__init__(reason)
+        self.required = required
+
+
+def lock_path():
+    return os.path.join(config.CACHE_DIR, "publication-build.lock")
+
+
+def priority_path():
+    return os.path.join(config.CACHE_DIR, "publication-priority.lock")
+
+
+def obsolete(gap=None, lease=None):
+    gap = gap or os.environ.get("PNP_PUBLISH_GAP")
+    lease = lease or os.environ.get("PNP_PUBLISH_LEASE")
+    if not gap:
+        return False
+    try:
+        rec = state.load(gap)
+    except (OSError, ValueError, TypeError):
+        return False
+    if not isinstance(rec, dict):
+        return False
+    if lease and rec.get("lease") and lease != rec["lease"]:
+        return True
+    return rec.get("state") in ("STALE", "RELEASED", "ACCEPTED", "PR_OPEN")
+
+
+def try_lock(fd, mode):
+    try:
+        fcntl.flock(fd, mode | fcntl.LOCK_NB)
+        return True
+    except BlockingIOError:
+        return False
+
+
+def legacy_compilers(proc=Path("/proc")):
+    """Detect existing unmanaged PnP compilers; never terminate them here."""
+    try:
+        entries = list(proc.iterdir())
+    except OSError:
+        return []
+    found = []
+    for entry in entries:
+        if not entry.name.isdigit():
+            continue
+        try:
+            if (entry / "comm").read_text().strip() not in ("lean", "lake", "checklemma"):
+                continue
+            cwd = (entry / "cwd").resolve(strict=True)
+            if not any(part in ("pnp", "pnp-work") or part.startswith("pequalnp")
+                       or part.startswith("pnp-") for part in cwd.parts):
+                continue
+            if b"PNP_MANAGED_COMPILER=1" in (entry / "environ").read_bytes().split(b"\0"):
+                continue
+            found.append(int(entry.name))
+        except (OSError, ValueError):
+            continue
+    return found
+
+
+def light_slot():
+    """At most two light reservations, admitted against measured headroom."""
+    for index in range(LIGHT_SLOTS):
+        path = os.path.join(config.CACHE_DIR, "lean-light-%d.lock" % index)
+        fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
+        if try_lock(fd, fcntl.LOCK_EX):
+            return fd, index + 1
+        os.close(fd)
+    return None, LIGHT_SLOTS
+
+
+@contextlib.contextmanager
+def slot(timeout=600, heavy=True, publication=True):
+    """Heavy=exclusive; light=shared; a waiting publisher bars new research."""
+    os.makedirs(config.CACHE_DIR, exist_ok=True)
+    fd = os.open(lock_path(), os.O_CREAT | os.O_RDWR, 0o600)
+    priority = os.open(priority_path(), os.O_CREAT | os.O_RDWR, 0o600)
+    deadline = time.monotonic() + timeout
+    preferred = False
+    light = None
+    try:
+        while True:
+            if obsolete():
+                raise BuildDeferred("compilation assignment ended")
+            # A publisher retains the gate while waiting for existing builds.
+            # Research holds it only during the short admission decision.
+            if not preferred:
+                preferred = try_lock(priority, fcntl.LOCK_EX)
+            if preferred:
+                if try_lock(fd, fcntl.LOCK_EX if heavy else fcntl.LOCK_SH):
+                    free = headroom()
+                    # During migration, defer rather than fighting a legacy
+                    # raw Lean/checklemma process for RAM.
+                    legacy = legacy_compilers()
+                    if heavy:
+                        enough = free is not None and free >= RESERVE + HEAVY_MIN
+                    else:
+                        light, _ = light_slot()
+                        # Reserve both potential light jobs conservatively.
+                        enough = light is not None and free is not None and free >= RESERVE + LIGHT_SLOTS * LIGHT_RSS
+                    if enough and not legacy:
+                        fcntl.flock(priority, fcntl.LOCK_UN)
+                        preferred = False
+                        break
+                    if light is not None:
+                        os.close(light)
+                        light = None
+                    fcntl.flock(fd, fcntl.LOCK_UN)
+                    # If admission fails for memory/legacy reasons, allow
+                    # other requests to re-evaluate; do not monopolize gate.
+                    fcntl.flock(priority, fcntl.LOCK_UN)
+                    preferred = False
+                elif not publication:
+                    fcntl.flock(priority, fcntl.LOCK_UN)
+                    preferred = False
+            if time.monotonic() >= deadline:
+                raise BuildDeferred("Lean queue, legacy compiler or host memory busy; retry later")
+            time.sleep(0.25)
+        yield (fd,) if light is None else (fd, light)
+    finally:
+        if light is not None:
+            os.close(light)
+        os.close(priority)
+        os.close(fd)
+
+
+def busy():
+    """True while a heavy build holds the lock or publication is waiting."""
+    for path in (priority_path(), lock_path()):
+        try:
+            fd = os.open(path, os.O_RDONLY)
+        except FileNotFoundError:
+            continue
+        except OSError:
+            return None
+        try:
+            if not try_lock(fd, fcntl.LOCK_EX):
+                return True
+        except OSError:
+            return None
+        finally:
+            os.close(fd)
+    return False
+
+
+def headroom(root=Path("/sys/fs/cgroup"), meminfo=Path("/proc/meminfo")):
+    """Budget clean, reclaimable cache with a haircut and host-availability cap."""
+    try:
+        maximum = (root / "memory.max").read_text().strip()
+        if maximum == "max":
+            return None
+        limit = int(maximum)
+        current = int((root / "memory.current").read_text())
+        stats = {k: int(v) for k, v in (line.split() for line in
+                 (root / "memory.stat").read_text().splitlines())}
+        if "file" in stats:
+            clean = max(0, stats["file"] - sum(stats.get(k, 0) for k in
+                         ("shmem", "file_dirty", "file_writeback", "unevictable")))
+            reclaimable = clean * 9 // 10 + stats.get("slab_reclaimable", 0) // 2
+        else:
+            reclaimable = stats.get("inactive_file", 0)
+        result = max(0, min(limit, limit - current + reclaimable))
+        # Root cgroup cannot reclaim more memory than the host can supply.
+        try:
+            available = next(int(line.split()[1]) * 1024 for line in
+                             meminfo.read_text().splitlines()
+                             if line.startswith("MemAvailable:"))
+            result = min(result, available)
+        except (OSError, ValueError, StopIteration):
+            pass
+        return result
+    except (OSError, ValueError, TypeError):
+        return None
+
+
+def group_rss(group, proc=Path("/proc")):
+    rss = 0
+    page = os.sysconf("SC_PAGE_SIZE")
+    for entry in proc.iterdir():
+        if not entry.name.isdigit():
+            continue
+        try:
+            fields = (entry / "stat").read_text().rsplit(")", 1)[1].split()
+            if int(fields[2]) == group:
+                rss += max(0, int(fields[21])) * page
+        except (OSError, ValueError, IndexError):
+            continue
+    return rss
+
+
+def memory_reason(group, heavy=True):
+    free = headroom()
+    if free is not None and free < RESERVE:
+        return "host memory reserve threatened"
+    # The light class is deliberately bounded; a larger job belongs in heavy.
+    # No fixed RSS ceiling applies to heavy builds.
+    if not heavy:
+        try:
+            if group_rss(group) > LIGHT_RSS:
+                return "light compilation exceeded 2 GiB; retry as heavy"
+        except OSError:
+            pass
+    return None
+
+
+def resource_ready(rec):
+    required = rec.get("publisher_memory_required")
+    if not required:
+        return True
+    free = headroom()
+    return free is not None and free >= required
+
+
+def oom_count(root=Path("/sys/fs/cgroup")):
+    try:
+        return int(dict(line.split() for line in
+                        (root / "memory.events").read_text().splitlines())["oom_kill"])
+    except (OSError, KeyError, ValueError):
+        return None
diff --git a/missions/pnp/cli.py b/missions/pnp/cli.py
new file mode 100755
index 00000000..8d04861b
--- /dev/null
+++ b/missions/pnp/cli.py
@@ -0,0 +1,227 @@
+#!/usr/bin/env python3
+"""Stable operator interface for the PnP contribution workflow.
+
+    python3 missions/pnp/cli.py status
+    python3 missions/pnp/cli.py acquire [--hard]
+    python3 missions/pnp/cli.py beat <gap-id>
+    python3 missions/pnp/cli.py release <gap-id> <reason>
+    python3 missions/pnp/cli.py submit <gap-id> <candidate-file>
+    python3 missions/pnp/cli.py reconcile
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import sys
+import time
+
+if __package__ in (None, ""):
+    # Support the required direct invocation:
+    #   python3 missions/pnp/cli.py <command>
+    sys.path.insert(0, os.path.abspath(os.path.join(
+        os.path.dirname(__file__), "..", "..")))
+    from missions.pnp import (config, desk as desk_mod, publish,
+                                reconcile, state, jobs, frontier, assignment)
+else:
+    from . import config, desk as desk_mod, publish, reconcile, state, jobs, frontier, assignment
+
+
+def _printer(data):
+    print(json.dumps(data, indent=2, sort_keys=True))
+
+
+def cmd_status(args):
+    d = desk_mod.Desk()
+    docs = d.docs()
+    desk_state = d.status()
+    _printer({
+        "headline": config.HEADER,
+        "open_gaps": desk_state.get("open_gaps"),
+        "held_now": desk_state.get("held_now"),
+        "docs_bytes": len(docs),
+        "leases": [{"gap": g,
+                    "state": state.load(g)["state"],
+                    "expires": state.load(g).get("lease_expires_at")}
+                   for g in state.all_gaps()
+                   if state.load(g).get("lease")],
+        "gaps": [{k: state.load(g).get(k)
+                  for k in ("gap_id", "state", "lease", "branch",
+                            "commit_sha", "pr_number", "external_verdict")}
+                 for g in state.all_gaps()],
+    })
+
+
+def cmd_acquire(args):
+    d = desk_mod.Desk()
+    d.docs(refresh=True)                       # live rules on startup
+    held = sum(1 for g in state.all_gaps()
+               if state.load(g).get("lease") and
+               state.load(g)["state"] not in
+               ("RELEASED", "STALE", "ACCEPTED"))
+    if held >= config.MAX_LEASES:
+        print("refusing to exceed the desk's %d active leases" %
+              config.MAX_LEASES, file=sys.stderr)
+        return 2
+    answer = d.next_gap(hard=args.hard, another=args.another)
+    if answer is None:
+        print("no claimable gap right now; retry later", file=sys.stderr)
+        return 1
+    gap, lease_data = answer["gap"], answer["lease"]
+    lease = lease_data.get("id") if isinstance(lease_data, dict) else lease_data
+    if not isinstance(lease, str) or not lease:
+        print("desk returned a malformed lease", file=sys.stderr)
+        return 2
+    gid = gap.get("id")
+    if not isinstance(gid, str) or not config.GAP_ID_RE.match(gid):
+        print("desk returned a gap id failing the grammar", file=sys.stderr)
+        return 2
+    prior = state.load(gid)
+    if prior is not None:
+        # The desk granted a fresh lease for a gap we have seen before.  The
+        # old behaviour released it with reason 'other', which (per live
+        # join.txt) re-arms a one-hour cooldown and feeds the ten-minute step
+        # rate limit.  With several workers churning acquire/release this
+        # locked the whole handle out of the desk.  Adopt the fresh lease so
+        # the gap can actually be worked; the event log keeps every attempt.
+        if prior["state"] in ("RELEASED", "STALE"):
+            rec = state.reacquire(
+                gid, statement=gap.get("statement"),
+                module=gap.get("module"), path=gap.get("file"),
+                imports=gap.get("imports") or [],
+                gap_title=gap.get("title"),
+                context=gap.get("context"), dead=gap.get("dead"),
+                lease=lease, lease_obtained_at=time.time(),
+                lease_expires_at=time.time() +
+                config.LEASE_TTL_SECONDS)
+            state.event(gid, "acquired", {"hard": bool(args.hard),
+                                          "another": bool(args.another),
+                                          "reacquired": True})
+            _printer({"gap": gid, "file": rec["path"],
+                      "module": rec["module"], "lease": lease,
+                      "reacquired": True, "headline": config.HEADER})
+            return 0
+        # Genuine duplicate: an active lease/PR already exists.  Never
+        # release the spare lease with 'other'/'out_of_time': that triggers
+        # the cooldown and rate limit.  Let the spare lease expire on its own.
+        print("gap already has an active local lease; ignoring spare desk "
+              "lease (it will expire) - never release it as 'other'",
+              file=sys.stderr)
+        return 1
+    rec = state.create(gid, state="DISCOVERED",
+                       statement=gap.get("statement"),
+                       module=gap.get("module"), path=gap.get("file"),
+                       imports=gap.get("imports") or [],
+                       gap_title=gap.get("title"),
+                       context=gap.get("context"), dead=gap.get("dead"),
+                       lease=lease, lease_obtained_at=time.time(),
+                       lease_expires_at=time.time() +
+                       config.LEASE_TTL_SECONDS)
+    state.transition(gid, "LEASED")
+    state.event(gid, "acquired", {"hard": bool(args.hard),
+                                  "another": bool(args.another)})
+    _printer({"gap": gid, "file": rec["path"], "module": rec["module"],
+              "lease": lease, "headline": config.HEADER})
+    return 0
+
+
+def cmd_beat(args):
+    rec = state.load(args.gap)
+    if not rec or not rec.get("lease"):
+        print("no lease for gap", file=sys.stderr)
+        return 2
+    status = desk_mod.Desk().beat(rec["lease"])
+    if status == 410:
+        state.transition(args.gap, "STALE",
+                         failure_reason="lease returned 410")
+        print("lease is gone (410); stop work on this gap", file=sys.stderr)
+        return 1
+    state.update(args.gap, lease_expires_at=time.time() +
+                 config.LEASE_TTL_SECONDS)
+    print("lease renewed")
+    return 0
+
+
+def cmd_release(args):
+    rec = state.load(args.gap)
+    if not rec or not rec.get("lease"):
+        print("no lease for gap", file=sys.stderr)
+        return 2
+    desk_mod.Desk().release(rec["lease"], args.reason)
+    state.transition(args.gap, "RELEASED", failure_reason=args.reason)
+    print("released " + args.gap + " with reason " + args.reason)
+    return 0
+
+
+def cmd_submit(args):
+    try:
+        expected = None
+        for path in (Path.cwd(), Path(args.candidate).resolve().parent):
+            if assignment.workspace(path):
+                gap, lease = assignment.resolve(args.gap, cwd=path)
+                if expected is not None and expected != lease:
+                    raise ValueError("candidate belongs to a different assignment")
+                expected = lease
+        _printer(jobs.submit(args.gap, args.candidate, expected_lease=expected))
+    except (publish.StopPublish, jobs.validate.InvalidCandidate, OSError, ValueError) as exc:
+        print("PUBLISH STOPPED: " + str(exc), file=sys.stderr)
+        return 1
+    return 0
+
+
+def cmd_reconcile(args):
+    _printer(reconcile.reconcile_all())
+    return 0
+
+
+def cmd_guard(args):
+    try:
+        gap, lease = assignment.resolve(args.gap, args.lease)
+        result = frontier.checkpoint(gap, lease)
+    except (OSError, ValueError) as exc:
+        result = {"decision": "wait", "reason": str(exc)}
+    _printer(result)
+    return 0
+
+
+def cmd_assignment(args):
+    try:
+        _printer(assignment.prepare(args.gap))
+        return 0
+    except (OSError, ValueError, RuntimeError) as exc:
+        print("assignment unavailable: " + str(exc), file=sys.stderr)
+        return 1
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(prog="pnp")
+    sub = parser.add_subparsers(dest="cmd", required=True)
+    sub.add_parser("status").set_defaults(fn=cmd_status)
+    acq = sub.add_parser("acquire")
+    acq.add_argument("--hard", action="store_true")
+    acq.add_argument("--another", action="store_true")
+    acq.set_defaults(fn=cmd_acquire)
+    beat = sub.add_parser("beat")
+    beat.add_argument("gap")
+    beat.set_defaults(fn=cmd_beat)
+    rel = sub.add_parser("release")
+    rel.add_argument("gap")
+    rel.add_argument("reason")
+    rel.set_defaults(fn=cmd_release)
+    subp = sub.add_parser("submit")
+    subp.add_argument("gap")
+    subp.add_argument("candidate")
+    subp.set_defaults(fn=cmd_submit)
+    guard = sub.add_parser("guard")
+    guard.add_argument("gap", nargs="?")
+    guard.add_argument("--lease")
+    guard.set_defaults(fn=cmd_guard)
+    bind = sub.add_parser("assignment")
+    bind.add_argument("gap")
+    bind.set_defaults(fn=cmd_assignment)
+    sub.add_parser("reconcile").set_defaults(fn=cmd_reconcile)
+    args = parser.parse_args(argv)
+    return args.fn(args)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/missions/pnp/compile.py b/missions/pnp/compile.py
new file mode 100644
index 00000000..6e571645
--- /dev/null
+++ b/missions/pnp/compile.py
@@ -0,0 +1,109 @@
+"""One supervised entry point for research and publisher Lean compilation."""
+import argparse
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import time
+
+from . import build_control as control, watchdog, state, assignment
+
+
+def command(args):
+    # No use of the upstream mkdir queue from managed builds. Both research
+    # and publisher share the kernel locks above; retain the Lake artifact cache.
+    tool = args[0] if args else ""
+    if tool not in ("lake", "lean"):
+        raise ValueError("expected lake or lean")
+    if tool == "lake" and (len(args) < 2 or args[1] not in ("build", "env", "lean")):
+        raise ValueError("expected lake build, lake env lean or lake lean")
+    if args[:2] == ["lake", "env"] and (len(args) < 3 or args[2] != "lean"):
+        raise ValueError("lake env must run lean")
+    return [os.path.join(os.path.expanduser("~/.elan/bin"), tool)] + args[1:]
+
+
+def run(args, cwd=None, heavy=True, publication=False, timeout=600,
+        output=None, inherited=()):
+    argv = command(args)
+    # Avoid inheriting a researcher's custom path/options in publication.
+    env = {k: v for k, v in os.environ.items()
+           if not (publication and (k.startswith("LEAN_") or k.startswith("LAKE_")
+                                    or k in ("PEQUALNP_IN_QUEUE", "PEQUALNP_REAL_LAKE")))}
+    env.update(PNP_MANAGED_COMPILER="1", LEAN_NUM_THREADS="1", LAKE_ARTIFACT_CACHE="true",
+               LAKE_RESTORE_ARTIFACTS="true",
+               LAKE_CACHE_DIR=os.path.expanduser("~/.pequalnp/lake-cache"))
+    wait = timeout if publication else min(15, timeout)
+    with control.slot(timeout=wait, heavy=heavy, publication=publication) as fds:
+        initial = control.headroom()
+        oom = control.oom_count()
+        proc = subprocess.Popen(argv, cwd=cwd, env=env, stdout=output,
+                                stderr=output, start_new_session=True,
+                                pass_fds=inherited + fds)
+        deadline = time.monotonic() + timeout
+        try:
+            while True:
+                if control.obsolete():
+                    raise control.BuildDeferred("compilation assignment ended")
+                reason = control.memory_reason(proc.pid, heavy=heavy)
+                if reason:
+                    required = (initial or control.HEAVY_MIN + control.RESERVE) + control.GIB // 2
+                    raise control.MemoryDeferred(reason, required)
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise control.BuildDeferred("Lean compilation timed out")
+                try:
+                    code = proc.wait(timeout=min(0.25, remaining))
+                except subprocess.TimeoutExpired:
+                    continue
+                after = control.oom_count()
+                if code and (code in (-signal.SIGKILL, 137) or
+                             (oom is not None and after is not None and after > oom)):
+                    required = (initial or control.HEAVY_MIN + control.RESERVE) + control.GIB // 2
+                    raise control.MemoryDeferred("compiler killed or host OOM during build", required)
+                return code
+        except BaseException:
+            # Only the child group created by this invocation.
+            try:
+                os.killpg(proc.pid, signal.SIGKILL)
+            except ProcessLookupError:
+                pass
+            proc.wait()
+            raise
+
+
+def main(argv=None):
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--light", action="store_true")
+    p.add_argument("--gap")
+    p.add_argument("--lease")
+    p.add_argument("--timeout", type=int, default=600)
+    p.add_argument("args", nargs=argparse.REMAINDER)
+    ns = p.parse_args(argv)
+    local = assignment.workspace(Path.cwd())
+    if local or ns.gap or ns.lease:
+        try:
+            gap, lease = assignment.resolve(ns.gap, ns.lease)
+            rec = state.load(gap)
+            if not isinstance(rec, dict) or rec.get("lease") != lease:
+                raise ValueError("assignment unavailable or superseded")
+            os.environ["PNP_PUBLISH_GAP"] = gap
+            os.environ["PNP_PUBLISH_LEASE"] = lease
+        except (OSError, ValueError) as exc:
+            print("RESOURCE DEFERRED:", exc, file=sys.stderr)
+            return 75
+    args = ns.args[1:] if ns.args[:1] == ["--"] else ns.args
+    def interrupted(signum, frame):
+        raise KeyboardInterrupt
+    signal.signal(signal.SIGTERM, interrupted)
+    try:
+        return run(args, heavy=not ns.light, timeout=max(1, min(ns.timeout, 1800)))
+    except (control.BuildDeferred, KeyboardInterrupt, OSError) as exc:
+        print("RESOURCE DEFERRED:", exc, file=sys.stderr, flush=True)
+        return 75
+    except ValueError as exc:
+        p.error(str(exc))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
