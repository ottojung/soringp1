+                    with build_control.slot(timeout=5):
+                        entered.set()
+                        release.wait(5)
+                except Exception as exc:
+                    errors.append(exc)
+                    entered.set()
+            with build_control.slot(timeout=0, heavy=True, publication=False):
+                thread = threading.Thread(target=publisher)
+                thread.start()
+                try:
+                    deadline = time.monotonic() + 3
+                    while time.monotonic() < deadline:
+                        fd = os.open(build_control.priority_path(), os.O_CREAT | os.O_RDWR, 0o600)
+                        try:
+                            import fcntl
+                            if not build_control.try_lock(fd, fcntl.LOCK_EX):
+                                break
+                        finally:
+                            os.close(fd)
+                        time.sleep(0.025)
+                    else:
+                        self.fail("publisher never took priority gate")
+                    self.assertFalse(entered.is_set())
+                    with self.assertRaises(build_control.BuildDeferred):
+                        with build_control.slot(timeout=0, heavy=False, publication=False):
+                            self.fail("new light build overtook publisher")
+                except BaseException:
+                    release.set()
+                    raise
+            try:
+                self.assertTrue(entered.wait(3))
+                self.assertFalse(errors)
+            finally:
+                release.set()
+                thread.join(5)
+
+    def test_legacy_compiler_and_unknown_memory_defer_admission(self):
+        with tempfile.TemporaryDirectory() as tmp, patch.object(config, "CACHE_DIR", tmp):
+            with patch.object(build_control, "headroom", return_value=12 * build_control.GIB), patch.object(build_control, "legacy_compilers", return_value=[123]):
+                with self.assertRaises(build_control.BuildDeferred):
+                    with build_control.slot(timeout=0):
+                        self.fail("legacy compiler overlaps managed build")
+            with patch.object(build_control, "headroom", return_value=None), patch.object(build_control, "legacy_compilers", return_value=[]):
+                with self.assertRaises(build_control.BuildDeferred):
+                    with build_control.slot(timeout=0):
+                        self.fail("unknown headroom allowed a heavy build")
+
+    def test_supervisor_reaps_its_own_memory_deferred_child(self):
+        from missions.pnp import compile as compiler
+        children = []
+        popen = subprocess.Popen
+        def spawn(*args, **kwargs):
+            proc = popen(*args, **kwargs)
+            children.append(proc)
+            return proc
+        with tempfile.TemporaryDirectory() as tmp, patch.object(config, "CACHE_DIR", tmp), patch.object(build_control, "headroom", return_value=10 * build_control.GIB), patch.object(build_control, "legacy_compilers", return_value=[]), patch.object(build_control, "memory_reason", return_value="simulated pressure"), patch.object(compiler, "command", return_value=[sys.executable, "-c", "import time; time.sleep(30)"]), patch.object(compiler.subprocess, "Popen", side_effect=spawn):
+            with self.assertRaises(build_control.MemoryDeferred):
+                compiler.run(["lean", "scratch.lean"], timeout=3)
+            self.assertEqual(len(children), 1)
+            self.assertIsNotNone(children[0].poll())
+            self.assertFalse(build_control.busy())
+
+    def test_compiler_supervisor_success(self):
+        from missions.pnp import compile as compiler
+        with tempfile.TemporaryDirectory() as tmp, patch.object(config, "CACHE_DIR", tmp), patch.object(build_control, "headroom", return_value=10 * build_control.GIB), patch.object(build_control, "legacy_compilers", return_value=[]), patch.object(compiler, "command", return_value=[sys.executable, "-c", "pass"]):
+            self.assertEqual(compiler.run(["lean", "scratch.lean"], timeout=3), 0)
+            self.assertFalse(build_control.busy())
+
+    def test_resource_blocked_waits_for_more_headroom(self):
+        rec = {"publisher_memory_required": 10 * build_control.GIB}
+        with patch.object(build_control, "headroom", return_value=9 * build_control.GIB):
+            self.assertFalse(build_control.resource_ready(rec))
+        with patch.object(build_control, "headroom", return_value=11 * build_control.GIB):
+            self.assertTrue(build_control.resource_ready(rec))
+        with patch.object(build_control, "headroom", return_value=None):
+            self.assertFalse(build_control.resource_ready(rec))
+        self.assertTrue(build_control.resource_ready({}))
+
+    def test_reuse_requires_exact_publisher_tree(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            def git(*args):
+                return subprocess.run(["git", "-C", tmp, *args], check=True,
+                                      capture_output=True, text=True).stdout.strip()
+            git("init", "-q")
+            pathlib.Path(tmp, "seed").write_text("base")
+            git("add", "seed")
+            git("-c", "user.name=Seed", "-c", "user.email=seed@example.org",
+                "-c", "commit.gpgsign=false", "commit", "-qm", "base")
+            base = git("rev-parse", "HEAD")
+            path = "lean/PEqualNP/Outside/L_meta_582.lean"
+            gitctl.pin_candidate(tmp, path, b"proof")
+            self.assertTrue(gitctl.reusable_checked_tree(tmp, base, path, b"proof"))
+            self.assertFalse(gitctl.reusable_checked_tree(tmp, base, path, b"other"))
+            pathlib.Path(tmp, "seed").write_text("different dependency")
+            self.assertFalse(gitctl.reusable_checked_tree(tmp, base, path, b"proof"))
+
+    def test_real_signed_git_commit(self):
+        # CI environments intentionally lack Otto Jung's private signing key.
+        key = config.SIGNING_KEY.rstrip("!")
+        r = subprocess.run(["gpg", "--batch", "--list-secret-keys", key],
+                           capture_output=True, timeout=10)
+        if r.returncode != 0:
+            self.skipTest("Otto Jung signing key unavailable in this environment")
+        work = pathlib.Path(TMP.name) / "signed"
+        work.mkdir()
+        def git(*args):
+            r = subprocess.run(["git", "-C", str(work), *args],
+                               capture_output=True, text=True, timeout=15)
+            self.assertEqual(r.returncode, 0, r.stderr)
+            return r.stdout.strip()
+        git("init", "-q")
+        (work / "seed").write_text("base\n")
+        git("add", "seed")
+        # Seed locally, without signing; the *new* contribution must be signed.
+        git("-c", "user.name=Seed", "-c", "user.email=seed@example.org",
+            "-c", "commit.gpgsign=false", "commit", "-qm", "seed")
+        base = git("rev-parse", "HEAD")
+        (work / "proof").write_text("proof\n")
+        git("add", "proof")
+        sha = gitctl.signed_commit(str(work), base, "L-meta-582")
+        self.assertEqual(sha, git("rev-parse", "HEAD"))
+        self.assertTrue(gitctl.all_new_commits_signed(str(work), base))
+        self.assertEqual(git("log", "-1", "--format=%ae"), config.AUTHOR_EMAIL)
+
+
+    def test_real_rejected_pr_correction_commit(self):
+        key = config.SIGNING_KEY.rstrip("!")
+        r = subprocess.run(["gpg", "--batch", "--list-secret-keys", key],
+                           capture_output=True, timeout=10)
+        if r.returncode != 0:
+            self.skipTest("Otto Jung signing key unavailable")
+        work = pathlib.Path(TMP.name) / "correction"
+        work.mkdir()
+        def git(*args):
+            r = subprocess.run(["git", "-C", str(work), *args],
+                               capture_output=True, text=True, timeout=15)
+            self.assertEqual(r.returncode, 0, r.stderr)
+            return r.stdout.strip()
+        git("init", "-q")
+        (work / "seed").write_text("base\n")
+        git("add", "seed")
+        git("-c", "user.name=Seed", "-c", "user.email=seed@example.org",
+            "-c", "commit.gpgsign=false", "commit", "-qm", "seed")
+        base = git("rev-parse", "HEAD")
+        proof = "lean/PEqualNP/Outside/L_meta_582.lean"
+        gitctl.pin_candidate(str(work), proof, b"proof version one\n")
+        first = gitctl.signed_commit(str(work), base, "L-meta-582")
+        gitctl.pin_candidate(str(work), proof, b"proof version two\n",
+                             correction=True)
+        second = gitctl.signed_commit(str(work), base, "L-meta-582",
+                                      correction=True)
+        self.assertNotEqual(first, second)
+        self.assertEqual(gitctl.new_commits(str(work), base), [first, second])
+        self.assertTrue(gitctl.all_new_commits_signed(str(work), base))
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
diff --git a/tests/pnp-watchdog-smoke.py b/tests/pnp-watchdog-smoke.py
new file mode 100644
index 00000000..000521a5
--- /dev/null
+++ b/tests/pnp-watchdog-smoke.py
@@ -0,0 +1,191 @@
+#!/usr/bin/env python3
+"""Hermetic tests for exact, lease-scoped compiler reclamation."""
+import fcntl
+import os
+from pathlib import Path
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from missions.pnp import config, state, watchdog, compile as compiler, assignment, frontier
+
+GAP = "L-meta-1662"
+LIVE = "L-meta-1665"
+
+
+class WatchdogTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.patches = patch.multiple(config, GAPS_DIR=str(self.root / "gaps"),
+                                      WORKTREES_DIR=str(self.root / "worktrees"),
+                                      CACHE_DIR=str(self.root / "cache"))
+        self.patches.start()
+        self.addCleanup(self.patches.stop)
+        self.stale = self.worktree(GAP, "STALE")
+        self.live = self.worktree(LIVE, "RESEARCHING")
+        self.unrelated = self.root / "unrelated"
+        self.unrelated.mkdir()
+        self.binary = self.root / "checklemma"
+        # GNU coreutils can be a multicall binary on CI; renaming sleep
+        # then fails before the watchdog test has a live process.
+        shutil.copyfile(sys.executable, self.binary)
+        self.binary.chmod(0o700)
+
+    def worktree(self, gap, status):
+        state.create(gap, state=status, lease="lease-" + gap)
+        cwd = Path(state.gap_dir(gap), "path", "lean")
+        cwd.mkdir(parents=True)
+        return cwd
+
+    def spawn(self, cwd, executable=None, env=None):
+        p = subprocess.Popen(
+            [str(executable), "90"] if executable else
+            [str(self.binary), "-c", "import time; time.sleep(90)"],
+            cwd=cwd, env=(env or os.environ) | {"PYTHONHOME": sys.base_prefix})
+        def cleanup():
+            if p.poll() is None:
+                p.terminate()
+                try:
+                    p.wait(timeout=2)
+                except subprocess.TimeoutExpired:
+                    p.kill()
+                    p.wait()
+        self.addCleanup(cleanup)
+        end = time.monotonic() + 3
+        while time.monotonic() < end:
+            try:
+                if Path("/proc", str(p.pid), "exe").resolve(strict=True) == (executable or self.binary):
+                    break
+            except OSError:
+                pass
+            time.sleep(.02)
+        return p
+
+    def test_exact_stale_compiler_only(self):
+        stale = self.spawn(self.stale)
+        live = self.spawn(self.live)
+        unrelated = self.spawn(self.unrelated)
+        ordinary = self.spawn(self.stale, Path(shutil.which("sleep")).resolve())
+        watchdog.scan()
+        self.assertEqual(stale.wait(timeout=3), -signal.SIGTERM)
+        for child in (live, unrelated, ordinary):
+            self.assertIsNone(child.poll())
+
+    def test_reacquisition_before_signal(self):
+        p = self.spawn(self.stale)
+        entry = Path("/proc", str(p.pid))
+        ident = watchdog.identity(entry)
+        self.assertEqual(ident[0], GAP)
+        state.reacquire(GAP, lease="new-lease")
+        with patch.object(watchdog, "send") as send:
+            self.assertIsNone(watchdog.stop_if_terminal(entry, ident, {}, 0))
+            send.assert_not_called()
+        self.assertIsNone(p.poll())
+
+    def test_orphaned_managed_compiler_on_superseded_lease(self):
+        env = dict(os.environ, PNP_MANAGED_COMPILER="1",
+                   PNP_PUBLISH_GAP=GAP, PNP_PUBLISH_LEASE="lease-" + GAP)
+        old = self.spawn(self.stale, env=env)
+        state.reacquire(GAP, lease="new-lease")
+        current = self.spawn(self.stale, env=dict(env, PNP_PUBLISH_LEASE="new-lease"))
+        watchdog.scan()
+        self.assertEqual(old.wait(timeout=3), -signal.SIGTERM)
+        self.assertIsNone(current.poll())
+
+    def test_unreadable_state_and_busy_lock(self):
+        p = self.spawn(self.stale)
+        lock = os.open(Path(state.gap_dir(GAP), ".lock"), os.O_RDWR)
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            self.assertEqual(watchdog.scan(), {})
+            self.assertIsNone(p.poll())
+        finally:
+            os.close(lock)
+        Path(state.state_path(GAP)).write_text("{broken")
+        self.assertEqual(watchdog.scan(), {})
+        self.assertIsNone(p.poll())
+
+    def test_term_grace_and_kill_only_if_still_obsolete(self):
+        p = self.spawn(self.stale)
+        entry = Path("/proc", str(p.pid))
+        ident = watchdog.identity(entry)
+        with patch.object(watchdog, "send") as send:
+            first = watchdog.stop_if_terminal(entry, ident, {}, 10)
+            self.assertEqual(send.call_args.args[1], signal.SIGTERM)
+            send.reset_mock()
+            watchdog.stop_if_terminal(entry, ident, dict([first]), 11)
+            send.assert_not_called()
+            watchdog.stop_if_terminal(entry, ident, dict([first]), 14)
+            self.assertEqual(send.call_args.args[1], signal.SIGKILL)
+            send.reset_mock()
+            state.reacquire(GAP, lease="new-lease")
+            watchdog.stop_if_terminal(entry, ident, dict([first]), 15)
+            send.assert_not_called()
+
+    def test_mismatched_identity_never_signalled(self):
+        p = self.spawn(self.stale)
+        entry = Path("/proc", str(p.pid))
+        gap, start = watchdog.identity(entry)
+        with patch.object(watchdog, "send") as send:
+            self.assertIsNone(watchdog.stop_if_terminal(entry, (gap, start + 1), {}, 0))
+            send.assert_not_called()
+
+    def test_requires_exact_local_assignment_for_managed_build(self):
+        original = Path.cwd()
+        try:
+            os.chdir(self.live)
+            with patch.object(compiler, "run") as run:
+                self.assertEqual(compiler.main(["--", "lean", "test.lean"]), 75)
+                self.assertEqual(compiler.main(["--gap", GAP, "--lease", "lease-" + GAP,
+                                                "--", "lean", "test.lean"]), 75)
+                self.assertEqual(compiler.main(["--gap", LIVE, "--lease", "wrong",
+                                                "--", "lean", "test.lean"]), 75)
+                run.assert_not_called()
+        finally:
+            os.chdir(original)
+
+    def test_binding_survives_reacquisition_without_adopting_new_lease(self):
+        state.event(LIVE, "acquired")
+        prepared = assignment.prepare(LIVE, checkout=False)
+        cwd = Path(prepared["cwd"])
+        self.assertEqual(cwd, self.live.parent)
+        self.assertEqual(assignment.resolve(cwd=cwd), (LIVE, "lease-" + LIVE))
+        self.assertEqual(assignment.resolve(LIVE, LIVE, cwd=cwd), (LIVE, "lease-" + LIVE))
+        state.transition(LIVE, "STALE")
+        state.reacquire(LIVE, lease="new-lease", lease_expires_at=time.time()+900)
+        new = Path(assignment.prepare(LIVE, checkout=False)["cwd"])
+        self.assertNotEqual(cwd, new)
+        self.assertEqual(assignment.resolve(cwd=cwd), (LIVE, "lease-" + LIVE))
+        self.assertEqual(assignment.resolve(cwd=new), (LIVE, "new-lease"))
+        self.assertEqual(frontier.checkpoint(*assignment.resolve(cwd=cwd))["decision"], "stop")
+        self.assertEqual(frontier.checkpoint(*assignment.resolve(cwd=new))["decision"], "continue")
+        self.assertEqual(watchdog.assignment(new), LIVE)
+
+    def test_missing_or_placeholder_identity_is_not_supersession(self):
+        with self.assertRaises(ValueError):
+            assignment.resolve(LIVE, LIVE, cwd=self.unrelated)
+        with self.assertRaises(ValueError):
+            assignment.resolve(cwd=self.live)
+
+    def test_singleton_ensure(self):
+        os.makedirs(config.CACHE_DIR, exist_ok=True)
+        lock = os.open(watchdog.lock_path(), os.O_CREAT | os.O_RDWR, 0o600)
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            with patch.object(watchdog.subprocess, "Popen") as launch:
+                watchdog.ensure()
+                launch.assert_not_called()
+        finally:
+            os.close(lock)
+
+
+if __name__ == "__main__":
+    unittest.main()
