+"""Deterministic publisher: the ONLY supported authenticated mutation path.
+
+Parameters are strictly (gap id, local candidate file).  Repository, remote,
+branch, author, committer, signing key and PR target are internal constants.
+Recovery queries remote ground truth before retrying any external effect, so a
+restart after SIGNED, PUSHED or PR_OPEN never duplicates a branch or PR.
+"""
+import os
+import time
+
+from . import config, desk as desk_mod, gitctl, github, state, validate, build_control
+
+
+class StopPublish(Exception):
+    """A safety condition stopped publication; the reason is recorded."""
+
+
+def _stop(gap_id, reason):
+    rec = state.load(gap_id)
+    cur = rec["state"]
+    target = "FAULT" if "FAULT" in config.ALLOWED.get(cur, set()) else cur
+    if target != cur:
+        state.transition(gap_id, target, failure_reason=reason)
+    else:
+        state.update(gap_id, failure_reason=reason)
+    raise StopPublish(reason)
+
+
+def _retry_later(gap_id, reason):
+    """Preserve signed/PUSHED state for transient outages, no PR mutation."""
+    state.update(gap_id, failure_reason=reason)
+    raise StopPublish(reason)
+
+
+def _candidate_failed(gap_id, reason):
+    rec = state.load(gap_id)
+    if rec["state"] in ("CANDIDATE_READY", "LOCAL_CHECKED"):
+        state.transition(gap_id, "RESEARCHING", candidate_digest=None,
+                         queued_lease=None, failure_reason=reason)
+    else:
+        state.update(gap_id, queued_lease=None, failure_reason=reason)
+    raise StopPublish(reason)
+
+
+def _open_gap_ids(desk):
+    data = desk.status()
+    return {g.get("id") for g in data.get("gaps", [])
+            if isinstance(g, dict) and g.get("id")}
+
+
+def _read_candidate(path):
+    if not os.path.isfile(path):
+        raise StopPublish("candidate file does not exist")
+    with open(path, "rb") as f:
+        return f.read()
+
+
+def publish(gap_id, candidate_path, desk=None, git=None, gh=None,
+            build_runner=None, signer=None, pusher=None, known_prs=None):
+    """Publish one validated, signed, checked candidate.  Idempotent."""
+    desk = desk or desk_mod.Desk()
+    git = git or gitctl
+    gh = gh or github
+    if not config.GAP_ID_RE.match(gap_id):
+        raise StopPublish("gap id fails the published grammar")
+    rec = state.load(gap_id)
+    if rec is None:
+        raise StopPublish("gap has no state record")
+    if rec["state"] not in ("CANDIDATE_READY", "LOCAL_CHECKED", "SIGNED",
+                            "PUSHED", "REJECTED"):
+        raise StopPublish("state %s is not publishable" % rec["state"])
+    correction = rec["state"] == "REJECTED"
+    resume = rec["state"] in ("SIGNED", "PUSHED")
+
+    # Re-read live instructions at startup; a stale pnp.sh comment is not law.
+    try:
+        desk.docs()
+    except Exception as e:
+        _retry_later(gap_id, "cannot re-read live desk docs: %s" % e)
+
+    # The exact statement comes from the acquired lease. A status listing may
+    # be incomplete; use the authoritative beat instead of a redundant GET.
+    if not rec.get("lease") and not rec.get("pr_number"):
+        _stop(gap_id, "no live assignment or existing PR")
+    gap_meta = {
+        "id": gap_id, "file": rec.get("path"), "module": rec.get("module"),
+        "statement": rec.get("statement"), "imports": rec.get("imports"),
+    }
+    data = _read_candidate(candidate_path)
+    try:
+        digest = validate.validate(gap_meta, data)
+    except validate.InvalidCandidate as e:
+        _candidate_failed(gap_id, "candidate validation failed: %s" % e)
+    if (rec.get("candidate_digest") and
+            rec["candidate_digest"] != digest and not correction):
+        _candidate_failed(gap_id, "candidate digest changed since local check")
+    state.update(gap_id, candidate_digest=digest)
+
+    # Renew the lease before submitting; 410 means someone else settled it.
+    if rec.get("lease") and not correction and not resume and not rec.get("pr_number"):
+        try:
+            if desk.beat(rec["lease"]) == 410:
+                state.stale_lease(gap_id, rec["lease"], "lease returned 410 at submission")
+                raise StopPublish("lease returned 410 at submission")
+        except StopPublish:
+            raise
+        except Exception as e:
+            _retry_later(gap_id, "lease renewal failed: %s" % e)
+        state.update(gap_id, lease_expires_at=time.time() +
+                     config.LEASE_TTL_SECONDS)
+
+    branch = rec.get("branch") or config.branch_for(gap_id)
+    if not resume:
+        base_sha = rec.get("base_sha")
+        worktree = rec.get("worktree")
+        reuse = (rec["state"] == "LOCAL_CHECKED" and not correction
+                 and hasattr(git, "reusable_checked_tree")
+                 and git.reusable_checked_tree(worktree, base_sha, rec["path"], data))
+        if not reuse:
+            try:
+                latest_base = git.ensure_mirror()
+            except Exception as e:
+                _retry_later(gap_id, "upstream checkout unavailable: %s" % e)
+            base_sha = rec.get("base_sha") or latest_base
+            if not base_sha:
+                _stop(gap_id, "correction has no pinned original base")
+            state.update(gap_id, base_sha=base_sha, branch=branch)
+            try:
+                worktree = git.fresh_worktree(gap_id, base_sha, branch)
+            except Exception as e:
+                _retry_later(gap_id, "publication checkout unavailable: %s" % e)
+            state.update(gap_id, worktree=worktree)
+            try:
+                if correction:
+                    git.pin_candidate(worktree, rec["path"], data, correction=True)
+                else:
+                    git.pin_candidate(worktree, rec["path"], data)
+            except Exception as e:
+                _stop(gap_id, "staging failed: %s" % e)
+            try:
+                ok, log = git.build(worktree, rec["module"], rec["statement"],
+                                    runner=build_runner)
+            except build_control.MemoryDeferred as e:
+                state.update(gap_id, publisher_memory_required=e.required)
+                _retry_later(gap_id, "resource deferred: %s" % e)
+            except Exception as e:
+                _retry_later(gap_id, "local build unavailable: %s" % e)
+            if not ok:
+                _candidate_failed(gap_id, "pinned Lean build failed: %s" % log[-300:])
+            if rec["state"] == "CANDIDATE_READY":
+                state.transition(gap_id, "LOCAL_CHECKED", candidate_digest=digest)
+        # A rival may settle the gap during a lengthy build. Renew immediately
+        # before signing/pushing, rather than publishing a known stale proof.
+        if not correction:
+            current = state.load(gap_id)
+            if current["state"] in ("STALE", "RELEASED") or current.get("lease") != rec.get("lease"):
+                raise StopPublish("gap settled during local build")
+            try:
+                live = desk.beat(current["lease"])
+            except Exception as e:
+                _retry_later(gap_id, "lease recheck failed: %s" % e)
+            if live == 410:
+                state.stale_lease(gap_id, current["lease"], "lease lost during build")
+                raise StopPublish("lease lost during build")
+            state.update(gap_id, lease_expires_at=time.time() + config.LEASE_TTL_SECONDS)
+        state.intent(gap_id, "signed_commit",
+                     {"base": base_sha, "path": rec["path"]})
+        try:
+            if correction:
+                sha = git.signed_commit(worktree, base_sha, gap_id,
+                                        signer=signer, correction=True)
+            else:
+                sha = git.signed_commit(worktree, base_sha, gap_id,
+                                        signer=signer)
+        except Exception as e:
+            _stop(gap_id, "signed commit failed: %s" % e)
+        state.clear_intent(gap_id)
+        if correction and not git.all_new_commits_signed(worktree, base_sha):
+            _stop(gap_id, "a PR-range commit is unsigned or misattributed")
+        if correction:
+            state.transition(gap_id, "RESEARCHING")
+            state.transition(gap_id, "CANDIDATE_READY")
+            state.transition(gap_id, "LOCAL_CHECKED")
+        state.transition(gap_id, "SIGNED", commit_sha=sha)
+        expected_commits = (git.new_commits(worktree, base_sha) if correction
+                            and hasattr(git, "new_commits") else [sha])
+    else:
+        sha = rec.get("commit_sha")
+        base_sha = rec.get("base_sha")
+        if not sha or not base_sha:
+            _stop(gap_id, "resume lacks a signed commit or pinned base")
+        expected_commits = [sha]
+
+    # Before any mutation: authenticated identity and remote ground truth.
+    try:
+        gh.identity()
+    except Exception as e:
+        _retry_later(gap_id, "GitHub identity preflight failed: %s" % e)
+    remote = git.remote_branch_sha(branch)
+    if remote == sha:
+        pass                                   # already pushed: recover
+    elif correction and remote == rec.get("commit_sha"):
+        # The fork still carries the rejected, signed commit.  The new
+        # signed commit must descend from it; Git rejects non-FF pushes.
+        state.intent(gap_id, "push_correction",
+                     {"branch": branch, "sha": sha, "previous": remote})
+        try:
+            pushed = git.push_branch(branch, pusher=pusher)
+        except Exception as e:
+            _stop(gap_id, "correction push failed: %s" % e)
+        state.clear_intent(gap_id)
+        if pushed != sha:
+            _stop(gap_id, "correction push returned a different SHA")
+    elif remote is not None:
+        _stop(gap_id, "remote branch differs from our signed commit")
+    elif rec["state"] == "PUSHED":
+        _stop(gap_id, "state says pushed but the fork branch is missing")
+    else:
+        state.intent(gap_id, "push", {"branch": branch, "sha": sha})
+        try:
+            pushed = git.push_branch(branch, pusher=pusher)
+        except Exception as e:
+            _stop(gap_id, "push failed: %s" % e)
+        state.clear_intent(gap_id)
+        if pushed != sha:
+            _stop(gap_id, "pushed SHA differs from signed SHA")
+    if state.load(gap_id)["state"] == "SIGNED":
+        state.transition(gap_id, "PUSHED", commit_sha=sha)
+
+    try:
+        ver = gh.commit_verification(sha)
+    except Exception as e:
+        _retry_later(gap_id, "GitHub verification unavailable: %s" % e)
+    if ver.get("verified") is not True:
+        _retry_later(gap_id, "GitHub signature not yet verified; no PR opened")
+    if (ver.get("name") != config.AUTHOR_NAME or
+            ver.get("email") != config.AUTHOR_EMAIL):
+        _stop(gap_id, "GitHub commit identity mismatch; no PR opened")
+
+    number = rec.get("pr_number") or gh.pr_exists_for(
+        branch, gap_id, api=known_prs)
+    if not number:
+        if not correction:
+            # Recheck only when resuming a signed/pushed proof: the old beat
+            # may no longer be live. Existing PRs can always be recovered.
+            if resume:
+                try:
+                    if desk.beat(rec["lease"]) == 410:
+                        _stop(gap_id, "lease ended before PR creation")
+                except StopPublish:
+                    raise
+                except Exception as exc:
+                    _retry_later(gap_id, "lease recheck failed: %s" % exc)
+        state.intent(gap_id, "create_pr", {"branch": branch, "gap": gap_id})
+        try:
+            number = gh.create_pr(branch, gap_id)
+        except Exception as e:
+            _retry_later(gap_id, "PR creation failed; reconcile before retry: %s" % e)
+        state.clear_intent(gap_id)
+    number = int(number)
+    pr, problems = gh.validate_created(number, sha, rec["path"],
+                                       expected_commits=expected_commits)
+    if problems:
+        _stop(gap_id, "post-create PR validation failed: " + "; ".join(problems))
+    if rec.get("lease") and not correction and not rec.get("pr_number"):
+        try:
+            desk.release(rec["lease"], "submitted")
+        except Exception as e:
+            state.update(gap_id, failure_reason="release retry needed: %s" % e)
+    if state.load(gap_id)["state"] in ("PUSHED", "SIGNED", "LOCAL_CHECKED"):
+        state.transition(gap_id, "PR_OPEN", pr_number=number,
+                         pr_url=pr.get("url"), external_verdict="pending",
+                         queued_lease=None, failure_reason=None)
+    else:
+        state.update(gap_id, pr_number=number, pr_url=pr.get("url"),
+                     external_verdict="pending", queued_lease=None)
+    state.event(gap_id, "published", {"sha": sha, "pr": number,
+                                      "digest": digest})
+    return {"gap": gap_id, "sha": sha, "pr": number, "url": pr.get("url"),
+            "digest": digest}
+
+
+def correct(gap_id, candidate_path, **kwargs):
+    """Allowed correction: fixed file, same PR, every new commit signed."""
+    return publish(gap_id, candidate_path, **kwargs)
diff --git a/missions/pnp/reconcile.py b/missions/pnp/reconcile.py
new file mode 100644
index 00000000..852889ca
--- /dev/null
+++ b/missions/pnp/reconcile.py
@@ -0,0 +1,141 @@
+"""Nonfatal, idempotent reconciliation after interruption or restart.
+
+Queries remote ground truth (desk, fork, upstream PRs) before retrying.
+Never opens a PR itself and never mistakes a checker verdict for novelty.
+"""
+import os
+import re
+import time
+
+from . import config, desk as desk_mod, gitctl, github, state, frontier
+
+VERDICT = re.compile(r"\b(ACCEPTED|REJECTED|FAULT)\b")
+
+
+def _heartbeat(gap_id, rec, desk, force=False):
+    if not rec.get("lease") or rec["state"] not in (
+            "LEASED", "RESEARCHING", "CANDIDATE_READY", "LOCAL_CHECKED"):
+        return
+    now = time.time()
+    last = rec.get("lease_expires_at") or 0
+    if not force and now < last - config.LEASE_TTL_SECONDS + config.BEAT_INTERVAL_SECONDS:
+        return
+    try:
+        status = desk.beat(rec["lease"])
+    except Exception:
+        return
+    if status == 410:
+        state.stale_lease(gap_id, rec["lease"], "lease returned 410")
+    else:
+        state.update(gap_id, lease_expires_at=now + config.LEASE_TTL_SECONDS)
+
+
+def reconcile_gap(gap_id, desk=None, gh=None, git=None, observed=None):
+    """Return a short summary; never raise for one bad gap."""
+    desk = desk or desk_mod.Desk()
+    gh = gh or github
+    git = git or gitctl
+    rec = state.load(gap_id)
+    if rec is None:
+        return {"gap": gap_id, "result": "no-state"}
+    if rec["state"] in ("ACCEPTED", "RELEASED", "STALE") or (
+            rec["state"] == "REJECTED" and not rec.get("queued_lease")):
+        return {"gap": gap_id, "result": "terminal", "state": rec["state"]}
+
+    # Missing from a complete fresh frontier is a reason to confirm, not a verdict.
+    _heartbeat(gap_id, rec, desk, force=frontier.missing(observed or {}, gap_id))
+    rec = state.load(gap_id)
+    if rec["state"] in ("ACCEPTED", "RELEASED", "STALE") or (
+            rec["state"] == "REJECTED" and not rec.get("queued_lease")):
+        return {"gap": gap_id, "result": "terminal", "state": rec["state"]}
+
+    # A detached deterministic publisher owns a durable candidate. Recovery
+    # never starts a competing build or holds the short reconciliation pass.
+    from . import jobs
+    if jobs.resume(gap_id):
+        return {"gap": gap_id, "result": "publishing", "state": rec["state"]}
+
+    branch = rec.get("branch") or config.branch_for(gap_id)
+    remote = (git.remote_branch_sha(branch)
+              if rec["state"] in ("SIGNED", "PUSHED", "PR_OPEN")
+              else None)
+    if remote and rec["state"] == "SIGNED":
+        if remote == rec.get("commit_sha"):
+            state.transition(gap_id, "PUSHED")
+        else:
+            state.transition(gap_id, "FAULT",
+                             failure_reason="remote branch SHA differs")
+    elif not remote and rec["state"] == "PUSHED":
+        # Branch disappeared: do not silently re-push; record for inspection.
+        state.update(gap_id, failure_reason="pushed branch missing at fork")
+
+    number = rec.get("pr_number")
+    if not number and rec["state"] in ("SIGNED", "PUSHED", "PR_OPEN"):
+        number = gh.pr_exists_for(branch, gap_id)
+    if not number and rec["state"] in ("SIGNED", "PUSHED"):
+        # A process can die after push and before gh pr create.  Do not
+        # strand a signed contribution indefinitely: finish idempotently
+        # from its preserved proof file and pinned commit.
+        candidate = os.path.join(rec.get("worktree") or "",
+                                 rec.get("path") or "")
+        if rec.get("worktree") and os.path.isfile(candidate):
+            try:
+                from . import publish
+                published = publish.publish(
+                    gap_id, candidate, desk=desk, git=git, gh=gh)
+                state.update(gap_id, last_reconcile=time.strftime(
+                    "%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
+                return {"gap": gap_id, "result": "publish-recovered",
+                        "state": "PR_OPEN", "pr": published["pr"]}
+            except Exception as e:
+                state.update(gap_id, failure_reason=(
+                    "retry PR publication after push: %s" % e))
+        else:
+            state.update(gap_id, failure_reason=(
+                "signed publication recovery requires the preserved candidate"))
+    if number:
+        number = int(number)
+        pr = gh.get_pr(number)
+        if rec["state"] in ("PUSHED", "SIGNED", "LOCAL_CHECKED"):
+            state.transition(gap_id, "PR_OPEN", pr_number=number,
+                             pr_url=pr.get("url"),
+                             external_verdict="pending")
+        state.update(gap_id, pr_number=number, pr_url=pr.get("url"))
+        comments = gh.pr_comments(number)
+        verdicts = [(m.get("created_at", ""),
+                     VERDICT.search(m.get("body", "")).group(1))
+                    for m in comments
+                    if VERDICT.search(m.get("body", ""))]
+        if verdicts:
+            verdict = sorted(verdicts)[-1][1]
+            if verdict != "FAULT":
+                state.transition(gap_id, verdict,
+                                 external_verdict=verdict, queued_lease=None)
+            else:
+                state.update(gap_id, external_verdict="FAULT",
+                             failure_reason="upstream checker FAULT; will recheck")
+    rec = state.load(gap_id)
+    state.update(gap_id, last_reconcile=time.strftime("%Y-%m-%dT%H:%M:%SZ",
+                                                      time.gmtime()))
+    return {"gap": gap_id, "result": "ok", "state": rec["state"],
+            "pr": rec.get("pr_number")}
+
+
+def reconcile_all(desk=None, gh=None, git=None):
+    results = []
+    observed = frontier.load()
+    desk = desk or desk_mod.Desk()
+    for gap_id in state.all_gaps():
+        try:
+            results.append(reconcile_gap(gap_id, desk=desk, gh=gh, git=git, observed=observed))
+        except Exception as e:                       # nonfatal by construction
+            try:
+                rec = state.load(gap_id)
+                if rec:
+                    # Network or checker outages must not expire unrelated
+                    # running research: preserve current state and retry.
+                    state.update(gap_id, failure_reason="reconcile: %s" % e)
+            except Exception:
+                pass
+            results.append({"gap": gap_id, "result": "error", "detail": str(e)})
+    return results
diff --git a/missions/pnp/state.py b/missions/pnp/state.py
new file mode 100644
index 00000000..49392ccb
--- /dev/null
+++ b/missions/pnp/state.py
@@ -0,0 +1,227 @@
+"""Atomic, locked, append-only state for one leased gap at a time.
+
+Every external effect is preceded by a write-ahead intent record; recovery
+queries remote ground truth before retrying anything (see reconcile.py).
+"""
+import contextlib
+import fcntl
+import json
+import os
+import tempfile
+import time
+
+from . import config
+
+EMPTY = {
+    "gap_id": None,
+    "state": "DISCOVERED",
+    "statement": None,
+    "module": None,
+    "path": None,
+    "imports": [],
+    "gap_title": None,
+    "context": None,
+    "dead": None,
+    "lease": None,
+    "lease_obtained_at": None,
+    "lease_expires_at": None,
+    "base_sha": None,
+    "lean_toolchain": config.LEAN_TOOLCHAIN,
+    "researchers": [],
+    "candidate_digest": None,
+    "queued_lease": None,
+    "branch": None,
+    "worktree": None,
+    "commit_sha": None,
+    "pr_number": None,
+    "pr_url": None,
+    "external_verdict": None,
+    "failure_reason": None,
+    "intent": None,
+    "last_reconcile": None,
+    "created_at": None,
+    "updated_at": None,
+}
+
+
+def _now():
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def gap_dir(gap_id):
+    if not config.GAP_ID_RE.match(gap_id):
+        raise ValueError("invalid gap id: %r" % gap_id)
+    return os.path.join(config.GAPS_DIR, gap_id)
+
+
+def state_path(gap_id):
+    return os.path.join(gap_dir(gap_id), "state.json")
+
+
+def events_path(gap_id):
+    return os.path.join(gap_dir(gap_id), "events.jsonl")
+
+
+@contextlib.contextmanager
+def lock(gap_id):
+    d = gap_dir(gap_id)
+    os.makedirs(d, exist_ok=True)
+    fd = os.open(os.path.join(d, ".lock"), os.O_CREAT | os.O_RDWR, 0o600)
+    try:
+        fcntl.flock(fd, fcntl.LOCK_EX)
+        yield
+    finally:
+        fcntl.flock(fd, fcntl.LOCK_UN)
+        os.close(fd)
+
+
+def atomic_write(path, data):
+    d = os.path.dirname(path)
+    os.makedirs(d, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=d)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as f:
+            f.write(data)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp, path)
+    finally:
+        if os.path.exists(tmp):
+            os.unlink(tmp)
+
+
+def load(gap_id):
+    p = state_path(gap_id)
+    if not os.path.exists(p):
+        return None
+    with open(p, encoding="utf-8") as f:
+        return json.load(f)
+
+
+def save(rec):
+    rec["updated_at"] = _now()
+    atomic_write(state_path(rec["gap_id"]),
+                 json.dumps(rec, indent=2, sort_keys=True) + "\n")
+
+
+def event(gap_id, kind, detail=None):
+    rec = {"at": _now(), "kind": kind, "detail": detail or {}}
+    with open(events_path(gap_id), "a", encoding="utf-8") as f:
+        f.write(json.dumps(rec, sort_keys=True) + "\n")
+        f.flush()
+        os.fsync(f.fileno())
+
+
+def create(gap_id, **fields):
+    if load(gap_id) is not None:
+        raise ValueError("gap already exists: " + gap_id)
+    rec = dict(EMPTY)
+    rec.update(fields)
+    rec["gap_id"] = gap_id
+    rec["created_at"] = _now()
+    rec["updated_at"] = rec["created_at"]
+    with lock(gap_id):
+        save(rec)
+        event(gap_id, "created", {"state": rec["state"]})
+    return rec
+
+
+def transition(gap_id, new_state, **fields):
+    with lock(gap_id):
+        rec = load(gap_id)
+        if rec is None:
+            raise KeyError(gap_id)
+        if new_state not in config.ALLOWED.get(rec["state"], set()):
+            raise ValueError("illegal transition %s -> %s" %
+                             (rec["state"], new_state))
+        rec.update(fields)
+        rec["state"] = new_state
+        save(rec)
+        event(gap_id, "state", {"to": new_state, "fields": fields})
+    return rec
+
+
+def reacquire(gap_id, **fields):
+    """Adopt a freshly granted desk lease for a gap with local history.
+
+    The desk may re-offer a gap that was previously released or went stale
+    once its cooldown expires.  Releasing that fresh lease back with reason
+    'other' (the old cli.py behaviour) re-arms the desk's one-hour cooldown
+    and feeds its ten-minute step rate limit; with several workers this
+    locked the whole handle out of the desk.  Reuse the new lease instead.
+    The append-only event log preserves every earlier attempt.
+    """
+    with lock(gap_id):
+        rec = load(gap_id)
+        if rec is None:
+            raise KeyError(gap_id)
+        if rec["state"] not in ("RELEASED", "STALE"):
+            raise ValueError("refusing to reacquire gap in state %s" %
+                             rec["state"])
+        previous = rec["state"]
+        lease_fields = ("lease", "lease_obtained_at", "lease_expires_at")
+        meta_fields = ("statement", "module", "path", "imports", "gap_title",
+                       "context", "dead")
+        for key in lease_fields + meta_fields:
+            if key in fields:
+                rec[key] = fields[key]
+        # A re-leased gap starts a fresh publication cycle.  Stale digest or
+        # publish artifacts from an earlier attempt would make publish()
+        # abort ("candidate digest changed since local check") or reuse an
+        # old base/branch/PR, driving the gap to FAULT instead of credited.
+        for key in ("candidate_digest", "base_sha", "branch", "worktree",
+                    "commit_sha", "pr_number", "pr_url", "external_verdict"):
+            rec[key] = None
+        rec["failure_reason"] = None
+        rec["queued_lease"] = None
+        rec["publisher_retry_at"] = None
+        rec["publisher_failures"] = 0
+        rec["publisher_memory_required"] = None
+        rec["intent"] = None
+        rec["researchers"] = []
+        rec["state"] = "LEASED"
+        save(rec)
+        event(gap_id, "reacquired", {"previous_state": previous,
+                                     "lease": rec["lease"]})
+    return rec
+
+
+def stale_lease(gap_id, lease, reason):
+    """Do not invalidate a reacquired or already-published gap on an old reply."""
+    with lock(gap_id):
+        rec = load(gap_id)
+        if not rec or rec.get("lease") != lease or "STALE" not in config.ALLOWED.get(rec["state"], set()):
+            return False
+        rec.update(state="STALE", failure_reason=reason)
+        save(rec)
+        event(gap_id, "state", {"to": "STALE", "fields": {"failure_reason": reason}})
+        return True
+
+
+def update(gap_id, **fields):
+    with lock(gap_id):
+        rec = load(gap_id)
+        if rec is None:
+            raise KeyError(gap_id)
+        rec.update(fields)
+        save(rec)
+        event(gap_id, "update", {"fields": fields})
+    return rec
+
+
+def intent(gap_id, what, payload):
+    """Write-ahead intent before an external effect."""
+    return update(gap_id, intent={"what": what, "at": _now(),
+                                  "payload": payload})
+
+
+def clear_intent(gap_id):
+    return update(gap_id, intent=None)
+
+
+def all_gaps():
+    try:
+        return sorted(d for d in os.listdir(config.GAPS_DIR)
+                      if config.GAP_ID_RE.match(d))
+    except FileNotFoundError:
+        return []
diff --git a/missions/pnp/status.py b/missions/pnp/status.py
new file mode 100755
index 00000000..6df4ad05
--- /dev/null
+++ b/missions/pnp/status.py
@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+"""Read-only P vs NP mission state and independent, Executive-owned worker signal."""
+import collections
+import datetime
+import json
+import os
+import re
+import time
+from pathlib import Path
+import subprocess
+import sys
+
+if __package__ in (None, ""):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+    from missions.pnp import leaderboard, frontier, assignment
+else:
+    from . import leaderboard, frontier, assignment
+
+STATE = Path(os.environ.get("VICHE_STATE_ROOT",
+                            "/var/lib/lubko/wd/viche-state"))
+
+
+def workers():
+    """Unknown must never be reported as zero; the Executive must investigate."""
+    try:
+        p = subprocess.run(["antonina", "agent", "list", "--running",
+                            "--page", "1", "--limit", "100", "--json"],
+                           capture_output=True, text=True, timeout=8, check=True)
+        data = json.loads(p.stdout)
+        agents = data.get("agents")
+        if not isinstance(agents, list):
+            raise ValueError("unreadable agent roster")
+        filtered = [a for a in agents if
+                    (a.get("title") or "").startswith("Viche P vs NP:")]
+        coverage = ("partial" if len(agents) >= 100 or data.get("unreadable")
+                    else "complete")
+        return {"count": len(filtered), "coverage": coverage,
+                "agents": [{"id": a.get("id"), "title": a.get("title"),
+                            "state": a.get("state"), "cwd": a.get("cwd")}
+                           for a in filtered]}
+    except (OSError, ValueError, subprocess.SubprocessError):
+        return {"count": None, "coverage": "unavailable", "agents": []}
+
+
+def snapshot():
+    rows = []
+    for path in sorted((STATE / "pnp/gaps").glob("*/state.json")):
+        try:
+            item = json.loads(path.read_text())
+        except (OSError, ValueError):
+            continue
+        rows.append({"gap": item.get("gap_id"),
+                     "state": item.get("state"),
+                     "pr_url": item.get("pr_url"),
+                     "lease_expires_at": item.get("lease_expires_at"),
+                     "lease_obtained_at": item.get("lease_obtained_at"),
+                     "resource_deferred": bool(item.get("publisher_memory_required") and not frontier.build_control.resource_ready(item)) if item.get("state") in ("CANDIDATE_READY", "LOCAL_CHECKED") else False,
+                     "failure_reason": item.get("failure_reason")})
+    lb = leaderboard.load()
+    stale = True
+    if lb.get("available"):
+        try:
+            age = (datetime.datetime.now(datetime.timezone.utc) -
+                   datetime.datetime.fromisoformat(
+                       lb["observed_at"].replace("Z", "+00:00"))).total_seconds()
+            stale = age > 1800
+        except (KeyError, ValueError):
+            stale = True
+    w = workers()
+    observed = frontier.load()
+    by_gap = {r["gap"]: r for r in rows}
+    for worker in w["agents"]:
+        match = re.search(r"\bL-[a-z0-9]+(?:-[a-z0-9]+)+\b", worker.get("title") or "")
+        bound = assignment.binding(Path(worker["cwd"])) if worker.get("cwd") else None
+        gid = bound[0] if bound else match.group(0) if match else None
+        worker["gap"] = gid
+        worker["bound"] = bool(bound)
+        worker["lease_current"] = None
+        if bound:
+            try:
+                rec = frontier.state.load(gid)
+                if isinstance(rec, dict) and rec.get("lease"):
+                    worker["lease_current"] = rec["lease"] == bound[1]
+            except (OSError, ValueError):
+                pass
+        worker["gap_state"] = by_gap.get(gid, {}).get("state")
+        worker["competition"] = observed.get("gaps", {}).get(gid)
+    stale_workers = [a["id"] for a in w["agents"]
+                     if a["gap_state"] in frontier.STOPPED or a["lease_current"] is False]
+    active = [r["gap"] for r in rows if r["state"] in frontier.ACTIVE
+              and type(r["lease_expires_at"]) in (int, float)
+              and r["lease_expires_at"] > time.time() and isinstance(r["gap"], str)]
+    staffed = {a["gap"] for a in w["agents"] if a["lease_current"] is not False}
+    unstaffed = sorted(set(active) - staffed) if w["coverage"] == "complete" else []
+    ordinary = observed.get("ordinary")
+    # These are useful opportunities, not automatic staffing instructions.
+    # Desk status only exposes title/competition, not individually offerable IDs.
+    related = []
+    for gid, item in observed.get("gaps", {}).items():
+        held, parallel = item.get("held"), item.get("parallel")
+        if type(held) is int and type(parallel) is int and held < parallel:
+            related.append({"gap": gid, "title": item.get("title"), "held": held, "parallel": parallel})
+    related.sort(key=lambda x: (x["held"], x["gap"]))
+    coordination_due = bool(w["coverage"] == "complete" and (
+        stale_workers or unstaffed or (ordinary is not None and ordinary > 0)))
+    age = {r["gap"]: max(0, round((time.time()-r["lease_obtained_at"])/60))
+           for r in rows if r["gap"] in active and type(r["lease_obtained_at"]) in (int,float)}
+    score = {k: lb.get(k) for k in ("rank", "our_steps", "leader",
+                                   "runner_up", "lead_over_second",
+                                   "our_margin_vs_best_competitor",
+                                   "additional_steps_to_clear_first",
+                                   "source_checked_at", "observed_at",
+                                   "margin_change_since_previous_snapshot")}
+    score["available"] = lb.get("available", False)
+    score["stale"] = stale
+    by_state = dict(collections.Counter(r["state"] for r in rows))
+    return {
+        "observed": len(rows), "by_state": by_state, "recent": rows[-12:],
+        "leaderboard": score, "workers": w,
+        "frontier": {k: observed.get(k) for k in ("offerable", "ordinary", "open_gaps", "held")},
+        "frontier_fresh": bool(observed), "active_lease_gaps": active,
+        "unstaffed_active_gaps": unstaffed, "active_lease_age_minutes": age,
+        "potential_fronts": related[:12],
+        "coordination_due": coordination_due,
+        "publisher_build_busy": frontier.build_control.busy(),
+        "legacy_lean_compiler_pids": frontier.build_control.legacy_compilers(),
+        "lean_headroom_bytes": frontier.build_control.headroom(),
+        "resource_deferred_gaps": [r["gap"] for r in rows if r.get("resource_deferred")],
+        "workers_on_terminal_gaps": stale_workers,
+        "owned_by": "Viche Executive; other operators do not launch agents",
+        "action": (
+            "Executive: finish or reassign confirmed terminal-gap workers cooperatively; preserve their proof work. Acquire ordinary gaps promptly when offered."
+            if stale_workers else
+            "Executive must restore multiple independent P vs NP researchers "
+            "and coordinate desk acquisition and submissions."
+            if w["count"] == 0 else
+            "Executive must replenish independent P vs NP research fronts; "
+            "one worker is not a steady-state research program."
+            if w["count"] == 1 else
+            "Executive must restore visibility of the actual worker roster."
+            if w["count"] is None else
+            "Executive must increase the verified checked-step lead over #2 "
+            "and protect the lead trajectory."
+            if score.get("rank") == 1 else
+            "Executive must increase checked-step throughput to gain #1; "
+            "evaluate research yield, resources and worker replenishment."),
+        # No timestamps here: the general government dispatch gate changes
+        # only when mission facts or staffing change, not every refresh.
+        "dispatch_signal": {
+            "leaderboard": [score.get("rank"), score.get("our_steps"),
+                            (score.get("leader") or {}).get("steps"),
+                            (score.get("runner_up") or {}).get("steps")],
+            "workers": w["count"], "coverage": w["coverage"],
+            "gaps": by_state, "active": sorted(active),
+            "assignments": sorted((str(a["id"]), a["gap"] or "", a["gap_state"] or "") for a in w["agents"]),
+            "ordinary_available": (observed.get("ordinary") or 0) > 0 if observed else None,
+            "hard_available": (observed.get("offerable") or 0) > (observed.get("ordinary") or 0) if observed else None,
+            "unstaffed": unstaffed, "obsolete_workers": sorted(stale_workers),
+            "unbound": sorted(str(a["id"]) for a in w["agents"] if not a["bound"])},
+        "caveat": "Only public checked steps count; local activity is not proof."}
+
+
+if __name__ == "__main__":
+    print(json.dumps(snapshot(), sort_keys=True))
