+run_test() {
+    label=$1; shift
+    started=$(date +%s)
+    printf '\nRunning %s\n' "$label"
+    rc=0
+    "$@" || rc=$?
+    elapsed=$(($(date +%s) - started))
+    if [ "$rc" -ne 0 ]; then
+        printf 'FAIL: %s (exit=%s, elapsed=%ss)\n' "$label" "$rc" "$elapsed" >&2
+        exit "$rc"
+    fi
+    printf 'PASS: %s (elapsed=%ss)\n' "$label" "$elapsed"
+}
 
