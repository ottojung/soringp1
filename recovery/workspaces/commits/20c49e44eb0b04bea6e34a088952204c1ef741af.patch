 rc1=$(printf '%s' "$first" | cut -f1)
 h1=$(printf '%s' "$first" | cut -f2)
 r1=red; [ "$rc1" -eq 0 ] && r1=green
@@ -100,7 +129,7 @@ if [ "$rc1" -eq 0 ]; then
     result=green
     runs="[{\"run\":1,\"result\":\"$r1\",\"exit\":$rc1,\"output_sha256\":\"$h1\"}]"
 else
-    second=$(run_once)
