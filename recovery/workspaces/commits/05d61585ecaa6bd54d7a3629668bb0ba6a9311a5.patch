    Use the widened Act heading detector in branch-bootstrap
    
    Independent review found the last strict Act 24-era detector in
    branch-bootstrap.sh did not match the operative Act 25 re-enacted heading. The
    variable is currently unused, but the inconsistency is real and latent. Widen it
    to the same (re-)?enacted pattern used by every other consumer.

diff --git a/government/branch-bootstrap.sh b/government/branch-bootstrap.sh
index dcd7822d..7480f334 100755
--- a/government/branch-bootstrap.sh
+++ b/government/branch-bootstrap.sh
@@ -8,7 +8,7 @@ case "$branch" in
   judiciary) id=c1e00008; title=Judiciary ;;
   innovation-centre)
     id=c1e00011; title="Legislative Innovation Centre"
-    if grep -Eq '^## Act [0-9]+ — Executive Innovation Office Act \(enacted ' \
+    if grep -Eq '^## Act [0-9]+ — Executive Innovation Office Act \((re-)?enacted ' \
         "${VICHE_TOWN_ROOT:-/var/lib/lubko/wd/viche}/government/LAWS.md" 2>/dev/null; then
       title="Executive Innovation Office"
     fi ;;
