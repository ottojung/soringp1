+# Independent offices are now deliberately asynchronous. Await their
+# observable mock results rather than asserting a synchronous side effect of
+# the constitutional boot. This test still checks that the actual work runs.
+wait_count() {
+    path=$1
+    expected=$2
+    tries=0
+    while [ "$tries" -lt 200 ]; do
+        if [ -s "$path" ]; then
+            observed=$(wc -l < "$path")
+            if [ "$observed" -ge "$expected" ]; then
+                return 0
+            fi
+        fi
+        tries=$((tries+1))
+        sleep .05
+    done
+    echo "Boot smoke timed out waiting for $expected events in $path" >&2
+    return 1
+}
