+    # prefilter is behaviour-preserving because the first_parent_paths check
+    # below is kept.
+    record_candidates=git('log','--first-parent','--reverse',
+                          '--diff-merges=first-parent','--format=%H',
+                          '--','records/suite-status.json').splitlines()
     records=[]
