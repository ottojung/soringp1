    Viche Executive: enforce Act 17 correction finality (issue lWMIGRLB53TS70RCs2gpI8-suppose)
    
    Two corrections on cases 7750b56b775ed8959a and edb67f8a646f569b5a were
    admitted after the same-office confirmation cleared correction_pending, with
    no durable cycle identity on the chain; both corrections are tied to frozen
    draw 1792737985 with no distinct documented cycle. Add durable finality:
    confirmations record the confirming cycle in correction_finality_cycle_id;
    the correction path now refuses excess same-cycle corrections by durable
    cycle identity and fails closed when the prior chain lacks valid cycle
    identity. Hermetic coverage added to audit-correction-smoke.sh.

diff --git a/government/audit-accountability.py b/government/audit-accountability.py
index ffc60d3b..9698e695 100644
--- a/government/audit-accountability.py
+++ b/government/audit-accountability.py
@@ -349,6 +349,11 @@ def report(args):
         prior["details"] = pending.get("details", prior.get("details", ""))
         prior["correction_pending"] = False
         prior.pop("correction_cycle_id", None)
+        # Durable finality: a correction confirmed in this cycle may not be
+        # followed by another correction on the same cycle (Act 17 §2.6.1).
+        # Record the confirming cycle identity for the correction-path check.
+        prior["correction_finality_cycle_id"] = pending_cycle
+        prior["correction_finality_at"] = now
         if pending["verdict"] == "finding":
             prior.pop("corrected_from_finding", None)
         else:
@@ -374,6 +379,20 @@ def report(args):
             raise ValueError("one correction per case per cycle (finality)")
         if args.cycle_id in used_cycle_tokens(prior, args.case):
             raise ValueError("one correction per case per cycle (cycle_id already used)")
+        # Act 17 §2.6.1 ("finality"): confirmation clears correction_pending,
+        # so a second excess correction in the same cycle must be refused by
+        # durable cycle identity, not by the transient pending flag. A case
+        # whose earlier correction lacks a valid cycle identity is refused
+        # fail-closed: until a new registered dispatch records durable
+        # identity, an excess correction on an unidentified cycle is refused.
+        prior_corrections = [h for h in prior.get("history", []) if h.get("correction")]
+        if any(not valid_cycle_token(h.get("cycle_id")) for h in prior_corrections):
+            raise ValueError("one correction per case per cycle (durable cycle identity required)")
+        finality = prior.get("correction_finality_cycle_id")
+        if finality is not None and not valid_cycle_token(finality):
+            raise ValueError("one correction per case per cycle (durable cycle identity required)")
+        if finality is not None and args.cycle_id == finality:
+            raise ValueError("one correction per case per cycle (finality)")
         if args.evidence == prior.get("evidence_ref"):
             raise ValueError("correction evidence must be distinct from the original reference")
         if not args.why_stronger or not args.why_stronger.strip():
diff --git a/tests/audit-correction-smoke.sh b/tests/audit-correction-smoke.sh
index c0af7efd..a4dd0c41 100644
--- a/tests/audit-correction-smoke.sh
+++ b/tests/audit-correction-smoke.sh
@@ -453,4 +453,57 @@ jq -e --arg c "$TWO_STEP" '.signals[]|select(.type=="correction_not_effective" a
 if jq -e --arg c "$TWO_STEP" '.signals[]|select((.type=="corrected_finding" or .type=="unresolved_finding") and .case_id==$c)' "$scratch/check" >/dev/null; then
  echo 'Unanchored two-step history changed original inconclusive verdict' >&2;exit 1
 fi
+# Excess same-cycle correction after a legacy (cycle-unidentified)
+# confirmation is refused fail-closed (Act 17 §2.6.1 finality). Mirrors the
+# real pattern: two corrections tied to one frozen draw with no distinct
+# documented cycle; later corrections must not be accepted on that chain.
+CASE5=505050505050505050
+printf '{"case_id":"%s","population":"ignored_work","id":"305","at":2000000000}\n' "$CASE5" \
+    > "$scratch/state/oversight/random/cases/$CASE5.json"
+TOKEN21=ecececececececececececececececec
+VICHE_AUDIT_CYCLE_ID=$TOKEN21
+printf '%s\n' "$TOKEN21" > "$scratch/state/oversight/current-audit-cycle"
+printf '2000000021\t%s\n' "$TOKEN21" >> "$scratch/state/oversight/audit-cycle-identities.tsv"
+export VICHE_AUDIT_CYCLE_ID
+python3 "$CTRL" report --case "$CASE5" --verdict not_assigned --evidence "initial legacy-chain case" >/dev/null
+legacy_outcomes="$scratch/state/oversight/random/outcomes/$CASE5.json"
+python3 - "$legacy_outcomes" <<'PY'
+import json,sys
+p=sys.argv[1]; d=json.load(open(p))
+d["history"]=[{"correction":True,"confirmed":True,"verdict":"finding",
+               "supersedes":"not_assigned","cycle_id":None,"at":1792738483}]
+d["verdict"]="finding"; d["correction_pending"]=False
+json.dump(d,open(p,"w"))
+PY
+if python3 "$CTRL" report --case "$CASE5" --verdict not_assigned --evidence "excess legacy correction" \
+    --correction --cycle-id "$TOKEN21" --supersedes finding --auditor c1e00008 \
+    --reason_code excess --why_stronger "excess correction on unidentified legacy cycle" 2>/dev/null; then
+    echo "excess correction on legacy-identified chain accepted" >&2; exit 1
+fi
+# A correction repeating the cycle identity of the last confirmed correction
+# is refused ("finality"), even with a new current token.
+TOKEN22=b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1
+VICHE_AUDIT_CYCLE_ID=$TOKEN22
+printf '%s\n' "$TOKEN22" > "$scratch/state/oversight/current-audit-cycle"
+printf '2000000022\t%s\n' "$TOKEN22" >> "$scratch/state/oversight/audit-cycle-identities.tsv"
+export VICHE_AUDIT_CYCLE_ID
+TOKEN_A=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
+VICHE_AUDIT_CYCLE_ID=$TOKEN_A
+printf '%s\n' "$TOKEN_A" > "$scratch/state/oversight/current-audit-cycle"
+printf '2000000023\t%s\n' "$TOKEN_A" >> "$scratch/state/oversight/audit-cycle-identities.tsv"
+export VICHE_AUDIT_CYCLE_ID
+python3 - "$legacy_outcomes" "$TOKEN_A" <<'PY'
+import json,sys
+p=sys.argv[1]; token=sys.argv[2]
+d=json.load(open(p))
+d["history"]=[{"correction":True,"confirmed":True,"verdict":"finding",
+               "supersedes":"not_assigned","cycle_id":token,"at":1792738483}]
+d["correction_finality_cycle_id"]=token
+json.dump(d,open(p,"w"))
+PY
+if python3 "$CTRL" report --case "$CASE5" --verdict not_assigned --evidence "same final cycle" \
+    --correction --cycle-id "$TOKEN_A" --supersedes finding --auditor c1e00008 \
+    --reason_code finality --why_stronger "repeat of confirmed correction cycle" 2>/dev/null; then
+    echo "same-cycle correction after confirmation accepted" >&2; exit 1
+fi
 echo 'Act 17 audit correction smoke passed'
