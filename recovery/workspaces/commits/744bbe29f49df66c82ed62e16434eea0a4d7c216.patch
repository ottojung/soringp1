+        if state == "closed":
+            basis["closed_usage"] += int(row["usage"]["tokens_total"])
+        elif state == "held":
+            basis["held_charge"] += int(row["charge"]["tokens_total"])
+        elif state == "active":
+            basis["active_caps"] += int(caps["tokens_total"])
+        elif state == "reserved":
+            basis["reserved_caps"] += int(caps["tokens_total"])
+    return basis, counts
