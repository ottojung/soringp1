-    is reported on stderr while the pass continues.
+    placeholder). Those are skipped. A non-empty dict without an id is
+    malformed: skipping it silently could hide a real obligation, so its name
+    is returned for durable reporting in the generated index.
     """
     cases = []
+    malformed = []
     for path in sorted(STORE.glob("*.json")):
         if path.name == "index.json":
             continue
@@ -422,13 +424,12 @@ def _case_documents():
         if document.get("id"):
             cases.append(document)
             continue
-        print("institutional-cases: case document without id: {}".format(path.name),
-              file=sys.stderr)
-    return cases
+        malformed.append(path.name)
+    return cases, malformed
 
 
