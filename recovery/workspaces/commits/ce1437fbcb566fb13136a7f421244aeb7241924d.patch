    Janitor: gate the allowlist reclaim solely by safe_reclaim_enabled
    
    Previously reclaim() deferred only when BOTH safe_reclaim_enabled and
    reclaim_enabled were 0, so enabling reclaim_enabled (for reclaim-quarantined)
    also re-enabled the allowlist reclaim when safe_reclaim_enabled=0. Separate the
    gates: the reversible allowlist is gated by safe_reclaim_enabled; the destructive
    reclaim-quarantined is a separate mode gated by reclaim_enabled. Regression test
    tests/janitor-smoke.sh passes.

diff --git a/government/janitor.sh b/government/janitor.sh
index 2c10607e..f62c01e5 100644
--- a/government/janitor.sh
+++ b/government/janitor.sh
@@ -232,7 +232,10 @@ write_status() {
 reclaim() {
     # reclaim <reason>
     reason=${1:-scheduled}
-    if [ "$safe_reclaim" -ne 1 ] && [ "$reclaim_enabled" -ne 1 ]; then
+    # The reversible allowlist reclaim is gated solely by safe_reclaim_enabled.
+    # The destructive reclaim-quarantined step is a separate mode gated by
+    # reclaim_enabled, so this gate must not be coupled to reclaim_enabled.
+    if [ "$safe_reclaim" -ne 1 ]; then
         log_append "$jstate/actions.log" \
             "$ts reclaim reason=$reason deferred safe_reclaim_enabled=$safe_reclaim"
         return 0
