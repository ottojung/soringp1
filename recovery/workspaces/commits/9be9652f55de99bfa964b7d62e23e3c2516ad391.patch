+# A transient 'unknown' is re-read, not fatal and not treated as idle.
+MODE=sequence
+VICHE_AGENT_STATE_RETRIES=3 VICHE_AGENT_STATE_DELAY=0
+export MODE VICHE_AGENT_STATE_RETRIES VICHE_AGENT_STATE_DELAY
