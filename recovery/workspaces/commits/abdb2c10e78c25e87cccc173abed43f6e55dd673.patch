+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def digest_map():
+    return {str(p.relative_to(E)): sha(p) for p in sorted(E.rglob("*"))
+            if p.is_file() and p.name not in ("measure.py", "measurement.json")
+            and "__pycache__" not in p.parts}
