             continue
         path = STORE / (signal + ".json")
         case = read(path)
+        # The store also holds non-case JSON (for example an evidence list or an
+        # empty placeholder file). A valid non-dict document is not a case and
+        # must not abort the whole reconcile pass.
+        if not isinstance(case, dict):
+            case = {}
         if signal in signals:
             if not case:
                 case = {
@@ -389,7 +394,8 @@ def reconcile():
