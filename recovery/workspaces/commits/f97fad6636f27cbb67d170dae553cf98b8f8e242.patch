+#!/usr/bin/env python3
+"""Derive UNSIGNED follow-on Act34 permit candidates from the signed first-wave bytes.
+
+This generator NEVER signs, activates, attests or dispatches. It only:
+  * re-binds budget_sha256 to the draft recurring config,
+  * adds the distinct per_run_caps,
+  * keeps the cumulative caps, term and (unchanged) Economy control evidence,
+  * marks signature_status unsigned and clears signer/attestation.
+
+Genuine approval must later be recorded by the Executive officer on the exact
+origin commit; see README.md.
+"""
+import hashlib
+import json
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+CANON = Path("/var/lib/lubko/wd/viche")
+PERMITS = ("statistics", "foresight", "strategy", "spying")
+
+config = (HERE / "knowledge-budget.conf").read_bytes()
+budget_sha = hashlib.sha256(config).hexdigest()
+cfg = json.loads(config)
+run_caps = cfg["offices"]["statistics"]["per_run_caps"]
+
+for office in PERMITS:
+    src = json.loads((CANON / "records/knowledge/permits" / (office + ".json")).read_text())
+    out = dict(src)
