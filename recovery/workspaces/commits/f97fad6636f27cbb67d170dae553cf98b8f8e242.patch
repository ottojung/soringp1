index 00000000..25f16a96
--- /dev/null
+++ b/draft/recurring-envelope-20261124/verify.py
@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+"""Targeted verification of the recurring-envelope candidate.
+
+Uses ONLY the authoritative, read-only government code and the real canonical
+ledger rows. Does not install, activate, sign, dispatch, or run the full suite.
+Writes machine-readable results under evidence/results/.
+"""
+import copy
+import json
+import subprocess
+import time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+TOWN = Path("/var/lib/lubko/wd/viche")
+TOOL = TOWN / "government/knowledge-budget-tool.py"
+BOUNDS = TOWN / "government/knowledge-practical-bounds.py"
+RESDIR = Path("/var/lib/lubko/wd/viche-state/knowledge/budget/reservations")
+LEDGER = Path("/var/lib/lubko/wd/viche-state/knowledge/budget/aggregate.json")
+CANON_CONF = TOWN / "government/knowledge-budget.conf"
+DRAFT_CONF = HERE / "knowledge-budget.conf"
+RESULTS = HERE / "evidence/results"
+WINDOW = 3888000
+OFFICES = ("statistics", "foresight", "strategy", "spying")
+KEYS = ("tokens_total", "cpu_seconds", "wall_seconds")
+NOW = int(time.time())
+
+
+def run(*args):
+    p = subprocess.run(["python3", str(TOOL)] + [str(a) for a in args],
+                       capture_output=True, text=True)
+    out = p.stdout.strip()
+    try:
+        parsed = json.loads(out.splitlines()[-1]) if out else None
+    except ValueError:
+        parsed = out
+    return {"argv": [str(a) for a in args], "exit": p.returncode,
+            "stdout": out, "stderr": p.stderr.strip(), "json": parsed}
+
+
+def save(name, obj):
+    (RESULTS / (name + ".json")).write_text(json.dumps(obj, indent=2, sort_keys=True) + "\n")
+    return obj
+
+
+report = {"generated_epoch": NOW, "sources": {
+    "tool": str(TOOL), "bounds": str(BOUNDS), "reservations": str(RESDIR),
+    "ledger": str(LEDGER), "canonical_config": str(CANON_CONF),
+    "draft_config": str(DRAFT_CONF)}}
+
+# 1. Config validation.
+report["validate_draft"] = save("validate-draft", run("validate", DRAFT_CONF))
+report["validate_current"] = save("validate-current", run("validate", CANON_CONF))
+draft_cfg = json.loads(DRAFT_CONF.read_text())
+canon_cfg = json.loads(CANON_CONF.read_text())
+report["cap_shape"] = {
+    "draft_per_run": draft_cfg["offices"]["statistics"]["per_run_caps"],
+    "draft_cumulative": draft_cfg["offices"]["statistics"]["caps"],
+    "current_per_run": canon_cfg["offices"]["statistics"]["per_run_caps"],
+    "current_cumulative": canon_cfg["offices"]["statistics"]["caps"],
+}
+
+# 2. Reconstruct the aggregate from the four real reservation rows.
+agg = save("aggregate-from-real-rows", run("aggregate", RESDIR, WINDOW, NOW))
+ledger_on_disk = json.loads(LEDGER.read_text())
+report["ledger_matches_disk"] = all(
+    agg["json"].get(k) == ledger_on_disk.get(k) for k in KEYS) and \
+    sorted(agg["json"].get("counted", [])) == sorted(ledger_on_disk.get("counted", []))
+report["ledger_rows"] = ledger_on_disk
+
+# 3. Headroom table from the real ledger (cumulative cap - actual charge).
+def headroom(cfg, aggj):
+    table = {}
+    for office in OFFICES:
+        table[office] = {k: cfg["offices"][office]["caps"][k] -
+                            aggj["by_office"][office][k] for k in KEYS}
+    table["aggregate"] = {k: cfg["aggregate"]["caps"][k] - aggj[k] for k in KEYS}
+    return table
+report["headroom"] = headroom(draft_cfg, agg["json"])
+
+# 4. Admission with the REAL ledger: current config (broken) vs draft config.
+aggj = agg["json"]
+report["admit_current_real"] = {o: save("admit-current-" + o, run("admit", CANON_CONF, json.dumps(aggj), o))["json"]
+                                 for o in OFFICES}
+report["admit_draft_real"] = {o: save("admit-draft-" + o, run("admit", DRAFT_CONF, json.dumps(aggj), o))["json"]
+                               for o in OFFICES}
+
+# 5. Project N extra per-office turns onto a copy of the real ledger, then admit.
+def projected(aggj, turns, cfg):
+    copy_agg = copy.deepcopy(aggj)
+    for office in OFFICES:
+        for k in KEYS:
+            unit = cfg["offices"][office]["per_run_caps"][k]
+            copy_agg["by_office"][office][k] += turns * unit
+            copy_agg[k] += unit
+    return copy_agg
+
+# n = number of follow-on turns ALREADY charged; the admit() call tests the
+# NEXT (n+1) turn against that non-resettable projection.
+for n in (0, 1, 2, 3):
+    proj = projected(aggj, n, draft_cfg)
+    report["admit_turn_%d_after_%d_completed" % (n + 1, n)] = {
+        o: save("admit-turn-%d-after-%d-completed-%s" % (n + 1, n, o),
+                run("admit", DRAFT_CONF, json.dumps(proj), o))["json"] for o in OFFICES}
+    report["projection_%d_completed" % n] = proj
+
+# 6. Adverse cases from the cumulative-admission tests: 399k/400k with 120k run
+#    is refused; 120k/400k with 120k run is admitted. Missing/invalid accounting
+#    fails closed. per_run > cumulative never validates.
+adv_cfg = json.loads(json.dumps(draft_cfg))
+for office in OFFICES:
+    adv_cfg["offices"][office]["caps"] = {"tokens_total": 400000, "cpu_seconds": 1800, "wall_seconds": 3600}
+    adv_cfg["offices"][office]["per_run_caps"] = {"tokens_total": 120000, "cpu_seconds": 300, "wall_seconds": 600}
+adv_cfg["aggregate"]["caps"] = {"tokens_total": 1600000, "cpu_seconds": 7200, "wall_seconds": 14400}
+ADV_CONF = HERE / "evidence/adversarial-config.json"
+ADV_CONF.write_text(json.dumps(adv_cfg, indent=2, sort_keys=True) + "\n")
+
+def adv_agg(used):
+    a = {"tokens_total": used, "cpu_seconds": 0.0, "wall_seconds": 0,
+         "by_office": {o: {"tokens_total": used, "cpu_seconds": 0.0, "wall_seconds": 0} for o in OFFICES}}
+    return a
+
+report["adverse_399k"] = save("adverse-399k", run("admit", ADV_CONF, json.dumps(adv_agg(399000)), "statistics"))
+report["adverse_120k"] = save("adverse-120k", run("admit", ADV_CONF, json.dumps(adv_agg(120000)), "statistics"))
+report["adverse_missing_office"] = save("adverse-missing-office", run("admit", ADV_CONF, json.dumps({"tokens_total": 0, "cpu_seconds": 0.0, "wall_seconds": 0, "by_office": {}}), "statistics"))
+bad = adv_agg(120000)
+bad["tokens_total"] = -1
+report["adverse_invalid_accounting"] = save("adverse-invalid-accounting", run("admit", ADV_CONF, json.dumps(bad), "statistics"))
+over_cfg = json.loads(json.dumps(adv_cfg))
+over_cfg["offices"]["statistics"]["per_run_caps"]["tokens_total"] = 500000
+OVER_CONF = HERE / "evidence/adversarial-over-cap-config.json"
+OVER_CONF.write_text(json.dumps(over_cfg, indent=2, sort_keys=True) + "\n")
+report["adverse_per_run_gt_cumulative"] = save("adverse-per-run-gt-cumulative", run("validate", OVER_CONF))
+
+# 7. Overrun and CPU reboot-reset behaviour on authoritative primitives.
+caps = {"tokens_total": 100, "cpu_seconds": 100, "wall_seconds": 100}
+snap = {"session_found": True, "tokens": {"delta_total": 100}, "cpu_seconds": 99.0, "cpu_available": True}
+report["adverse_overrun"] = save("adverse-overrun", run("overrun", json.dumps(caps), json.dumps(snap), 99))
+b0 = {"cpu_boot_id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "cpu_seconds": 10.0,
+      "cpu_source": "proc-stat-host-busy-upper-bound-v1"}
+b1 = dict(b0, cpu_boot_id="bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb", cpu_seconds=20.0,
+          tokens={"total": 5}, session_found=True)
+report["adverse_cpu_reboot"] = save("adverse-cpu-reboot", run("cpu-delta", json.dumps(b0), json.dumps(b1)))
+
+# 8. Ambiguous exit holds the FULL prepaid charge (no reset/release).
+def bounds_run(*args):
+    p = subprocess.run(["python3", str(BOUNDS)] + [str(a) for a in args],
+                       capture_output=True, text=True)
+    out = p.stdout.strip()
+    try:
+        parsed = json.loads(out.splitlines()[-1]) if out else None
+    except ValueError:
+        parsed = out
+    return {"argv": [str(a) for a in args], "exit": p.returncode,
+            "stdout": out, "stderr": p.stderr.strip(), "json": parsed}
+
+
+report["bounds_profile_validate"] = save("bounds-profile-validate",
+                                         bounds_run("validate", str(HERE / "evidence/practical-bounds-profile.json")))
+amb_res = {"schema": "viche-knowledge-budget-reservation-v1",
