@@ -0,0 +1,194 @@
+"""Lean proof certificates for edge-owned star constructions.
+
+Semantic checking uses exact symbolic antichains. Lean proof generation
+uses a permutation of concrete edges instead of an exponential truth table.
+"""
+import argparse
+import json
+from pathlib import Path
+import re
+
+from . import star
+from .. import validate
+from ..proofs import synthesis
+
+NS="PEqualNP.CircuitLowerBounds."
+PERM_BODY="""by
+  intro α L R p h
+  induction h with
+  | nil => rfl
+  | cons a h ih => simp only [List.any_cons, ih]
+  | swap a b l => simp only [List.any_cons]; cases p a <;> cases p b <;> rfl
+  | trans h1 h2 ih1 ih2 => exact ih1.trans ih2"""
+PERM_TYPE="∀ (α : Type) (L R : List α) (p : α → Bool), L.Perm R → L.any p = R.any p"
+
+def dnf(z):
+    """Exact ordered DNF of the star circuit; no absorption/reordering."""
+    w=[[(i,)] for i in range(z["n"])]
+    for op,a,b in z["gates"]:
+        if op=="or":
+            if len(w[a])+len(w[b])>10000:raise ValueError("DNF expansion too large")
+            w.append(w[a]+w[b])
+        else:
+            if len(w[a])*len(w[b])>10000:raise ValueError("DNF expansion too large")
+            w.append([u+v for u in w[a] for v in w[b]])
+    result=w[z["output"]]
+    if any(len(t)!=2 for t in result):raise ValueError("not an edge-owned star construction")
+    return result
+
+def lean_list(edges):
+    return "["+", ".join("("+str(a)+", "+str(b)+")" for a,b in edges)+"]"
+
+def expr(edges):
+    return " || ".join(f"(x {a} && x {b})" for a,b in edges)
+
+def eval_body(z,ordered,permutation="any_perm",simp_steps=None):
+    n=z["n"];D=dnf(z)
+    L=[tuple(sorted(e)) for e in D];R=[tuple(sorted(e)) for e in ordered]
+    if sorted(L)!=sorted(R):
+        raise ValueError("certificate requires each target edge exactly once")
+    swaps=", ".join(f"Bool.and_comm (x {u}) (x {v})" for u,v in D if u>v)
+    reverse=", ".join(f"Bool.and_comm (x {u}) (x {v})" for u,v in ordered if u>v)
+    left_extra=", "+swaps if swaps else ""
+    right_extra=", "+reverse if reverse else ""
+    simp="simp" if simp_steps is None else "simp (config := { maxSteps := "+str(simp_steps)+" })"
+    return f"""by
+  intro x
+  let L : List (Fin {n} × Fin {n}) := {lean_list(L)}
+  let R : List (Fin {n} × Fin {n}) := {lean_list(R)}
+  have hp : L.Perm R := by decide
+  calc
+    _ = L.any (fun e => x e.1 && x e.2) := by
+      {simp} [witness, L, {NS}Circuit.eval, {NS}Circuit.wires,
+        {NS}GateOp.eval, List.ofFn_succ, Bool.and_or_distrib_left,
+        Bool.and_or_distrib_right, Bool.or_assoc{left_extra}]
+    _ = R.any (fun e => x e.1 && x e.2) := {permutation} _ L R _ hp
+    _ = _ := by {simp} [R, Bool.or_assoc{right_extra}]
+"""
+
+def parse(statement):
+    m=synthesis.SHAPE.fullmatch(statement.strip())
+    if not m:return None
+    n,bound,rhs=int(m[2]),int(m[1]),m[3]
+    if not 2<=n<=256:return None
+    E=synthesis.EDGE
+    if not re.fullmatch(r"[()\s]*"+E.pattern+r"(?:[()\s]*\|\|[()\s]*"+E.pattern+r")*[()\s]*",rhs):return None
+    ordered=[(int(a),int(b)) for a,b in E.findall(rhs)]
+    try:edges=star.normalize(n,ordered)
+    except ValueError:return None
+    if len(edges)!=len(ordered):return None
+    return n,bound,ordered,edges,rhs
+
+def witness_term(z):
+    gs=", ".join("⟨"+NS+"GateOp."+op+", ["+str(a)+", "+str(b)+"]⟩" for op,a,b in z["gates"])
+    return "⟨["+gs+"], "+str(z["output"])+"⟩"
+
+def indent(text,n=4):
+    return "\n".join(" "*n+line for line in text.rstrip().splitlines())
+
+def obligation_body(meta,z):
+    """Generate a complete term directly, without reparsing generated Lean."""
+    parsed=parse(meta["statement"])
+    if not parsed:raise ValueError("unsupported certificate statement")
+    n,bound,ordered,edges,rhs=parsed
+    if len(z["gates"])>bound or star.verify(n,edges,z["gates"],z["output"])["status"]!="verified":
+        raise ValueError("certificate is not within the stated bound")
+    if len(z["gates"])>64:
+        from . import dnf_reflection
+        return dnf_reflection.artifact(z)
+    steps=None
+    code="by\n  let witness : "+NS+"Circuit := "+witness_term(z)+"\n"
+    code+="  have any_perm : "+PERM_TYPE+" :=\n"+indent(PERM_BODY)+"\n"
+    code+="  have eval_witness : ∀ x : Fin "+str(n)+" → Bool, witness.eval (List.ofFn x) = ("+rhs+") :=\n"
+    code+=indent(eval_body(z,ordered,simp_steps=steps))+"\n"
+    code+="  have hwf : PEqualNP.MetaComplexity.Monotone2 witness := by\n"
+    code+="    intro g hg\n    simp only [witness, List.mem_cons, List.not_mem_nil, or_false] at hg\n"
+    code+="    rcases hg with "+" | ".join("rfl" for _ in z["gates"])+" <;> simp\n"
+    code+="  exact ⟨witness, hwf, by decide, eval_witness⟩\n"
+    return code
+
+def render(meta,seconds=5):
+    parsed=parse(meta["statement"])
+    if not parsed:return {"status":"unsupported"}
+    n,bound,ordered,edges,rhs=parsed
+    z=star.synthesize(n,edges,seconds)
+    ver=star.verify(n,edges,z["gates"],z["output"])
+    info={"status":"generated","n":n,"gates":len(z["gates"]),"bound":bound,"verification":ver,"certificate":z}
+    if ver["status"]!="verified" or len(z["gates"])>bound:
+        return dict(info,status="no_witness_within_bound")
+    if len(z["gates"])>64:
+        from . import dnf_reflection
+        code=dnf_reflection.render(meta,z,ordered,rhs)
+        validate.validate(meta,code.encode())
+        return dict(info,candidate=code,proof_strategy="reflection")
+    mod=meta["module"];aux=mod+"_aux"
+    imports=["Mathlib"]+[m for m in meta["imports"] if m!="Mathlib"]
+    gs=", ".join("⟨"+NS+"GateOp."+op+", ["+str(a)+", "+str(b)+"]⟩" for op,a,b in z["gates"])
+    code="\n".join("import "+m for m in imports)+"\n\nnamespace "+aux+"\n\n"
+    code+="lemma any_perm : "+PERM_TYPE+" := "+PERM_BODY+"\n\n"
+    code+="def witness : "+NS+"Circuit := ⟨["+gs+"], "+str(z["output"])+"⟩\n\n"
+    code+="set_option maxHeartbeats 4000000 in\nset_option maxRecDepth 10000 in\n"
+    code+="lemma eval_witness : ∀ x : Fin "+str(n)+" → Bool, witness.eval (List.ofFn x) = ("+rhs+") :=\n"
+    code+=eval_body(z,ordered)+"\n"
+    code+="lemma wf : PEqualNP.MetaComplexity.Monotone2 witness := by\n"
+    code+="  intro g hg\n  simp only [witness, List.mem_cons, List.not_mem_nil, or_false] at hg\n"
+    code+="  rcases hg with "+" | ".join("rfl" for _ in z["gates"])+" <;> simp\n"
+    code+="\nend "+aux+"\n\ntheorem "+mod+" : "+meta["statement"]+" := by\n"
+    code+="  exact ⟨"+aux+".witness, "+aux+".wf, by decide, "+aux+".eval_witness⟩\n"
+    validate.validate(meta,code.encode())
+    return dict(info,candidate=code)
+
+def graph_meta(graph,module="PEqualNP.Outside.VicheStarCertificate"):
+    n=graph["n"];edges=sorted(star.normalize(n,graph["edges"]))
+    bound=graph.get("bound",len(edges)+n-1)
+    statement=f"∃ C : {NS}Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ {bound} ∧ ∀ x : Fin {n} → Bool, C.eval (List.ofFn x) = (fun x : Fin {n} → Bool => {expr(edges)}) x"
+    return {"id":"L-meta-0","module":module,"file":"lean/"+module.replace(".","/")+".lean",
+            "statement":statement,"imports":["PEqualNP.Defs"]}
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument("graph",nargs="?",help="graph JSON; omit in a bound workspace for exact lease")
+    p.add_argument("--output")
+    p.add_argument("--check",action="store_true",help="store exact obligation and start async kernel verification")
+    p.add_argument("--base",help="public revision for independent --check")
+    p.add_argument("--family",default="graph-circuit")
+    p.add_argument("--wall",type=int,default=600)
+    p.add_argument("--rss-mib",type=int,default=8192)
+    p.add_argument("--seconds",type=float,default=5)
+    a=p.parse_args()
+    if not a.output and not a.check:p.error("--output or --check is required")
+    if a.check and a.graph and not a.base:p.error("independent --check requires --base")
+    if a.base and not (a.check and a.graph):p.error("--base applies to independent --check only")
+    if a.graph:
+        meta=graph_meta(json.loads(Path(a.graph).read_text()))
+    else:
+        from .obligations import binding
+        r,w,b=binding()
+        meta={"id":r["gap_id"],"module":r["module"],"file":r["path"],"statement":r["statement"],"imports":r["imports"]}
+    out=render(meta,a.seconds)
+    candidate=out.pop("candidate",None)
+    if candidate and a.output:
+        with Path(a.output).open("x") as f:f.write(candidate)
+        out["path"]=str(Path(a.output).resolve())
+    if candidate and a.check:
+        from contextlib import closing
+        import tempfile
+        from . import knowledge as k,obligations as o,async_check
+        from .. import support
+        if a.graph:
+            base=a.base;o.public_toolchain(base)
+            provenance="certificate / graph file "+Path(a.graph).name
+            family=a.family
+        else:
+            base=b;provenance=r["gap_id"]+" / "+support.attempt(r)+" / certificate"
+            family=k.family((r.get("gap_title") or "")+" "+r["statement"])
+        detail=k.canon({"imports":sorted(set(["Mathlib"]+meta["imports"])),
+                        "options":{"maxHeartbeats":4000000,"maxRecDepth":10000}})
+        with closing(k.db()) as c:
+            node=k.add(c,"obligation",family,meta["statement"],detail,provenance,base=base)
+            with tempfile.NamedTemporaryFile(mode="w",suffix=".body") as f:
+                f.write(obligation_body(meta,out["certificate"]));f.flush()
+                out["verification_request"]=async_check.submit(c,node,f.name,bool(a.graph),a.wall,a.rss_mib)
+    print(json.dumps(out,indent=2))
+    return 0 if candidate else 1
+if __name__=="__main__":raise SystemExit(main())
diff --git a/missions/pnp/research/certificate_bench.py b/missions/pnp/research/certificate_bench.py
new file mode 100644
index 00000000..2f058c3d
--- /dev/null
+++ b/missions/pnp/research/certificate_bench.py
@@ -0,0 +1,75 @@
+"""Reproducible remote kernel-check benchmark of the new certificate generator."""
+import argparse
+from contextlib import closing
+import json
+import os
+from pathlib import Path
+import sqlite3
+import subprocess
+import time
+
+from . import certificate, knowledge, obligations
+from .. import config
+
+def rows():
+    with closing(sqlite3.connect("file:"+str(Path(config.CACHE_DIR)/"proof-corpus.sqlite")+"?mode=ro",uri=True)) as db:
+        revision=db.execute("SELECT value FROM metadata WHERE key='revision'").fetchone()[0]
+        result=[]
+        for path,stmt,imports in db.execute("SELECT path,statement,imports FROM proof ORDER BY path"):
+            if not certificate.parse(stmt):continue
+            module=path.removeprefix("lean/").removesuffix(".lean").replace("/",".")
+            stem=Path(path).stem
+            gid=stem.replace("_","-")
+            if not config.GAP_ID_RE.fullmatch(gid):continue
+            result.append({"id":gid,"file":path,"module":module,"statement":stmt,"imports":json.loads(imports)})
+    return revision,result
+
+def acceptable(log,name):
+    return obligations.verify_report(log,name)
+
+def run(base,output,limit=None):
+    revision,items=rows()
+    if limit:items=items[:limit]
+    output=Path(output)
+    output.parent.mkdir(parents=True,exist_ok=True)
+    seen={}
+    if output.exists():
+        for line in output.read_text().splitlines():
+            try:
+                row=json.loads(line);seen[row["id"]]=row
+            except (ValueError,KeyError):continue
+    for meta in items:
+        z=certificate.render(meta)
+        source=z.get("candidate")
+        if source:source+=obligations.axiom_guard(meta["module"])
+        digest=knowledge.digest(source.encode()) if source else None
+        old=seen.get(meta["id"])
+        if old and old.get("base")==base and old.get("source_digest")==digest and old.get("status")=="kernel_checked":continue
+        start=time.monotonic()
+        row={"id":meta["id"],"base":base,"corpus":revision,"source_digest":digest,
+             "gates":z.get("gates"),"bound":z.get("bound"),"status":z["status"]}
+        if source:
+            try:
+                proc,r=obligations.method_check(base,"benchmark:"+meta["id"]+":"+digest,
+                                             source)
+                row["compiler_status"]=r.get("status")
+                row["lean_ms"]=r.get("elapsed_ms")
+                row["status"]="kernel_checked" if proc.returncode==0 and r.get("status")=="elaborated" and r.get("exit_code")==0 and acceptable(r.get("diagnostic",""),meta["module"]) else "not_verified"
+                if row["status"]!="kernel_checked":
+                    row["diagnostic"]=r.get("diagnostic",proc.stderr)[-1500:]
+            except (OSError,ValueError,subprocess.SubprocessError) as exc:
+                row.update(status="infrastructure",diagnostic=str(exc)[:1000])
+        row["wall_ms"]=round(1000*(time.monotonic()-start))
+        with output.open("a") as f:
+            f.write(json.dumps(row,ensure_ascii=False)+"\n");f.flush();os.fsync(f.fileno())
+        seen[meta["id"]]=row
+        print(meta["id"],row["status"],row.get("lean_ms"),row["wall_ms"],flush=True)
+    checked=sum(seen.get(m["id"],{}).get("status")=="kernel_checked" for m in items)
+    print(json.dumps({"total":len(items),"kernel_checked":checked,"base":base,"corpus":revision,"output":str(output)}),flush=True)
+    return int(checked!=len(items))
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--base",required=True);p.add_argument("--output",required=True);p.add_argument("--limit",type=int)
+    a=p.parse_args();return run(a.base,a.output,a.limit)
+if __name__=="__main__":raise SystemExit(main())
diff --git a/missions/pnp/research/dnf_reflection.py b/missions/pnp/research/dnf_reflection.py
new file mode 100644
index 00000000..e808fcf2
--- /dev/null
+++ b/missions/pnp/research/dnf_reflection.py
@@ -0,0 +1,189 @@
+"""Reusable Lean reflection kernel for binary monotone circuits."""
+
+TEMPLATE = """abbrev Dnf := List (List Nat)
+def value (x : List Bool) (d : Dnf) : Bool :=
+  d.any (fun t => t.all (fun i => x.getD i false))
+
+def conjunction (a b : Dnf) : Dnf :=
+  a.flatMap (fun u => b.map (fun v => u ++ v))
+
+lemma value_prefix (x : List Bool) (u : List Nat) (b : Dnf) :
+    value x (b.map (fun v => u ++ v)) =
+      (u.all (fun i => x.getD i false) && value x b) := by
+  induction b with
+  | nil => simp [value]
+  | cons v vs ih =>
+    simp only [List.map_cons, value, List.any_cons, List.all_append] at *
+    rw [ih, Bool.and_or_distrib_left]
+
+lemma value_append (x : List Bool) (a b : Dnf) :
+    value x (a ++ b) = (value x a || value x b) := by
+  simp [value,List.any_append]
+
+lemma value_cons (x : List Bool) (u : List Nat) (a : Dnf) :
+    value x (u :: a) = (u.all (fun i => x.getD i false) || value x a) := rfl
+
+lemma value_conjunction (x : List Bool) (a b : Dnf) :
+    value x (conjunction a b) = (value x a && value x b) := by
+  induction a with
+  | nil => simp [conjunction,value]
+  | cons u us ih =>
+    change value x (b.map (fun v => u ++ v) ++ conjunction us b) = _
+    rw [value_append, value_prefix x u b, ih, value_cons, Bool.and_or_distrib_right]
+
+lemma value_getD (x : List Bool) (ds : List Dnf) (i : Nat) :
+    (ds.map (value x)).getD i false = value x (ds.getD i []) := by
+  simp only [List.getD_eq_getElem?_getD,List.getElem?_map]
+  cases ds[i]? <;> rfl
+
+abbrev Op := Bool × Nat × Nat
+def gate (g : Op) : Gate :=
+  ⟨if g.1 then GateOp.and else GateOp.or,[g.2.1,g.2.2]⟩
+def dstep (ds : List Dnf) (g : Op) : List Dnf :=
+  ds ++ [if g.1 then conjunction (ds.getD g.2.1 []) (ds.getD g.2.2 [])
+         else ds.getD g.2.1 [] ++ ds.getD g.2.2 []]
+
+def bstep (w : List Bool) (g : Gate) : List Bool :=
+  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]
+
+lemma value_step (x : List Bool) (ds : List Dnf) (g : Op) :
+    (dstep ds g).map (value x) = bstep (ds.map (value x)) (gate g) := by
+  rcases g with ⟨b,i,j⟩
+  cases b <;> simp only [dstep,bstep,gate,Bool.false_eq_true,ite_false,ite_true,
+    List.map_append,List.map_cons,List.map_nil,GateOp.eval,List.any_cons,List.any_nil,
+    List.all_cons,List.all_nil,id,Bool.or_false,Bool.and_true,value_getD,value_append,value_conjunction]
+
+lemma value_fold (x : List Bool) (ds : List Dnf) (gs : List Op) :
+    (gs.foldl dstep ds).map (value x) =
+      (gs.map gate).foldl bstep (ds.map (value x)) := by
+  induction gs generalizing ds with
+  | nil => rfl
+  | cons g gs ih => simp only [List.foldl_cons,List.map_cons,ih,value_step]
+
+def inputs (n : Nat) : List Dnf := List.ofFn (fun i : Fin n => [[i.val]])
+
+lemma value_inputs {n : Nat} (x : Fin n → Bool) :
+    (inputs n).map (value (List.ofFn x)) = List.ofFn x := by
+  simp only [inputs,List.map_ofFn]
+  congr 1
+  funext i
+  simp [value,List.getD_eq_getElem?_getD]
+
+lemma sound {n : Nat} (x : Fin n → Bool) (gs : List Op) (out : Nat) :
+    (Circuit.mk (gs.map gate) out).eval (List.ofFn x) =
+      value (List.ofFn x) ((gs.foldl dstep (inputs n)).getD out []) := by
+  change ((gs.map gate).foldl bstep (List.ofFn x)).getD out false = _
+  have h := value_fold (List.ofFn x) (inputs n) gs
+  rw [value_inputs x] at h
+  rw [← h]
+  exact value_getD _ _ _
+lemma value_pairs {n : Nat} (x : Fin n → Bool) (l : List (Fin n × Fin n)) :
+    value (List.ofFn x) (l.map (fun e => [e.1.val,e.2.val])) =
+      l.any (fun e => x e.1 && x e.2) := by
+  induction l with
+  | nil => rfl
+  | cons e es ih =>
+    change (value (List.ofFn x) ([e.1.val,e.2.val] :: es.map (fun e => [e.1.val,e.2.val]))) = _
+    rw [value_cons, ih]
+    simp [List.getD_eq_getElem?_getD]
+
+def orderPair {n : Nat} (e : Fin n × Fin n) :=
+  if e.1 ≤ e.2 then e else (e.2,e.1)
+
+lemma value_ordered {n : Nat} (x : Fin n → Bool) (l : List (Fin n × Fin n)) :
+    (l.map orderPair).any (fun e => x e.1 && x e.2) =
+      l.any (fun e => x e.1 && x e.2) := by
+  induction l with
+  | nil => rfl
+  | cons e es ih =>
+    simp only [List.map_cons,List.any_cons,ih,orderPair]
+    split <;> simp [Bool.and_comm]
+
+lemma any_perm (α : Type) (L R : List α) (p : α → Bool) :
+    L.Perm R → L.any p = R.any p := by
+  intro hp
+  induction hp with
+  | nil => rfl
+  | cons _ _ ih => simp only [List.any_cons,ih]
+  | swap _ _ _ => simp only [List.any_cons, Bool.or_left_comm]
+  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
+
+lemma monotone (gs : List Op) (out : Nat) :
+    PEqualNP.MetaComplexity.Monotone2 (Circuit.mk (gs.map gate) out) := by
+  intro g hg
+  obtain ⟨t,ht,rfl⟩ := List.mem_map.mp hg
+  rcases t with ⟨b,i,j⟩
+  cases b <;> simp [gate]
+"""
+
+def data(z,ordered):
+    from .certificate import dnf,lean_list
+    D=dnf(z)
+    R=[tuple(sorted(e)) for e in ordered]
+    if sorted(tuple(sorted(e)) for e in D)!=sorted(R):
+        raise ValueError("reflection requires exactly one occurrence of each target edge")
+    ops="["+ ", ".join("("+("true" if op=="and" else "false")+", "+str(a)+", "+str(b)+")" for op,a,b in z["gates"])+"]"
+    return ops,lean_list(D),lean_list(R)
+
+def definitions(z,ordered):
+    ops,pairs,target=data(z,ordered)
+    n=z["n"];out=z["output"]
+    return f"""def ops : List Op := {ops}
+def pairs : List (Fin {n} × Fin {n}) := {pairs}
+def target : List (Fin {n} × Fin {n}) := {target}
+def witness : Circuit := ⟨ops.map gate, {out}⟩
+"""
+
+def eval_proof(z,ordered):
+    n=z["n"];out=z["output"]
+    swaps=", ".join(f"Bool.and_comm (x {u}) (x {v})" for u,v in ordered if u>v)
+    extra=", "+swaps if swaps else ""
+    return f"""by
+  change (Circuit.mk (ops.map gate) {out}).eval (List.ofFn x) = _
+  rw [sound]
+  have h : (ops.foldl dstep (inputs {n})).getD {out} [] =
+      pairs.map (fun e => [e.1.val,e.2.val]) := by decide
+  rw [h,value_pairs,← value_ordered]
+  have hp : (pairs.map orderPair).Perm target := by decide
+  rw [any_perm _ _ _ _ hp]
+  simp (config := {{maxSteps := 2000000}}) [target,Bool.or_assoc{extra}]
+"""
+
+OPTIONS="set_option maxHeartbeats 4000000 in\nset_option maxRecDepth 10000 in\n"
+
+def parts(z,ordered,rhs,aux):
+    n=z["n"];out=z["output"]
+    code="namespace "+aux+"\nopen PEqualNP.CircuitLowerBounds\n"
+    code+=TEMPLATE+"\n"+definitions(z,ordered)+"\n"+OPTIONS
+    code+=f"lemma eval_witness (x : Fin {n} → Bool) : witness.eval (List.ofFn x) = ({rhs}) :=\n"+eval_proof(z,ordered)
+    code+=f"\nlemma wf : PEqualNP.MetaComplexity.Monotone2 witness := monotone ops {out}\nend {aux}\n\n"
+    body=f"by\n  exact ⟨{aux}.witness,{aux}.wf,by decide,{aux}.eval_witness⟩"
+    return code,body
+
+def render(meta,z,ordered,rhs):
+    module=meta["module"];aux=module+"_aux"
+    imports=["Mathlib"]+[m for m in meta["imports"] if m!="Mathlib"]
+    helpers,body=parts(z,ordered,rhs,aux)
+    return "\n".join("import "+m for m in imports)+"\n\n"+helpers+OPTIONS+f"theorem {module} : {meta['statement']} := "+body+"\n"
+
+MARKER="-- viche-reflected-star-v1\n"
+
+def artifact(z):
+    import json
+    # Only computational data, not arbitrary injected Lean declarations.
+    return MARKER+json.dumps({"n":z["n"],"gates":z["gates"],"output":z["output"]},separators=(",",":"))+"\n"
+
+def unpack(text,statement,aux):
+    import json
+    from . import certificate,star
+    z=json.loads(text[len(MARKER):])
+    if not isinstance(z,dict) or set(z)!={"n","gates","output"}:
+        raise ValueError("invalid reflected proof artifact")
+    parsed=certificate.parse(statement)
+    if not parsed:raise ValueError("unsupported reflected proof statement")
+    n,bound,ordered,edges,rhs=parsed
+    if z["n"]!=n or len(z["gates"])>bound:
+        raise ValueError("reflected proof does not fit exact obligation")
+    if star.verify(n,edges,z["gates"],z["output"])["status"]!="verified":
+        raise ValueError("invalid reflected circuit")
+    return parts(z,ordered,rhs,aux)
