+++ b/missions/pnp/staffing/backend.py
@@ -0,0 +1,159 @@
+"""Bounded Antonina operations. Prompt files avoid ARG_MAX and secret argv."""
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+import fcntl
+
+from .. import assignment, config, gitctl, staff, state, support
+from ..research import adoption, playbook
+from . import plan
+
+
+class Uncertain(RuntimeError):
+    pass
+
+
+class MissingAgent(Uncertain):
+    pass
+
+
+def wire(*args, timeout=12):
+    p = subprocess.run(["antonina","agent",*args],capture_output=True,text=True,
+                       timeout=timeout,check=True)
+    return p.stdout.strip()
+
+
+def object_row(text):
+    row=json.loads(text)
+    if not isinstance(row,dict):
+        raise Uncertain("invalid backend response")
+    return row
+
+
+def running():
+    # No destructive operations from partial/unreadable observations.
+    rows={}
+    for page in range(1,65):
+        data=object_row(wire("list","--running","--page",str(page),"--limit","100","--json"))
+        agents=data.get("agents")
+        if not isinstance(agents,list) or data.get("unreadable"):
+            raise Uncertain("running roster unavailable")
+        for a in agents:
+            if not isinstance(a,dict) or not isinstance(a.get("id"),str) or a["id"] in rows:
+                raise Uncertain("unstable running roster")
+            rows[a["id"]]=a
+        if len(agents)<100:
+            return list(rows.values())
+    raise Uncertain("running roster exceeds bounded scan")
+
+
+def status(aid):
+    try:
+        row=object_row(wire("status","--id",aid,"--json"))
+    except subprocess.CalledProcessError as exc:
+        if exc.returncode==3 and (exc.stderr or "").strip()=="antonina: unknown agent: "+aid:
+            raise MissingAgent("agent deleted") from exc
+        raise
+    if row.get("id")!=aid or not isinstance(row.get("state"),str) or type(row.get("alive")) is not bool:
+        raise Uncertain("agent identity unavailable")
+    return row
+
+
+def same(row,path):
+    return (row.get("invocation_cwd") or row.get("cwd"))==path
+
+
+def live(row):
+    return row.get("state")=="running" and row.get("alive") is True
+
+
+def known_terminal(row):
+    return row.get("state") in staff._REUSABLE and row.get("alive") is False
+
+
+def prepare(slot):
+    if not slot.gap:
+        Path(slot.path).mkdir(parents=True,exist_ok=True)
+        return
+    rec=state.load(slot.gap)
+    if not plan.current(slot):
+        raise Uncertain("assignment changed")
+    path=Path(slot.path)
+    base=slot.base or None
+    if not (path/".git").exists() and not base:
+        general=Path(state.gap_dir(slot.gap),"attempts",assignment.attempt_id(rec["lease"]),"workers/general/path")
+        if slot.label!="general" and (general/".git").exists():
+            base=subprocess.check_output(["git","-C",str(general),"rev-parse","HEAD"],text=True,timeout=5).strip()
+        else:
+            # Staffing never waits for a network fetch when a local public
+            # mirror is available. The independent mirror refresh owns freshness.
+            try:
+                base=gitctl.run(["git","--git-dir="+gitctl.MIRROR,"rev-parse","refs/remotes/upstream/main"]).stdout.strip()
+            except gitctl.GitError:
+                # Bootstrap only if the local mirror/ref is absent. Serialize
+                # the repair; other slots retry rather than race a clone.
+                root=Path(config.CACHE_DIR);root.mkdir(parents=True,exist_ok=True)
+                with (root/"staffing-mirror.lock").open("a+") as lock:
+                    fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
+                    base=gitctl.ensure_mirror()
+    result=assignment.prepare(slot.gap,worker=slot.label,base=base,expected=rec["lease"])
+    if result["cwd"]!=slot.path or not plan.current(slot):
+        raise Uncertain("assignment changed during preparation")
+
+
+def new(slot):
+    title=("Viche P vs NP research: "+slot.gap+" "+slot.label if slot.gap
+           else support.PREFIX+" "+slot.label)
+    aid=wire("new","--cwd",slot.path,"--title",title)
+    if not re.fullmatch(r"[A-Za-z0-9_-]+",aid):
+        raise Uncertain("unreadable created agent identity")
+    return aid
+
+
+def resource_ready():
+    # Use the existing town memory safety policy, not a private worker cap.
+    root=Path(__file__).resolve().parents[3]
+    p=subprocess.run(["/bin/sh",str(root/"government/resource-safety.sh"),"pnp-staffing"],
+                     capture_output=True,text=True,timeout=5)
+    return p.returncode==0
+
+
+def run(slot,aid):
+    role=playbook.role_for(slot.label,slot.label=="general") if slot.gap else slot.label
+    if slot.gap:
+        rec=state.load(slot.gap)
+        text=staff.prompt(rec,slot.task,slot.label=="general",slot.label)
+        text+="\nContinue the durable mathematical work from this workspace. Do not end a pass after only reporting status. If no route remains, preserve exact exhaustion evidence for the evaluator."
+    else:
+        text=("Continue the durable support work in this workspace. Read current assignments and prior findings. "
+              "Deliver concrete results and preserve them. No agent launches, lease acquisition or direct publication. "
+              "Do not repeat identical work without new evidence.\n"+slot.task)
+    text=playbook.guide(role)+"\n\n"+text
+    did=adoption.planned(aid,Path(slot.path),role,text)
+    with tempfile.NamedTemporaryFile(mode="w",encoding="utf-8",prefix="pnp-staff-",delete=True) as f:
+        f.write(text);f.flush()
+        if not plan.current(slot):
+            raise Uncertain("assignment changed before run")
+        row=object_row(wire("run","--id",aid,"--cwd",slot.path,"--prompt-file",f.name,
+                           "--detach","--json",timeout=30))
+    if row.get("id")!=aid or row.get("state")!="running":
+        raise Uncertain("launch acknowledgement not confirmed")
+    adoption.confirmed(did)
+    if slot.gap and slot.label.startswith("ob-"):
+        # Advisory assignment record; dispatch already happened.
+        try:
+            from contextlib import closing
+            from ..research import knowledge
+            import time
+            with closing(knowledge.db()) as c,c:
+                c.execute("INSERT OR REPLACE INTO assignment VALUES(?,?,?,?)",
+                          (slot.label[3:],slot.attempt,slot.label,time.time()))
+        except Exception:
+            pass
+
+
+def stop(aid):
+    wire("stop","--id",aid,timeout=15)
diff --git a/missions/pnp/staffing/controller.py b/missions/pnp/staffing/controller.py
new file mode 100644
index 00000000..6c1287b3
--- /dev/null
+++ b/missions/pnp/staffing/controller.py
@@ -0,0 +1,133 @@
+"""Single-writer, independently supervised desired-state reconciliation."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import json
+import os
+from pathlib import Path
+import sys
+import time
+
+from .. import staff
+from . import backend, plan, policy, reconcile, store
+
+
+def tick():
+    now=time.time()
+    p=policy.load()
+    # The lock also fences legacy helpers during the migration.
+    with staff.staffing_lock():
+        running=backend.running()
+        issues=[]
+        slots=plan.desired(p,running,issues)
+        # Known positions do not wait for the historical registry scan.
+        # Cold/ambiguous identities need complete history before creating.
+        warm=[];cold=[]
+        for s in slots:
+            if store.get(s.key).get("agent") or any(backend.same(a,s.path) for a in running):
+                warm.append(s)
+            else:
+                cold.append(s)
+        rows=[]
+        def finish(s,f):
+            try:
+                row=f.result()
+            except Exception as exc:
+                row={"phase":"unknown","reason":"slot error "+type(exc).__name__}
+            rows.append({"key":s.key,"label":s.label,"gap":s.gap,
+                         **{k:row.get(k) for k in ("phase","reason","agent","vacant_since","next_at","failures","started","activity","model","uncovered_since")}})
+        def history_scan():
+            try:
+                return staff.roster()
+            except reconcile.ERRORS:
+                return None
+        with ThreadPoolExecutor(max_workers=1) as scan:
+            history_future=scan.submit(history_scan) if cold and not p["paused"] else None
+            with ThreadPoolExecutor(max_workers=p["parallel"]) as pool:
+                jobs=[(s,pool.submit(reconcile.reconcile,s,p,running,None))
+                      for s in sorted(warm,key=lambda s:s.priority)]
+                # Known positions already reconcile while the scan is underway.
+                history=history_future.result() if history_future else None
+                jobs.extend((s,pool.submit(reconcile.reconcile,s,p,running,history))
+                            for s in sorted(cold,key=lambda s:s.priority))
+                for s,f in jobs:
+                    finish(s,f)
+        # Retire exact obsolete agents independently, never arbitrary processes.
+        retired=[]
+        if not p["paused"]:
+            for a in running:
+                try:
+                    if plan.obsolete(a,slots):
+                        fresh=backend.status(a["id"])
+                        if backend.live(fresh) and plan.obsolete(fresh,slots):
+                            backend.stop(a["id"])
+                            retired.append(a["id"])
+                except reconcile.ERRORS:
+                    pass
+        t=time.time()
+        store.sample(rows,t)
+        alerts=sorted(f'{r["gap"] or "support"}:{r["label"]}'
+                      for r in rows if r["phase"] not in ("running","completed","paused","obsolete")
+                      and isinstance(r.get("uncovered_since"),(int,float))
+                      and t-r["uncovered_since"]>=p["alert_after"])
+        if issues:
+            alerts.append("planning degraded")
+        out={"at":t,"last_good_at":t,"state":"paused" if p["paused"] else "degraded" if issues or any(r["phase"]=="unknown" for r in rows) else "healthy" if all(r["phase"] in ("running","completed") for r in rows) else "reconciling","issues":issues,"alerts":alerts,
+             "duration":round(t-now,3),"slots":rows,"retired":retired,
+             "desired":len(rows),"running":sum(r["phase"]=="running" for r in rows),
+             "unknown":sum(r["phase"]=="unknown" for r in rows)}
+        store.health(out)
+        return out
+
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("command",choices=("tick","status","metrics","policy","set-policy","pause","resume"),default="status",nargs="?")
+    ap.add_argument("--hours",type=float,default=1)
+    ap.add_argument("--json",help="JSON object of policy fields to update")
+    args=ap.parse_args()
+    if args.command=="status":
+        print(json.dumps(store.read_health(),indent=2));return 0
+    if args.command=="metrics":
+        if not 0<args.hours<=168:
+            ap.error("metrics window must be within 0–168 hours")
+        print(json.dumps(store.metrics(args.hours),indent=2));return 0
+    if args.command=="policy":
+        print(json.dumps(policy.load(),indent=2));return 0
+    if args.command in ("set-policy","pause","resume"):
+        if Path(__file__).resolve().parents[3]!=Path("/var/lib/lubko/wd/viche") or policy.root()!=Path("/var/lib/lubko/wd/viche-state/pnp/staffing"):
+            ap.error("policy edits require canonical deployment")
+        try:
+            patch=json.loads(args.json or "{}") if args.command=="set-policy" else {"paused":args.command=="pause"}
+            if not isinstance(patch,dict) or not patch:
+                raise ValueError("nonempty policy object required")
+            print(json.dumps(policy.change(lambda p:{**p,**patch}),indent=2))
+            return 0
+        except (OSError,ValueError,TypeError) as exc:
+            ap.error(str(exc))
+    # Only the canonical launcher can mutate live state. Hermetic tests call
+    # the pure tick with an isolated state root and mocked backend.
+    if (Path(__file__).resolve().parents[3]!=Path("/var/lib/lubko/wd/viche")
+            or os.environ.get("PNP_STAFFING_DAEMON")!="1"
+            or policy.root()!=Path("/var/lib/lubko/wd/viche-state/pnp/staffing")):
+        ap.error("live ticks belong to canonical staffing daemon")
+    try:
+        result=tick()
+        print(json.dumps({k:v for k,v in result.items() if k!="slots"}),flush=True)
+        return 0
+    except Exception as exc:
+        # Preserve previous evidence while making uncertainty explicit.
+        previous=store.read_health()
+        t=time.time()
+        rows=[{**r,"phase":"unknown"} for r in previous.get("slots",[])]
+        if rows:
+            try:store.sample(rows,t)
+            except Exception:pass
+        store.health({**previous,"at":t,"state":"unknown","slots":rows,
+                      "running":None,"unknown":len(rows),
+                      "reason":type(exc).__name__,"last_good_at":previous.get("last_good_at",previous.get("at"))})
+        print("staffing tick deferred: "+type(exc).__name__,file=sys.stderr,flush=True)
+        return 1
+
+
+if __name__=="__main__":
+    raise SystemExit(main())
