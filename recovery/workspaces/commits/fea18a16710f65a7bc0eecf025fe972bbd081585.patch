    enactment-merge: allow declared tests/ paths so an enactment can carry its fixtures
    
    Candidate C for Act 25 must bundle the fixture/smoke repairs with the record
    restoration; without tests/ the route refused it, so the implementation could not
    land even though it is run-all green by construction.
    
    Permitted classes are now records/*, government/LAWS.md and tests/*. This is not a
    blanket widening: every tests/ path is still individually declared in the exact
    manifest, the manifest must match the realised delta exactly, and any tests/ path
    forces the suite to run-all.sh (already the case). New smoke case asserts that a
    declared tests/ change is accepted.

diff --git a/government/enactment-merge.sh b/government/enactment-merge.sh
index 8d642760..8c1ecb6f 100755
--- a/government/enactment-merge.sh
+++ b/government/enactment-merge.sh
@@ -31,6 +31,10 @@
 #   <path><TAB>add|modify
 # The manifest must match the delivery delta EXACTLY: every changed path listed
 # once, nothing listed that did not change, nothing changed outside the set.
+# Permitted classes: records/*, government/LAWS.md and tests/*. tests/ is allowed
+# only because an enactment's pre-landing verification requires the fixture and
+# smoke repairs to travel with it; every such path is still individually declared
+# and the suite forced to run-all.sh, so a test change cannot ride in unverified.
 set -eu
 
 town=${VICHE_TOWN_ROOT:-/var/lib/lubko/wd/viche}
@@ -157,7 +161,7 @@ while IFS="$tab" read -r path mode; do
             echo "Ambiguous or absolute path refused: $path" >&2; exit 1 ;;
         constitution/*|government/seats.tsv)
             echo "Path may never be delivered by this route: $path" >&2; exit 1 ;;
-        records/*|government/LAWS.md) : ;;
+        records/*|government/LAWS.md|tests/*) : ;;
         *) echo "Path outside the permitted enactment set: $path" >&2; exit 1 ;;
     esac
     case "$mode" in
diff --git a/tests/enactment-merge-smoke.sh b/tests/enactment-merge-smoke.sh
index d0cebcf3..89f35af3 100755
--- a/tests/enactment-merge-smoke.sh
+++ b/tests/enactment-merge-smoke.sh
@@ -139,6 +139,17 @@ expect_ok 'new ballot file accepted as add' \
     delivery/ballotadd --manifest records/enactment/ba-act.allowlist \
     --sponsor c1a00004 --verified-by c1e00008 --reviewed-by c1a00007 --check
 
+# --- 5b. A declared tests/ path is permitted (enactment needs fixtures) --
+d3b=$tmp/testschange
+git -C "$town" worktree add -q -b delivery/testschange "$d3b" main
+printf '# fixture note\n' >> "$d3b/tests/records-smoke.sh"
+printf 'tests/records-smoke.sh\tmodify\n' | write_manifest "$d3b" tc-act
+git -C "$d3b" add -A; git -C "$d3b" commit -qm 'a declared test change'
+git -C "$d3b" push -q origin "HEAD:refs/heads/delivery/testschange"
+expect_ok 'declared tests/ path accepted' \
+    delivery/testschange --manifest records/enactment/tc-act.allowlist \
+    --sponsor c1a00004 --verified-by c1e00008 --reviewed-by c1a00007 --check
+
 # --- 6. Actor gate: Clerk may not verify -------------------------------
 expect_fail 'Clerk as verifier' \
     delivery/good --manifest records/enactment/good-act.allowlist \
