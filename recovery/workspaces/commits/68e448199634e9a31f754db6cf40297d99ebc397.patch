+#   (2) terminal continuity is due: the office is terminally dead
+#       ($4 in failed|stopped|killed), the ledger has a recorded terminal
+#       event for this office, that event has aged past oc_cooldown (no
+#       immediate replacement of a freshly dead office), and no reset has
+#       been recorded for the office since that event (the replacement
+#       boundary).
+# Every path that might replace an appointment (branch-bootstrap,
+# terminal-continuity, seat-liveness, clerk-liveness, sitting) must consult
+# this function first.
+oc_supervisor_replacement_due() {
+  # $1 liveness dir, $2 office, $3 now, $4 terminal state
+  if oc_reset_due "$1" "$2" "$3"; then
+    return 0
+  fi
+  case "$4" in
+    failed|stopped|killed) : ;;
+    *) return 1 ;;
+  esac
+  oc_log=$1/failures/events.tsv
+  [ -s "$oc_log" ] || return 1
+  oc_newest=0
+  while IFS="$(printf '\t')" read -r oc_f1 oc_f2 oc_f3 oc_f4 oc_f5 oc_f6 oc_f7 oc_tstate oc_transient oc_evidence; do
