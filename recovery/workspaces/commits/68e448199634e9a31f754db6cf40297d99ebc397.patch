+    oc_last_reset=$(cat "$1/last-reset-$2")
+    case "$oc_last_reset" in ''|*[!0-9]*) oc_last_reset=0 ;; esac
+  fi
+  # A reset recorded since the terminal event means the office is already
+  # being re-established; do not replace it again while it is alive.
