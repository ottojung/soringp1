+#!/bin/sh
+# Real integration path for Act 19 §3: the office supervisor (branch-bootstrap)
+# records every terminal appointment event in the single-source per-office
+# ledger (with retry-safe and durable evidence); the shared supervisor decision
+# point (oc_supervisor_replacement_due) gates every new appointment;
+# terminal-continuity and sitting consult the same decision point.
+#
+# Property under test: a failed/stopped/killed appointment by itself causes NO
+# new Antonina ID and NO registry overwrite. Replacements happen only when the
+# decision point is due: the Act 19 §3.1 threshold, or the aged
+# terminal-continuity reconcile boundary.
+set -eu
+repo=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
+d=$(mktemp -d)
+trap 'rm -rf "$d"' EXIT HUP INT TERM
+
+mkdir -p "$d/bin" \
+         "$d/town/government" \
+         "$d/seats/branches/executive" "$d/seats/branches/judiciary" \
+         "$d/seats/branches/economy" "$d/seats/branches/innovation-centre" \
+         "$d/state" "$d/mock"
+printf 'c1a00001\tClerk\tintake\n' > "$d/town/government/seats.tsv"
+for f in appointments.sh branch-bootstrap.sh office-continuity.sh \
+         terminal-continuity.sh terminal-appointment-evidence.sh sitting.sh \
+         AGENT-REPORTING-POLICY.md; do
+    cp "$repo/government/$f" "$d/town/government/$f"
+done
+for branch in executive judiciary economy innovation-centre; do
+    git -C "$d/seats/branches/$branch" init -q
+    git -C "$d/seats/branches/$branch" -c user.name=fixture -c user.email=fixture@example.com \
+        commit --allow-empty -qm "$branch-baseline"
+done
+
+cat > "$d/bin/antonina" <<'MOCK'
+#!/bin/sh
+set -eu
+case "$1 $2" in
+  'agent status')
+    id=$4
+    [ -s "$MOCK_ROOT/$id.json" ] || exit 3
+    cat "$MOCK_ROOT/$id.json" ;;
+  'agent new')
+    n=0; [ ! -s "$MOCK_ROOT/next" ] || n=$(cat "$MOCK_ROOT/next")
+    n=$((n+1)); printf '%s\n' "$n" > "$MOCK_ROOT/next"
+    id="id-$n"
+    printf '{"state":"idle","model":null,"variant":null}\n' > "$MOCK_ROOT/$id.json"
+    printf '%s\n' "$id" ;;
+  'agent log')
+    printf 'captured log\n' ;;
+  'agent stop')
+    id=$4
+    jq '.state="stopped"' "$MOCK_ROOT/$id.json" > "$MOCK_ROOT/$id.next"
+    mv "$MOCK_ROOT/$id.next" "$MOCK_ROOT/$id.json" ;;
+  'board list') printf '[]\n' ;;
+  'board show') printf '{"body":"","messages":[]}\n' ;;
+  *) echo "unexpected Antonina call: $*" >&2; exit 9 ;;
+esac
+MOCK
+chmod +x "$d/bin/antonina"
+export PATH="$d/bin:$PATH" MOCK_ROOT="$d/mock" \
+       VICHE_TOWN_ROOT="$d/town" VICHE_SEATS_ROOT="$d/seats" VICHE_STATE_ROOT="$d/state"
+
+# Real scripts under test, sourced from the fixture town.
+. "$d/town/government/office-continuity.sh"
+mkdir -p "$VICHE_STATE_ROOT/appointments"
+liv=$VICHE_STATE_ROOT/liveness
+registry=$VICHE_STATE_ROOT/appointments/appointments.tsv
+ledger=$liv/failures/events.tsv
+
+# $1 state, $2 finished_at, $3 invocation, $4 classification,
+# $5 transient, $6 automatic_retry_safe, $7 agent id
+set_status() {
+  printf '{"state":"%s","alive":false,"active_runner":false,"model":null,"variant":"low","finished_at":"%s","invocation_id":"%s","backend_error":{"classification":"%s","transient":%s,"automatic_retry_safe":%s}}\n' \
+    "$1" "$2" "$3" "$4" "$5" "$6" > "$MOCK_ROOT/$7.json"
+}
+run_branch() { /bin/sh "$VICHE_TOWN_ROOT/government/branch-bootstrap.sh" "$1"; }
+registry_row() { awk -F '\t' -v k="$1" '$1==k {print $2}' "$registry"; }
+ledger_rows_for() { awk -F '\t' -v k="$1" '$2==k {n++} END {print n+0}' "$ledger"; }
+
+# --- Part 1: the office supervisor path (branch-bootstrap) ------------------
+printf '{"state":"idle","model":null,"variant":"low"}\n' > "$MOCK_ROOT/executive-agent.json"
+printf 'executive\texecutive-agent\n' > "$registry"
+base=$(date +%s)
+
+# A: a single transient failure enters the ledger; no new appointment.
+set_status failed "$((base+1))" run-a1 upstream_endpoint_unavailable true true executive-agent
+run_branch executive
+test "$(registry_row executive)" = executive-agent
+test "$(ledger_rows_for executive)" -eq 1
+test "$(awk -F '\t' -v k=executive '$2==k && $8=="failed" {n++} END {print n+0}' "$ledger")" -eq 1
+test "$(awk -F '\t' -v k=executive '$2==k && $6=="yes" {n++} END {print n+0}' "$ledger")" -eq 1
+test "$(awk -F '\t' -v k=executive '$2==k && $9=="true" {n++} END {print n+0}' "$ledger")" -eq 1
+test -s "$VICHE_STATE_ROOT/appointments/terminal-evidence/executive-agent"
+# A fresh terminal event is NOT an immediate replacement.
+if oc_supervisor_replacement_due "$liv" executive "$(date +%s)" failed; then
+  echo 'decision point fired on a fresh terminal event' >&2; exit 1
+fi
+
+# B: a second distinct transient failure is still below the threshold.
+set_status failed "$((base+2))" run-a2 upstream_endpoint_unavailable true true executive-agent
+run_branch executive
+test "$(registry_row executive)" = executive-agent
+test "$(ledger_rows_for executive)" -eq 2
+if oc_supervisor_replacement_due "$liv" executive "$(date +%s)" failed; then
+  echo 'decision point fired below the Act 19 threshold' >&2; exit 1
+fi
+
+# C: the third distinct transient failure inside the window reaches the
+# Act 19 §3.1 threshold: branch-bootstrap performs exactly one replacement.
+set_status failed "$((base+3))" run-a3 upstream_endpoint_unavailable true true executive-agent
+run_branch executive
+new_exec_id=$(/bin/sh "$VICHE_TOWN_ROOT/government/appointments.sh" resolve executive)
+test "$new_exec_id" != executive-agent
+test "$(registry_row executive)" = "$new_exec_id"
+test "$(wc -l < "$VICHE_STATE_ROOT/liveness/recoveries.log")" -eq 1
+
+# --- Part 2: the terminal-continuity decision-point path -------------------
+# D: a freshly dead office below threshold — terminal continuity defers.
+judge_id=$(/bin/sh "$VICHE_TOWN_ROOT/government/appointments.sh" ensure judiciary)
+set_status failed "$(date +%s)" run-judge-fresh upstream_endpoint_unavailable true true "$judge_id"
+run_branch judiciary
+test "$(registry_row judiciary)" = "$judge_id"
+if oc_supervisor_replacement_due "$liv" judiciary "$(date +%s)" failed; then
+  echo 'decision point fired on a fresh terminal event (judiciary)' >&2; exit 1
+fi
+
+# E: an aged terminal event — the decision point is due: terminal continuity
+# replaces the dead appointment with a new reconcilatory one.
+econ_id=$(/bin/sh "$VICHE_TOWN_ROOT/government/appointments.sh" ensure economy)
+set_status failed "$(( $(date +%s) - 3600 ))" run-econ-death upstream_endpoint_unavailable true true "$econ_id"
+run_branch economy
+econ_id_after=$(registry_row economy)
+test "$econ_id_after" != "$econ_id"
+jq -e '.state=="awaiting_reconciliation" and .previous_agent=="'"$econ_id"'"' \
+  "$d/state/continuity/reconciliation-economy.json" >/dev/null
+test -s "$d/state/liveness/last-reset-economy"
+
+# --- Part 3: sitting consults the same decision point -----------------------
+# F: sitting on a fresh death defers (no immediate new appointment).
+innov_id=$(/bin/sh "$VICHE_TOWN_ROOT/government/appointments.sh" ensure innovation-centre)
+set_status failed "$(date +%s)" run-inv-0 upstream_endpoint_unavailable true true "$innov_id"
+oc_record_failure "$liv" innovation-centre "$innov_id" run-inv-0 upstream_endpoint_unavailable "$(date +%s)" yes "$(date +%s)" "$d/seats/branches/innovation-centre" failed true "$(oc_terminal_evidence_path "$innov_id")"
+/bin/sh "$VICHE_TOWN_ROOT/government/sitting.sh" innovation-centre
+test "$(registry_row innovation-centre)" = "$innov_id"
+if oc_supervisor_replacement_due "$liv" innovation-centre "$(date +%s)" failed; then
+  echo 'decision point fired on a fresh terminal event (innovation-centre)' >&2; exit 1
+fi
+
+# F2: the §3.1 threshold is reached — sitting replaces through the shared
+# decision point and re-resolves the seat before returning.
+oc_record_failure "$liv" innovation-centre "$innov_id" run-inv-1 upstream_endpoint_unavailable "$(date +%s)" yes "$(date +%s)" "$d/seats/branches/innovation-centre" failed true "$(oc_terminal_evidence_path "$innov_id")"
+oc_record_failure "$liv" innovation-centre "$innov_id" run-inv-2 upstream_endpoint_unavailable "$(date +%s)" yes "$(date +%s)" "$d/seats/branches/innovation-centre" failed true "$(oc_terminal_evidence_path "$innov_id")"
+set_status failed "$(date +%s)" run-inv-2 upstream_endpoint_unavailable true true "$innov_id"
+/bin/sh "$VICHE_TOWN_ROOT/government/sitting.sh" innovation-centre
+innov_id_after=$(registry_row innovation-centre)
+test "$innov_id_after" != "$innov_id"
+jq -e '.state=="awaiting_reconciliation" and .previous_agent=="'"$innov_id"'"' \
+  "$d/state/continuity/reconciliation-innovation-centre.json" >/dev/null
+
+echo 'Office failure-recorder real-integration smoke passed'
