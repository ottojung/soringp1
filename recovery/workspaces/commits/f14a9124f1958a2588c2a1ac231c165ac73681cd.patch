+}
+async function main(){
+ const [cmd,arg,...rest]=process.argv.slice(2);
+ if(!cmd||cmd==='--help'){
+  console.log('marceline-request status | ping [message] | lean-check JOB.json | submit OP [argument] | wait ID [seconds] | cancel ID');return 0;
+ }
