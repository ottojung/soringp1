    government: recognise a re-enacted Innovation Office heading
    
    Six detection sites across five scripts (boot.sh x2, appointments.sh,
    branch-health.sh, executive-innovation-cycle.sh, sitting.sh) match the literal
    'Executive Innovation Office Act \(enacted ' only. A heading of the form required
    by Act 25 section 2.2.1 -- '(re-enacted 2026-11-08, bill ...v3)' -- is therefore
    not recognised: boot.sh runs the legacy innovation-centre cycle instead of the
    Executive office cycle and boot-smoke fails at '[ 10 -eq 11 ]'.
    
    Widening to '\((re-)?enacted ' at the same six sites is behaviour-preserving for
    the current '(enacted' heading and makes a compliant re-enacted heading
    operative. No assertion or expectation is changed.
    
    Rebuilt on current main 45f155378db96ebea9cf742ddb48c1e19139c34d (Act 25 codification at 5d89656, s4 records
    after).

diff --git a/government/appointments.sh b/government/appointments.sh
index c6b85f5f..43cc1189 100644
--- a/government/appointments.sh
+++ b/government/appointments.sh
@@ -35,7 +35,7 @@ if [ -z "$cwd" ]; then
     judiciary) title=Judiciary;;
     innovation-centre)
       title='Legislative Innovation Centre'
-      if grep -Eq '^## Act [0-9]+ — Executive Innovation Office Act \(enacted ' "$town/government/LAWS.md"; then
+      if grep -Eq '^## Act [0-9]+ — Executive Innovation Office Act \((re-)?enacted ' "$town/government/LAWS.md"; then
         title='Executive Innovation Office'
       fi ;;
     recovery-steward) title='Institutional Recovery Steward';;
diff --git a/government/boot.sh b/government/boot.sh
index ca6fc4bf..b99fab2e 100644
--- a/government/boot.sh
+++ b/government/boot.sh
@@ -77,7 +77,7 @@ if [ -f "$town/government/branch-liveness.sh" ]; then
 fi
 
 # The innovation office is an Executive unit ONLY after parliamentary enactment.
-if grep -Eq '^## Act [0-9]+ — Executive Innovation Office Act \(enacted ' "$town/government/LAWS.md"; then
+if grep -Eq '^## Act [0-9]+ — Executive Innovation Office Act \((re-)?enacted ' "$town/government/LAWS.md"; then
     /bin/sh "$town/government/executive-innovation-cycle.sh" ||
         echo "Viche: Executive Innovation Office needs recovery" >&2
 fi
@@ -107,7 +107,7 @@ if [ -f "$town/government/branch-liveness.sh" ]; then
         echo "Viche: Judiciary liveness investigation required" >&2
 fi
 # Run the historic legislative Centre ONLY until lawful transfer.
-if ! grep -Eq '^## Act [0-9]+ — Executive Innovation Office Act \(enacted ' "$town/government/LAWS.md"; then
+if ! grep -Eq '^## Act [0-9]+ — Executive Innovation Office Act \((re-)?enacted ' "$town/government/LAWS.md"; then
     if [ -f "$town/government/innovation-centre-cycle.sh" ]; then
         /bin/sh "$town/government/innovation-centre-cycle.sh" ||
             echo "Viche: legislative Innovation Centre failed; investigate" >&2
