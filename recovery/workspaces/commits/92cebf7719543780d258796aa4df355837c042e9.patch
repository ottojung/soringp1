    Accept checker-intake[bot] verdicts in PnP reconciliation
    
    The upstream checker now posts verdicts as pequalnp-intake[bot] after the
    repository/bot rename. Accept both the legacy LiorDagan author and the
    intake bot so ACCEPTED/REJECTED on an exact published revision are recorded
    and corrections trigger. Add a regression test.

diff --git a/missions/pnp/reconcile.py b/missions/pnp/reconcile.py
index 9106f2cc..96f0ecea 100644
--- a/missions/pnp/reconcile.py
+++ b/missions/pnp/reconcile.py
@@ -13,13 +13,18 @@ VERDICT = re.compile(
     r"^Checked on the base repository at commit `([0-9a-f]{9,40})`\.\s+"
     r"\*\*(ACCEPTED|REJECTED|FAULT|REFUSED) \([^\n]*\)\*\*", re.M)
 
+# The checker posts verdicts under the legacy human account and, after the
+# upstream repository/bot rename, under the intake bot. Accept both so a
+# verdict on a published, exact revision is never silently ignored.
+VERDICT_AUTHORS = frozenset({"LiorDagan", "pequalnp-intake[bot]"})
+
 
 def current_verdict(comments, sha):
     if not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{40}", sha):
         return None
     verdicts = []
     for comment in comments:
-        if comment.get("author") != "LiorDagan":
+        if comment.get("author") not in VERDICT_AUTHORS:
             continue
         body = comment.get("body") or ""
         match = VERDICT.search(body)
