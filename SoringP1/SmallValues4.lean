import SoringP1.SmallValues
import SoringP1.LowerBound

/-!
# `S 4 = 5`, via a machine-generated optimal decision tree

The tree below is an optimal 4-key comparison tree (worst-case 5 comparisons),
produced by a minimax search over partial orders and emitted mechanically.
Leaves are computable permutation expressions, so correctness is closed by
`decide`.
-/

namespace SoringP1

/-- If a budget `v` is feasible for `n` and `2^(v-1) < n!`, then `S n = v`. -/
theorem S_eq_of {n v : ℕ} (hup : HasBudget n v) (hlo : 2 ^ (v - 1) < n.factorial) :
    S n = v := by
  apply le_antisymm
  · rw [S_le_iff]; exact hup
  · have h := factorial_le_two_pow_S n
    by_contra hlt
    have hle : S n ≤ v - 1 := by omega
    have hpow : 2 ^ S n ≤ 2 ^ (v - 1) := Nat.pow_le_pow_right (by norm_num) hle
    omega

/-- Optimal 4-key sorting tree (5 comparisons), generated by minimax. -/
def treeFour : ComparisonTree 4 :=
  (.compare 0 1
    (.compare 0 2
      (.compare 1 2
        (.compare 1 3
          (.compare 2 3
            (.leaf (Equiv.refl (Fin 4)))
            (.leaf (Equiv.swap 2 3)))
          (.compare 0 3
            (.leaf ((Equiv.swap 2 3).trans (Equiv.swap 1 3)))
            (.leaf ((Equiv.swap 2 3).trans ((Equiv.swap 1 3).trans (Equiv.swap 0 3))))))
        (.compare 2 3
          (.compare 1 3
            (.leaf (Equiv.swap 1 2))
            (.leaf ((Equiv.swap 2 3).trans (Equiv.swap 1 2))))
          (.compare 0 3
            (.leaf (Equiv.swap 1 3))
            (.leaf ((Equiv.swap 1 3).trans (Equiv.swap 0 3))))))
      (.compare 0 3
        (.compare 1 3
          (.leaf ((Equiv.swap 1 2).trans (Equiv.swap 0 2)))
          (.leaf ((Equiv.swap 2 3).trans ((Equiv.swap 1 2).trans (Equiv.swap 0 2)))))
        (.compare 2 3
          (.leaf ((Equiv.swap 1 3).trans (Equiv.swap 0 2)))
          (.leaf ((Equiv.swap 2 3).trans ((Equiv.swap 1 2).trans (Equiv.swap 0 3)))))))
    (.compare 0 2
      (.compare 0 3
        (.compare 2 3
          (.leaf (Equiv.swap 0 1))
          (.leaf ((Equiv.swap 2 3).trans (Equiv.swap 0 1))))
        (.compare 1 3
          (.leaf ((Equiv.swap 2 3).trans ((Equiv.swap 1 3).trans (Equiv.swap 0 1))))
          (.leaf ((Equiv.swap 2 3).trans (Equiv.swap 0 3)))))
      (.compare 1 2
        (.compare 2 3
          (.compare 0 3
            (.leaf ((Equiv.swap 1 2).trans (Equiv.swap 0 1)))
            (.leaf ((Equiv.swap 2 3).trans ((Equiv.swap 1 2).trans (Equiv.swap 0 1)))))
          (.compare 1 3
            (.leaf ((Equiv.swap 1 3).trans (Equiv.swap 0 1)))
            (.leaf (Equiv.swap 0 3))))
        (.compare 1 3
          (.compare 0 3
            (.leaf (Equiv.swap 0 2))
            (.leaf ((Equiv.swap 2 3).trans (Equiv.swap 0 2))))
          (.compare 2 3
            (.leaf ((Equiv.swap 2 3).trans ((Equiv.swap 1 3).trans (Equiv.swap 0 2))))
            (.leaf ((Equiv.swap 1 2).trans (Equiv.swap 0 3))))))))

theorem treeFour_correct : Correct treeFour := by
  intro ranking
  fin_cases ranking <;> decide

theorem hasBudget_four : HasBudget 4 5 :=
  ⟨treeFour, treeFour_correct, by decide⟩

theorem S_four : S 4 = 5 :=
  S_eq_of hasBudget_four (by norm_num)

end SoringP1
